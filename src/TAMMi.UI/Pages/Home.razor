@page "/"
@inject WorkspaceTabs WorkspaceTabs
@inject NavigationManager Navigation

<div class="page">
    <h1>Workspaces</h1>

    <p class="placeholder">These are placeholder workspaces until workspaces can be created.</p>

    <ul class="workspace-list">
        @foreach (var workspace in PlaceholderWorkspaces.All)
        {
            <li class="workspace-card">
                <div>
                    <div class="workspace-name">@workspace.Name</div>
                    <div class="workspace-summary">@workspace.Summary</div>
                </div>
                <button type="button" class="button" @onclick="() => Open(workspace)">Open</button>
            </li>
        }
    </ul>
</div>

@code {
    private void Open(PlaceholderWorkspace workspace)
    {
        WorkspaceTabs.Open(workspace.Id, workspace.Name);
        Navigation.NavigateTo(AppRoutes.Workspace(workspace.Id));
    }
}
