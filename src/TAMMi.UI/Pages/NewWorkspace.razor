@page "/new-workspace"
@using TAMMi.Core.Platform
@using TAMMi.Core.Settings
@inject ISettingsStore SettingsStore
@inject IFolderPicker FolderPicker

<div class="page wizard">
    <h1>New workspace</h1>

    <ol class="wizard-steps" aria-label="Steps">
        @foreach (var (step, title) in Steps)
        {
            <li class="wizard-step @(step == _step ? "active" : null) @(step < _step ? "done" : null)"
                aria-current="@(step == _step ? "step" : null)">
                <span class="wizard-step-number">@((int)step + 1)</span>
                @title
            </li>
        }
    </ol>

    @switch (_step)
    {
        case WizardStep.Tasks:
            <section class="wizard-body">
                <h2>Choose tasks</h2>
                <p class="settings-help settings-intro">
                    Choose the tasks this workspace is for, from any of your integrations. You can change them later.
                </p>
                <TaskPicker Draft="_draft" />
            </section>
            break;

        case WizardStep.NameAndLocation:
            <section class="wizard-body">
                <h2>Name and location</h2>
                <div class="settings-form">
                    <div class="settings-field">
                        <label for="workspace-name">Name</label>
                        <input id="workspace-name" class="settings-text @(_draft.NameProblem is null ? null : "invalid")"
                               autocomplete="off" @bind="_draft.Name" @bind:event="oninput" />
                        @if (_draft.NameProblem is { } nameProblem)
                        {
                            <p class="error">@nameProblem</p>
                        }
                        else if (!_draft.IsNameEdited && _draft.Tasks.Count == 1)
                        {
                            <p class="settings-help">
                                From the task, in the format set in <a href="@AppRoutes.Settings">Settings › General</a>.
                            </p>
                        }
                    </div>

                    <div class="settings-field">
                        <label for="workspace-parent-folder">Parent folder</label>
                        <div class="settings-field-row">
                            <input id="workspace-parent-folder"
                                   class="settings-path @(_draft.ParentFolderProblem is null ? null : "invalid")"
                                   @bind="_draft.ParentFolder" @bind:event="oninput" />
                            <button type="button" class="button" @onclick="PickParentFolderAsync">Choose…</button>
                        </div>
                        @if (_draft.ParentFolderProblem is { } parentProblem)
                        {
                            <p class="error">@parentProblem</p>
                        }
                        else if (_draft.ParentFolderIsNew)
                        {
                            <p class="settings-help">This folder doesn't exist yet. It's created with the workspace.</p>
                        }
                    </div>

                    <div class="settings-field">
                        <div class="settings-field-label">Workspace Folder</div>
                        @if (_draft.Folder is { } folder)
                        {
                            <div class="wizard-folder">@folder</div>
                        }
                        else
                        {
                            <div class="placeholder">Enter a valid name and parent folder.</div>
                        }
                        @if (_draft.FolderProblem is { } folderProblem)
                        {
                            <p class="error">@folderProblem</p>
                        }
                    </div>
                </div>
            </section>
            break;

        case WizardStep.Repositories:
            <section class="wizard-body">
                <h2>Repositories</h2>
                <dl class="workspace-details-facts">
                    <dt>Name</dt>
                    <dd>@_draft.Name.Trim()</dd>
                    <dt>Workspace Folder</dt>
                    <dd>@_draft.Folder</dd>
                    <dt>Tasks</dt>
                    <dd>
                        @if (_draft.Tasks.Count == 0)
                        {
                            <span class="placeholder">None</span>
                        }
                        else
                        {
                            @string.Join(", ", _draft.Tasks.Select(task => task.Key))
                        }
                    </dd>
                </dl>
                <p class="placeholder">Choosing repositories and creating the workspace will appear here.</p>
            </section>
            break;
    }

    <div class="wizard-actions">
        <a class="button button-secondary" href="@AppRoutes.Home">Cancel</a>
        <div class="wizard-actions-end">
            @if (_step > WizardStep.Tasks)
            {
                <button type="button" class="button button-secondary" @onclick="Back">Back</button>
            }
            @if (_step < WizardStep.Repositories)
            {
                <button type="button" class="button" disabled="@(!CanGoNext)" @onclick="Next">Next</button>
            }
        </div>
    </div>
</div>

@code {
    private enum WizardStep
    {
        Tasks,
        NameAndLocation,
        Repositories,
    }

    private static readonly IReadOnlyList<(WizardStep Step, string Title)> Steps =
    [
        (WizardStep.Tasks, "Tasks"),
        (WizardStep.NameAndLocation, "Name and location"),
        (WizardStep.Repositories, "Repositories"),
    ];

    private WorkspaceDraft _draft = null!;
    private WizardStep _step = WizardStep.Tasks;

    // The location is checked against the disk again on Next, since a render's result can be out of date.
    private bool CanGoNext => _step != WizardStep.NameAndLocation || _draft.IsLocationValid;

    protected override void OnInitialized()
    {
        var general = SettingsStore.Current.General;
        _draft = new WorkspaceDraft(general.DefaultWorkspaceParentFolder, general.WorkspaceNameFormat);
    }

    private void Next()
    {
        if (CanGoNext)
        {
            _step++;
        }
    }

    private void Back() => _step--;

    private async Task PickParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the workspace's parent folder",
            InitialDirectory = Directory.Exists(_draft.ParentFolder) ? _draft.ParentFolder : null,
        });
        if (folder is not null)
        {
            _draft.ParentFolder = folder;
        }
    }
}
