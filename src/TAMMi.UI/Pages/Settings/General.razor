@page "/settings"
@layout SettingsLayout
@inherits SettingsSectionBase
@using TAMMi.Core.Integrations
@using TAMMi.Core.Platform
@using TAMMi.Core.Settings
@inject IFolderPicker FolderPicker

<h1>General</h1>

<div class="settings-form">
    <div class="settings-field">
        <label for="default-workspace-parent-folder">Default Workspace Parent Folder</label>
        <div class="settings-field-row">
            <input id="default-workspace-parent-folder"
                   class="settings-path"
                   value="@Current.DefaultWorkspaceParentFolder"
                   @onchange="OnDefaultWorkspaceParentFolderChanged" />
            <button type="button" class="button" @onclick="PickDefaultWorkspaceParentFolderAsync">Choose…</button>
        </div>
        <p class="settings-help">New workspaces are created in this folder unless you choose another one.</p>
    </div>

    <div class="settings-field">
        <h2 class="settings-field-title">Suggested workspace name</h2>
        <p class="settings-help settings-field-intro">
            How the name is written when a new workspace has exactly one task. You can still change it.
        </p>
        <div class="settings-options">
            <label for="workspace-name-separator">Separator</label>
            <select id="workspace-name-separator" value="@NameFormat.Separator"
                    @onchange="e => UpdateNameFormatAsync(f => f with { Separator = Parse(e, f.Separator) })">
                <option value="@WorkspaceNameSeparator.Hyphens">Hyphens</option>
                <option value="@WorkspaceNameSeparator.Underscores">Underscores</option>
                <option value="@WorkspaceNameSeparator.Spaces">Spaces</option>
            </select>

            <label for="workspace-name-case">Case</label>
            <select id="workspace-name-case" value="@NameFormat.Case"
                    @onchange="e => UpdateNameFormatAsync(f => f with { Case = Parse(e, f.Case) })">
                <option value="@WorkspaceNameCase.Lowercase">Lowercase</option>
                <option value="@WorkspaceNameCase.Uppercase">Uppercase</option>
                <option value="@WorkspaceNameCase.AsWritten">As written</option>
            </select>
        </div>
        <label class="settings-choice">
            <input type="checkbox" checked="@NameFormat.IncludeTaskReference"
                   @onchange="e => UpdateNameFormatAsync(f => f with { IncludeTaskReference = e.Value is true })" />
            Start with the task's reference
        </label>
        <dl class="settings-preview">
            @foreach (var example in Examples)
            {
                <dt>@example.Key @example.Title</dt>
                <dd>@(WorkspaceNames.Suggest([example], NameFormat))</dd>
            }
        </dl>
        <p class="settings-help">
            Hyphens and underscores leave out punctuation. A GitHub issue's reference is its repository and number.
        </p>
    </div>
</div>

@if (SaveError is not null)
{
    <p class="error">@SaveError</p>
}

@code {
    private GeneralSettings Current => SettingsStore.Current.General;

    private Task OnDefaultWorkspaceParentFolderChanged(ChangeEventArgs e) =>
        UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = e.Value?.ToString() ?? "" });

    private async Task PickDefaultWorkspaceParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the Default Workspace Parent Folder",
            InitialDirectory = Directory.Exists(Current.DefaultWorkspaceParentFolder)
                ? Current.DefaultWorkspaceParentFolder
                : null,
        });
        if (folder is not null)
        {
            await UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = folder });
        }
    }

    // Example tasks to preview the name format with, one from each kind of integration.
    private static readonly IReadOnlyList<TaskInfo> Examples =
    [
        new("example", "JIRA-123", "Add some feature", new Uri("https://example.com/")),
        new("example", "acme/api#42", "Fix the login page's error message", new Uri("https://example.com/")),
    ];

    private WorkspaceNameFormat NameFormat => Current.WorkspaceNameFormat;

    private Task UpdateNameFormatAsync(Func<WorkspaceNameFormat, WorkspaceNameFormat> update) =>
        UpdateGeneralAsync(general => general with { WorkspaceNameFormat = update(general.WorkspaceNameFormat) });

    private static T Parse<T>(ChangeEventArgs e, T current) where T : struct, Enum =>
        Enum.TryParse(e.Value?.ToString(), out T value) ? value : current;

    private Task UpdateGeneralAsync(Func<GeneralSettings, GeneralSettings> update) =>
        UpdateAsync(settings => settings with { General = update(settings.General) });
}
