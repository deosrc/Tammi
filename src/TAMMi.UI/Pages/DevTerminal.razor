@page "/dev/terminal"
@using TAMMi.Core.Platform
@implements IAsyncDisposable
@inject IPtyService PtyService
@inject IFolderPicker FolderPicker

@* A developer page for trying the embedded terminal with the platform's default shell. *@
<div class="dev-terminal">
    <header>
        <h1>Terminal</h1>
        <form @onsubmit="StartAsync">
            <label>
                Working folder
                <input @bind="_workingDirectory" placeholder="Home folder" />
            </label>
            <button type="button" @onclick="PickFolderAsync">Choose…</button>
            <button type="submit">@(_session is null ? "Start" : "Restart")</button>
        </form>
        <span class="status">@_status</span>
    </header>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @if (_session is not null)
    {
        <Terminal @key="_session" Session="_session" Class="dev-terminal-view" OnExited="OnExited" />
    }
</div>

@code {
    private string _workingDirectory = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
    private IPtySession? _session;
    private string? _status;
    private string? _error;

    protected override Task OnInitializedAsync() => StartAsync();

    private async Task StartAsync()
    {
        _error = null;
        await StopAsync();

        var shell = PtyService.GetDefaultShell() with
        {
            WorkingDirectory = string.IsNullOrWhiteSpace(_workingDirectory) ? null : _workingDirectory,
        };

        try
        {
            // The Terminal resizes the session to fit as soon as it's shown.
            _session = PtyService.Start(shell, PtySize.Default);
            _status = $"{Path.GetFileName(shell.FileName)} (PID {_session.ProcessId}) is running";
        }
        catch (Exception ex) when (ex is IOException or System.Runtime.InteropServices.ExternalException)
        {
            _error = ex.Message;
            _status = null;
        }
    }

    private async Task PickFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(
            new FolderPickerOptions { Title = "Choose the working folder", InitialDirectory = _workingDirectory });
        if (folder is not null)
        {
            _workingDirectory = folder;
        }
    }

    private void OnExited(int exitCode) => _status = $"Exited with code {exitCode}";

    private async Task StopAsync()
    {
        if (_session is not null)
        {
            var session = _session;
            _session = null;
            await session.DisposeAsync();
        }
    }

    public async ValueTask DisposeAsync() => await StopAsync();
}
