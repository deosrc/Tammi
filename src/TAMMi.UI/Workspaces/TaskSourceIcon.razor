@* The logo of a task's source, or nothing for a source TAMMi has no logo for (e.g. one that was removed). *@
@using TAMMi.Core.Integrations
@using TAMMi.Core.Integrations.GitHub
@using TAMMi.Core.Integrations.Jira

@if (Service is { } service)
{
    <span class="task-source-icon" title="@Source!.Name"><IntegrationIcon Service="service" /></span>
}

@code {
    /// <summary>
    /// The task's source, or <see langword="null"/> if it isn't connected.
    /// </summary>
    [Parameter]
    public IIntegration? Source { get; set; }

    private IntegrationService? Service => Source switch
    {
        GitHubIntegration => IntegrationService.GitHub,
        JiraIntegration => IntegrationService.Jira,
        _ => null,
    };
}
