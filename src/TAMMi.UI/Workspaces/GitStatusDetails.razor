@using TAMMi.Core.Git
@* The git status of a repository or submodule: what's checked out, what could be lost, and its submodules. *@

<div class="git-status-head">
    <span class="git-status-branch" title="@(Status.Branch is null ? "Detached HEAD" : "Branch")">
        @GitStatusText.Head(Status)
    </span>
    @if (Status.Upstream is not null && (Status.AheadBy > 0 || Status.BehindBy > 0))
    {
        <span class="git-status-ahead-behind" title="@GitStatusText.AheadBehindTitle(Status)">
            @if (Status.AheadBy > 0)
            {
                <span>↑@Status.AheadBy</span>
            }
            @if (Status.BehindBy > 0)
            {
                <span>↓@Status.BehindBy</span>
            }
        </span>
    }
</div>

@if (GitStatusText.Summary(Status) is { } summary)
{
    <div class="git-status-summary">@summary</div>
}

@if (Status.Submodules.Count > 0)
{
    <ul class="git-status-submodules">
        @foreach (var submodule in Status.Submodules)
        {
            <li class="git-status-submodule" @key="submodule.Path">
                <div class="git-status-heading">
                    <span class="git-status-name" title="@submodule.Name">@submodule.Path</span>
                    @if (submodule.Status is { } inner && GitStatusText.NeedsAttention(inner))
                    {
                        <span class="git-status-badge">@(inner.IsChanged ? "Changed" : "Out of sync")</span>
                    }
                </div>
                @if (submodule.CommitChange != SubmoduleCommitChange.None)
                {
                    <div class="git-status-summary">@GitStatusText.CommitChange(submodule.CommitChange)</div>
                }
                @if (submodule.Status is { } status)
                {
                    <GitStatusDetails Status="status" />
                }
                else
                {
                    <div class="placeholder">Not checked out</div>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public RepositoryStatus Status { get; set; } = null!;
}
