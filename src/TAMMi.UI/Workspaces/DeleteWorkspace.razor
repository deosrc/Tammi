@implements IDisposable
@inject WorkspaceDeleter Deleter
@inject WorkspaceTabs WorkspaceTabs

@* The Delete Workspace flow: check for work that would be lost, confirm, delete, then offer to delete the branches. *@
<div class="delete-workspace">
    @switch (_step)
    {
        case Step.Checking:
            <p class="placeholder">Checking for work that would be lost…</p>
            break;

        case Step.Failed:
            <p class="error">@_error</p>
            <div class="workspace-details-actions">
                <button type="button" class="button" @onclick="PlanAsync">Check again</button>
                <button type="button" class="button button-secondary" @onclick="OnCancel">Cancel</button>
            </div>
            break;

        case Step.Confirm when _plan is { Scope: WorkspaceDeletionScope.IndexEntryOnly } plan:
            <p class="workspace-details-problem">@plan.Reason</p>
            <p>
                Its folder isn't this workspace's any more, so it's left alone. Deleting the workspace only removes it
                from the list of workspaces.
            </p>
            <div class="workspace-details-actions">
                <button type="button" class="button button-danger" @onclick="DeleteAsync">Remove from list</button>
                <button type="button" class="button button-secondary" @onclick="OnCancel">Cancel</button>
            </div>
            break;

        case Step.Confirm when _plan is { } plan:
            <p>@WorktreeDeletionText.DescribeRemoval(plan) You can choose which branches to delete next.</p>
            @if (!plan.MetadataRead)
            {
                <p class="warning">
                    The workspace's metadata can't be read, so its worktrees were found by looking in its folder.
                </p>
            }
            @if (plan.CouldLoseWork)
            {
                <div class="alert alert-warning" role="alertdialog" aria-labelledby="delete-workspace-lost-title">
                    <h3 id="delete-workspace-lost-title" class="alert-title">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                            <path d="M12 9v4M12 17h.01" />
                        </svg>
                        Work will be lost
                    </h3>
                    <p>Deleting the workspace loses this work, which isn't committed and pushed anywhere else.</p>
                    <ul class="settings-list">
                        @foreach (var worktree in plan.Worktrees.Where(worktree => worktree.NeedsConfirmation))
                        {
                            <li class="settings-list-item">
                                <span class="settings-list-path">@worktree.FolderName</span>
                                <span class="settings-list-status">@WorktreeDeletionText.Describe(worktree)</span>
                            </li>
                        }
                        @foreach (var path in plan.OtherContent)
                        {
                            <li class="settings-list-item">
                                <span class="settings-list-path">@System.IO.Path.GetFileName(path)</span>
                                <span class="settings-list-status">Not a worktree</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            <div class="workspace-details-actions">
                <button type="button" class="button button-danger" @onclick="DeleteAsync">
                    @(plan.CouldLoseWork ? "Delete workspace and lose this work" : "Delete workspace")
                </button>
                <button type="button" class="button button-secondary" @onclick="OnCancel">Cancel</button>
            </div>
            break;

        case Step.Deleting:
            <p class="placeholder">Deleting the workspace…</p>
            break;

        case Step.Branches:
            <p>
                The workspace is deleted. Its @(_branches.Count == 1 ? "branch is" : "branches are") still in
                @(_branches.Count == 1 ? "its local repository" : "their local repositories"). Merged and pushed
                branches are selected, because deleting them loses no work.
            </p>
            <ul class="settings-list">
                @foreach (var branch in _branches)
                {
                    var id = $"delete-branch-{_branches.IndexOf(branch)}";
                    <li class="settings-list-item">
                        <input type="checkbox" id="@id" checked="@_selected.Contains(branch)"
                               @onchange="e => Select(branch, e.Value is true)" />
                        <label for="@id" class="settings-list-path">@branch.Branch</label>
                        <span class="settings-list-status" title="@branch.LocalRepositoryPath">
                            @WorktreeDeletionText.Describe(branch) · @System.IO.Path.GetFileName(branch.LocalRepositoryPath)
                        </span>
                    </li>
                }
            </ul>
            <div class="workspace-details-actions">
                <button type="button" class="button button-danger" disabled="@(_selected.Count == 0)"
                        @onclick="DeleteBranchesAsync">
                    Delete selected branches
                </button>
                <button type="button" class="button button-secondary" @onclick="OnFinished">Keep all branches</button>
            </div>
            break;

        case Step.DeletingBranches:
            <p class="placeholder">Deleting branches…</p>
            break;

        case Step.BranchesFailed:
            <p>The workspace is deleted, but some branches couldn't be deleted:</p>
            <ul class="settings-list">
                @foreach (var result in _failures)
                {
                    <li class="settings-list-item">
                        <span class="settings-list-path">@result.Branch.Branch</span>
                        <span class="error">@result.Error</span>
                    </li>
                }
            </ul>
            <div class="workspace-details-actions">
                <button type="button" class="button" @onclick="OnFinished">Done</button>
            </div>
            break;
    }
</div>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private bool _isDisposed;
    private Step _step = Step.Checking;
    private WorkspaceDeletionPlan? _plan;
    private string? _error;
    private List<WorkspaceBranch> _branches = [];
    private readonly HashSet<WorkspaceBranch> _selected = [];
    private IReadOnlyList<BranchDeletionResult> _failures = [];

    private enum Step
    {
        Checking,
        Failed,
        Confirm,
        Deleting,
        Branches,
        DeletingBranches,
        BranchesFailed,
    }

    /// <summary>
    /// The workspace to delete.
    /// </summary>
    [Parameter, EditorRequired]
    public string WorkspaceId { get; set; } = "";

    /// <summary>
    /// Called when the user cancels before anything is deleted.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Called once the workspace is deleted and the user is done with its branches.
    /// </summary>
    [Parameter]
    public EventCallback OnFinished { get; set; }

    protected override Task OnInitializedAsync() => PlanAsync();

    public void Dispose()
    {
        _isDisposed = true;
        if (_step is Step.Branches or Step.BranchesFailed)
        {
            // The workspace is already deleted, so its tab has nothing left to show. Its branches are kept.
            WorkspaceTabs.Close(WorkspaceId);
        }

        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task PlanAsync()
    {
        _step = Step.Checking;
        try
        {
            _plan = await Deleter.PlanAsync(WorkspaceId, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Fail($"Couldn't check the workspace for work that would be lost. {ex.Message}");
            return;
        }

        if (_isDisposed)
        {
            return;
        }

        if (_plan is null)
        {
            // Already gone, e.g. deleted from another tab.
            await OnFinished.InvokeAsync();
            return;
        }

        _step = Step.Confirm;
    }

    private async Task DeleteAsync()
    {
        _step = Step.Deleting;
        IReadOnlyList<WorkspaceBranch> branches;
        try
        {
            // Not cancelled if the flow is closed, e.g. by showing another tab, so it doesn't stop half-way.
            branches = await Deleter.DeleteAsync(_plan!, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Fail(ex is WorkspaceDeletionException ? ex.Message : $"Couldn't delete the workspace. {ex.Message}");
            return;
        }

        if (_isDisposed)
        {
            // Nothing is showing the flow any more, so its branches can't be offered. They're kept.
            WorkspaceTabs.Close(WorkspaceId);
            return;
        }

        if (branches.Count == 0)
        {
            await OnFinished.InvokeAsync();
            return;
        }

        _branches = [.. branches];
        _selected.Clear();
        _selected.UnionWith(branches.Where(branch => branch.SelectedByDefault));
        _step = Step.Branches;
    }

    private void Select(WorkspaceBranch branch, bool selected)
    {
        if (selected)
        {
            _selected.Add(branch);
        }
        else
        {
            _selected.Remove(branch);
        }
    }

    private async Task DeleteBranchesAsync()
    {
        _step = Step.DeletingBranches;
        var results = await Deleter.DeleteBranchesAsync(_branches.Where(_selected.Contains).ToList());
        if (_isDisposed)
        {
            WorkspaceTabs.Close(WorkspaceId);
            return;
        }

        _failures = [.. results.Where(result => !result.Succeeded)];
        if (_failures.Count == 0)
        {
            await OnFinished.InvokeAsync();
            return;
        }

        _step = Step.BranchesFailed;
    }

    private void Fail(string error)
    {
        _error = error;
        _step = Step.Failed;
    }
}
