@page "/new-workspace"
@using Deosrc.Tammi.Core.Platform
@inject IFolderPicker FolderPicker
@inject Deosrc.Tammi.UI.Layout.NewWorkspaceTabState TabState
@inject NavigationManager Navigation
@implements IDisposable

<div class="page wizard">
    <h1>New workspace</h1>

    @* The steps are changed with the buttons below, which check each one first, so the wizard's own navigation is off. *@
    <FluentWizard Value="@((int)_step)" StepSequence="WizardStepSequence.Linear" StepperPosition="StepperPosition.Top" Height="auto"
                  DisplayStepNumber="@(WizardStepStatus.Current | WizardStepStatus.Next | WizardStepStatus.Previous)">
        <Steps>
            <FluentWizardStep Label="Tasks" DeferredLoading="true" OnChange="KeepStep">
                <section class="wizard-body">
                    <h2>Choose tasks</h2>
                    <p class="settings-help settings-intro">
                        Choose the tasks this workspace is for, from any of your integrations. You can change them later.
                    </p>
                    <TaskPicker Draft="_draft" />
                </section>
            </FluentWizardStep>

            <FluentWizardStep Label="Name and location" DeferredLoading="true" OnChange="KeepStep">
                <section class="wizard-body">
                    <h2>Name and location</h2>
                    <div class="settings-form">
                        <div class="settings-field-group">
                            <FluentTextInput Label="Name" AutoComplete="off" Width="100%" Immediate="true"
                                             @bind-Value="_draft.Name" MessageCondition="FluentFieldCondition.Always"
                                             MessageState="@(_draft.NameProblem is null ? null : MessageState.Error)"
                                             Message="@_draft.NameProblem" />
                            @if (_draft.NameProblem is null && !_draft.IsNameEdited && _draft.SuggestedName is not null)
                            {
                                <p class="settings-help">
                                    From the task, with the template set in
                                    <FluentLink Href="@AppRoutes.Settings">Settings › General</FluentLink>.
                                </p>
                            }
                            else if (_draft.NameProblem is null && !_draft.IsNameEdited)
                            {
                                <p class="settings-help">The folder name, unless you enter another.</p>
                            }

                            <FluentTextInput Label="Folder name" AutoComplete="off" Width="100%" Immediate="true"
                                             @bind-Value="_draft.FolderName" MessageCondition="FluentFieldCondition.Always"
                                             MessageState="@(_draft.FolderNameProblem is null ? null : MessageState.Error)"
                                             Message="@_draft.FolderNameProblem" />
                            @if (_draft.FolderNameProblem is null && !_draft.IsFolderNameEdited && _draft.SuggestedFolderName is not null)
                            {
                                <p class="settings-help">
                                    From the task, in the format set in
                                    <FluentLink Href="@AppRoutes.Settings">Settings › General</FluentLink>.
                                </p>
                            }
                            else if (_draft.FolderNameProblem is null && !_draft.IsFolderNameEdited && _draft.IsNameEdited)
                            {
                                <p class="settings-help">
                                    From the name, in the format set in
                                    <FluentLink Href="@AppRoutes.Settings">Settings › General</FluentLink>.
                                </p>
                            }

                            <FluentTextInput Label="Parent folder" Width="100%" Immediate="true"
                                             @bind-Value="_draft.ParentFolder" MessageCondition="FluentFieldCondition.Always"
                                             MessageState="@(_draft.ParentFolderProblem is null ? null : MessageState.Error)"
                                             Message="@(_draft.ParentFolderProblem
                                                 ?? (_draft.ParentFolderIsNew ? "This folder doesn't exist yet. It's created with the workspace." : null))">
                                <EndTemplate>
                                    <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                                                  OnClick="PickParentFolderAsync">
                                        Choose…
                                    </FluentButton>
                                </EndTemplate>
                            </FluentTextInput>

                            <div>
                                <div class="settings-field-label">Workspace Folder</div>
                                @if (_draft.Folder is { } folder)
                                {
                                    <div class="wizard-folder">@folder</div>
                                }
                                else
                                {
                                    <div class="placeholder">Enter a valid folder name and parent folder.</div>
                                }
                                @if (_draft.FolderProblem is { } folderProblem)
                                {
                                    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                                      AllowDismiss="false">
                                        <CopyOnClick>@folderProblem</CopyOnClick>
                                    </FluentMessageBar>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </FluentWizardStep>

            <FluentWizardStep Label="Repositories" DeferredLoading="true" OnChange="KeepStep">
                <section class="wizard-body">
                    <h2>Repositories</h2>
                    <dl class="workspace-details-facts">
                        <dt>Name</dt>
                        <dd>@_draft.Name.Trim()</dd>
                        <dt>Workspace Folder</dt>
                        <dd>@_draft.Folder</dd>
                        <dt>Tasks</dt>
                        <dd>
                            @if (_draft.Tasks.Count == 0)
                            {
                                <span class="placeholder">None</span>
                            }
                            else
                            {
                                @string.Join(", ", _draft.Tasks.Select(task => task.Key))
                            }
                        </dd>
                    </dl>

                    @if (_created is not null)
                    {
                        <p>The workspace <strong>@_created.Workspace.Name</strong> was created.</p>
                        @foreach (var warning in _created.Warnings)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                <CopyOnClick>@warning</CopyOnClick>
                            </FluentMessageBar>
                        }
                    }
                    else if (_creating)
                    {
                        <div class="workspace-creation" aria-live="polite">
                            <FluentProgressBar Value="@(_progress?.CompletedSteps ?? 0)" Max="@(_progress?.TotalSteps ?? 1)"
                                               Width="100%" />
                            <p>@(_progress?.Message ?? "Checking…")</p>
                        </div>
                    }
                    else
                    {
                        <RepositoryPicker Draft="_draft" Changed="StateHasChanged" />
                    }

                    @if (_failure is not null)
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                          AllowDismiss="false">
                            <CopyOnClick Block="true">
                                @if (_failure.Problems.Count > 0)
                                {
                                    <p>The workspace can't be created:</p>
                                    <ul>
                                        @foreach (var problem in _failure.Problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p>@_failure.Message</p>
                                }
                                @if (_failure.CleanupProblems.Count > 0)
                                {
                                    <p>Some of what was created couldn't be removed again:</p>
                                    <ul>
                                        @foreach (var problem in _failure.CleanupProblems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                            </CopyOnClick>
                        </FluentMessageBar>
                        @if (_failure.CleanupProblems.Count == 0 && _failure.InnerException is not null)
                        {
                            <p class="settings-help">Everything created for it has been removed again.</p>
                        }
                    }
                </section>
            </FluentWizardStep>
        </Steps>
        @* The buttons are below the wizard, across the whole page, not in its own button area. *@
        <ButtonTemplate></ButtonTemplate>
    </FluentWizard>

    <div class="wizard-actions">
        @if (_created is not null)
        {
            <FluentButton OnClick="Close">Home</FluentButton>
            <div class="wizard-actions-end">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OpenCreated">Open workspace</FluentButton>
            </div>
        }
        else if (_creating)
        {
            <FluentButton Disabled="_cancelling" OnClick="CancelCreating">
                @(_cancelling ? "Cancelling…" : "Cancel")
            </FluentButton>
        }
        else
        {
            <FluentButton OnClick="Close">Cancel</FluentButton>
            <div class="wizard-actions-end">
                @if (_step > NewWorkspaceStep.Tasks)
                {
                    <FluentButton OnClick="Back">Back</FluentButton>
                }
                @if (_step < NewWorkspaceStep.Repositories)
                {
                    <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanGoNext)" OnClick="Next">
                        Next
                    </FluentButton>
                }
                else
                {
                    <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!_draft.IsRepositoriesValid)"
                                  OnClick="CreateAsync">
                        Create workspace
                    </FluentButton>
                }
            </div>
        }
    </div>
</div>

@code {
    private NewWorkspaceSession _session = null!;

    private WorkspaceDraft _draft => _session.Draft;
    private NewWorkspaceStep _step => _session.Step;
    private bool _creating => _session.IsCreating;
    private bool _cancelling => _session.IsCancelling;
    private WorkspaceCreationProgress? _progress => _session.Progress;
    private WorkspaceCreationException? _failure => _session.Failure;
    private WorkspaceCreationResult? _created => _session.Created;

    // The location is checked against the disk again on Next, since a render's result can be out of date.
    private bool CanGoNext => _step != NewWorkspaceStep.NameAndLocation || _draft.IsLocationValid;

    protected override void OnInitialized()
    {
        // Resumes the flow if the tab was already open. Also covers arriving here by address rather than from Home.
        _session = TabState.Open();
        _session.Changed += OnSessionChanged;
        _session.Completed += OnCompleted;
    }

    public void Dispose()
    {
        // Leaving the page keeps the session, and a creation carries on.
        _session.Changed -= OnSessionChanged;
        _session.Completed -= OnCompleted;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Shows the agent started with the workspace, if any, or else its dashboard.
    private void OnCompleted(Deosrc.Tammi.Core.Workspaces.Workspace workspace, IMainAreaTab? tab) =>
        InvokeAsync(() => Navigation.NavigateTo(tab is null
            ? AppRoutes.Workspace(workspace.Id)
            : AppRoutes.WorkspaceTab(workspace.Id, tab.Id)));

    // The steps are changed with the buttons, so the wizard's own way of changing them (clicking a step) is turned off.
    private static void KeepStep(FluentWizardStepChangeEventArgs args) => args.IsCancelled = true;

    private void Next()
    {
        if (CanGoNext)
        {
            _session.Step++;
        }
    }

    private void Back()
    {
        _session.Failure = null;
        _session.Step--;
    }

    private Task CreateAsync() => _session.CreateAsync();

    private void CancelCreating() => _session.CancelCreating();

    private void OpenCreated() => _session.OpenCreated();

    private void Close()
    {
        TabState.Close();
        Navigation.NavigateTo(AppRoutes.Home);
    }

    private async Task PickParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the workspace's parent folder",
            InitialDirectory = Directory.Exists(_draft.ParentFolder) ? _draft.ParentFolder : null,
        });
        if (folder is not null)
        {
            _draft.ParentFolder = folder;
        }
    }
}
