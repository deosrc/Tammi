@page "/new-workspace"
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@inject ISettingsStore SettingsStore
@inject IFolderPicker FolderPicker
@inject WorkspaceCreator Creator
@inject WorkspaceTabs WorkspaceTabs
@inject NavigationManager Navigation
@implements IDisposable

<div class="page wizard">
    <h1>New workspace</h1>

    <ol class="wizard-steps" aria-label="Steps">
        @foreach (var (step, title) in Steps)
        {
            <li class="wizard-step @(step == _step ? "active" : null) @(step < _step ? "done" : null)"
                aria-current="@(step == _step ? "step" : null)">
                <span class="wizard-step-number">@((int)step + 1)</span>
                @title
            </li>
        }
    </ol>

    @switch (_step)
    {
        case WizardStep.Tasks:
            <section class="wizard-body">
                <h2>Choose tasks</h2>
                <p class="settings-help settings-intro">
                    Choose the tasks this workspace is for, from any of your integrations. You can change them later.
                </p>
                <TaskPicker Draft="_draft" />
            </section>
            break;

        case WizardStep.NameAndLocation:
            <section class="wizard-body">
                <h2>Name and location</h2>
                <div class="settings-form">
                    <div class="settings-field">
                        <label for="workspace-name">Name</label>
                        <input id="workspace-name" class="settings-text @(_draft.NameProblem is null ? null : "invalid")"
                               autocomplete="off" @bind="_draft.Name" @bind:event="oninput" />
                        @if (_draft.NameProblem is { } nameProblem)
                        {
                            <p class="error">@nameProblem</p>
                        }
                        else if (!_draft.IsNameEdited && _draft.SuggestedName is not null)
                        {
                            <p class="settings-help">
                                From the task, with the template set in
                                <a href="@AppRoutes.Settings">Settings › General</a>.
                            </p>
                        }
                        else if (!_draft.IsNameEdited)
                        {
                            <p class="settings-help">The folder name, unless you enter another.</p>
                        }
                    </div>

                    <div class="settings-field">
                        <label for="workspace-folder-name">Folder name</label>
                        <input id="workspace-folder-name"
                               class="settings-text @(_draft.FolderNameProblem is null ? null : "invalid")"
                               autocomplete="off" @bind="_draft.FolderName" @bind:event="oninput" />
                        @if (_draft.FolderNameProblem is { } folderNameProblem)
                        {
                            <p class="error">@folderNameProblem</p>
                        }
                        else if (!_draft.IsFolderNameEdited && _draft.SuggestedFolderName is not null)
                        {
                            <p class="settings-help">
                                From the task, in the format set in <a href="@AppRoutes.Settings">Settings › General</a>.
                            </p>
                        }
                        else if (!_draft.IsFolderNameEdited && _draft.IsNameEdited)
                        {
                            <p class="settings-help">
                                From the name, in the format set in <a href="@AppRoutes.Settings">Settings › General</a>.
                            </p>
                        }
                    </div>

                    <div class="settings-field">
                        <label for="workspace-parent-folder">Parent folder</label>
                        <div class="settings-field-row">
                            <input id="workspace-parent-folder"
                                   class="settings-path @(_draft.ParentFolderProblem is null ? null : "invalid")"
                                   @bind="_draft.ParentFolder" @bind:event="oninput" />
                            <button type="button" class="button" @onclick="PickParentFolderAsync">Choose…</button>
                        </div>
                        @if (_draft.ParentFolderProblem is { } parentProblem)
                        {
                            <p class="error">@parentProblem</p>
                        }
                        else if (_draft.ParentFolderIsNew)
                        {
                            <p class="settings-help">This folder doesn't exist yet. It's created with the workspace.</p>
                        }
                    </div>

                    <div class="settings-field">
                        <div class="settings-field-label">Workspace Folder</div>
                        @if (_draft.Folder is { } folder)
                        {
                            <div class="wizard-folder">@folder</div>
                        }
                        else
                        {
                            <div class="placeholder">Enter a valid folder name and parent folder.</div>
                        }
                        @if (_draft.FolderProblem is { } folderProblem)
                        {
                            <p class="error">@folderProblem</p>
                        }
                    </div>
                </div>
            </section>
            break;

        case WizardStep.Repositories:
            <section class="wizard-body">
                <h2>Repositories</h2>
                <dl class="workspace-details-facts">
                    <dt>Name</dt>
                    <dd>@_draft.Name.Trim()</dd>
                    <dt>Workspace Folder</dt>
                    <dd>@_draft.Folder</dd>
                    <dt>Tasks</dt>
                    <dd>
                        @if (_draft.Tasks.Count == 0)
                        {
                            <span class="placeholder">None</span>
                        }
                        else
                        {
                            @string.Join(", ", _draft.Tasks.Select(task => task.Key))
                        }
                    </dd>
                </dl>

                @if (_created is not null)
                {
                    <p>The workspace <strong>@_created.Workspace.Name</strong> was created.</p>
                    @foreach (var warning in _created.Warnings)
                    {
                        <p class="warning">@warning</p>
                    }
                }
                else if (_creating)
                {
                    <div class="workspace-creation" aria-live="polite">
                        <progress max="@(_progress?.TotalSteps ?? 1)" value="@(_progress?.CompletedSteps ?? 0)"></progress>
                        <p>@(_progress?.Message ?? "Checking…")</p>
                    </div>
                }
                else
                {
                    <RepositoryPicker Draft="_draft" Changed="StateHasChanged" />
                }

                @if (_failure is not null)
                {
                    <div class="workspace-creation-failure" role="alert">
                        @if (_failure.Problems.Count > 0)
                        {
                            <p class="error">The workspace can't be created:</p>
                            <ul>
                                @foreach (var problem in _failure.Problems)
                                {
                                    <li class="error">@problem</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="error">@_failure.Message</p>
                        }
                        @if (_failure.CleanupProblems.Count == 0)
                        {
                            @if (_failure.InnerException is not null)
                            {
                                <p class="settings-help">Everything created for it has been removed again.</p>
                            }
                        }
                        else
                        {
                            <p class="error">Some of what was created couldn't be removed again:</p>
                            <ul>
                                @foreach (var problem in _failure.CleanupProblems)
                                {
                                    <li class="error">@problem</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
            break;
    }

    <div class="wizard-actions">
        @if (_created is not null)
        {
            <a class="button button-secondary" href="@AppRoutes.Home">Home</a>
            <div class="wizard-actions-end">
                <button type="button" class="button" @onclick="OpenCreated">Open workspace</button>
            </div>
        }
        else if (_creating)
        {
            <button type="button" class="button button-secondary" disabled="@_cancelling" @onclick="CancelCreating">
                @(_cancelling ? "Cancelling…" : "Cancel")
            </button>
        }
        else
        {
            <a class="button button-secondary" href="@AppRoutes.Home">Cancel</a>
            <div class="wizard-actions-end">
                @if (_step > WizardStep.Tasks)
                {
                    <button type="button" class="button button-secondary" @onclick="Back">Back</button>
                }
                @if (_step < WizardStep.Repositories)
                {
                    <button type="button" class="button" disabled="@(!CanGoNext)" @onclick="Next">Next</button>
                }
                else
                {
                    <button type="button" class="button" disabled="@(!_draft.IsRepositoriesValid)"
                            @onclick="CreateAsync">Create workspace</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private enum WizardStep
    {
        Tasks,
        NameAndLocation,
        Repositories,
    }

    private static readonly IReadOnlyList<(WizardStep Step, string Title)> Steps =
    [
        (WizardStep.Tasks, "Tasks"),
        (WizardStep.NameAndLocation, "Name and location"),
        (WizardStep.Repositories, "Repositories"),
    ];

    private WorkspaceDraft _draft = null!;
    private WizardStep _step = WizardStep.Tasks;
    private bool _creating;
    private bool _cancelling;
    private CancellationTokenSource? _creation;
    private WorkspaceCreationProgress? _progress;
    private WorkspaceCreationException? _failure;
    private WorkspaceCreationResult? _created;

    // The location is checked against the disk again on Next, since a render's result can be out of date.
    private bool CanGoNext => _step != WizardStep.NameAndLocation || _draft.IsLocationValid;

    protected override void OnInitialized()
    {
        var general = SettingsStore.Current.General;
        _draft = new WorkspaceDraft(
            general.DefaultWorkspaceParentFolder,
            general.WorkspaceFolderNameFormat,
            general.WorkspaceNameTemplate);
    }

    private void Next()
    {
        if (CanGoNext)
        {
            _step++;
        }
    }

    private void Back()
    {
        _failure = null;
        _step--;
    }

    public void Dispose()
    {
        // Leaving the page while creating stops it, and removes what was created.
        _creation?.Cancel();
    }

    private async Task CreateAsync()
    {
        if (!_draft.IsLocationValid)
        {
            // Something appeared at the Workspace Folder since the last step.
            _step = WizardStep.NameAndLocation;
            return;
        }

        _failure = null;
        _progress = null;
        _creating = true;
        _cancelling = false;
        using var creation = _creation = new CancellationTokenSource();
        var progress = new Progress<WorkspaceCreationProgress>(update =>
        {
            _progress = update;
            StateHasChanged();
        });
        try
        {
            _created = await Creator.CreateAsync(_draft.ToCreationRequest(), progress, creation.Token);
            if (_created.Warnings.Count == 0)
            {
                OpenCreated();
            }
        }
        catch (WorkspaceCreationException ex)
        {
            _failure = ex;
        }
        catch (OperationCanceledException)
        {
            // Cancelled by the user, or by leaving the page. Nothing is left on disk.
        }
        finally
        {
            _creation = null;
            _creating = false;
        }
    }

    private void CancelCreating()
    {
        _cancelling = true;
        _creation?.Cancel();
    }

    private void OpenCreated()
    {
        if (_created?.Workspace is { } workspace)
        {
            WorkspaceTabs.Open(workspace.Id, workspace.Name);
            Navigation.NavigateTo(AppRoutes.Workspace(workspace.Id));
        }
    }

    private async Task PickParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the workspace's parent folder",
            InitialDirectory = Directory.Exists(_draft.ParentFolder) ? _draft.ParentFolder : null,
        });
        if (folder is not null)
        {
            _draft.ParentFolder = folder;
        }
    }
}
