@page "/usage"
@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Usage
@using Deosrc.Tammi.UI.Components
@inject AgentUsageMonitor Monitor
@inject Deosrc.Tammi.UI.Layout.UsageTabState TabState

<div class="page">
    <h1>AI Usage</h1>

    <div class="usage-toolbar">
        <FluentSelect Label="Show in the footer" Items="@Monitor.AgentNames" OptionText="@(name => name)"
                      Value="@Monitor.TabAgentName" ValueChanged="@((string name) => OnTabAgentChanged(name))" />
    </div>

    @foreach (var name in Monitor.AgentNames)
    {
        var state = Monitor.Get(name);
        <FluentCard Class="usage-agent">
            @* The heading is the same as an agent's card on the Agents settings page. *@
            <div class="agent-definition-header">
                <AgentIcon Definition="DefinitionOf(name)" />
                <span class="agent-definition-name" role="heading" aria-level="2">@name</span>
                @if (state.Usage is { } updated)
                {
                    <span class="usage-limit-reset">Updated @updated.FetchedAt.ToLocalTime().ToString("t")</span>
                }
                <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small" IconOnly="true"
                              Loading="@_refreshing.Contains(name)" IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                              Title="Read the usage again" aria-label="@($"Refresh {name} usage")"
                              OnClick="() => RefreshAsync(name, force: true)" />
            </div>
            @if (state.Error is not null)
            {
                <PanelMessage Intent="MessageBarIntent.Warning"><CopyOnClick>@state.Error</CopyOnClick></PanelMessage>
            }
            @if (state.Usage is { } usage)
            {
                @if (usage.Limits.Count == 0)
                {
                    <p>No usage limits were reported.</p>
                }
                <ul class="usage-limits">
                    @foreach (var limit in usage.Limits)
                    {
                        <li>
                            <div class="usage-limit-header">
                                <span>@limit.Description</span>
                                <span>@limit.PercentUsed.ToString("0")% used</span>
                            </div>
                            <UsageBar Limit="limit" Large="true" />
                            @if (limit.ResetsAt is { } resetsAt)
                            {
                                <div class="usage-limit-reset">Resets @ResetText(resetsAt)</div>
                            }
                        </li>
                    }
                </ul>
            }
            else if (state.Error is null)
            {
                <p>Reading usage…</p>
            }
        </FluentCard>
    }
</div>

@code {
    // The agents whose usage is being read.
    private readonly HashSet<string> _refreshing = [];

    protected override async Task OnInitializedAsync()
    {
        // Also covers arriving here by address rather than from the footer.
        TabState.Open();
        Monitor.Changed += OnChanged;
        await Task.WhenAll(Monitor.AgentNames.Select(name => RefreshAsync(name, force: false)));
    }

    public void Dispose() => Monitor.Changed -= OnChanged;

    private async Task RefreshAsync(string name, bool force)
    {
        _refreshing.Add(name);
        try
        {
            await Monitor.RefreshAsync(name, force);
        }
        finally
        {
            _refreshing.Remove(name);
        }
    }

    // The agent's definition, which gives its icon.
    private static AgentDefinition DefinitionOf(string name) =>
        name == AgentDefinition.ClaudeCode.Name ? AgentDefinition.ClaudeCode : new AgentDefinition(name, name);

    private Task OnTabAgentChanged(string? name) =>
        name is null ? Task.CompletedTask : Monitor.SetTabAgentAsync(name);

    private static string ResetText(DateTimeOffset resetsAt)
    {
        var relative = UsageText.TimeUntil(resetsAt, DateTimeOffset.UtcNow);
        return (relative == "now" ? relative : "in " + relative) + $" ({resetsAt.ToLocalTime():ddd HH:mm})";
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
