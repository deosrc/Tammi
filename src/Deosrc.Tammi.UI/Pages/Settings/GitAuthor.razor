@using Deosrc.Tammi.Core.Git
@inject IGitUserConfig GitUserConfig

@* The commit author in the user's global git config. It isn't an app setting, so it's read from and saved to git. *@
<div class="settings-field-group">
    <div class="settings-field">
        <h2 class="settings-field-title">Author</h2>
        <p class="settings-help">
            The name and email address git records on your commits. They're saved in your global git config, so they
            apply to every git tool on this computer, not only Tammi. Leave one empty to remove it.
        </p>
    </div>

    @if (_loadError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
            <CopyOnClick>@_loadError</CopyOnClick>
        </FluentMessageBar>
    }
    else if (_identity is null)
    {
        <p class="placeholder">Reading your git config…</p>
    }
    else
    {
        @* Recreated after each change (the keys change), so the input shows the saved value, e.g. without surrounding
           spaces. *@
        <FluentTextInput @key="@("name-" + _revision)"
                         Label="Name"
                         AutoComplete="name"
                         Value="@_identity.Name"
                         ValueChanged="OnNameChanged" />

        <FluentTextInput @key="@("email-" + _revision)"
                         Label="Email"
                         TextInputType="TextInputType.Email"
                         AutoComplete="email"
                         Value="@_identity.Email"
                         ValueChanged="OnEmailChanged" />

        @if (_saveError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                <CopyOnClick>@_saveError</CopyOnClick>
            </FluentMessageBar>
        }
    }
</div>

@code {
    private GitIdentity? _identity;
    private string? _loadError;
    private string? _saveError;
    private int _revision;

    /// <summary>
    /// Raised when the author changes, e.g. so a new SSH key can default to the email address.
    /// </summary>
    [Parameter]
    public EventCallback<GitIdentity> IdentityChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _identity = await GitUserConfig.GetIdentityAsync();
            await IdentityChanged.InvokeAsync(_identity);
        }
        catch (GitException ex)
        {
            _loadError = $"Couldn't read your git config. {ex.Message}";
        }
    }

    private Task OnNameChanged(string? value) =>
        SaveAsync(name => GitUserConfig.SetNameAsync(name), value, identity => identity.Name);

    private Task OnEmailChanged(string? value) =>
        SaveAsync(email => GitUserConfig.SetEmailAsync(email), value, identity => identity.Email);

    private async Task SaveAsync(Func<string?, Task> save, string? value, Func<GitIdentity, string?> shown)
    {
        try
        {
            await save(value);
            _saveError = null;
        }
        catch (GitException ex)
        {
            _saveError = $"Couldn't save your git config. {ex.Message}";
        }

        // Shows what git saved, which might differ from what was typed (e.g. trimmed), or not have changed.
        try
        {
            _identity = await GitUserConfig.GetIdentityAsync();
            await IdentityChanged.InvokeAsync(_identity);
        }
        catch (GitException ex)
        {
            _loadError = $"Couldn't read your git config. {ex.Message}";
        }

        // Recreating the inputs drops their focus, so it's only done when what's shown differs from what was typed.
        if (_identity is null || !string.Equals(shown(_identity) ?? "", value ?? "", StringComparison.Ordinal))
        {
            _revision++;
        }
    }
}
