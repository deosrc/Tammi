@page "/settings/about"
@layout SettingsLayout

<h1>About</h1>

<div class="about-logo">
    <img class="about-logo-on-light" src="_content/Deosrc.Tammi.UI/images/tammi-wordmark-on-light.svg" alt="@AppInfo.Name" width="228" height="64" />
    <img class="about-logo-on-dark" src="_content/Deosrc.Tammi.UI/images/tammi-wordmark-on-dark.svg" alt="@AppInfo.Name" width="228" height="64" />
</div>

<p>@AppInfo.Name: task-first software development workspace manager.</p>

<dl class="settings-values">
    <dt>Version</dt>
    <dd>@AppInfo.Version</dd>
    <dt>Git CLI version</dt>
    <dd><GitCliVersion /></dd>
    <dt>libgit2 version</dt>
    <dd><LibGit2Version /></dd>
</dl>

<p><a href="@AppRoutes.ThirdPartySoftware">Third-party software and licenses</a></p>
