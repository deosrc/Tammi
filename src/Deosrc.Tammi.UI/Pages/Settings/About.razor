@page "/settings/about"
@layout SettingsLayout

<h1>About</h1>

<BrandWordmark Class="about-logo" />

<p>@AppInfo.Name: task-first software development workspace manager.</p>

@* Copied together, e.g. for a bug report. *@
<CopyOnClick Block="true" Class="about-versions" What="the versions">
    <dl class="settings-values">
        <dt>Version</dt>
        <dd>@AppInfo.Version</dd>
        <dt>Git CLI version</dt>
        <dd><GitCliVersion /></dd>
        <dt>libgit2 version</dt>
        <dd><LibGit2Version /></dd>
    </dl>
</CopyOnClick>

<p><FluentLink Href="@AppRoutes.ThirdPartySoftware">Third-party software and licenses</FluentLink></p>
