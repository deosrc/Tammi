@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Ssh
@implements IDisposable
@inject ISshKeyStore KeyStore
@inject IntegrationRegistry Registry
@inject IProcessLauncher ProcessLauncher
@inject Clipboard Clipboard

@* The SSH keys in ~/.ssh. They aren't app settings, so they're read from and changed on disk. *@
<div class="settings-field-group">
    <div class="settings-field">
        <h2 class="settings-field-title">SSH keys</h2>
        <p class="settings-help">
            The keys in <span class="settings-list-path">@KeyStore.KeyDirectory</span>, which git uses for SSH remotes. Every
            SSH tool on this computer uses them, not only Tammi. Add a key to a service to clone and push over SSH.
        </p>
    </div>

    @if (_listError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
            <CopyOnClick>@_listError</CopyOnClick>
        </FluentMessageBar>
    }
    else if (_keys is null)
    {
        <p class="placeholder">Reading your SSH keys…</p>
    }
    else if (_keys.Count == 0)
    {
        <p class="placeholder">No SSH keys yet.</p>
    }
    else
    {
        <ul class="settings-list">
            @foreach (var key in _keys)
            {
                <li @key="key.Name">
                    <FluentCard>
                        <div class="ssh-key">
                            <div class="ssh-key-summary">
                                <span class="settings-list-name">@key.Name</span>
                                <span class="settings-list-status">@AlgorithmName(key.Algorithm)@(key.Comment is { } comment ? $" · {comment}" : "")</span>
                                <span class="settings-list-path">@key.Fingerprint</span>
                            </div>
                            <div class="settings-field-row">
                                <FluentButton OnClick="() => CopyAsync(key)">Copy public key</FluentButton>
                                <FluentButton Class="danger-button" Disabled="_busy" OnClick="() => StartRemoving(key)">Remove</FluentButton>
                            </div>

                            @foreach (var integration in SshKeyIntegrations)
                            {
                                <div class="settings-field-row ssh-key-service">
                                    <StatusDot Tone="@StatusClass(key, integration)" />
                                    <span>@integration.Name: @StatusText(key, integration)</span>
                                    @if (UploadState(key, integration) != true)
                                    {
                                        <FluentButton Disabled="_busy" OnClick="() => AddAsync(key, integration)">
                                            Add to @integration.Name
                                        </FluentButton>
                                    }
                                </div>
                            }

                            @if (_unloaded.TryGetValue(key.Name, out var choices))
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                                  AllowDismiss="false">
                                    <ChildContent>
                                        <p>
                                            SSH won't use this key on its own. It only tries keys with default names, such as id_ed25519,
                                            unless <span class="settings-list-path">@KeyStore.ConfigPath</span> names the file with an
                                            <code>IdentityFile</code>. Git fetch, pull and push fail with "Permission denied (publickey)".
                                        </p>
                                        @if (choices.Count == 0)
                                        {
                                            <p class="settings-help">
                                                Add a Host entry with <code>IdentityFile ~/.ssh/@key.Name</code> to that file, or rename the key
                                                to a default name.
                                            </p>
                                        }
                                        else
                                        {
                                            <p>Add a Host entry for this key to your SSH config, before any <code>Host *</code> entry, for:</p>
                                            @foreach (var host in choices.Keys.ToList())
                                            {
                                                <FluentCheckbox Label="@host" Disabled="_busy" Value="choices[host]"
                                                                ValueChanged="ticked => choices[host] = ticked" />
                                            }
                                        }
                                    </ChildContent>
                                    <ActionsTemplate>
                                        @if (choices.Count > 0)
                                        {
                                            <FluentButton Appearance="ButtonAppearance.Primary"
                                                          Disabled="@(_busy || !choices.ContainsValue(true))"
                                                          OnClick="() => AddHostEntriesAsync(key, choices)">
                                                Add Host entry
                                            </FluentButton>
                                        }
                                    </ActionsTemplate>
                                </FluentMessageBar>
                            }

                            @if (_messages.TryGetValue(key.Name, out var message))
                            {
                                @if (message.IsError)
                                {
                                    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                                      AllowDismiss="false">
                                        <CopyOnClick>@message.Text</CopyOnClick>
                                    </FluentMessageBar>
                                }
                                else
                                {
                                    <p class="settings-help">@message.Text</p>
                                }
                            }

                            @if (_removing == key)
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                                  AllowDismiss="false" Title="@($"Remove {key.Name}?")">
                                    <ChildContent>
                                        Both of its files are deleted from <span class="settings-list-path">@KeyStore.KeyDirectory</span>,
                                        and this can't be undone. Services you added the key to won't accept this computer
                                        any more, unless it has another key they know. Remove it from those services too.
                                    </ChildContent>
                                    <ActionsTemplate>
                                        <FluentButton Class="danger-button" Appearance="ButtonAppearance.Primary" Disabled="_busy"
                                                      OnClick="() => RemoveAsync(key)">
                                            Remove
                                        </FluentButton>
                                        <FluentButton Disabled="_busy" OnClick="() => _removing = null">Cancel</FluentButton>
                                    </ActionsTemplate>
                                </FluentMessageBar>
                            }
                        </div>
                    </FluentCard>
                </li>
            }
        </ul>
    }

    @if (_generating)
    {
        <form class="ssh-key-generate" @onsubmit="GenerateAsync">
            <div class="settings-field-group">
                <FluentSelect Label="Type" Items="KeyTypes" OptionText="@(type => TypeText(type))"
                              @bind-Value="_type" @bind-Value:after="OnTypeChanged" />

                <FluentTextInput Label="File name" AutoComplete="off" @bind-Value="_name" @bind-Value:after="OnNameEdited"
                                 Message="The private key's file name. The public key gets the same name with .pub after it."
                                 MessageCondition="FluentFieldCondition.Always" />
                @if (!string.IsNullOrWhiteSpace(_name) && !SshKey.IsDefaultName(_name))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                      AllowDismiss="false">
                        SSH only tries keys with default names, such as id_ed25519, on its own. With this name, git can't use
                        the key until your SSH config names it. After you generate it, the key shows a warning with an
                        "Add Host entry" button that adds the entry to @KeyStore.ConfigPath for you.
                    </FluentMessageBar>
                }

                <FluentTextInput Label="Comment" AutoComplete="off" @bind-Value="_comment"
                                 Message="Helps you recognise the key. It's usually your email address."
                                 MessageCondition="FluentFieldCondition.Always" />

                <FluentTextInput Label="Passphrase (optional)" TextInputType="TextInputType.Password"
                                 AutoComplete="new-password" @bind-Value="_passphrase"
                                 Message="Protects the key if someone copies it. Git asks for it when it uses the key, unless your SSH agent has it."
                                 MessageCondition="FluentFieldCondition.Always" />

                <FluentTextInput Label="Confirm passphrase" TextInputType="TextInputType.Password"
                                 AutoComplete="new-password" @bind-Value="_passphraseConfirm" />

                @if (_generateError is not null)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                      AllowDismiss="false">
                        <CopyOnClick>@_generateError</CopyOnClick>
                    </FluentMessageBar>
                }
                <div class="settings-field-row">
                    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="_busy">
                        Generate
                    </FluentButton>
                    <FluentButton Disabled="_busy" OnClick="CancelGenerating">Cancel</FluentButton>
                </div>
            </div>
        </form>
    }
    else if (KeyStore.CanGenerate)
    {
        <div class="settings-field-row">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="StartGenerating">Generate key…</FluentButton>
        </div>
    }
    else
    {
        <p class="settings-help">@(new SshKeygenNotFoundException().Message)</p>
    }
</div>

@code {
    private IReadOnlyList<SshKey>? _keys;
    private string? _listError;

    // The public keys on each service's account, by integration ID: null if the token can't list them.
    private readonly Dictionary<string, IReadOnlyList<string>?> _serviceKeys = [];
    private readonly Dictionary<string, string> _serviceErrors = [];
    private readonly Dictionary<string, (string Text, bool IsError)> _messages = [];

    // For each key SSH wouldn't load: the hosts that could get an entry for it, and whether each is ticked.
    private readonly Dictionary<string, Dictionary<string, bool>> _unloaded = [];

    private bool _busy;
    private SshKey? _removing;

    private bool _generating;
    private SshKeyType _type;
    private string? _name;
    private bool _nameEdited;
    private string? _comment;
    private string? _passphrase;
    private string? _passphraseConfirm;
    private string? _generateError;

    /// <summary>
    /// The author's email address, the default comment for a new key.
    /// </summary>
    [Parameter]
    public string? Email { get; set; }

    private IEnumerable<ISshKeyIntegration> SshKeyIntegrations =>
        Registry.All.OfType<ISshKeyIntegration>().OrderBy(integration => integration.Name, StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Registry.Changed += OnRegistryChanged;
        await LoadKeysAsync();
        await LoadServiceKeysAsync();
        UpdateHostChoices();
    }

    public void Dispose() => Registry.Changed -= OnRegistryChanged;

    private void OnRegistryChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        await LoadServiceKeysAsync();
        await CheckLoadedAsync();
        StateHasChanged();
    });

    private async Task LoadKeysAsync()
    {
        try
        {
            _keys = await KeyStore.ListAsync();
            _listError = null;
            await CheckLoadedAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _listError = $"Couldn't read your SSH keys. {ex.Message}";
        }
    }

    /// <summary>
    /// Finds the keys SSH wouldn't load, and the integration hosts that could get an entry for each. Hosts the key
    /// isn't on are listed but not ticked.
    /// </summary>
    private async Task CheckLoadedAsync()
    {
        var previous = _unloaded.ToDictionary(pair => pair.Key, pair => pair.Value);
        _unloaded.Clear();
        foreach (var key in _keys ?? [])
        {
            try
            {
                if (await KeyStore.IsLoadedBySshAsync(key))
                {
                    continue;
                }

                var hosts = SshKeyIntegrations.Select(integration => integration.SshHost).Distinct(StringComparer.OrdinalIgnoreCase);
                var missing = await KeyStore.GetHostsWithoutEntryAsync(key, hosts);
                previous.TryGetValue(key.Name, out var before);
                _unloaded[key.Name] = missing.ToDictionary(
                    host => host,
                    host => before is not null && before.TryGetValue(host, out bool ticked)
                        ? ticked
                        : !SshKeyIntegrations.Any(integration =>
                            string.Equals(integration.SshHost, host, StringComparison.OrdinalIgnoreCase)
                            && UploadState(key, integration) == false));
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                _messages[key.Name] = ($"Couldn't read the SSH config. {ex.Message}", true);
            }
        }
    }

    private void UpdateHostChoices() => _ = InvokeAsync(async () =>
    {
        await CheckLoadedAsync();
        StateHasChanged();
    });

    private async Task AddHostEntriesAsync(SshKey key, Dictionary<string, bool> choices)
    {
        _busy = true;
        try
        {
            var added = await KeyStore.AddHostEntriesAsync(key, choices.Where(pair => pair.Value).Select(pair => pair.Key));
            _messages[key.Name] = ($"Added {key.Name} to {KeyStore.ConfigPath} for {string.Join(", ", added)}.", false);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _messages[key.Name] = ($"Couldn't update the SSH config. {ex.Message}", true);
        }
        finally
        {
            _busy = false;
        }

        await CheckLoadedAsync();
    }

    private async Task LoadServiceKeysAsync()
    {
        var integrations = SshKeyIntegrations.ToList();
        await Task.WhenAll(integrations.Select(LoadServiceKeysAsync));
    }

    private async Task LoadServiceKeysAsync(ISshKeyIntegration integration)
    {
        try
        {
            _serviceKeys[integration.Id] = await integration.GetSshKeysAsync();
            _serviceErrors.Remove(integration.Id);
        }
        catch (IntegrationException ex)
        {
            _serviceKeys.Remove(integration.Id);
            _serviceErrors[integration.Id] = ex.Message;
        }
    }

    /// <summary>
    /// Whether the key is on the service's account, or <c>null</c> if that's not known.
    /// </summary>
    private bool? UploadState(SshKey key, ISshKeyIntegration integration) =>
        _serviceKeys.TryGetValue(integration.Id, out var keys) && keys is not null
            ? keys.Any(key.Matches)
            : null;

    private string StatusClass(SshKey key, ISshKeyIntegration integration) => UploadState(key, integration) switch
    {
        true => "ok",
        false => "warning",
        null => _serviceErrors.ContainsKey(integration.Id) ? "error" : "unknown",
    };

    private string StatusText(SshKey key, ISshKeyIntegration integration) => UploadState(key, integration) switch
    {
        true => "added",
        false => "not added",
        null when _serviceErrors.TryGetValue(integration.Id, out var error) => $"couldn't check. {error}",
        null when !_serviceKeys.ContainsKey(integration.Id) => "checking…",
        null => "unknown. The token can't list SSH keys.",
    };

    private static string AlgorithmName(string algorithm) => algorithm switch
    {
        "ssh-ed25519" => "Ed25519",
        "ssh-rsa" => "RSA",
        "ssh-dss" => "DSA",
        _ when algorithm.StartsWith("ecdsa-", StringComparison.Ordinal) => "ECDSA",
        _ when algorithm.StartsWith("sk-", StringComparison.Ordinal) => "Security key",
        _ => algorithm,
    };

    private async Task CopyAsync(SshKey key)
    {
        _messages[key.Name] = await Clipboard.CopyAsync(key.PublicKey)
            ? ("The public key is on the clipboard.", false)
            : ("Couldn't copy the public key.", true);
    }

    private async Task AddAsync(SshKey key, ISshKeyIntegration integration)
    {
        _busy = true;
        try
        {
            await integration.AddSshKeyAsync($"{Environment.MachineName} ({key.Name})", key.PublicKey);
            _messages[key.Name] = ($"Added {key.Name} to {integration.Name}.", false);
            await LoadServiceKeysAsync(integration);
        }
        catch (IntegrationPermissionException ex)
        {
            // The token can't add keys, so the user adds it on the website instead.
            bool copied = await Clipboard.CopyAsync(key.PublicKey);
            ProcessLauncher.Open(integration.NewSshKeyUrl.AbsoluteUri);
            _messages[key.Name] = (copied
                ? $"{ex.Message} The public key is on the clipboard, and {integration.Name}'s page for adding it is open."
                : $"{ex.Message} {integration.Name}'s page for adding it is open. Copy the public key and paste it there.",
                false);
        }
        catch (IntegrationException ex)
        {
            _messages[key.Name] = ($"Couldn't add {key.Name} to {integration.Name}. {ex.Message}", true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartRemoving(SshKey key)
    {
        _removing = key;
        _messages.Remove(key.Name);
    }

    private async Task RemoveAsync(SshKey key)
    {
        _busy = true;
        try
        {
            await KeyStore.RemoveAsync(key);
            _removing = null;
            _messages.Remove(key.Name);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _messages[key.Name] = ($"Couldn't remove {key.Name}. {ex.Message}", true);
        }
        finally
        {
            _busy = false;
        }

        await LoadKeysAsync();
    }

    private void StartGenerating()
    {
        _generating = true;
        _type = SshKeyType.Ed25519;
        _name = KeyStore.SuggestName(_type);
        _nameEdited = false;
        _comment = Email;
        _passphrase = _passphraseConfirm = null;
        _generateError = null;
    }

    private void CancelGenerating()
    {
        _generating = false;
        _passphrase = _passphraseConfirm = null;
        _generateError = null;
    }

    private void OnNameEdited() => _nameEdited = true;

    private static readonly SshKeyType[] KeyTypes = [SshKeyType.Ed25519, SshKeyType.Rsa];

    private static string TypeText(SshKeyType type) => type == SshKeyType.Rsa
        ? "RSA, 4096 bits (for older servers)"
        : "Ed25519 (recommended)";

    private void OnTypeChanged()
    {
        if (!_nameEdited)
        {
            _name = KeyStore.SuggestName(_type);
        }
    }

    private async Task GenerateAsync()
    {
        if (KeyStore.CheckName(_name) is { } problem)
        {
            _generateError = problem;
            return;
        }

        if ((_passphrase ?? "") != (_passphraseConfirm ?? ""))
        {
            _generateError = "The passphrases don't match.";
            return;
        }

        _busy = true;
        try
        {
            var key = await KeyStore.GenerateAsync(new SshKeyRequest(_name!.Trim(), _type)
            {
                Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
                Passphrase = _passphrase,
            });
            CancelGenerating();
            await LoadKeysAsync();
            _messages[key.Name] = ($"Generated {key.Name}. Add it to the services you use.", false);
        }
        catch (Exception ex) when (ex is SshKeyException or ArgumentException or IOException or UnauthorizedAccessException)
        {
            _generateError = $"Couldn't generate the key. {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
