@page "/settings/agents"
@layout SettingsLayout
@inherits SettingsSectionBase
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Settings

@{
    // Read once, so the whole page shows the same settings. A change being saved replaces them on another thread,
    // and could otherwise do so part-way through rendering (e.g. removing the agent the loop is showing).
    var agents = SettingsStore.Current.Agents;
}

<h1>Agents</h1>

<h2>Supported agents</h2>

<p class="settings-help">
    Agents that Tammi knows how to start. They're always offered: install an agent's CLI to use it.
</p>

<ul class="agent-definition-list">
    @foreach (var agent in SupportedAgent.All)
    {
        <SupportedAgentStatus @key="agent" Agent="agent" />
    }
</ul>

<h2>Custom agents</h2>

<p class="settings-help">
    Any other agent CLI, set up by you. Custom agents are offered after the supported ones, in this order. Changes apply
    to agents started afterwards.
</p>

<ul class="agent-definition-list">
    @for (var i = 0; i < agents.CustomDefinitions.Count; i++)
    {
        var index = i;
        var definition = agents.CustomDefinitions[index];
        <li>
            <FluentCard>
                <div class="agent-settings-card">
                    <div class="agent-definition-header">
                        <span class="agent-definition-name">@(string.IsNullOrWhiteSpace(definition.Name) ? "Unnamed agent" : definition.Name)</span>
                        <FluentButton Size="ButtonSize.Small" IconOnly="true" Disabled="@(index == 0)"
                                      IconStart="@(new Icons.Regular.Size16.ArrowUp())" Title="Move up"
                                      aria-label="@($"Move {definition.Name} up")" OnClick="() => MoveAsync(index, -1)" />
                        <FluentButton Size="ButtonSize.Small" IconOnly="true"
                                      Disabled="@(index == agents.CustomDefinitions.Count - 1)"
                                      IconStart="@(new Icons.Regular.Size16.ArrowDown())" Title="Move down"
                                      aria-label="@($"Move {definition.Name} down")" OnClick="() => MoveAsync(index, 1)" />
                        <FluentButton Size="ButtonSize.Small" OnClick="() => RemoveAsync(index)">Remove</FluentButton>
                    </div>

                    <div class="settings-field-group">
                        <FluentTextInput Label="Name" Width="100%" Value="@definition.Name"
                                         ValueChanged="value => UpdateDefinitionAsync(index, d => d with { Name = Text(value) })"
                                         MessageCondition="FluentFieldCondition.Always"
                                         MessageState="@(agents.HasDuplicateName(index) ? MessageState.Error : null)"
                                         Message="@(agents.HasDuplicateName(index) ? $"Another agent is called \"{definition.Name.Trim()}\". Give each one its own name, so you can tell them apart." : null)" />

                        <FluentTextInput Label="Command" Width="100%" Value="@definition.Command"
                                         ValueChanged="value => UpdateDefinitionAsync(index, d => d with { Command = Text(value) })"
                                         MessageCondition="FluentFieldCondition.Always"
                                         MessageState="@(string.IsNullOrWhiteSpace(definition.Command) ? MessageState.Warning : null)"
                                         Message="@(string.IsNullOrWhiteSpace(definition.Command) ? "This agent can't be started until it has a command." : "The agent's executable: a name on the search path, or a full path.")" />

                        <FluentTextArea Label="Arguments" Width="100%" Height="72px"
                                        Value="@ArgumentLines.Format(definition.Arguments)"
                                        ValueChanged="value => UpdateDefinitionAsync(index, d => d with { Arguments = ArgumentLines.Parse(Text(value)) })" />
                        <p class="settings-help">
                            Passed <strong>every time</strong> the agent starts, e.g. an option that picks a model. One
                            argument on each line, without quotes.
                        </p>

                        <FluentTextArea Label="Initial prompt arguments" Width="100%" Height="72px"
                                        Value="@ArgumentLines.Format(definition.PromptArguments)"
                                        ValueChanged="value => UpdateDefinitionAsync(index, d => d with { PromptArguments = ArgumentLines.Parse(Text(value)) })" />
                        <p class="settings-help">
                            Added after the arguments <strong>only when</strong> Tammi sends the agent an initial prompt
                            (see below). <code>@AgentDefinition.PromptPlaceholder</code> is replaced with the prompt. Most
                            agents take it on its own line. If the agent takes the prompt as an option's value, put the
                            option on the line before, e.g. <code>--prompt</code>, so it's left out with the prompt. Leave
                            this empty if the agent can't take a prompt: it then starts without one.
                        </p>
                        @if (definition.AcceptsInitialPrompt && !HasPromptPlaceholder(definition))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                None of these arguments has <code>@AgentDefinition.PromptPlaceholder</code>, so the prompt
                                won't be passed.
                            </FluentMessageBar>
                        }

                        <FluentTextArea Label="Session ID arguments" Width="100%" Height="72px"
                                        Value="@ArgumentLines.Format(definition.SessionIdArguments)"
                                        ValueChanged="value => UpdateDefinitionAsync(index, d => d with { SessionIdArguments = ArgumentLines.Parse(Text(value)) })" />
                        <p class="settings-help">
                            Added after the arguments when the agent starts a new session, so Tammi can resume it later.
                            <code>@AgentDefinition.SessionIdPlaceholder</code> is replaced with a session ID that Tammi
                            makes up (a UUID), e.g. <code>--session-id</code> then <code>@AgentDefinition.SessionIdPlaceholder</code>.
                            Leave this empty if the agent can't be given a session ID.
                        </p>
                        @if (definition.SessionIdArguments.Count > 0 && !HasSessionIdPlaceholder(definition.SessionIdArguments))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                None of these arguments has <code>@AgentDefinition.SessionIdPlaceholder</code>, so the
                                session can't be resumed.
                            </FluentMessageBar>
                        }

                        <FluentTextArea Label="Resume arguments" Width="100%" Height="72px"
                                        Value="@ArgumentLines.Format(definition.ResumeArguments)"
                                        ValueChanged="value => UpdateDefinitionAsync(index, d => d with { ResumeArguments = ArgumentLines.Parse(Text(value)) })" />
                        <p class="settings-help">
                            Added after the arguments, in place of the session ID and initial prompt arguments, to resume a
                            session. <code>@AgentDefinition.SessionIdPlaceholder</code> is replaced with the session's ID,
                            e.g. <code>--resume</code> then <code>@AgentDefinition.SessionIdPlaceholder</code>. Sessions
                            can only be resumed when both these and the session ID arguments are set.
                        </p>
                        @if (definition.ResumeArguments.Count > 0 && !HasSessionIdPlaceholder(definition.ResumeArguments))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                None of these arguments has <code>@AgentDefinition.SessionIdPlaceholder</code>, so the
                                agent won't know which session to resume.
                            </FluentMessageBar>
                        }
                        else if (definition.SessionIdArguments.Count > 0 != definition.ResumeArguments.Count > 0)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                Set both the session ID arguments and the resume arguments to resume this agent's sessions.
                            </FluentMessageBar>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(definition.Command))
                    {
                        <dl class="settings-values agent-command-preview">
                            <dt>Starts as</dt>
                            <dd><code>@CommandLinePreview.Format(definition.Command, definition.BuildArguments(null))</code></dd>
                            @if (definition.AcceptsInitialPrompt)
                            {
                                <dt>With a prompt</dt>
                                <dd><code>@CommandLinePreview.Format(definition.Command, definition.BuildArguments(PromptExample))</code></dd>
                            }
                            @if (definition.CanResume)
                            {
                                <dt>New session</dt>
                                <dd><code>@CommandLinePreview.Format(definition.Command, definition.BuildArguments(PromptExample, SessionIdExample))</code></dd>
                                <dt>Resuming</dt>
                                <dd><code>@CommandLinePreview.Format(definition.Command, definition.BuildResumeArguments(SessionIdExample))</code></dd>
                            }
                        </dl>
                    }
                </div>
            </FluentCard>
        </li>
    }
</ul>

<div class="settings-actions">
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="AddDefinitionAsync">Add custom agent</FluentButton>
</div>

<h2>Initial prompt</h2>

<div class="settings-form">
    <div class="settings-field-group">
        <FluentSelect Label="Style" Items="PromptStyles" OptionText="@(style => style.ToString())"
                      Value="agents.InitialPromptStyle"
                      ValueChanged="@((InitialPromptStyle style) => UpdateAgentsAsync(a => a with { InitialPromptStyle = style }))" />
        <p class="settings-help">
            <strong>Prefill</strong> types the prompt into the agent's input a moment after it starts, so you can change
            it and send it yourself. <strong>Submit</strong> passes it to the agent as its initial prompt arguments say,
            and the agent acts on it straight away.
        </p>
    </div>

    <div class="settings-field-group">
        @* Recreated when what it shows isn't what was saved, e.g. when a cleared template goes back to the default, as
           recreating it drops its focus. *@
        <FluentTextArea @key="_templateRevision" Label="Template" Width="100%" Height="120px"
                        Value="@agents.InitialPromptTemplate" ValueChanged="OnTemplateChanged" />
        <p class="settings-help">
            Sent to an agent when it starts, to tell it about the workspace's workspace context file.
            <code>@InitialPrompt.ContextFilePlaceholder</code> is replaced with the file's full path, and the rest is sent
            as it is. Start from a predefined prompt to choose what the agent does after reading the tasks. Leave it
            empty to use the default, which reads the tasks and then waits for instructions.
        </p>
        @if (!agents.InitialPromptTemplate.Contains(InitialPrompt.ContextFilePlaceholder, StringComparison.Ordinal))
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                The template doesn't have <code>@InitialPrompt.ContextFilePlaceholder</code>, so agents won't be told
                where the context file is.
            </FluentMessageBar>
        }
        @if (agents.InitialPromptTemplate.AsSpan().ContainsAny('\r', '\n'))
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                On Windows, agents whose command is a batch file (e.g. <code>claude.cmd</code>) can't be given a prompt
                with several lines, so they won't start. Keep the template on one line to start them.
            </FluentMessageBar>
        }
        <div class="settings-field-row">
            <FluentButton Id="predefined-prompts" IconEnd="@(new Icons.Regular.Size16.ChevronDown())">
                Use a predefined prompt
            </FluentButton>
            <FluentMenu Trigger="predefined-prompts">
                <FluentMenuList>
                    @foreach (var prompt in InitialPrompt.Predefined)
                    {
                        var chosen = prompt;
                        var used = chosen.Template == agents.InitialPromptTemplate;
                        @* The prompt in use is marked with a tick. *@
                        <FluentMenuItem IconEnd="@(used ? new Icons.Regular.Size16.Checkmark() : null)"
                                        OnClick="() => UsePredefinedPromptAsync(chosen)">
                            <span class="prompt-menu-item">
                                <span>
                                    @chosen.Name
                                    @if (chosen.Template == InitialPrompt.DefaultTemplate)
                                    {
                                        <span class="placeholder">(default)</span>
                                    }
                                </span>
                                <span class="placeholder">@chosen.Description</span>
                            </span>
                        </FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        </div>
    </div>
</div>

@if (SaveError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
        @SaveError
    </FluentMessageBar>
}

@code {
    private int _templateRevision;

    private static readonly InitialPromptStyle[] PromptStyles = [InitialPromptStyle.Prefill, InitialPromptStyle.Submit];

    // Shown in place of the prompt in the command previews.
    private const string PromptExample = "<initial prompt>";
    private const string SessionIdExample = "<session ID>";

    private static string Text(string? value) => value ?? "";

    private static bool HasPromptPlaceholder(AgentDefinition definition) =>
        definition.PromptArguments.Any(argument =>
            argument.Contains(AgentDefinition.PromptPlaceholder, StringComparison.Ordinal));

    private static bool HasSessionIdPlaceholder(IEnumerable<string> arguments) =>
        arguments.Any(argument => argument.Contains(AgentDefinition.SessionIdPlaceholder, StringComparison.Ordinal));

    private Task AddDefinitionAsync() =>
        UpdateDefinitionsAsync(definitions =>
            [.. definitions, new AgentDefinition("New agent", "") { PromptArguments = [AgentDefinition.PromptPlaceholder] }]);

    private Task RemoveAsync(int index) =>
        UpdateDefinitionsAsync(definitions => index < definitions.Count
            ? [.. definitions.Take(index), .. definitions.Skip(index + 1)]
            : definitions);

    private Task MoveAsync(int index, int offset) =>
        UpdateDefinitionsAsync(definitions =>
        {
            var target = index + offset;
            if (index >= definitions.Count || target < 0 || target >= definitions.Count)
            {
                return definitions;
            }

            var moved = definitions.ToList();
            (moved[index], moved[target]) = (moved[target], moved[index]);
            return moved;
        });

    private Task UpdateDefinitionAsync(int index, Func<AgentDefinition, AgentDefinition> update) =>
        UpdateDefinitionsAsync(definitions => index < definitions.Count
            ? [.. definitions.Take(index), update(definitions[index]), .. definitions.Skip(index + 1)]
            : definitions);

    private Task UpdateDefinitionsAsync(Func<IReadOnlyList<AgentDefinition>, IReadOnlyList<AgentDefinition>> update) =>
        UpdateAgentsAsync(agents => agents with { CustomDefinitions = update(agents.CustomDefinitions) });

    private async Task OnTemplateChanged(string? template)
    {
        await UpdateAgentsAsync(agents => agents with { InitialPromptTemplate = Text(template) });

        // Recreating the text area drops its focus, so it's only done when what it shows isn't what was saved.
        if (!string.Equals(Text(template), SettingsStore.Current.Agents.InitialPromptTemplate, StringComparison.Ordinal))
        {
            _templateRevision++;
        }
    }

    private Task UsePredefinedPromptAsync(PredefinedPrompt prompt)
    {
        _templateRevision++;
        return UpdateAgentsAsync(agents => agents with { InitialPromptTemplate = prompt.Template });
    }

    private Task UpdateAgentsAsync(Func<AgentSettings, AgentSettings> update) =>
        UpdateAsync(settings => settings with { Agents = update(settings.Agents) });
}
