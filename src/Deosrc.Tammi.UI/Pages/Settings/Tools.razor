@page "/settings/tools"
@layout SettingsLayout
@inherits SettingsSectionBase
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Tools
@implements IDisposable
@inject IPtyService PtyService
@inject WorkspaceTools WorkspaceTools
@inject ToolImages ToolImages
@inject IFilePicker FilePicker

@{
    // Read once, so the whole page shows the same settings. A change being saved replaces them on another thread,
    // and could otherwise do so part-way through rendering (e.g. removing the tool the loop is showing).
    var tools = SettingsStore.Current.Tools;
    var allTools = tools.Tools;
}

<h1>Tools</h1>

<div class="settings-form">
    <div class="settings-field-group">
        <FluentSelect Label="With only one repository, tools open" Items="SingleRepositoryTargets"
                      OptionText="@(target => SingleRepositoryTargetText(target))" Value="tools.SingleRepositoryTarget"
                      ValueChanged="@((SingleRepositoryTarget target) => UpdateToolsAsync(t => t with { SingleRepositoryTarget = target }))" />
        <p class="settings-help">
            What Terminal and the tools that open <code>{PreferredFolder}</code> open when they're launched for a
            workspace that has only one repository. With several repositories, they open the Workspace Folder.
        </p>
    </div>
</div>

<h2 class="settings-field-title">Predefined tools</h2>

<p class="settings-help">
    Tools that come with Tammi. The Workspace View offers them to open the Workspace Folder, a repository or a file in:
    workspace tools in the side panel's Tools section, and repository tools on each repository's card. A tool is only
    offered when its executable is found. Predefined tools can be turned on and off, but not changed. Terminal is always
    on, and comes first.
</p>

<ul class="agent-definition-list">
    @* The Terminal tool is always enabled, so it has no switch. It has the terminal shell's settings instead. *@
    <li>
        <FluentCard>
            <div class="agent-settings-card">
                <div class="agent-definition-header">
                    <ToolImageView Image="ImageOf(PredefinedTools.Terminal)" Fallback="PredefinedTools.Terminal.Icon.Generic" />
                    <span class="agent-definition-name">@PredefinedTools.Terminal.Name</span>
                </div>

                <p class="settings-help">
                    Opens one of Tammi's own terminals in a new tab of the Workspace View, in the Workspace Folder or a
                    repository, as the New menu's Terminal does. It's always on.
                </p>

                <div class="settings-field-group">
                    @* Recreated when what it shows isn't what was saved, e.g. after spaces are trimmed, as recreating it
                       drops its focus. *@
                    <FluentTextInput @key="_shellRevision" Label="Terminal shell" Width="100%"
                                     Value="@Current.TerminalShell" Placeholder="@DefaultShell.FileName"
                                     ValueChanged="OnTerminalShellChanged" />
                    <p class="settings-help">
                        The shell that new terminals run: a name on the search path, or a full path. Leave it empty to use
                        the platform's default shell (@DefaultShell.FileName).
                    </p>

                    <FluentTextArea Label="Shell arguments" Width="100%" Height="96px"
                                    Disabled="@(Current.TerminalShell is null)"
                                    Placeholder="@(Current.TerminalShell is null ? ArgumentLines.Format(DefaultShell.Arguments) : null)"
                                    Value="@ArgumentLines.Format(Current.TerminalShellArguments)"
                                    ValueChanged="OnTerminalShellArgumentsChanged" />
                    <p class="settings-help">
                        One argument on each line, passed as it is, without quotes. The default shell uses its own
                        arguments.
                    </p>
                </div>
            </div>
        </FluentCard>
    </li>

    @foreach (var tool in allTools.Where(tool => tool.IsPredefined && !tool.OpensTerminal))
    {
        var executable = WorkspaceTools.FindExecutable(tool);
        <li @key="tool.Id">
            <FluentCard Class="@(tool.Enabled ? null : "agent-definition-collapsed")">
                <div class="agent-settings-card">
                    <div class="agent-definition-header">
                        <FluentSwitch Value="tool.Enabled" aria-label="@($"Enable {tool.Name}")"
                                      ValueChanged="enabled => UpdateToolsAsync(t => t.WithEnabled(tool, enabled))" />
                        <ToolImageView Image="ImageOf(tool)" Fallback="tool.Icon.Generic" />
                        <span class="agent-definition-name">@tool.Name</span>
                        @if (tool.Enabled)
                        {
                            @FoundBadge(executable)
                        }
                    </div>

                    @if (tool.Enabled)
                    {
                        <dl class="settings-values agent-status">
                            <dt>Opens</dt>
                            <dd>
                                @if (tool.Kind == ToolKind.File)
                                {
                                    @:Files matching <code>@string.Join(", ", tool.FilePatterns)</code>
                                }
                                else
                                {
                                    @:Folders
                                }
                            </dd>
                            @if (tool.Kind == ToolKind.Folder)
                            {
                                <dt>Offered for</dt>
                                <dd>@ToolText.Label(tool.Scope)</dd>
                            }
                            <dt>Command</dt>
                            <dd><code>@CommandLinePreview.Format(tool.Executable, tool.Arguments)</code></dd>
                            @if (executable is not null)
                            {
                                <dt>Executable</dt>
                                <dd><code>@executable</code></dd>
                            }
                        </dl>
                    }
                </div>
            </FluentCard>
        </li>
    }
</ul>

<div class="settings-actions">
    <FluentButton OnClick="LookAgain">Look again</FluentButton>
    <span class="settings-help">Finds the tools' executables and icons again, e.g. after installing one.</span>
</div>

<h2 class="settings-field-title">Custom tools</h2>

<p class="settings-help">
    Any other tool, set up by you, offered after the predefined ones, in this order. A <strong>folder tool</strong> opens
    the Workspace Folder or a repository. A <strong>file tool</strong> has an entry for each file it finds in the
    repositories, e.g. each solution, and isn't offered where there are none.
</p>

<SortableCardList TItem="ToolDefinition" Class="settings-card-list" AriaLabel="Custom tools"
                  Items="tools.CustomTools" OnMoved="OnReorderedAsync">
    <ItemTemplate Context="tool">
        @{
            var index = IndexOf(tools, tool);
            var executable = WorkspaceTools.FindExecutable(tool);
            var unavailable = ToolText.UnavailablePlaceholders(tool);
            var unknown = ToolText.UnknownPlaceholders(tool);
            var expanded = _expansion.IsExpanded(index);
        }
        <FluentCard Class="@(tool.Enabled ? null : "agent-definition-collapsed")">
            <div class="agent-settings-card">
                @* The whole header toggles the card, except its buttons and switch, which stop the click reaching it.
                   The chevron doesn't, so clicking it, or pressing it with the keyboard, toggles the card the same
                   way. A tool that's off can still be collapsed and expanded. *@
                <div class="agent-definition-header agent-definition-toggle" @onclick="() => _expansion.Toggle(index)">
                    <SortableGrip />
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Transparent" IconOnly="true"
                                  IconStart="@(expanded ? new Icons.Regular.Size16.ChevronDown() : new Icons.Regular.Size16.ChevronRight())"
                                  aria-expanded="@(expanded ? "true" : "false")"
                                  aria-controls="@($"tool-{index}-settings")"
                                  Title="@(expanded ? "Hide settings" : "Show settings")"
                                  aria-label="@($"{(expanded ? "Hide" : "Show")} {tool.Name} settings")" />
                    <span @onclick:stopPropagation="true">
                        <FluentSwitch Value="tool.Enabled" aria-label="@($"Enable {tool.Name}")"
                                      ValueChanged="enabled => SetEnabledAsync(index, enabled)" />
                    </span>
                    <ToolImageView Image="ImageOf(tool)" Fallback="tool.Icon.Generic" />
                    <span class="agent-definition-name">@(string.IsNullOrWhiteSpace(tool.Name) ? "Unnamed tool" : tool.Name)</span>
                    @if (tool.Enabled)
                    {
                        @* A tool is a folder or file tool from when it's added: it can't be changed. *@
                        <FluentBadge Appearance="BadgeAppearance.Tint">@ToolText.Label(tool.Kind)</FluentBadge>
                        @FoundBadge(executable)
                    }
                    <FluentButton Size="ButtonSize.Small" StopPropagation="true" OnClick="() => RemoveAsync(index)">Remove</FluentButton>
                </div>

                @if (!expanded && !string.IsNullOrWhiteSpace(tool.Executable))
                {
                    <dl class="settings-values agent-status">
                        <dt>Command</dt>
                        <dd><code>@CommandLinePreview.Format(tool.Executable, tool.Arguments)</code></dd>
                    </dl>
                }

                @if (expanded)
                {
                    <div class="settings-field-group" id="@($"tool-{index}-settings")">
                        <FluentTextInput Label="Name" Width="100%" Value="@tool.Name"
                                         ValueChanged="value => UpdateCustomAsync(index, t => t with { Name = Text(value) })" />
                        <p class="settings-help">
                            Shown for each of the tool's entries. It can have placeholders, e.g.
                            <code>Visual Studio - {FileNameWithoutExtension}</code>.
                        </p>

                        @if (tool.Kind == ToolKind.File)
                        {
                            <FluentTextArea Label="File patterns" Width="100%" Height="96px"
                                            Value="@ArgumentLines.Format(tool.FilePatterns)"
                                            ValueChanged="value => UpdateCustomAsync(index, t => t with { FilePatterns = ArgumentLines.Parse(Text(value)) })" />
                            <p class="settings-help">
                                One pattern on each line, each looked for in every repository and its subfolders,
                                @ToolFileFinder.DefaultMaxDepth deep, leaving out hidden, <code>bin</code>,
                                <code>obj</code>, <code>node_modules</code> and <code>packages</code> folders. A file
                                name (e.g. <code>*.sln</code>) matches files in each of them. A path (e.g.
                                <code>.devcontainer/devcontainer.json</code>) is a path from each of them, and can name
                                hidden folders; start it with <code>/</code> to only look in the repository's own
                                folder. <code>*</code> and <code>?</code> are wildcards, and case is ignored.
                            </p>
                            @if (tool.FilePatterns.Count == 0)
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">
                                    This tool isn't offered until it has a file pattern.
                                </FluentMessageBar>
                            }
                        }

                        <FluentTextInput Label="Executable" Width="100%" Value="@tool.Executable"
                                         ValueChanged="value => UpdateCustomAsync(index, t => t with { Executable = Text(value) })" />
                        <p class="settings-help">
                            A name on the search path, or a full path. Environment variables written as
                            <code>%NAME%</code> are filled in.
                        </p>
                        @if (string.IsNullOrWhiteSpace(tool.Executable))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">
                                This tool isn't offered until it has an executable.
                            </FluentMessageBar>
                        }
                        else if (executable is null)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">
                                Couldn't find this executable, so the tool isn't offered.
                            </FluentMessageBar>
                        }

                        <FluentTextArea Label="Arguments" Width="100%" Height="72px"
                                        Value="@ArgumentLines.Format(tool.Arguments)"
                                        ValueChanged="value => UpdateCustomAsync(index, t => t with { Arguments = ArgumentLines.Parse(Text(value)) })" />
                        <p class="settings-help">One argument on each line, passed as it is, without quotes.</p>

                        <span class="settings-field-label">Placeholders</span>
                        <dl class="settings-values tool-placeholders">
                            @foreach (var placeholder in ToolPlaceholders.For(tool.Kind))
                            {
                                <dt><code>@ToolPlaceholders.Format(placeholder)</code></dt>
                                <dd>@ToolText.Description(placeholder)</dd>
                            }
                        </dl>
                        <p class="settings-help">
                            Filled in in the name and arguments for each entry. An entry is left out where a placeholder
                            it uses has no value, e.g. <code>{RepositoryFolder}</code> for the Workspace Folder.
                        </p>
                        @if (unavailable.Count > 0)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                @string.Join(", ", unavailable.Select(ToolPlaceholders.Format)) can only be used by file
                                tools, so this tool isn't offered.
                            </FluentMessageBar>
                        }
                        @if (unknown.Count > 0)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                @string.Join(", ", unknown.Select(ToolPlaceholders.Format)) isn't a placeholder, so it's
                                passed as it is.
                            </FluentMessageBar>
                        }

                        @* File tools open the files they find, wherever they find them, so only folder tools have a
                           scope. *@
                        @if (tool.Kind == ToolKind.Folder)
                        {
                            <ToolScopeField Scope="tool.Scope"
                                            ScopeChanged="scope => UpdateCustomAsync(index, t => t with { Scope = scope })" />
                        }

                        <FluentSelect Label="Icon" Items="IconChoices" OptionText="@(choice => IconChoiceText(choice))"
                                      Value="IconChoice(tool.Icon)"
                                      ValueChanged="@((string choice) => UpdateCustomAsync(index, t => t with { Icon = ParseIconChoice(choice, t.Icon) }))" />
                        @if (tool.Icon.Source == ToolIconSource.Custom)
                        {
                            <div class="settings-field-row tool-icon-picker">
                                <FluentButton OnClick="() => PickCustomIconAsync(index)">Choose image…</FluentButton>
                                <span class="settings-path tool-icon-path" title="@tool.Icon.CustomPath">
                                    @(tool.Icon.CustomPath ?? "No image chosen")
                                </span>
                            </div>
                            <p class="settings-help">
                                A PNG, SVG, JPEG, GIF, WebP, ICO or BMP file, up to 1 MB.
                            </p>
                            @if (tool.Icon.CustomPath is not null && ImageOf(tool) is { DataUri: null })
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">
                                    Couldn't read this image, so the tool shows a generic icon.
                                </FluentMessageBar>
                            }
                        }
                        else if (tool.Icon.Source == ToolIconSource.Application)
                        {
                            <p class="settings-help">
                                The icon of the application the executable belongs to. Without one, it shows a generic
                                icon.
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(tool.Executable))
                        {
                            <dl class="settings-values agent-command-preview">
                                <dt>Opens as</dt>
                                <dd><code>@CommandLinePreview.Format(tool.Executable, tool.Arguments)</code></dd>
                            </dl>
                        }
                    </div>
                }
            </div>
        </FluentCard>
    </ItemTemplate>
</SortableCardList>

<div class="settings-actions">
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="() => AddCustomAsync(ToolKind.Folder)">Add folder tool</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="() => AddCustomAsync(ToolKind.File)">Add file tool</FluentButton>
</div>

@if (SaveError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
        @SaveError
    </FluentMessageBar>
}

@code {
    private const string ApplicationIconChoice = "application";
    private const string CustomIconChoice = "custom";
    private const string GenericIconPrefix = "generic:";

    private readonly CancellationTokenSource _disposed = new();
    private ProcessRequest? _defaultShell;
    private int _shellRevision;

    // The tools' icons, once found. A tool whose settings change is a new key, so its icon is found again.
    private readonly Dictionary<ToolDefinition, ToolImage> _images = [];

    private ToolSettings Current => SettingsStore.Current.Tools;

    private ProcessRequest DefaultShell => _defaultShell ??= PtyService.GetDefaultShell();

    protected override void OnInitialized() => _ = LoadImagesAsync();

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private RenderFragment FoundBadge(string? executable) => executable is null
        ? @<FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Danger" title="The executable can't be found">✗ Not found</FluentBadge>
        : @<FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" title="@executable">✓ Found</FluentBadge>;

    private ToolImage? ImageOf(ToolDefinition tool) => _images.GetValueOrDefault(tool);

    // Finds the icons of the tools that don't have one yet, and shows each as it's found.
    private async Task LoadImagesAsync()
    {
        foreach (var tool in SettingsStore.Current.Tools.Tools.Where(tool => !_images.ContainsKey(tool)).ToArray())
        {
            var image = await ToolImages.GetAsync(tool, WorkspaceTools.FindExecutable(tool));
            if (_disposed.IsCancellationRequested)
            {
                return;
            }

            _images[tool] = image;
            StateHasChanged();
        }
    }

    private void LookAgain()
    {
        ToolImages.Clear();
        _images.Clear();
        _ = LoadImagesAsync();
    }

    private static string Text(string? value) => value ?? "";

    private static readonly SingleRepositoryTarget[] SingleRepositoryTargets =
        [SingleRepositoryTarget.Repository, SingleRepositoryTarget.Workspace];

    private static string SingleRepositoryTargetText(SingleRepositoryTarget target) =>
        target == SingleRepositoryTarget.Workspace ? "The Workspace Folder" : "The repository";

    // The icon choices, as the values they're stored by in the select.
    private static readonly string[] IconChoices =
    [
        ApplicationIconChoice,
        .. ToolText.Icons.Select(GenericIconChoice),
        CustomIconChoice,
    ];

    private static string IconChoiceText(string choice) => choice switch
    {
        ApplicationIconChoice => "Application's icon",
        CustomIconChoice => "Custom image…",
        _ when choice.StartsWith(GenericIconPrefix, StringComparison.Ordinal)
            && Enum.TryParse<ToolIcon>(choice[GenericIconPrefix.Length..], out var generic) => ToolText.Label(generic),
        _ => choice,
    };

    private static string GenericIconChoice(ToolIcon icon) => GenericIconPrefix + icon;

    private static string IconChoice(ToolIconSettings icon) => icon.Source switch
    {
        ToolIconSource.Generic => GenericIconChoice(icon.Generic),
        ToolIconSource.Custom => CustomIconChoice,
        _ => ApplicationIconChoice,
    };

    private static ToolIconSettings ParseIconChoice(string choice, ToolIconSettings icon) => choice switch
    {
        ApplicationIconChoice => icon with { Source = ToolIconSource.Application },
        CustomIconChoice => icon with { Source = ToolIconSource.Custom },
        _ when choice.StartsWith(GenericIconPrefix, StringComparison.Ordinal)
            && Enum.TryParse<ToolIcon>(choice[GenericIconPrefix.Length..], out var generic) =>
            icon with { Source = ToolIconSource.Generic, Generic = generic },
        _ => icon,
    };

    private async Task PickCustomIconAsync(int index)
    {
        var current = index < Current.CustomTools.Count ? Current.CustomTools[index].Icon.CustomPath : null;
        var path = await FilePicker.PickFileAsync(new FilePickerOptions
        {
            Title = "Choose icon image",
            InitialDirectory = current is null ? null : Path.GetDirectoryName(current),
            FileTypeName = "Images",
            Extensions = [.. ImageDataUri.Extensions],
        });
        if (path is not null)
        {
            await UpdateCustomAsync(index, t => t with { Icon = t.Icon with { CustomPath = path } });
        }
    }

    // Which custom tools show their settings. They're hidden until shown, except a tool that's just been added.
    private readonly CardExpansion _expansion = new();

    // Turns a custom tool on or off. A tool that's turned off is collapsed.
    private Task SetEnabledAsync(int index, bool enabled)
    {
        if (!enabled)
        {
            _expansion.Collapse(index);
        }

        return UpdateCustomAsync(index, t => t with { Enabled = enabled });
    }

    // The position of a tool in the list. The same tool can be in it twice, so it's found by reference.
    private static int IndexOf(ToolSettings tools, ToolDefinition tool)
    {
        for (var i = 0; i < tools.CustomTools.Count; i++)
        {
            if (ReferenceEquals(tools.CustomTools[i], tool))
            {
                return i;
            }
        }

        return -1;
    }

    private async Task AddCustomAsync(ToolKind kind)
    {
        await UpdateCustomToolsAsync(tools =>
        [
            .. tools,
            kind == ToolKind.File
                ? new ToolDefinition
                {
                    Kind = ToolKind.File,
                    Name = "New tool - " + ToolPlaceholders.Format(ToolPlaceholders.FileName),
                    Arguments = [ToolPlaceholders.Format(ToolPlaceholders.FilePath)],
                }
                : new ToolDefinition
                {
                    Name = "New tool",
                    Arguments = [ToolPlaceholders.Format(ToolPlaceholders.PreferredFolder)],
                },
        ]);

        // A new tool shows its settings, so it can be set up.
        if (SaveError is null)
        {
            _expansion.Expand(Current.CustomTools.Count - 1);
        }
    }

    private async Task RemoveAsync(int index)
    {
        await UpdateCustomToolsAsync(tools =>
            index < tools.Count ? [.. tools.Take(index), .. tools.Skip(index + 1)] : tools);
        if (SaveError is null)
        {
            _expansion.Removed(index);
        }
    }

    // A tool was dragged to a new place. Its card and the cards it passed keep their state.
    private async Task OnReorderedAsync(FluentSortableListEventArgs args)
    {
        var from = args.OldIndex;
        var to = args.NewIndex;
        await UpdateCustomToolsAsync(tools =>
        {
            if (from == to || from < 0 || to < 0 || from >= tools.Count || to >= tools.Count)
            {
                return tools;
            }

            var reordered = tools.ToList();
            var tool = reordered[from];
            reordered.RemoveAt(from);
            reordered.Insert(to, tool);
            return reordered;
        });

        if (SaveError is null)
        {
            _expansion.Moved(from, to);
        }
    }

    private Task UpdateCustomAsync(int index, Func<ToolDefinition, ToolDefinition> update) =>
        UpdateCustomToolsAsync(tools => index < tools.Count
            ? [.. tools.Take(index), update(tools[index]), .. tools.Skip(index + 1)]
            : tools);

    private Task UpdateCustomToolsAsync(Func<IReadOnlyList<ToolDefinition>, IReadOnlyList<ToolDefinition>> update) =>
        UpdateToolsAsync(tools => tools with { CustomTools = update(tools.CustomTools) });

    private async Task OnTerminalShellChanged(string? shell)
    {
        await UpdateToolsAsync(tools => tools with { TerminalShell = shell });

        // Recreating the input drops its focus, so it's only done when what it shows isn't what was saved.
        if (!string.Equals(shell ?? "", Current.TerminalShell ?? "", StringComparison.Ordinal))
        {
            _shellRevision++;
        }
    }

    private Task OnTerminalShellArgumentsChanged(string? arguments) =>
        UpdateToolsAsync(tools => tools with { TerminalShellArguments = ArgumentLines.Parse(arguments) });

    private async Task UpdateToolsAsync(Func<ToolSettings, ToolSettings> update)
    {
        await UpdateAsync(settings => settings with { Tools = update(settings.Tools) });
        _ = LoadImagesAsync();
    }
}
