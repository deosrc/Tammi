@page "/settings/git"
@layout SettingsLayout

<h1>Git</h1>

<dl class="settings-values">
    <dt>Git CLI version</dt>
    <dd><GitCliVersion /></dd>
    <dt>libgit2 version</dt>
    <dd><LibGit2Version /></dd>
</dl>

<div class="settings-form">
    <GitAuthor IdentityChanged="identity => _authorEmail = identity.Email" />

    <SshKeys Email="@_authorEmail" />
</div>

@code {
    private string? _authorEmail;
}
