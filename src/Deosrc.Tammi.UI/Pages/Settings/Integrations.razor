@page "/settings/integrations"
@layout SettingsLayout
@implements IDisposable
@using Deosrc.Tammi.Core.Credentials
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Integrations.Bitbucket
@using Deosrc.Tammi.Core.Integrations.GitHub
@using Deosrc.Tammi.Core.Integrations.Jira
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@inject IntegrationManager IntegrationManager
@inject ISettingsStore SettingsStore
@inject IProcessLauncher ProcessLauncher

<h1>Integrations</h1>

<p class="settings-help settings-intro">
    Integrations provide the tasks and repositories you build workspaces from. @AppInfo.Name only reads from them.
    Tokens are kept in your system's credential store, never in the settings file.
</p>

@if (Configured.Count == 0)
{
    <p class="placeholder">No integrations are connected yet.</p>
}
else
{
    <ul class="integration-list">
        @foreach (var integration in Configured)
        {
            var status = IntegrationManager.GetStatus(integration.Id);
            <li @key="integration.Id">
                <FluentCard>
                    <div class="integration-card">
                        <div class="integration-header">
                            <div class="integration-heading">
                                <IntegrationIcon Service="@ServiceOf(integration)" />
                                <div class="integration-title">
                                    <span class="integration-name">@integration.Name</span>
                                    <span class="placeholder">@integration.Detail</span>
                                </div>
                            </div>
                            <div class="integration-actions">
                                <FluentButton Disabled="@(status.State == IntegrationConnectionState.Checking || IsBusy(integration.Id))"
                                              OnClick="() => CheckAsync(integration.Id)">
                                    Test
                                </FluentButton>
                                <FluentButton Disabled="@IsBusy(integration.Id)" OnClick="() => StartAuthenticating(integration)">
                                    Authenticate…
                                </FluentButton>
                                <FluentButton Class="danger-button" Disabled="@IsBusy(integration.Id)" OnClick="() => StartRemoving(integration.Id)">
                                    Remove
                                </FluentButton>
                            </div>
                        </div>

                        <div class="integration-status" role="status">
                            <StatusDot Tone="@StatusClass(status.State)" />
                            <span>@StatusText(status)</span>
                        </div>
                        @if (status.Message is { } message)
                        {
                            <p class="settings-help integration-message">@message</p>
                        }
                        @if (status.Warning is { } warning)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false">
                                @warning
                            </FluentMessageBar>
                        }

                        @if (_removingId == integration.Id)
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                              AllowDismiss="false" Title="@($"Remove {integration.Name}?")">
                                <ChildContent>
                                    Its token is deleted from the credential store.
                                </ChildContent>
                                <ActionsTemplate>
                                    <FluentButton Class="danger-button" Appearance="ButtonAppearance.Primary" Disabled="_busy"
                                                  OnClick="() => RemoveAsync(integration.Id)">
                                        Remove
                                    </FluentButton>
                                    <FluentButton Disabled="_busy" OnClick="CancelPanel">Cancel</FluentButton>
                                </ActionsTemplate>
                            </FluentMessageBar>
                            @if (_panelError is not null)
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                                  AllowDismiss="false">
                                    <CopyOnClick>@_panelError</CopyOnClick>
                                </FluentMessageBar>
                            }
                        }
                        else if (_authenticatingId == integration.Id)
                        {
                            <form @onsubmit="() => AuthenticateAsync(integration)">
                                <div class="settings-field-group">
                                    @if (integration.Jira is { Deployment: JiraDeployment.Cloud } || integration.Bitbucket is not null)
                                    {
                                        <FluentTextInput Label="Atlassian account email" TextInputType="TextInputType.Email"
                                                         AutoComplete="off" Width="100%" Immediate="true" @bind-Value="_authEmail" />
                                    }
                                    <FluentTextInput Label="@TokenLabel(integration)" TextInputType="TextInputType.Password"
                                                     AutoComplete="off" Width="100%" Immediate="true" @bind-Value="_authToken" />
                                    <IntegrationTokenHelp ForBitbucket="@(integration.Bitbucket is not null)" ForGitHub="@(integration.GitHub is not null)" GitHub="integration.GitHub" Deployment="integration.Jira?.Deployment" Open="OpenExternal" />
                                    <div class="settings-field-row">
                                        <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary"
                                                      Disabled="@(_busy || !CanAuthenticate(integration))">
                                            @(_busy ? "Checking…" : "Save")
                                        </FluentButton>
                                        <FluentButton Disabled="_busy" OnClick="CancelPanel">Cancel</FluentButton>
                                    </div>
                                    @if (_panelError is not null)
                                    {
                                        <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine"
                                                          AllowDismiss="false">
                                            <CopyOnClick>@_panelError</CopyOnClick>
                                        </FluentMessageBar>
                                    }
                                </div>
                            </form>
                        }
                    </div>
                </FluentCard>
            </li>
        }
    </ul>
}

<h2 class="settings-field-title">Add an integration</h2>

@if (_adding is null)
{
    <FluentButton Id="add-integration" Appearance="ButtonAppearance.Primary"
                  IconEnd="@(new Icons.Regular.Size16.ChevronDown())">
        Add integration
    </FluentButton>
    <FluentMenu Trigger="add-integration">
        <FluentMenuList>
            @foreach (var (service, name) in AddableServices)
            {
                var chosen = service;
                <FluentMenuItem OnClick="() => StartAdding(chosen)">
                    <span class="integration-menu-item">
                        <IntegrationIcon Service="chosen" />
                        @name
                    </span>
                </FluentMenuItem>
            }
        </FluentMenuList>
    </FluentMenu>
}
else if (_adding == IntegrationService.Bitbucket)
{
    <form class="integration-add" @onsubmit="AddBitbucketAsync">
        <div class="settings-field-group">
            <FluentTextInput Label="Atlassian account email" TextInputType="TextInputType.Email" AutoComplete="off"
                             Width="100%" Immediate="true" @bind-Value="_bitbucketEmail"
                             Message="Bitbucket Cloud (bitbucket.org). Bitbucket Data Center isn't supported yet."
                             MessageCondition="FluentFieldCondition.Always" />
            <FluentTextInput Label="API token" TextInputType="TextInputType.Password" AutoComplete="off" Width="100%"
                             Immediate="true" @bind-Value="_addToken" />
            <IntegrationTokenHelp ForBitbucket="true" Open="OpenExternal" />
            <div class="settings-field-row">
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary"
                              Disabled="@(_busy || !CanAddBitbucket)">
                    @(_busy ? "Connecting…" : "Connect")
                </FluentButton>
                <FluentButton Disabled="_busy" OnClick="CancelAdding">Cancel</FluentButton>
            </div>
            <p class="settings-help">@AppInfo.Name checks the token with the service before saving it.</p>
            @if (_addError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    <CopyOnClick>@_addError</CopyOnClick>
                </FluentMessageBar>
            }
        </div>
    </form>
}
else if (_adding == IntegrationService.GitHub)
{
    <form class="integration-add" @onsubmit="AddGitHubAsync">
        <div class="settings-field-group">
            <FluentRadioGroup TValue="bool" Label="Server" @bind-Value="_gitHubEnterprise">
                <FluentRadio Value="@false" Label="github.com" />
                <FluentRadio Value="@true" Label="GitHub Enterprise Server" />
            </FluentRadioGroup>
            @if (_gitHubEnterprise)
            {
                <FluentTextInput Label="Server URL" Placeholder="https://github.example.com" Width="100%" Immediate="true"
                                 @bind-Value="_gitHubUrl"
                                 Message="The server's address, or its API URL (e.g. https://github.example.com/api/v3)."
                                 MessageCondition="FluentFieldCondition.Always" />
            }
            <FluentTextInput Label="Personal access token" TextInputType="TextInputType.Password" AutoComplete="off"
                             Width="100%" Immediate="true" @bind-Value="_addToken" />
            <IntegrationTokenHelp ForGitHub="true" GitHub="PendingGitHub" Open="OpenExternal" />
            <div class="settings-field-row">
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary"
                              Disabled="@(_busy || !CanAddGitHub)">
                    @(_busy ? "Connecting…" : "Connect")
                </FluentButton>
                <FluentButton Disabled="_busy" OnClick="CancelAdding">Cancel</FluentButton>
            </div>
            <p class="settings-help">@AppInfo.Name checks the token with the service before saving it.</p>
            @if (_addError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    <CopyOnClick>@_addError</CopyOnClick>
                </FluentMessageBar>
            }
        </div>
    </form>
}
else
{
    <form class="integration-add" @onsubmit="AddJiraAsync">
        <div class="settings-field-group">
            <FluentTextInput Label="Site URL" Placeholder="https://acme.atlassian.net" Width="100%" Immediate="true"
                             Value="@_jiraUrl" ValueChanged="OnJiraUrlChanged"
                             Message="The address you open JIRA at, e.g. https://acme.atlassian.net or https://jira.example.com."
                             MessageCondition="FluentFieldCondition.Always" />
            <FluentRadioGroup TValue="JiraDeployment" Label="Deployment" @bind-Value="_jiraDeployment">
                <FluentRadio Value="@JiraDeployment.Cloud" Label="JIRA Cloud" />
                <FluentRadio Value="@JiraDeployment.DataCenter" Label="JIRA Server or Data Center" />
            </FluentRadioGroup>
            @if (_jiraDeployment == JiraDeployment.Cloud)
            {
                <FluentTextInput Label="Atlassian account email" TextInputType="TextInputType.Email" AutoComplete="off"
                                 Width="100%" Immediate="true" @bind-Value="_jiraEmail" />
            }
            <FluentTextInput Label="@(_jiraDeployment == JiraDeployment.Cloud ? "API token" : "Personal access token")"
                             TextInputType="TextInputType.Password" AutoComplete="off" Width="100%" Immediate="true"
                             @bind-Value="_addToken" />
            <IntegrationTokenHelp Deployment="_jiraDeployment" Open="OpenExternal" />
            <div class="settings-field-row">
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary"
                              Disabled="@(_busy || !CanAddJira)">
                    @(_busy ? "Connecting…" : "Connect")
                </FluentButton>
                <FluentButton Disabled="_busy" OnClick="CancelAdding">Cancel</FluentButton>
            </div>
            <p class="settings-help">@AppInfo.Name checks the token with the service before saving it.</p>
            @if (_addError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    <CopyOnClick>@_addError</CopyOnClick>
                </FluentMessageBar>
            }
        </div>
    </form>
}

@code {
    // The integration types the Add menu offers, in alphabetical order.
    private static readonly IReadOnlyList<(IntegrationService Service, string Name)> AddableServices =
    [
        .. new[]
        {
            (IntegrationService.Bitbucket, "Bitbucket"),
            (IntegrationService.GitHub, "GitHub"),
            (IntegrationService.Jira, "JIRA"),
        }
            .OrderBy(service => service.Item2, StringComparer.CurrentCultureIgnoreCase),
    ];

    private readonly CancellationTokenSource _disposed = new();

    // Only one form is open at a time: adding, or authenticating or removing one integration.
    private IntegrationService? _adding;
    private string? _authenticatingId;
    private string? _removingId;
    private bool _busy;
    private string? _addError;
    private string? _panelError;

    private string _addToken = "";
    private bool _gitHubEnterprise;
    private string _gitHubUrl = "";
    private string _jiraUrl = "";
    private string _bitbucketEmail = "";
    private JiraDeployment _jiraDeployment = JiraDeployment.Cloud;
    private string _jiraEmail = "";

    private string _authToken = "";
    private string _authEmail = "";

    private sealed record ConfiguredIntegration(
        string Id,
        string Name,
        string Detail,
        GitHubIntegrationSettings? GitHub,
        JiraIntegrationSettings? Jira,
        BitbucketIntegrationSettings? Bitbucket = null);

    private static IntegrationService ServiceOf(ConfiguredIntegration integration) =>
        integration.Bitbucket is not null ? IntegrationService.Bitbucket
        : integration.GitHub is not null ? IntegrationService.GitHub
        : IntegrationService.Jira;

    private IReadOnlyList<ConfiguredIntegration> Configured
    {
        get
        {
            var settings = SettingsStore.Current.Integrations;
            IEnumerable<ConfiguredIntegration> integrations =
            [
                .. settings.Bitbucket.Select(bitbucket => new ConfiguredIntegration(
                    bitbucket.Id, bitbucket.Name, $"Bitbucket Cloud · {bitbucket.Email}", null, null, bitbucket)),
                .. settings.GitHub.Select(github => new ConfiguredIntegration(
                    github.Id, github.Name, github.ApiUrl.AbsoluteUri, github, null)),
                .. settings.Jira.Select(jira => new ConfiguredIntegration(
                    jira.Id,
                    jira.Name,
                    jira.Deployment == JiraDeployment.Cloud ? $"JIRA Cloud · {jira.Email}" : "JIRA Server or Data Center",
                    null,
                    jira)),
            ];
            return integrations
            .OrderBy(integration => integration.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(integration => integration.Id, StringComparer.Ordinal)
            .ToList();
        }
    }

    private GitHubIntegrationSettings? PendingGitHub =>
        (_gitHubEnterprise ? GitHubIntegrationSettings.ParseApiUrl(_gitHubUrl) : GitHubIntegrationOptions.GitHubComApiUrl)
            is { } apiUrl ? GitHubIntegrationSettings.For(apiUrl) : null;

    private JiraIntegrationSettings? PendingJira =>
        JiraIntegrationSettings.ParseSiteUrl(_jiraUrl) is { } siteUrl
            ? JiraIntegrationSettings.For(siteUrl, _jiraDeployment, _jiraEmail)
            : null;

    private BitbucketIntegrationSettings PendingBitbucket => BitbucketIntegrationSettings.For(_bitbucketEmail);

    private bool CanAddBitbucket => PendingBitbucket.IsValid() && !string.IsNullOrWhiteSpace(_addToken);

    private bool CanAddGitHub => PendingGitHub is not null && !string.IsNullOrWhiteSpace(_addToken);

    private bool CanAddJira => PendingJira?.IsValid() == true && !string.IsNullOrWhiteSpace(_addToken);

    protected override void OnInitialized()
    {
        IntegrationManager.Changed += OnChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // The results arrive through Changed.
            _ = IntegrationManager.CheckAllAsync(_disposed.Token);
        }
    }

    public void Dispose()
    {
        IntegrationManager.Changed -= OnChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsBusy(string id) => _busy && (_authenticatingId == id || _removingId == id);

    private async Task CheckAsync(string id)
    {
        try
        {
            await IntegrationManager.CheckAsync(id, _disposed.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ArgumentException)
        {
            // The page closed, or the integration was removed meanwhile.
        }
    }

    private void StartAdding(IntegrationService kind)
    {
        CancelPanel();
        _adding = kind;
        _addError = null;
        _addToken = "";
        _gitHubEnterprise = SettingsStore.Current.Integrations.GitHub.Any(github => github.IsGitHubCom);
        _gitHubUrl = "";
        _jiraUrl = "";
        _jiraDeployment = JiraDeployment.Cloud;
        _jiraEmail = "";
        _bitbucketEmail = "";
    }

    private void CancelAdding()
    {
        _adding = null;
        _addToken = "";
        _addError = null;
    }

    private void OnJiraUrlChanged(string? url)
    {
        _jiraUrl = url ?? "";
        if (JiraIntegrationSettings.ParseSiteUrl(_jiraUrl) is { } siteUrl)
        {
            _jiraDeployment = JiraIntegrationSettings.GuessDeployment(siteUrl);
        }
    }

    private Task AddGitHubAsync() =>
        PendingGitHub is { } settings
            ? AddAsync(() => IntegrationManager.AddGitHubAsync(settings, _addToken, _disposed.Token))
            : Task.CompletedTask;

    private Task AddBitbucketAsync() =>
        CanAddBitbucket
            ? AddAsync(() => IntegrationManager.AddBitbucketAsync(PendingBitbucket, _addToken, _disposed.Token))
            : Task.CompletedTask;

    private Task AddJiraAsync() =>
        PendingJira is { } settings
            ? AddAsync(() => IntegrationManager.AddJiraAsync(settings, _addToken, _disposed.Token))
            : Task.CompletedTask;

    private async Task AddAsync(Func<Task> add)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _addError = null;
        try
        {
            await add();
            CancelAdding();
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _addError = ErrorMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartAuthenticating(ConfiguredIntegration integration)
    {
        CancelPanel();
        _authenticatingId = integration.Id;
        _authToken = "";
        _authEmail = integration.Jira?.Email ?? integration.Bitbucket?.Email ?? "";
    }

    private void StartRemoving(string id)
    {
        CancelPanel();
        _removingId = id;
    }

    private void CancelPanel()
    {
        _authenticatingId = null;
        _removingId = null;
        _authToken = "";
        _panelError = null;
    }

    private bool CanAuthenticate(ConfiguredIntegration integration) =>
        !string.IsNullOrWhiteSpace(_authToken)
        && ((integration.Jira is not { Deployment: JiraDeployment.Cloud } && integration.Bitbucket is null)
            || !string.IsNullOrWhiteSpace(_authEmail));

    private Task AuthenticateAsync(ConfiguredIntegration integration) =>
        CanAuthenticate(integration)
            ? RunPanelAsync(() => IntegrationManager.AuthenticateAsync(
                integration.Id, _authToken, integration.Jira is null && integration.Bitbucket is null ? null : _authEmail,
                _disposed.Token))
            : Task.CompletedTask;

    private Task RemoveAsync(string id) => RunPanelAsync(() => IntegrationManager.RemoveAsync(id, _disposed.Token));

    private async Task RunPanelAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _panelError = null;
        try
        {
            await action();
            CancelPanel();
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _panelError = ErrorMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsExpected(Exception ex) =>
        ex is IntegrationException or CredentialStoreException or IOException or UnauthorizedAccessException
            or ArgumentException;

    private static string ErrorMessage(Exception ex) => ex switch
    {
        IOException or UnauthorizedAccessException => $"Couldn't save the settings. {ex.Message}",
        CredentialStoreException => $"Couldn't save the token. {ex.Message}",
        _ => ex.Message,
    };

    private static string TokenLabel(ConfiguredIntegration integration) =>
        integration.Jira is { Deployment: JiraDeployment.Cloud } || integration.Bitbucket is not null
            ? "API token"
            : "Personal access token";

    private static string StatusText(IntegrationStatus status) => status.State switch
    {
        IntegrationConnectionState.Checking => "Checking…",
        IntegrationConnectionState.Connected => $"Connected as {status.Account}",
        IntegrationConnectionState.NotAuthenticated => "Not authenticated. Authenticate it to use it.",
        IntegrationConnectionState.AuthenticationFailed => "Authentication failed",
        IntegrationConnectionState.Failed => "Couldn't connect",
        _ => "Not checked",
    };

    private static string StatusClass(IntegrationConnectionState state) => state switch
    {
        IntegrationConnectionState.Connected => "ok",
        IntegrationConnectionState.NotAuthenticated or IntegrationConnectionState.AuthenticationFailed => "warning",
        IntegrationConnectionState.Failed => "error",
        _ => "unknown",
    };

    private void OpenExternal(string url) => ProcessLauncher.Open(url);
}
