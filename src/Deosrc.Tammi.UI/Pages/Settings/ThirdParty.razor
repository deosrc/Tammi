@page "/settings/about/third-party"
@layout SettingsLayout
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.UI.About
@inject IProcessLauncher ProcessLauncher

<p><FluentLink Href="@AppRoutes.About">‹ About</FluentLink></p>

<h1>Third-party software</h1>

<p>@AppInfo.Name uses the following third-party software.</p>

<ul class="third-party-list">
    @foreach (var component in ThirdPartySoftware.All)
    {
        <li @key="component.Name">
            <FluentCard>
                <div class="third-party-item">
                    <div class="third-party-header">
                        <span class="third-party-name">@component.Name</span>
                        @if (component.Platforms != ThirdPartyPlatforms.All)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Outline">@component.Platforms</FluentBadge>
                        }
                        <FluentButton Class="third-party-website" Size="ButtonSize.Small"
                                      OnClick="() => OpenExternal(component.ProjectUrl)">
                            Website
                        </FluentButton>
                    </div>
                    <div class="placeholder">@component.Description</div>
                    @if (component.LicenseFile is { } licenseFile)
                    {
                        <FluentAccordion Block="true">
                            <FluentAccordionItem Header="@($"License: {component.License}")" Block="true">
                                <pre class="license-text">@ThirdPartySoftware.ReadLicense(licenseFile)</pre>
                            </FluentAccordionItem>
                        </FluentAccordion>
                    }
                    else
                    {
                        <div class="third-party-links">
                            <span>License: @component.License</span>
                        </div>
                    }
                    @if (component.LicenseUrl is { } licenseUrl)
                    {
                        <div class="third-party-links">
                            <FluentLink OnClick="() => OpenExternal(licenseUrl)">Read the license</FluentLink>
                        </div>
                    }
                </div>
            </FluentCard>
        </li>
    }
</ul>

@if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
        @_error
    </FluentMessageBar>
}

@code {
    private string? _error;

    // Links must open in the user's browser: following them would navigate the app's own window away from Tammi.
    private void OpenExternal(string url)
    {
        _error = null;
        try
        {
            ProcessLauncher.Open(url);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't open {url}: {ex.Message}";
        }
    }
}
