@page "/settings"
@layout SettingsLayout
@inherits SettingsSectionBase
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@using Microsoft.Extensions.Logging
@inject IFolderPicker FolderPicker
@inject IAppPaths AppPaths
@inject IProcessLauncher ProcessLauncher

<h1>General</h1>

<div class="settings-form">
    <div class="settings-field-group">
        <FluentTextInput Label="Default Workspace Parent Folder" Width="100%"
                         Value="@Current.DefaultWorkspaceParentFolder"
                         ValueChanged="OnDefaultWorkspaceParentFolderChanged"
                         Message="New workspaces are created in this folder unless you choose another one."
                         MessageCondition="FluentFieldCondition.Always">
            <EndTemplate>
                <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                              OnClick="PickDefaultWorkspaceParentFolderAsync">
                    Choose…
                </FluentButton>
            </EndTemplate>
        </FluentTextInput>
    </div>

    <div class="settings-field-group">
        <div class="settings-field">
            <h2 class="settings-field-title">Suggested workspace name</h2>
            <p class="settings-help settings-field-intro">
                The name a new workspace with exactly one task is given, shown on Home and its tab. You can still change it,
                when you create the workspace or later.
            </p>
        </div>
        @* Recreated when what it shows differs from what was entered, e.g. when it was trimmed, as recreating it drops
           its focus. *@
        <FluentTextInput @key="_nameTemplateRevision" Label="Template" Width="100%" AutoComplete="off"
                         Value="@Current.WorkspaceNameTemplate" ValueChanged="OnWorkspaceNameTemplateChanged" />
        <dl class="settings-values tool-placeholders">
            @foreach (var placeholder in WorkspaceNames.Placeholders)
            {
                <dt><CopyOnClick What="the placeholder"><code>@WorkspaceNames.Format(placeholder)</code></CopyOnClick></dt>
                <dd>@PlaceholderDescription(placeholder)</dd>
            }
        </dl>
        <p class="settings-help">
            When the template can't be filled in, because the workspace has no tasks or several, or the task has no
            value for a placeholder (e.g. a JIRA issue has no repository), the name is the folder name. Leave it empty to
            always use the folder name.
        </p>
        @if (WorkspaceNames.FindUnknown(Current.WorkspaceNameTemplate).ToList() is { Count: > 0 } unknown)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">
                <CopyOnClick>@string.Join(", ", unknown.Select(WorkspaceNames.Format)) @(unknown.Count == 1 ? "isn't a placeholder" : "aren't placeholders"),
                so @(unknown.Count == 1 ? "it's" : "they're") left as written.</CopyOnClick>
            </FluentMessageBar>
        }
        <dl class="settings-preview">
            @foreach (var example in Examples)
            {
                <dt>@example.Key @example.Title</dt>
                <dd>
                    @if (WorkspaceNames.Suggest([example], Current.WorkspaceNameTemplate) is { } name)
                    {
                        @name
                    }
                    else
                    {
                        @WorkspaceFolderNames.Suggest([example], FolderNameFormat)
                        <span class="placeholder"> (the folder name)</span>
                    }
                </dd>
            }
        </dl>
    </div>

    <div class="settings-field-group">
        <div class="settings-field">
            <h2 class="settings-field-title">Suggested folder name</h2>
            <p class="settings-help settings-field-intro">
                How the Workspace Folder's name is written when a new workspace has exactly one task. Otherwise it's made
                from the name you enter. You can still change it before the workspace is created.
            </p>
        </div>
        <div class="settings-field-row">
            <FluentSelect Label="Separator" Items="Separators" OptionText="@(separator => SeparatorText(separator))"
                          Value="FolderNameFormat.Separator"
                          ValueChanged="@((WorkspaceFolderNameSeparator separator) => UpdateFolderNameFormatAsync(f => f with { Separator = separator }))" />
            <FluentSelect Label="Case" Items="Cases" OptionText="@(folderCase => CaseText(folderCase))"
                          Value="FolderNameFormat.Case"
                          ValueChanged="@((WorkspaceFolderNameCase folderCase) => UpdateFolderNameFormatAsync(f => f with { Case = folderCase }))" />
        </div>
        <FluentCheckbox Label="Start with the task's reference" Value="FolderNameFormat.IncludeTaskReference"
                        ValueChanged="included => UpdateFolderNameFormatAsync(f => f with { IncludeTaskReference = included })" />
        <dl class="settings-preview">
            @foreach (var example in Examples)
            {
                <dt>@example.Key @example.Title</dt>
                <dd>@(WorkspaceFolderNames.Suggest([example], FolderNameFormat))</dd>
            }
        </dl>
        <p class="settings-help">
            Hyphens and underscores leave out punctuation. A GitHub issue's reference is its repository and number.
        </p>
    </div>

    <div class="settings-field-group">
        <FluentSelect Label="Theme" Items="Themes" OptionText="@(theme => theme.ToString())" Value="Current.Theme"
                      ValueChanged="@((ThemePreference theme) => UpdateGeneralAsync(g => g with { Theme = theme }))" />
        <p class="settings-help">
            Auto follows the system theme, and changes with it, e.g. when the system switches to dark mode in the
            evening. Changes apply straight away.
        </p>
    </div>

    <div class="settings-field-group">
        <FluentCheckbox Label="Slim window" Value="Current.SlimWindow"
                        ValueChanged="slim => UpdateGeneralAsync(g => g with { SlimWindow = slim })" />
        <p class="settings-help">
            Removes the window's title bar, and puts the minimise, maximise and close buttons at the end of the tabs.
            Drag any empty space in the tab bar, or the Tammi logo, to move the window, and double-click it to maximise
            or restore the window. Changes apply straight away.
        </p>
    </div>

    <div class="settings-field-group">
        <FluentSelect Label="Log level" Items="LogLevels" OptionText="@(level => level.ToString())"
                      Value="Current.LogLevel"
                      ValueChanged="@((LogLevel level) => UpdateGeneralAsync(g => g with { LogLevel = level }))" />
        <p class="settings-help">
            The least important messages Tammi logs. Debug adds details such as each git command, and Trace also adds
            the messages of the frameworks Tammi uses. Changes apply straight away. Logs are written to the console and
            to the logs folder.
        </p>
        <div class="settings-field-row">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OpenLogFolder">Open logs folder</FluentButton>
        </div>
        @if (_openLogFolderError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                <CopyOnClick>@_openLogFolderError</CopyOnClick>
            </FluentMessageBar>
        }
    </div>
</div>

@if (SaveError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
        <CopyOnClick>@SaveError</CopyOnClick>
    </FluentMessageBar>
}

@code {
    private string? _openLogFolderError;

    private GeneralSettings Current => SettingsStore.Current.General;

    // Opens the folder in the system file manager. It's created first, in case nothing has been logged to it yet.
    private void OpenLogFolder()
    {
        _openLogFolderError = null;
        try
        {
            Directory.CreateDirectory(AppPaths.LogDirectory);
            ProcessLauncher.Open(AppPaths.LogDirectory);
        }
        catch (Exception ex)
        {
            _openLogFolderError = $"Couldn't open the logs folder '{AppPaths.LogDirectory}': {ex.Message}";
        }
    }

    private Task OnDefaultWorkspaceParentFolderChanged(string? folder) =>
        UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = folder ?? "" });

    private async Task PickDefaultWorkspaceParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the Default Workspace Parent Folder",
            InitialDirectory = Directory.Exists(Current.DefaultWorkspaceParentFolder)
                ? Current.DefaultWorkspaceParentFolder
                : null,
        });
        if (folder is not null)
        {
            await UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = folder });
        }
    }

    // Example tasks to preview the name template and folder name format with, one from each kind of integration.
    private static readonly IReadOnlyList<TaskInfo> Examples =
    [
        new("example", "JIRA-123", "Add some feature", new Uri("https://example.com/")),
        new("example", "acme/api#42", "Fix the login page's error message", new Uri("https://example.com/"))
        {
            RepositoryUrl = new Uri("https://github.com/acme/api"),
        },
    ];

    private int _nameTemplateRevision;

    private async Task OnWorkspaceNameTemplateChanged(string? template)
    {
        var trimmed = template?.Trim() ?? "";
        await UpdateGeneralAsync(general => general with { WorkspaceNameTemplate = trimmed });

        // Recreating the input drops its focus, so it's only done when what it shows isn't what was saved.
        if (!string.Equals(template ?? "", Current.WorkspaceNameTemplate, StringComparison.Ordinal))
        {
            _nameTemplateRevision++;
        }
    }

    private static string PlaceholderDescription(string placeholder) => placeholder switch
    {
        WorkspaceNames.TaskReference => "The task's reference, e.g. api#42 or JIRA-123.",
        WorkspaceNames.TaskKey => "The task's full key, e.g. acme/api#42 or JIRA-123.",
        WorkspaceNames.TaskTitle => "The task's title (its summary).",
        WorkspaceNames.RepositoryOwner => "The owner of the task's repository, e.g. acme. Only for GitHub issues.",
        WorkspaceNames.RepositoryName => "The name of the task's repository, e.g. api. Only for GitHub issues.",
        _ => "",
    };

    private WorkspaceFolderNameFormat FolderNameFormat => Current.WorkspaceFolderNameFormat;

    private Task UpdateFolderNameFormatAsync(Func<WorkspaceFolderNameFormat, WorkspaceFolderNameFormat> update) =>
        UpdateGeneralAsync(general => general with { WorkspaceFolderNameFormat = update(general.WorkspaceFolderNameFormat) });

    private static readonly WorkspaceFolderNameSeparator[] Separators =
        [WorkspaceFolderNameSeparator.Hyphens, WorkspaceFolderNameSeparator.Underscores, WorkspaceFolderNameSeparator.Spaces];

    private static string SeparatorText(WorkspaceFolderNameSeparator separator) => separator.ToString();

    private static readonly WorkspaceFolderNameCase[] Cases =
        [WorkspaceFolderNameCase.Lowercase, WorkspaceFolderNameCase.Uppercase, WorkspaceFolderNameCase.AsWritten];

    private static string CaseText(WorkspaceFolderNameCase folderCase) =>
        folderCase == WorkspaceFolderNameCase.AsWritten ? "As written" : folderCase.ToString();

    private static readonly ThemePreference[] Themes = [ThemePreference.Auto, ThemePreference.Light, ThemePreference.Dark];

    private static readonly LogLevel[] LogLevels =
        [LogLevel.Trace, LogLevel.Debug, LogLevel.Information, LogLevel.Warning, LogLevel.Error];

    private Task UpdateGeneralAsync(Func<GeneralSettings, GeneralSettings> update) =>
        UpdateAsync(settings => settings with { General = update(settings.General) });
}
