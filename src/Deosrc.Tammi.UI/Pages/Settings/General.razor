@page "/settings"
@layout SettingsLayout
@inherits SettingsSectionBase
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@using Microsoft.Extensions.Logging
@inject IFolderPicker FolderPicker
@inject IAppPaths AppPaths
@inject IProcessLauncher ProcessLauncher
@inject AppUpdater Updater
@implements IDisposable

<h1>General</h1>

<div class="settings-form">
    <div class="settings-field">
        <label for="default-workspace-parent-folder">Default Workspace Parent Folder</label>
        <div class="settings-field-row">
            <input id="default-workspace-parent-folder"
                   class="settings-path"
                   value="@Current.DefaultWorkspaceParentFolder"
                   @onchange="OnDefaultWorkspaceParentFolderChanged" />
            <button type="button" class="button" @onclick="PickDefaultWorkspaceParentFolderAsync">Choose…</button>
        </div>
        <p class="settings-help">New workspaces are created in this folder unless you choose another one.</p>
    </div>

    <div class="settings-field">
        <h2 class="settings-field-title">Suggested workspace name</h2>
        <p class="settings-help settings-field-intro">
            The name a new workspace with exactly one task is given, shown on Home and its tab. You can still change it,
            when you create the workspace or later.
        </p>
        <label for="workspace-name-template">Template</label>
        @* Recreated after each change, so it shows the saved value even when that's unchanged, e.g. when a cleared
           template stays cleared. *@
        <input @key="_nameTemplateRevision"
               id="workspace-name-template"
               class="settings-input-wide"
               autocomplete="off"
               value="@Current.WorkspaceNameTemplate"
               @onchange="OnWorkspaceNameTemplateChanged" />
        <dl class="settings-values tool-placeholders">
            @foreach (var placeholder in WorkspaceNames.Placeholders)
            {
                <dt><code>@WorkspaceNames.Format(placeholder)</code></dt>
                <dd>@PlaceholderDescription(placeholder)</dd>
            }
        </dl>
        <p class="settings-help">
            When the template can't be filled in, because the workspace has no tasks or several, or the task has no
            value for a placeholder (e.g. a JIRA issue has no repository), the name is the folder name. Leave it empty to
            always use the folder name.
        </p>
        @if (WorkspaceNames.FindUnknown(Current.WorkspaceNameTemplate).ToList() is { Count: > 0 } unknown)
        {
            <p class="warning">
                @string.Join(", ", unknown.Select(WorkspaceNames.Format)) @(unknown.Count == 1 ? "isn't a placeholder" : "aren't placeholders"),
                so @(unknown.Count == 1 ? "it's" : "they're") left as written.
            </p>
        }
        <dl class="settings-preview">
            @foreach (var example in Examples)
            {
                <dt>@example.Key @example.Title</dt>
                <dd>
                    @if (WorkspaceNames.Suggest([example], Current.WorkspaceNameTemplate) is { } name)
                    {
                        @name
                    }
                    else
                    {
                        @WorkspaceFolderNames.Suggest([example], FolderNameFormat)
                        <span class="placeholder"> (the folder name)</span>
                    }
                </dd>
            }
        </dl>
    </div>

    <div class="settings-field">
        <h2 class="settings-field-title">Suggested folder name</h2>
        <p class="settings-help settings-field-intro">
            How the Workspace Folder's name is written when a new workspace has exactly one task. Otherwise it's made
            from the name you enter. You can still change it before the workspace is created.
        </p>
        <div class="settings-options">
            <label for="workspace-folder-name-separator">Separator</label>
            <select id="workspace-folder-name-separator" value="@FolderNameFormat.Separator"
                    @onchange="e => UpdateFolderNameFormatAsync(f => f with { Separator = Parse(e, f.Separator) })">
                <option value="@WorkspaceFolderNameSeparator.Hyphens">Hyphens</option>
                <option value="@WorkspaceFolderNameSeparator.Underscores">Underscores</option>
                <option value="@WorkspaceFolderNameSeparator.Spaces">Spaces</option>
            </select>

            <label for="workspace-folder-name-case">Case</label>
            <select id="workspace-folder-name-case" value="@FolderNameFormat.Case"
                    @onchange="e => UpdateFolderNameFormatAsync(f => f with { Case = Parse(e, f.Case) })">
                <option value="@WorkspaceFolderNameCase.Lowercase">Lowercase</option>
                <option value="@WorkspaceFolderNameCase.Uppercase">Uppercase</option>
                <option value="@WorkspaceFolderNameCase.AsWritten">As written</option>
            </select>
        </div>
        <label class="settings-choice">
            <input type="checkbox" checked="@FolderNameFormat.IncludeTaskReference"
                   @onchange="e => UpdateFolderNameFormatAsync(f => f with { IncludeTaskReference = e.Value is true })" />
            Start with the task's reference
        </label>
        <dl class="settings-preview">
            @foreach (var example in Examples)
            {
                <dt>@example.Key @example.Title</dt>
                <dd>@(WorkspaceFolderNames.Suggest([example], FolderNameFormat))</dd>
            }
        </dl>
        <p class="settings-help">
            Hyphens and underscores leave out punctuation. A GitHub issue's reference is its repository and number.
        </p>
    </div>

    <div class="settings-field">
        <label for="log-level">Log level</label>
        <select id="log-level" value="@Current.LogLevel"
                @onchange="e => UpdateGeneralAsync(g => g with { LogLevel = Parse(e, g.LogLevel) })">
            <option value="@LogLevel.Trace">Trace</option>
            <option value="@LogLevel.Debug">Debug</option>
            <option value="@LogLevel.Information">Information</option>
            <option value="@LogLevel.Warning">Warning</option>
            <option value="@LogLevel.Error">Error</option>
        </select>
        <p class="settings-help">
            The least important messages Tammi logs. Debug adds details such as each git command, and Trace also adds
            the messages of the frameworks Tammi uses. Changes apply straight away. Logs are written to the console and
            to the logs folder.
        </p>
        <div class="settings-field-actions">
            <button type="button" class="button" @onclick="OpenLogFolder">Open logs folder</button>
        </div>
        @if (_openLogFolderError is not null)
        {
            <p class="error">@_openLogFolderError</p>
        }
    </div>

    <div class="settings-field">
        <h2 class="settings-field-title">Updates</h2>
        <p class="settings-help settings-field-intro">
            You have Tammi @Updater.CurrentVersion. When a newer release is found, Tammi asks whether to install it. It
            installs into its own folder in your user app data folder, so no admin rights are needed, and the new version
            is used the next time Tammi starts. Old versions are deleted when Tammi starts, keeping the one running and
            the two before it.
        </p>
        <label class="settings-choice">
            <input type="checkbox" checked="@Updates.CheckOnStartup"
                   @onchange="e => UpdateUpdatesAsync(u => u with { CheckOnStartup = e.Value is true })" />
            Check for updates when Tammi starts
        </label>
        <label class="settings-choice">
            <input type="checkbox" checked="@Updates.IncludePreReleases"
                   @onchange="e => UpdateUpdatesAsync(u => u with { IncludePreReleases = e.Value is true })" />
            Include pre-releases
        </label>
        @if (!Updater.CanUpdate)
        {
            <p class="settings-help">
                This copy of Tammi wasn't installed by the installer, e.g. it's running from source, so it can't update
                itself.
            </p>
        }
        else
        {
            <div class="settings-field-actions">
                <button type="button" class="button" disabled="@(Updater.Status is UpdateStatus.Checking or UpdateStatus.Installing)"
                        @onclick="CheckForUpdatesAsync">
                    Check for updates
                </button>
            </div>
            <p class="settings-help" role="status">@UpdateStatusText</p>
        }
    </div>
</div>

@if (SaveError is not null)
{
    <p class="error">@SaveError</p>
}

@code {
    private string? _openLogFolderError;

    private UpdateSettings Updates => SettingsStore.Current.Updates;

    protected override void OnInitialized() => Updater.Changed += OnUpdaterChanged;

    private void OnUpdaterChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Updater.Changed -= OnUpdaterChanged;

    private bool _checked;

    private async Task CheckForUpdatesAsync()
    {
        _checked = true;
        await Updater.CheckAsync();
    }

    private string UpdateStatusText => Updater.Status switch
    {
        UpdateStatus.Checking => "Checking…",
        UpdateStatus.Available => $"Tammi {Updater.Available!.Version} is available.",
        UpdateStatus.Installing => $"Downloading Tammi {Updater.Available!.Version}…",
        UpdateStatus.Installed => $"Tammi {Updater.Available!.Version} is installed. Restart Tammi to use it.",
        UpdateStatus.Failed => Updater.Error ?? "",
        _ => _checked ? "Tammi is up to date." : "",
    };

    private Task UpdateUpdatesAsync(Func<UpdateSettings, UpdateSettings> update) =>
        UpdateAsync(settings => settings with { Updates = update(settings.Updates) });

    private GeneralSettings Current => SettingsStore.Current.General;

    // Opens the folder in the system file manager. It's created first, in case nothing has been logged to it yet.
    private void OpenLogFolder()
    {
        _openLogFolderError = null;
        try
        {
            Directory.CreateDirectory(AppPaths.LogDirectory);
            ProcessLauncher.Open(AppPaths.LogDirectory);
        }
        catch (Exception ex)
        {
            _openLogFolderError = $"Couldn't open the logs folder '{AppPaths.LogDirectory}': {ex.Message}";
        }
    }

    private Task OnDefaultWorkspaceParentFolderChanged(ChangeEventArgs e) =>
        UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = e.Value?.ToString() ?? "" });

    private async Task PickDefaultWorkspaceParentFolderAsync()
    {
        var folder = await FolderPicker.PickFolderAsync(new FolderPickerOptions
        {
            Title = "Choose the Default Workspace Parent Folder",
            InitialDirectory = Directory.Exists(Current.DefaultWorkspaceParentFolder)
                ? Current.DefaultWorkspaceParentFolder
                : null,
        });
        if (folder is not null)
        {
            await UpdateGeneralAsync(general => general with { DefaultWorkspaceParentFolder = folder });
        }
    }

    // Example tasks to preview the name template and folder name format with, one from each kind of integration.
    private static readonly IReadOnlyList<TaskInfo> Examples =
    [
        new("example", "JIRA-123", "Add some feature", new Uri("https://example.com/")),
        new("example", "acme/api#42", "Fix the login page's error message", new Uri("https://example.com/"))
        {
            RepositoryUrl = new Uri("https://github.com/acme/api"),
        },
    ];

    private int _nameTemplateRevision;

    private async Task OnWorkspaceNameTemplateChanged(ChangeEventArgs e)
    {
        await UpdateGeneralAsync(general => general with { WorkspaceNameTemplate = e.Value?.ToString()?.Trim() ?? "" });
        _nameTemplateRevision++;
    }

    private static string PlaceholderDescription(string placeholder) => placeholder switch
    {
        WorkspaceNames.TaskReference => "The task's reference, e.g. api#42 or JIRA-123.",
        WorkspaceNames.TaskKey => "The task's full key, e.g. acme/api#42 or JIRA-123.",
        WorkspaceNames.TaskTitle => "The task's title (its summary).",
        WorkspaceNames.RepositoryOwner => "The owner of the task's repository, e.g. acme. Only for GitHub issues.",
        WorkspaceNames.RepositoryName => "The name of the task's repository, e.g. api. Only for GitHub issues.",
        _ => "",
    };

    private WorkspaceFolderNameFormat FolderNameFormat => Current.WorkspaceFolderNameFormat;

    private Task UpdateFolderNameFormatAsync(Func<WorkspaceFolderNameFormat, WorkspaceFolderNameFormat> update) =>
        UpdateGeneralAsync(general => general with { WorkspaceFolderNameFormat = update(general.WorkspaceFolderNameFormat) });

    private static T Parse<T>(ChangeEventArgs e, T current) where T : struct, Enum =>
        Enum.TryParse(e.Value?.ToString(), out T value) ? value : current;

    private Task UpdateGeneralAsync(Func<GeneralSettings, GeneralSettings> update) =>
        UpdateAsync(settings => settings with { General = update(settings.General) });
}
