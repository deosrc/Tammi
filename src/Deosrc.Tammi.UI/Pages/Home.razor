@page "/"
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Workspaces
@implements IDisposable
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceTabs WorkspaceTabs
@inject NavigationManager Navigation
@inject HomeGitStatus GitStatus
@inject WorkspaceAgents Agents
@inject ISettingsStore SettingsStore
@inject IntegrationRegistry Registry

<div class="page">
    <div class="page-header">
        <h1>Workspaces</h1>
        <div class="page-header-actions">
            <button type="button" class="button button-secondary" aria-expanded="@(_layoutOpen ? "true" : "false")"
                    aria-controls="home-layout-panel" @onclick="() => _layoutOpen = !_layoutOpen">
                View Options
            </button>
            <a class="button" href="@AppRoutes.NewWorkspace">New workspace</a>
        </div>
    </div>

    @if (_layoutOpen)
    {
        var general = SettingsStore.Current.General;
        <div id="home-layout-panel" class="home-layout-panel">
            <div class="settings-options">
                <label for="home-tab-by">Tab by</label>
                <select id="home-tab-by" value="@general.HomeTabBy"
                        @onchange="e => UpdateGeneralAsync(g => g with { HomeTabBy = ParseGrouping(e, g.HomeTabBy) })">
                    @foreach (var option in Groupings)
                    {
                        <option value="@option" disabled="@(option != HomeGrouping.None && option == general.HomeGroupBy)">
                            @GroupingLabel(option)
                        </option>
                    }
                </select>

                <label for="home-group-by">Group by</label>
                <select id="home-group-by" value="@general.HomeGroupBy"
                        @onchange="e => UpdateGeneralAsync(g => g with { HomeGroupBy = ParseGrouping(e, g.HomeGroupBy) })">
                    @foreach (var option in Groupings)
                    {
                        <option value="@option" disabled="@(option != HomeGrouping.None && option == general.HomeTabBy)">
                            @GroupingLabel(option)
                        </option>
                    }
                </select>
            </div>
            <h2 class="settings-field-title">Status order</h2>
            <SortableStatusList Order="general.HomeStatusOrder" OnMove="move => MoveStatusToAsync(move.From, move.To)" />
            @if (_settingsError is not null)
            {
                <p class="error">@_settingsError</p>
            }
        </div>
    }

    @if (_indexProblem is not null)
    {
        <p class="error">@_indexProblem</p>
    }

    @if (_workspaces is null)
    {
        <p class="placeholder">Loading workspaces…</p>
    }
    else if (_workspaces.Count == 0)
    {
        <p class="placeholder">No workspaces yet. Create one to get started.</p>
    }
    else
    {
        var general = SettingsStore.Current.General;
        var tabs = Split(Entries(), general.HomeTabBy);
        var current = tabs.FirstOrDefault(tab => tab.Key == _selectedTab) ?? tabs[0];
        @if (general.HomeTabBy != HomeGrouping.None)
        {
            <div class="home-tabs" role="tablist" aria-label="@GroupingLabel(general.HomeTabBy)">
                @foreach (var tab in tabs)
                {
                    <button type="button" role="tab" class="home-tab-button @(tab == current ? "active" : null)"
                            data-status="@tab.Status"
                            aria-selected="@(tab == current ? "true" : "false")" @key="tab.Key"
                            @onclick="() => _selectedTab = tab.Key">
                        @tab.Key <span class="home-count">@tab.Entries.Count</span>
                    </button>
                }
            </div>
        }
        @foreach (var group in Split(current.Entries, general.HomeGroupBy))
        {
            <section class="home-group" @key="group.Key">
                @if (general.HomeGroupBy != HomeGrouping.None)
                {
                    <h2 class="home-group-title">@group.Key <span class="home-count">@group.Entries.Count</span></h2>
                }
                <ul class="workspace-list">
                    @foreach (var entry in group.Entries)
                    {
                        @Card(entry)
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private RenderFragment Card(Entry entry) => @<text>
        @{
            var workspace = entry.Listing;
            var available = workspace.Availability == WorkspaceAvailability.Available;
        }
        <li class="workspace-card @(available ? null : "workspace-card-unavailable")" @key="workspace.Id"
        role="button" tabindex="0" title="@(available ? "Open" : "Details")"
        @onclick="() => Open(workspace)" @onkeydown="e => OnCardKeyDown(e, workspace)">
            <div class="workspace-card-body">
                <div class="workspace-name" title="@workspace.Name">@workspace.Name</div>
                <div class="workspace-folder" title="@workspace.Folder">@workspace.Folder</div>
                @if (!available)
                {
                    <div class="workspace-problem warning">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                            <path d="M12 9v4M12 17h.01" />
                        </svg>
                        <span>@WorkspaceAvailabilityText.Summary(workspace.Availability)</span>
                    </div>
                }
                @if (available && workspace.Workspace is { Repositories.Count: > 0 } details
                     && GitStatus.Get(details) is { IsLoaded: true } summary)
                {
                    var hasGitBadges = summary.LocalChanges.Count > 0 || summary.Unpushed.Count > 0
                        || summary.Behind.Count > 0;
                    var hasPullRequests = summary.PullRequests.Count > 0 || summary.PullRequestProblem is not null;

                    @* Dividers only where there's something on both sides: after the text, and between the rows. *@
                    @if (hasGitBadges || hasPullRequests)
                    {
                        <hr class="workspace-card-divider" />
                    }
                    @if (hasGitBadges)
                    {
                        <div class="workspace-badges">
                            @if (summary.LocalChanges.Count > 0)
                            {
                                <span class="workspace-badge workspace-badge-warning">
                                    Local changes
                                </span>
                            }
                            @if (summary.Unpushed.Count > 0)
                            {
                                <span class="workspace-badge workspace-badge-warning">
                                    Unpushed
                                </span>
                            }
                            @if (summary.Behind.Count > 0)
                            {
                                <span class="workspace-badge workspace-badge-info">
                                    Behind
                                </span>
                            }
                        </div>
                    }
                    @if (hasGitBadges && hasPullRequests)
                    {
                        <hr class="workspace-card-divider" />
                    }
                    <PullRequestBadges PullRequests="summary.PullRequests" Problem="@summary.PullRequestProblem" />
                }
                @if (available && Agents.For(workspace.Id) is { Count: > 0 } agents)
                {
                    @* The workspace's agents, one indicator each, in the order they started. *@
                    <hr class="workspace-card-divider" />
                    <div class="workspace-agents" aria-label="Agents">
                        @foreach (var agent in agents)
                        {
                            <AgentStateIndicator State="agent.State"
                                                 Title="@($"{agent.Name}: {AgentStateText.Label(agent.State)}")" />
                        }
                    </div>
                }
            </div>
            @if (entry.Status == WorkspaceStatus.Done && available)
            {
                <div class="workspace-card-actions">
                    <button type="button" class="button button-danger"
                            @onclick="() => Delete(workspace)" @onclick:stopPropagation="true">
                        Delete workspace…
                    </button>
                </div>
            }
        </li>
    </text>;

    private IReadOnlyList<WorkspaceListing>? _workspaces;
    private string? _selectedTab;
    private bool _layoutOpen;
    private string? _settingsError;
    private IDisposable? _observing;
    private string? _indexProblem;
    private readonly CancellationTokenSource _disposed = new();

    // Counts loads, so a slow load that finishes after a newer one doesn't replace its result.
    private int _loadCount;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceStore.Changed += OnWorkspacesChanged;
        WorkspaceTabs.Changed += OnTabsChanged;
        GitStatus.Changed += OnGitStatusChanged;
        Agents.Changed += OnAgentsChanged;
        await LoadAsync();
        Observe();

        // Refresh when Home is shown, and then on the configured interval, in the background.
        _ = RefreshLoopAsync(_disposed.Token);
    }

    public void Dispose()
    {
        WorkspaceStore.Changed -= OnWorkspacesChanged;
        WorkspaceTabs.Changed -= OnTabsChanged;
        GitStatus.Changed -= OnGitStatusChanged;
        Agents.Changed -= OnAgentsChanged;
        _observing?.Dispose();
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task LoadAsync()
    {
        var load = ++_loadCount;
        IReadOnlyList<WorkspaceListing> workspaces;
        try
        {
            workspaces = await WorkspaceStore.ListAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (load == _loadCount)
        {
            _workspaces = workspaces;
            _indexProblem = WorkspaceStore.IndexProblem;
        }
    }

    private IEnumerable<Core.Workspaces.Workspace> AvailableWorkspaces() =>
        _workspaces?.Select(listing => listing.Workspace).OfType<Core.Workspaces.Workspace>() ?? [];

    // Follows the workspaces that are live (open in a tab), so their changes show as they happen.
    private void Observe()
    {
        _observing?.Dispose();
        _observing = GitStatus.Observe(AvailableWorkspaces(), OnGitStatusChanged);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var workspaces = AvailableWorkspaces().ToArray();
                if (workspaces.Length > 0)
                {
                    await GitStatus.RefreshAsync(workspaces, cancellationToken);
                }

                await Task.Delay(SettingsStore.Current.Git.StatusRefreshInterval, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Home was left.
        }
    }

    private void OnGitStatusChanged() => InvokeAsync(() =>
    {
        if (!_disposed.IsCancellationRequested)
        {
            StateHasChanged();
        }
    });

    // Raised on any thread, for any workspace. Agent states are always live, so there is nothing to read first.
    private void OnAgentsChanged(string workspaceId) => OnGitStatusChanged();

    private void OnTabsChanged() => InvokeAsync(() =>
    {
        if (!_disposed.IsCancellationRequested)
        {
            Observe();
            StateHasChanged();
        }
    });

    private sealed record Entry(WorkspaceListing Listing, string Source, WorkspaceStatus Status);

    // Status is set when the bucket is a workspace status, so it can be coloured.
    private sealed record Bucket(string Key, IReadOnlyList<Entry> Entries)
    {
        public WorkspaceStatus? Status { get; init; }
    }

    private IReadOnlyList<Entry> Entries() =>
    [
        .. _workspaces!.Select(listing =>
        {
            var details = listing.Workspace;
            var source = details is null
                ? WorkspaceSources.NoTasks
                : WorkspaceSources.Of(details.Tasks, id => Registry.All.FirstOrDefault(i => i.Id == id)?.Name);
            var status = details is null || listing.Availability != WorkspaceAvailability.Available
                ? WorkspaceStatus.RequiresAttention
                : WorkspaceStatuses.Of(
                    GitStatus.Get(details) is { IsLoaded: true } summary ? summary : EmptySummary(details),
                    Agents.For(listing.Id).Select(agent => agent.State));
            return new Entry(listing, source, status);
        }),
    ];

    // Until its git status is read, a workspace is shown as it would be with no changes.
    private static WorkspaceGitSummary EmptySummary(Core.Workspaces.Workspace workspace) => new([]);

    private static IReadOnlyList<Bucket> BySource(IEnumerable<Entry> entries) =>
    [
        .. entries.GroupBy(entry => entry.Source)
            .OrderBy(group => group.Key == WorkspaceSources.NoTasks)
            .ThenBy(group => group.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(group => new Bucket(group.Key, [.. group])),
    ];

    private static IReadOnlyList<Bucket> ByStatus(IEnumerable<Entry> entries, IReadOnlyList<WorkspaceStatus> order) =>
    [
        .. order.Select(status => new Bucket(WorkspaceStatuses.Label(status), [.. entries.Where(e => e.Status == status)]) { Status = status })
            .Where(bucket => bucket.Entries.Count > 0),
    ];

    private static readonly HomeGrouping[] Groupings = [HomeGrouping.None, HomeGrouping.Source, HomeGrouping.Status];

    private static string GroupingLabel(HomeGrouping grouping) => grouping switch
    {
        HomeGrouping.Source => "Source",
        HomeGrouping.Status => "Status",
        _ => "None",
    };

    private static HomeGrouping ParseGrouping(ChangeEventArgs e, HomeGrouping current) =>
        Enum.TryParse(e.Value?.ToString(), out HomeGrouping value) ? value : current;

    // Splits entries into tabs or groups. With None, they are all in one bucket, which isn't shown.
    private IReadOnlyList<Bucket> Split(IReadOnlyList<Entry> entries, HomeGrouping grouping) => grouping switch
    {
        HomeGrouping.Source => BySource(entries),
        HomeGrouping.Status => ByStatus(entries, SettingsStore.Current.General.HomeStatusOrder),
        _ => [new Bucket("", entries)],
    };

    private async Task UpdateGeneralAsync(Func<GeneralSettings, GeneralSettings> update)
    {
        try
        {
            await SettingsStore.UpdateAsync(settings => settings with { General = update(settings.General) });
            _settingsError = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _settingsError = $"Couldn't save the settings. {ex.Message}";
        }
    }

    // Moves the status at `index` to `target`, shifting the ones between.
    private Task MoveStatusToAsync(int index, int target) =>
        UpdateGeneralAsync(general =>
        {
            List<WorkspaceStatus> order = [.. general.HomeStatusOrder];
            if (index < 0 || index >= order.Count || target < 0 || target >= order.Count || index == target)
            {
                return general;
            }

            var status = order[index];
            order.RemoveAt(index);
            order.Insert(target, status);
            return general with { HomeStatusOrder = order };
        });

    private void OnCardKeyDown(KeyboardEventArgs e, WorkspaceListing workspace)
    {
        if (e.Key is "Enter" or " ")
        {
            Open(workspace);
        }
    }

    private void Delete(WorkspaceListing workspace)
    {
        WorkspaceTabs.Open(workspace.Id, workspace.Name);
        Navigation.NavigateTo(AppRoutes.DeleteWorkspace(workspace.Id));
    }

    private void Open(WorkspaceListing workspace)
    {
        // Opening a workspace that's already open keeps its tab, so this just shows it.
        WorkspaceTabs.Open(workspace.Id, workspace.Name);
        Navigation.NavigateTo(AppRoutes.Workspace(workspace.Id));
    }

    private void OnWorkspacesChanged() => InvokeAsync(async () =>
    {
        if (_disposed.IsCancellationRequested)
        {
            return;
        }

        await LoadAsync();
        Observe();
        StateHasChanged();
    });
}
