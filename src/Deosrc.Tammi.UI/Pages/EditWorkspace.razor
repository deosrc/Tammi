@page "/edit-workspace/{WorkspaceId}"
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Settings
@inject IWorkspaceStore WorkspaceStore
@inject IntegrationRegistry Registry
@inject ISettingsStore SettingsStore
@inject WorkspaceEditor Editor
@inject EditWorkspaceSessions Sessions
@inject NavigationManager Navigation
@implements IDisposable

<div class="page wizard">
    @if (_loadProblem is not null)
    {
        <h1>Edit workspace</h1>
        <p class="error" role="alert">@_loadProblem</p>
        <div class="wizard-actions">
            <a class="button button-secondary" href="@AppRoutes.Home">Home</a>
        </div>
    }
    else if (_draft is null || _workspace is null)
    {
        <h1>Edit workspace</h1>
        <p class="placeholder">Reading the workspace…</p>
    }
    else
    {
        <h1>Edit @_workspace.Name</h1>

        <ol class="wizard-steps" aria-label="Steps">
            @foreach (var (step, title) in Steps)
            {
                <li class="wizard-step @(step == _step ? "active" : null) @(step < _step ? "done" : null)"
                    aria-current="@(step == _step ? "step" : null)">
                    <span class="wizard-step-number">@((int)step + 1)</span>
                    @title
                </li>
            }
        </ol>

        @switch (_step)
        {
            case EditWorkspaceStep.Tasks:
                <section class="wizard-body">
                    <h2>Change tasks</h2>
                    <p class="settings-help settings-intro">
                        Add tasks to the workspace, or remove the ones it no longer needs.
                    </p>
                    <TaskPicker Draft="_draft" />
                </section>
                break;

            case EditWorkspaceStep.Repositories:
                <section class="wizard-body">
                    <h2>Add repositories</h2>
                    @if (_saving)
                    {
                        <div class="workspace-creation" aria-live="polite">
                            <progress max="@(_progress?.TotalSteps ?? 1)" value="@(_progress?.CompletedSteps ?? 0)"></progress>
                            <p>@(_progress?.Message ?? "Checking…")</p>
                        </div>
                    }
                    else if (_saved is not null)
                    {
                        <p>The workspace <strong>@_saved.Workspace.Name</strong> was changed.</p>
                        @foreach (var warning in _saved.Warnings)
                        {
                            <p class="warning">@warning</p>
                        }
                    }
                    else
                    {
                        <RepositoryPicker Draft="_draft" Changed="StateHasChanged" />
                    }

                    @if (_failure is not null)
                    {
                        <div class="workspace-creation-failure" role="alert">
                            @if (_failure.Problems.Count > 0)
                            {
                                <p class="error">The workspace can't be changed:</p>
                                <ul>
                                    @foreach (var problem in _failure.Problems)
                                    {
                                        <li class="error">@problem</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="error">@_failure.Message</p>
                            }
                            @if (_failure.CleanupProblems.Count == 0)
                            {
                                @if (_failure.InnerException is not null)
                                {
                                    <p class="settings-help">Everything added for it has been removed again.</p>
                                }
                            }
                            else
                            {
                                <p class="error">Some of what was added couldn't be removed again:</p>
                                <ul>
                                    @foreach (var problem in _failure.CleanupProblems)
                                    {
                                        <li class="error">@problem</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </section>
                break;
        }

        <div class="wizard-actions">
            @if (_saved is not null)
            {
                <div class="wizard-actions-end">
                    <button type="button" class="button" @onclick="Discard">Back to workspace</button>
                </div>
            }
            else if (_saving)
            {
                <button type="button" class="button button-secondary" disabled="@_cancelling" @onclick="CancelSaving">
                    @(_cancelling ? "Cancelling…" : "Cancel")
                </button>
            }
            else
            {
                <button type="button" class="button button-secondary" @onclick="Discard">Cancel</button>
                <div class="wizard-actions-end">
                    @if (_step > EditWorkspaceStep.Tasks)
                    {
                        <button type="button" class="button button-secondary" @onclick="Back">Back</button>
                    }
                    @if (_step < EditWorkspaceStep.Repositories)
                    {
                        <button type="button" class="button" @onclick="Next">Next</button>
                    }
                    else
                    {
                        <button type="button" class="button" disabled="@(!_draft.IsRepositoriesValid)"
                                @onclick="SaveAsync">Save changes</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly IReadOnlyList<(EditWorkspaceStep Step, string Title)> Steps =
    [
        (EditWorkspaceStep.Tasks, "Tasks"),
        (EditWorkspaceStep.Repositories, "Repositories"),
    ];

    [Parameter]
    public string WorkspaceId { get; set; } = "";

    private readonly CancellationTokenSource _disposed = new();
    private EditWorkspaceSession? _session;
    private string? _loadProblem;
    private string? _loadedId;

    private Deosrc.Tammi.Core.Workspaces.Workspace? _workspace => _session?.Workspace;
    private WorkspaceDraft? _draft => _session?.Draft;
    private EditWorkspaceStep _step => _session?.Step ?? EditWorkspaceStep.Tasks;
    private bool _saving => _session?.IsSaving ?? false;
    private bool _cancelling => _session?.IsCancelling ?? false;
    private WorkspaceCreationProgress? _progress => _session?.Progress;
    private WorkspaceEditException? _failure => _session?.Failure;
    private WorkspaceCreationResult? _saved => _session?.Saved;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == WorkspaceId)
        {
            return;
        }

        _loadedId = WorkspaceId;
        Detach();
        _loadProblem = null;

        // Resumes the flow if the workspace's tab already had one.
        if (Sessions.Find(WorkspaceId) is { } existing)
        {
            Attach(existing);
            return;
        }

        WorkspaceListing? listing;
        try
        {
            listing = await WorkspaceStore.FindAsync(WorkspaceId, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (listing?.Workspace is not { } workspace)
        {
            _loadProblem = listing is null
                ? "This workspace isn't in the list of workspaces."
                : $"The workspace '{listing.Name}' can't be edited. {listing.Problem}";
            return;
        }

        IReadOnlyList<TaskInfo> tasks;
        try
        {
            tasks = await ReadTasksAsync(workspace.Tasks);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var general = SettingsStore.Current.General;
        var draft = WorkspaceDraft.ForEditing(
            workspace, tasks, general.WorkspaceFolderNameFormat, general.WorkspaceNameTemplate);
        var session = new EditWorkspaceSession(workspace, draft, Editor);
        Sessions.Add(session);
        Attach(session);
    }

    private void Attach(EditWorkspaceSession session)
    {
        _session = session;
        session.Changed += OnSessionChanged;
        session.Completed += OnCompleted;
    }

    private void Detach()
    {
        if (_session is { } session)
        {
            session.Changed -= OnSessionChanged;
            session.Completed -= OnCompleted;
            _session = null;
        }
    }

    /// <summary>
    /// Reads each of the workspace's tasks from its source. One that can't be read stays, shown by its key, so it isn't
    /// dropped from the workspace by accident.
    /// </summary>
    private async Task<IReadOnlyList<TaskInfo>> ReadTasksAsync(IReadOnlyList<TaskReference> references)
    {
        var tasks = await Task.WhenAll(references.Select(async reference =>
        {
            if (Registry.Find(reference.Source) is ITaskIntegration source)
            {
                try
                {
                    if (await source.GetTaskAsync(reference.Key, _disposed.Token) is { } task)
                    {
                        // The workspace's metadata decides the key, so the task is still found by it.
                        return task with { Source = reference.Source, Key = reference.Key };
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Shown by its key below.
                }
            }

            return new TaskInfo(reference.Source, reference.Key, reference.Key, new Uri("about:blank"));
        }));
        return tasks;
    }

    private void Next() => _session!.Step++;

    private void Back()
    {
        _session!.Failure = null;
        _session.Step--;
    }

    public void Dispose()
    {
        // Leaving the page keeps the flow, and a save carries on. Only loading stops.
        Detach();
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void OnCompleted() => InvokeAsync(Discard);

    private Task SaveAsync() => _session is { } session ? session.SaveAsync() : Task.CompletedTask;

    private void CancelSaving() => _session?.CancelSaving();

    /// <summary>
    /// Ends the flow, and returns to the workspace.
    /// </summary>
    private void Discard()
    {
        Sessions.Discard(WorkspaceId);
        Navigation.NavigateTo(AppRoutes.Workspace(WorkspaceId));
    }
}
