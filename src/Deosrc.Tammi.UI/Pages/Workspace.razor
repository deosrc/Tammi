@page "/workspaces/{WorkspaceId}"
@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Terminals
@using Deosrc.Tammi.Core.Tools
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceTerminals Terminals
@inject WorkspaceAgents Agents
@inject WorkspaceGitGraphs GitGraphs
@inject WorkspaceHistoryTabs HistoryTabs
@inject WorkspaceTabRestorer TabRestorer
@inject ISettingsStore SettingsStore
@inject WorkspaceViewState ViewState
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceGitStatusMonitors GitStatusMonitors
@inject WorkspaceTaskLists TaskLists
@inject WorkspacePullRequestLists PullRequestLists
@inject WorkspaceTools WorkspaceTools
@inject ToolImages ToolImages
@inject NavigationManager Navigation

@if (_tab is null)
{
    <div class="page">
        <h1>Workspace not open</h1>
        <p>Open this workspace from <a href="@AppRoutes.Home">Home</a>.</p>
    </div>
}
else if (!IsLoaded)
{
    @* Render neither view until the workspace has been read, so a workspace that can't be read doesn't show the
       Workspace View for a moment first. *@
}
else if (_deleting)
{
    @* Shown until the flow finishes, since the workspace leaves the index before its branches are offered. *@
    <div class="page">
        <h1>Delete @_deletingName</h1>
        <DeleteWorkspace WorkspaceId="@WorkspaceId" OnCancel="CancelDelete" OnFinished="FinishDelete" />
    </div>
}
else if (_renaming && _listing?.Workspace is { } renamedWorkspace)
{
    <div class="page">
        <h1>Rename @renamedWorkspace.Name</h1>
        <form class="settings-form" @onsubmit="RenameAsync" @onsubmit:preventDefault>
            <div class="settings-field">
                <label for="workspace-new-name">Name</label>
                <input id="workspace-new-name"
                       class="settings-text @(RenameProblem is null ? null : "invalid")"
                       autocomplete="off" @bind="_newName" @bind:event="oninput" @ref="_newNameInput" />
                @if (RenameProblem is { } renameProblem)
                {
                    <p class="error">@renameProblem</p>
                }
                <p class="settings-help">
                    Shown on Home and the workspace's tab. The Workspace Folder keeps its name:
                    <code>@renamedWorkspace.Folder</code>.
                </p>
            </div>
            @if (_renameError is not null)
            {
                <p class="error" role="alert">@_renameError</p>
            }
            <div class="workspace-details-actions">
                <button type="submit" class="button" disabled="@(RenameProblem is not null || _savingName)">
                    @(_savingName ? "Renaming…" : "Rename")
                </button>
                <button type="button" class="button button-secondary" disabled="@_savingName" @onclick="CancelRename">
                    Cancel
                </button>
            </div>
        </form>
    </div>
}
else if (_listing is { Availability: not WorkspaceAvailability.Available } listing)
{
    @* A workspace that can't be read: say what's wrong instead of showing the Workspace View. *@
    <div class="page workspace-details">
        <h1>@listing.Name</h1>
        <p class="warning"><strong>@WorkspaceAvailabilityText.Summary(listing.Availability)</strong></p>
        <p class="workspace-details-problem">@listing.Problem</p>
        <dl class="workspace-details-facts">
            <dt>Workspace Folder</dt>
            <dd>@listing.Folder</dd>
        </dl>
        <div class="workspace-details-actions">
            <button type="button" class="button button-danger" @onclick="() => StartDelete(listing.Name)">
                Delete workspace…
            </button>
        </div>
    </div>
}
else
{
    @* Keyed by workspace, so switching tabs doesn't carry one workspace's collapsed sections over to another. *@
    <div class="workspace-view" @key="_tab.WorkspaceId">
        <aside class="side-panel">
            <div class="side-panel-sections">
                <SidePanelSection Title="Tasks">
                    <Actions>
                        @if (_tasks is { Tasks.Count: > 0 } tasks)
                        {
                            <button type="button" class="side-panel-section-action" title="Read the tasks again"
                                    aria-label="Refresh tasks" disabled="@tasks.IsRefreshing" @onclick="tasks.Refresh">
                                <svg class="icon icon-small @(tasks.IsRefreshing ? "icon-spin" : null)"
                                     viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M21 12a9 9 0 1 1-2.6-6.4L21 8" />
                                    <path d="M21 3v5h-5" />
                                </svg>
                            </button>
                        }
                    </Actions>
                    <ChildContent>
                        @if (_tasks is null || _tasks.Tasks.Count == 0)
                        {
                            <p class="placeholder">No tasks in this workspace.</p>
                        }
                        else
                        {
                            <ul class="workspace-task-list">
                                @foreach (var task in _tasks.Tasks)
                                {
                                    <WorkspaceTaskCard @key="task.Reference" WorkspaceTask="task" />
                                }
                            </ul>
                        }
                        @if (_tasks?.ContextFileProblem is { } contextFileProblem)
                        {
                            <p class="workspace-task-problem">@contextFileProblem</p>
                        }
                    </ChildContent>
                </SidePanelSection>
                <SidePanelSection Title="Agents">
                    <HeaderContent>
                        <WorkspaceAgentCounts WorkspaceId="@WorkspaceId" />
                    </HeaderContent>
                    <Actions>
                        <button type="button" class="side-panel-section-action" title="Past sessions" aria-label="History"
                                @onclick="OpenHistory">
                            @HistoryIcon
                        </button>
                        <button type="button" class="side-panel-section-action" title="Start a new agent"
                                aria-label="New agent" aria-haspopup="menu" disabled="@(AgentDefinitions.Count == 0)"
                                @onclick="OpenNewAgentMenu">
                            <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </button>
                    </Actions>
                    <ChildContent>
                        @if (_listing?.Workspace is { } agentsWorkspace)
                        {
                            <WorkspaceAgentsSection Workspace="agentsWorkspace" Shown="_shown" OnShow="ShowTab" />
                        }
                    </ChildContent>
                </SidePanelSection>
                <SidePanelSection Title="Repositories">
                    <Actions>
                        @if (_gitStatus is { Repositories.Count: > 0 })
                        {
                            <button type="button" class="side-panel-section-action"
                                    title="Read the repositories' git status and pull requests again"
                                    aria-label="Refresh repositories" disabled="@_refreshingRepositories"
                                    @onclick="RefreshRepositoriesAsync">
                                <svg class="icon icon-small @(_refreshingRepositories ? "icon-spin" : null)"
                                     viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M21 12a9 9 0 1 1-2.6-6.4L21 8" />
                                    <path d="M21 3v5h-5" />
                                </svg>
                            </button>
                        }
                    </Actions>
                    <ChildContent>
                        @if (_gitStatus is null || _gitStatus.Repositories.Count == 0)
                        {
                            <p class="placeholder">No repositories in this workspace.</p>
                        }
                        else
                        {
                            <ul class="git-status-list">
                                @foreach (var repository in _gitStatus.Repositories)
                                {
                                    <WorkspaceRepositoryGitStatus @key="repository.Repository.FolderName"
                                                                  Repository="repository"
                                                                  PullRequests="_pullRequests?.Find(repository.Repository.FolderName)"
                                                                  OnOpenGraph="path => OpenGraph(repository.Repository, path)"
                                                                  OnContextMenu="e => OpenRepositoryMenu(repository.Repository, e)" />
                                }
                            </ul>
                        }
                    </ChildContent>
                </SidePanelSection>
                <SidePanelSection Title="Tools">
                    @if (_toolItems.Count == 0)
                    {
                        <p class="placeholder">
                            No tools to open the workspace in. Add or enable them in
                            <a href="@AppRoutes.SettingsTools">Settings</a>.
                        </p>
                    }
                    else
                    {
                        @* Clicking a tool opens the Workspace Folder in it. Right-clicking it offers every folder it can
                           open. *@
                        <ul class="tool-list">
                            @foreach (var item in _toolItems)
                            {
                                <li @key="item">
                                    <button type="button" class="tool-item @PulseClass(item)"
                                            title="@(item.FilePath ?? item.Label)"
                                            aria-haspopup="@(item.DefaultEntry is null ? "menu" : null)"
                                            @onclick="e => OnToolClicked(item, e)"
                                            @oncontextmenu="e => OpenToolMenu(item, e)" @oncontextmenu:preventDefault>
                                        <ToolImageView Image="item.Entries[0].Image" Fallback="item.Tool.Icon.Generic" />
                                        <span class="tab-label-text">@item.Label</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </SidePanelSection>
            </div>
            <div class="side-panel-footer">
                @* Closes on Escape, or on a click anywhere outside the menu. *@
                <div class="menu-anchor menu-anchor-wide" @onkeydown="OnManageMenuKeyDown">
                    <button type="button" class="button button-secondary button-icon" aria-haspopup="menu"
                            aria-expanded="@(_manageMenuOpen ? "true" : "false")"
                            @onclick="ToggleManageMenu">
                        Manage Workspace
                        <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="6 15 12 9 18 15"></polyline>
                        </svg>
                    </button>
                    @if (_manageMenuOpen)
                    {
                        <div class="menu-backdrop" @onclick="() => _manageMenuOpen = false"></div>
                        <ul class="menu menu-up" role="menu" aria-label="Manage Workspace">
                            <li role="none">
                                <button type="button" class="menu-item" role="menuitem" @onclick="StartEdit">
                                    Edit tasks and repositories…
                                </button>
                            </li>
                            <li role="none">
                                <button type="button" class="menu-item" role="menuitem" @onclick="StartRename">
                                    Rename…
                                </button>
                            </li>
                            <li role="none">
                                <button type="button" class="menu-item menu-item-danger" role="menuitem"
                                        @onclick="() => StartDelete(_tab.Name)">
                                    Delete workspace…
                                </button>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </aside>
        <div class="workspace-main">
            @* The first tab is the dashboard and the last opens the New menu, so they're always there. *@
            <div class="session-tabs">
                <div class="session-tab-list" role="tablist" aria-label="Workspace">
                    <div class="session-tab session-tab-dashboard @(_shown is null ? "active" : null)">
                        <button type="button" class="session-tab-label session-tab-icon" role="tab"
                                aria-selected="@(_shown is null ? "true" : "false")" title="Dashboard"
                                aria-label="Dashboard" @onclick="ShowDashboard">
                            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <rect x="3" y="3" width="7" height="9" rx="1" />
                                <rect x="14" y="3" width="7" height="5" rx="1" />
                                <rect x="14" y="12" width="7" height="9" rx="1" />
                                <rect x="3" y="16" width="7" height="5" rx="1" />
                            </svg>
                        </button>
                    </div>
                    @foreach (var tab in _tabs)
                    {
                        var shown = ReferenceEquals(tab, _shown);
                        <div class="session-tab @(shown ? "active" : null)" @key="tab">
                            <button type="button" class="session-tab-label" role="tab"
                                    aria-selected="@(shown ? "true" : "false")"
                                    title="@(tab switch { IWorkspaceProcess process => process.WorkingDirectory, WorkspaceGitGraph graph => graph.Path, _ => null })"
                                    @onclick="() => ShowTab(tab)">
                                @if (tab is WorkspaceAgent iconAgent)
                                {
                                    <AgentIcon Definition="iconAgent.Agent.Definition" />
                                }
                                else if (tab is WorkspaceTerminal)
                                {
                                    @TerminalIcon
                                }
                                else if (tab is WorkspaceHistoryTab)
                                {
                                    @HistoryIcon
                                }
                                else if (tab is WorkspaceGitGraph)
                                {
                                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        @GitGraphIconPaths
                                    </svg>
                                }
                                <span class="tab-label-text">@tab.Name</span>
                                @if (tab is IWorkspaceProcess { HasExited: true })
                                {
                                    <span class="session-tab-status">
                                        @(tab is WorkspaceAgent { State: AgentState.Error } ? "Error" : "Exited")
                                    </span>
                                }
                                @if (tab is WorkspaceAgent agent)
                                {
                                    @* Agents' tabs show their state at the end, next to the close button. *@
                                    <AgentStateIndicator State="agent.State" />
                                }
                            </button>
                            <button type="button" class="tab-close" title="Close @tab.Name"
                                    aria-label="Close @tab.Name" @onclick="() => CloseTabAsync(tab)">
                                &times;
                            </button>
                        </div>
                    }
                </div>
                @* Outside the tab list, which scrolls and would clip the menu. Closes on Escape, or on a click anywhere
                   outside the menu. *@
                <div class="menu-anchor session-tab-new" @onkeydown="OnNewMenuKeyDown">
                    <button type="button" class="session-tab-label session-tab-icon" title="New…" aria-label="New…"
                            aria-haspopup="menu" aria-expanded="@(_newMenuOpen ? "true" : "false")"
                            @onclick="ToggleNewMenu">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </button>
                    @if (_newMenuOpen)
                    {
                        <div class="menu-backdrop" @onclick="CloseNewMenu"></div>
                        <ul class="menu" role="menu" aria-label="New">
                            @NewMenuItem(TerminalSubmenu, "Terminal", TerminalIcon, StartTerminal)
                            @if (_listing?.Workspace?.Repositories.Count > 0)
                            {
                                @GitMenuItem()
                            }
                            @if (AgentDefinitions.Count > 0)
                            {
                                <li role="separator" class="menu-separator"></li>
                            }
                            @for (var i = 0; i < AgentDefinitions.Count; i++)
                            {
                                var definition = AgentDefinitions[i];
                                var name = string.IsNullOrWhiteSpace(definition.Name)
                                    ? WorkspaceAgents.DefaultName
                                    : definition.Name;
                                @NewMenuItem(
                                    $"agent-{i}",
                                    name,
                                    @<AgentIcon Definition="definition" />,
                                    repository => StartAgentAsync(definition, repository))
                            }
                        </ul>
                    }
                </div>
            </div>
            @if (_startError is not null)
            {
                <p class="error workspace-main-error">@_startError</p>
            }
            @if (_shown is IWorkspaceProcess shownProcess)
            {
                <Terminal @key="shownProcess" Session="shownProcess.Session" Class="workspace-terminal" />
            }
            else if (_shown is WorkspaceHistoryTab && _listing?.Workspace is { } historyWorkspace)
            {
                <WorkspaceHistoryView Workspace="historyWorkspace" OnShow="ShowTab" />
            }
            else if (_shown is WorkspaceGitGraph shownGraph)
            {
                <GitGraphView @key="shownGraph" Graph="shownGraph" />
            }
            else
            {
                <div class="workspace-main-empty">
                    @if (_listing?.Workspace is { } dashboardWorkspace)
                    {
                        <WorkspaceDashboard Workspace="dashboardWorkspace" Tasks="_tasks" PullRequests="_pullRequests"
                                            GitStatus="_gitStatus" OnShowAgent="ShowTab"
                                            OnOpenGraph="graph => OpenGraph(graph.Repository, graph.Path)" />
                    }
                </div>
            }
        </div>
        @if (_contextMenu is { } contextMenu)
        {
            <ContextMenu @key="contextMenu" X="contextMenu.X" Y="contextMenu.Y" Label="@contextMenu.Label"
                         OnClose="CloseContextMenu">
                @contextMenu.Items
            </ContextMenu>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource _disposed = new();
    private WorkspaceTab? _tab;
    private WorkspaceListing? _listing;
    private string? _loadedWorkspaceId;
    private bool _deleting;
    private bool _renaming;
    private bool _savingName;
    private bool _focusNewName;
    private string _newName = "";
    private string? _renameError;
    private ElementReference _newNameInput;
    private bool _manageMenuOpen;
    private const string TerminalSubmenu = "terminal";
    private const string GitSubmenu = "git";

    private bool _newMenuOpen;

    // The New menu's open submenu: TerminalSubmenu, or "agent-<index>" for an Agent Definition.
    private string? _openSubmenu;
    private string? _startError;

    // The workspace's main area tabs after the dashboard, in the order they started.
    private IReadOnlyList<IMainAreaTab> _tabs = [];
    private IMainAreaTab? _shown;
    private string _deletingName = "";

    // Keeps running while the tab is open, so it isn't disposed with the page.
    private WorkspaceGitStatusMonitor? _gitStatus;

    // Kept while the tab is open, so switching tabs doesn't read the tasks again.
    private WorkspaceTaskList? _tasks;

    // Kept while the tab is open, reading again on its own timer.
    private WorkspacePullRequestList? _pullRequests;

    // Whether the Repositories section's Refresh is reading the git status and pull requests again.
    private bool _refreshingRepositories;

    // What the Workspace Folder and each repository (by folder name) can be opened in.
    private IReadOnlyList<ToolEntry> _workspaceTools = [];
    private IReadOnlyDictionary<string, IReadOnlyList<ToolEntry>> _repositoryTools =
        new Dictionary<string, IReadOnlyList<ToolEntry>>();

    // The Tools section's tools, each with the levels it can be launched at.
    private IReadOnlyList<ToolItem> _toolItems = [];

    // The Tools section's item that was just launched, which pulses once, and how many launches have pulsed.
    private static readonly TimeSpan PulseDuration = TimeSpan.FromMilliseconds(600);
    private ToolItem? _pulsing;
    private int _pulseCount;

    // The open right-click menu, if any, and whether its Tools submenu is open.
    private ContextMenuState? _contextMenu;
    private bool _contextSubmenuOpen;

    // Counts updates of the tools, so a slow one doesn't replace a newer one's result.

    private int _toolsUpdateCount;

    // Counts loads, so a slow load that finishes after a newer one (e.g. for another tab) doesn't replace its result.
    private int _loadCount;

    [Parameter]
    public string WorkspaceId { get; set; } = "";

    /// <summary>
    /// Starts the Delete Workspace flow when the tab is shown, e.g. from the button on Home's Done workspaces.
    /// </summary>
    [SupplyParameterFromQuery(Name = "delete")]
    public bool Delete { get; set; }

    protected override void OnInitialized()
    {
        WorkspaceTabs.Changed += OnTabsChanged;
        WorkspaceStore.Changed += OnWorkspacesChanged;
        Terminals.Changed += OnMainAreaTabsChanged;
        Agents.Changed += OnMainAreaTabsChanged;
        GitGraphs.Changed += OnMainAreaTabsChanged;
        HistoryTabs.Changed += OnMainAreaTabsChanged;
        SettingsStore.Changed += OnToolsChanged;
    }

    private IReadOnlyList<AgentDefinition> AgentDefinitions => SettingsStore.Current.Agents.Definitions;

    private bool IsLoaded => _loadedWorkspaceId == WorkspaceId;

    protected override async Task OnParametersSetAsync()
    {
        if (_tab?.WorkspaceId != WorkspaceId)
        {
            // Another tab is shown in this page, so the flow and menu for the previous one are closed.
            _deleting = false;
            _renaming = false;
            _manageMenuOpen = false;
            CloseNewMenu();
            _startError = null;
        }

        _tab = WorkspaceTabs.Find(WorkspaceId);
        UpdateTabs();
        await LoadAsync();

        if (Delete && IsLoaded && _listing is not null && !_deleting)
        {
            StartDelete(_listing.Name);
            // Drops the query, so the flow isn't started again.
            Navigation.NavigateTo(AppRoutes.Workspace(WorkspaceId), replace: true);
        }
    }

    public void Dispose()
    {
        WorkspaceTabs.Changed -= OnTabsChanged;
        WorkspaceStore.Changed -= OnWorkspacesChanged;
        Terminals.Changed -= OnMainAreaTabsChanged;
        Agents.Changed -= OnMainAreaTabsChanged;
        GitGraphs.Changed -= OnMainAreaTabsChanged;
        HistoryTabs.Changed -= OnMainAreaTabsChanged;
        SettingsStore.Changed -= OnToolsChanged;
        SetGitStatus(null);
        SetTasks(null);
        SetPullRequests(null);
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task LoadAsync()
    {
        var load = ++_loadCount;
        WorkspaceListing? listing;
        try
        {
            listing = await WorkspaceStore.FindAsync(WorkspaceId, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (load == _loadCount)
        {
            _listing = listing;
            _loadedWorkspaceId = WorkspaceId;
            UpdateGitStatus();
            UpdateTasks();
            UpdatePullRequests();
            _ = UpdateToolsAsync();
            if (listing?.Workspace is { } workspace)
            {
                await RestoreTabsAsync(workspace);
            }
        }
    }

    // Opens the agents and git graphs the workspace had open when Tammi last closed. Only the first time it's loaded.
    private async Task RestoreTabsAsync(Deosrc.Tammi.Core.Workspaces.Workspace workspace)
    {
        var restoration = await TabRestorer.RestoreAsync(workspace);
        if (restoration.Problems.Count > 0)
        {
            _startError = string.Join(" ", restoration.Problems);
        }

        if (restoration.Restored)
        {
            ViewState.SetShown(WorkspaceId, restoration.Active);
        }

        UpdateTabs();
    }

    private IReadOnlyList<ToolEntry> RepositoryTools(WorkspaceRepository repository) =>
        _repositoryTools.TryGetValue(repository.FolderName, out var tools) ? tools : [];

    // Finds what the workspace and its repositories can be opened in, then their icons. It reads their folders (for
    // the files that file tools open), so it's done in the background.
    private async Task UpdateToolsAsync()
    {
        var update = ++_toolsUpdateCount;
        IReadOnlyList<ToolEntry> workspaceTools = [];
        var repositoryTools = new Dictionary<string, IReadOnlyList<ToolEntry>>();
        var settings = SettingsStore.Current.Tools;
        var tools = settings.Tools;
        if (_listing?.Workspace is { } workspace)
        {
            (workspaceTools, repositoryTools) = await Task.Run(() => (
                WorkspaceTools.GetEntries(workspace, null, settings),
                workspace.Repositories.ToDictionary(
                    repository => repository.FolderName,
                    repository => WorkspaceTools.GetEntries(workspace, repository, settings))));
        }

        if (update != _toolsUpdateCount || _disposed.IsCancellationRequested)
        {
            return;
        }

        _workspaceTools = workspaceTools;
        _repositoryTools = repositoryTools;
        UpdateToolItems(tools);
        StateHasChanged();

        // The icons are shown once they're found. Until then, each tool shows its generic icon.
        _workspaceTools = await WithImagesAsync(workspaceTools);
        foreach (var (folderName, entries) in repositoryTools)
        {
            repositoryTools[folderName] = await WithImagesAsync(entries);
        }

        if (update == _toolsUpdateCount && !_disposed.IsCancellationRequested)
        {
            UpdateToolItems(tools);
            StateHasChanged();
        }
    }

    private void UpdateToolItems(IReadOnlyList<ToolDefinition> tools) =>
        _toolItems = WorkspaceTools.GroupByTool(
            tools,
            _workspaceTools,
            (_listing?.Workspace?.Repositories ?? []).Select(RepositoryTools));

    private async Task<IReadOnlyList<ToolEntry>> WithImagesAsync(IReadOnlyList<ToolEntry> entries)
    {
        var withImages = new List<ToolEntry>(entries.Count);
        foreach (var entry in entries)
        {
            withImages.Add(entry with { Image = await ToolImages.GetAsync(entry.Tool, entry.Request?.FileName) });
        }

        return withImages;
    }

    private void OnToolsChanged() => InvokeAsync(UpdateToolsAsync);

    private void OnToolClicked(ToolItem item, MouseEventArgs e)
    {
        if (item.DefaultEntry is { } entry)
        {
            OpenTool(item, entry);
        }
        else
        {
            // It can only be launched in a repository, and there are several, so it offers them.
            OpenToolMenu(item, e);
        }
    }

    private void OpenToolMenu(ToolItem item, MouseEventArgs e) => OpenContextMenu(e, item.Label, ToolMenuItems(item));

    // A tool's right-click menu: each folder it can be launched in.
    private RenderFragment ToolMenuItems(ToolItem item) => __builder =>
    {
        foreach (var entry in item.Launches)
        {
            var workspace = ReferenceEquals(entry, item.WorkspaceEntry);
            <li role="none">
                <button type="button" class="menu-item" role="menuitem" title="@entry.Path"
                        @onclick="() => OpenTool(item, entry)">
                    @(workspace ? WorkspaceFolderIcon : RepositoryIcon)
                    @(workspace ? "Workspace" : $"Repository: {entry.Repository?.FolderName}")
                </button>
            </li>
        }
    };

    private void OpenRepositoryMenu(WorkspaceRepository repository, MouseEventArgs e) =>
        OpenContextMenu(e, repository.FolderName, RepositoryMenuItems(repository));

    // A repository card's right-click menu: a Tools submenu of what the repository can be opened in.
    private RenderFragment RepositoryMenuItems(WorkspaceRepository repository) => __builder =>
    {
        var tools = RepositoryTools(repository);
        <li role="none" class="menu-submenu-anchor" @onmouseenter="() => _contextSubmenuOpen = true">
            <button type="button" class="menu-item" role="menuitem" aria-haspopup="menu"
                    aria-expanded="@(_contextSubmenuOpen ? "true" : "false")"
                    @onclick="() => _contextSubmenuOpen = !_contextSubmenuOpen">
                <span class="tab-label-text">Tools</span>
                <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
            </button>
            @if (_contextSubmenuOpen)
            {
                <ul class="menu menu-submenu" role="menu" aria-label="Tools">
                    @if (tools.Count == 0)
                    {
                        <li role="none">
                            <button type="button" class="menu-item" role="menuitem" disabled>No tools</button>
                        </li>
                    }
                    @foreach (var entry in tools)
                    {
                        <li role="none">
                            <button type="button" class="menu-item" role="menuitem" title="@entry.Path"
                                    @onclick="() => OpenTool(entry)">
                                <ToolImageView Image="entry.Image" Fallback="entry.Tool.Icon.Generic" />
                                <span class="tab-label-text">@entry.Label</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </li>
    };

    // The Agents section's New Agent menu: each Agent Definition, with a submenu of where to start it. It's a context
    // menu, as the side panel scrolls and would clip a drop-down.
    private void OpenNewAgentMenu(MouseEventArgs e) =>
        OpenContextMenu(e, "New agent", NewAgentMenuItems());

    private RenderFragment NewAgentMenuItems() => __builder =>
    {
        for (var i = 0; i < AgentDefinitions.Count; i++)
        {
            var definition = AgentDefinitions[i];
            var name = string.IsNullOrWhiteSpace(definition.Name) ? WorkspaceAgents.DefaultName : definition.Name;
            @NewMenuItem(
                $"agent-{i}",
                name,
                @<AgentIcon Definition="definition" />,
                repository => StartAgentAsync(definition, repository))
        }
    };

    // Opens a right-click menu at the pointer. Only one menu is open at a time.
    private void OpenContextMenu(MouseEventArgs e, string label, RenderFragment items)
    {
        _manageMenuOpen = false;
        CloseNewMenu();
        _contextSubmenuOpen = false;
        _contextMenu = new ContextMenuState(e.ClientX, e.ClientY, label, items);
    }

    private void CloseContextMenu()
    {
        _contextMenu = null;
        _contextSubmenuOpen = false;
    }

    // Opens a tool from the Tools section, and pulses its item once to show it's launching.
    private void OpenTool(ToolItem item, ToolEntry entry)
    {
        var pulse = ++_pulseCount;
        _pulsing = item;
        OpenTool(entry);
        _ = EndPulseAsync(pulse);
    }

    private async Task EndPulseAsync(int pulse)
    {
        await Task.Delay(PulseDuration);
        if (pulse == _pulseCount && !_disposed.IsCancellationRequested)
        {
            _pulsing = null;
            StateHasChanged();
        }
    }

    // Two classes with the same animation, so clicking the item again while it's pulsing starts the pulse again.
    private string? PulseClass(ToolItem item) =>
        Equals(item, _pulsing) ? (_pulseCount % 2 == 0 ? "tool-item-pulse" : "tool-item-pulse-again") : null;

    private void OpenTool(ToolEntry entry)
    {
        CloseContextMenu();
        _startError = null;
        if (entry.OpensTerminal)
        {
            // Opens in a tab, as the New menu's Terminal does.
            StartTerminal(entry.Repository);
            return;
        }

        try
        {
            WorkspaceTools.Open(entry);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException
            or System.ComponentModel.Win32Exception)
        {
            _startError = $"Couldn't open {entry.Label}. {ex.Message}";
        }
    }

    private void UpdateTasks() =>
        SetTasks(!_deleting && _listing?.Workspace is { } workspace && WorkspaceTabs.Find(workspace.Id) is not null
            ? TaskLists.Start(workspace)
            : null);

    private void SetTasks(WorkspaceTaskList? list)
    {
        if (ReferenceEquals(list, _tasks))
        {
            return;
        }

        if (_tasks is not null)
        {
            _tasks.Changed -= OnMonitorChanged;
        }

        _tasks = list;
        if (_tasks is not null)
        {
            _tasks.Changed += OnMonitorChanged;
        }
    }

    /// <summary>
    /// Reads every repository's git status and pull requests again, for the Repositories section's Refresh. It doesn't
    /// fetch: the status is compared with the remote-tracking branches as they are.
    /// </summary>
    private async Task RefreshRepositoriesAsync()
    {
        if (_refreshingRepositories)
        {
            return;
        }

        _refreshingRepositories = true;
        try
        {
            await Task.WhenAll(
                _gitStatus?.RefreshAsync(_disposed.Token) ?? Task.CompletedTask,
                _pullRequests?.RefreshAsync() ?? Task.CompletedTask);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The page closed, or the workspace started being deleted or its tab closed, meanwhile.
        }
        finally
        {
            _refreshingRepositories = false;
        }
    }

    private void UpdatePullRequests() =>
        SetPullRequests(!_deleting && _listing?.Workspace is { } workspace
            && WorkspaceTabs.Find(workspace.Id) is not null
                ? PullRequestLists.Start(workspace)
                : null);

    private void SetPullRequests(WorkspacePullRequestList? list)
    {
        if (ReferenceEquals(list, _pullRequests))
        {
            return;
        }

        if (_pullRequests is not null)
        {
            _pullRequests.Changed -= OnMonitorChanged;
        }

        _pullRequests = list;
        if (_pullRequests is not null)
        {
            _pullRequests.Changed += OnMonitorChanged;
        }
    }

    private void UpdateGitStatus()
    {
        // The monitor only runs while the workspace is open in a tab. It's stopped while the workspace is being
        // deleted, so it isn't watching the folders being deleted (on Windows, a watched folder can't be deleted
        // until the watch closes).
        SetGitStatus(!_deleting && _listing?.Workspace is { } workspace && WorkspaceTabs.Find(workspace.Id) is not null
            ? GitStatusMonitors.Start(workspace)
            : null);
    }

    private void SetGitStatus(WorkspaceGitStatusMonitor? monitor)
    {
        if (ReferenceEquals(monitor, _gitStatus))
        {
            return;
        }

        if (_gitStatus is not null)
        {
            _gitStatus.Changed -= OnGitStatusChanged;
        }

        _gitStatus = monitor;
        if (_gitStatus is not null)
        {
            _gitStatus.Changed += OnGitStatusChanged;
        }
    }

    // Something in one of the repositories changed, so the git graph shown reads its refs again, and the graph too if
    // they've changed (e.g. after a commit, fetch or checkout). Graphs that aren't shown do the same when they're next
    // shown.
    private void OnGitStatusChanged()
    {
        if (_shown is WorkspaceGitGraph graph)
        {
            _ = graph.RefreshIfChangedAsync();
        }

        OnMonitorChanged();
    }

    private void OnMonitorChanged() => InvokeAsync(() =>
    {
        if (!_disposed.IsCancellationRequested)
        {
            StateHasChanged();
        }
    });

    private void UpdateTabs()
    {
        _tabs = [.. Terminals.For(WorkspaceId).Concat<IMainAreaTab>(Agents.For(WorkspaceId))
            .Concat(GitGraphs.For(WorkspaceId))
            .Concat(HistoryTabs.For(WorkspaceId))
            .OrderBy(tab => tab.StartOrder)];

        // Show the tab the view was showing last time (in this run, or before Tammi restarted), or the dashboard if it
        // wasn't showing one or it has been closed. This only reads: what the view shows is only remembered when the
        // user changes it, as a tab that hasn't opened yet (while tabs are restored) isn't the dashboard.
        _shown = (ViewState.GetShown(WorkspaceId) ?? TabRestorer.GetActive(WorkspaceId)) is { } shown
            && _tabs.Contains(shown) ? shown : null;
    }

    // Remembers the tab the view shows, here and for the next time Tammi starts.
    private void SetShownTab(IMainAreaTab? tab)
    {
        ViewState.SetShown(WorkspaceId, tab);
        TabRestorer.SetActive(WorkspaceId, tab);
    }

    private void ShowDashboard()
    {
        SetShownTab(null);
        _shown = null;
    }

    private void ShowTab(IMainAreaTab tab)
    {
        SetShownTab(tab);
        _shown = tab;
        UpdateTabs();
    }

    private void StartTerminal(WorkspaceRepository? repository)
    {
        CloseNewMenu();
        _startError = null;
        if (_listing?.Workspace is not { } workspace)
        {
            return;
        }

        try
        {
            ShowTab(Terminals.Start(workspace, repository));
        }
        catch (Exception ex) when (ex is IOException or System.Runtime.InteropServices.ExternalException)
        {
            _startError = $"Couldn't start a terminal. {ex.Message}";
        }

        UpdateTabs();
    }

    private async Task StartAgentAsync(AgentDefinition definition, WorkspaceRepository? repository)
    {
        CloseNewMenu();
        CloseContextMenu();
        _startError = null;
        if (_listing?.Workspace is not { } workspace)
        {
            return;
        }

        try
        {
            ShowTab(await Agents.StartAsync(workspace, definition, repository));
        }
        catch (Exception ex) when (ex is IOException or ArgumentException
            or System.Runtime.InteropServices.ExternalException)
        {
            _startError = $"Couldn't start {definition.Name}. {ex.Message}";
        }

        UpdateTabs();
    }

    private async Task CloseTabAsync(IMainAreaTab tab)
    {
        if (ReferenceEquals(tab, _shown))
        {
            // Show the next tab, or the previous one if it was the last, or else the dashboard.
            var index = _tabs.ToList().IndexOf(tab);
            var next = index + 1 < _tabs.Count ? _tabs[index + 1] : index > 0 ? _tabs[index - 1] : null;
            SetShownTab(next);
        }

        // Closing an agent's tab stops it. Its session can still be resumed.
        var closing = tab switch
        {
            WorkspaceAgent agent => Agents.CloseAsync(agent),
            WorkspaceTerminal terminal => Terminals.CloseAsync(terminal),
            WorkspaceGitGraph graph => CloseGraph(graph),
            WorkspaceHistoryTab history => CloseHistory(history),
            _ => Task.CompletedTask,
        };
        UpdateTabs();
        await closing;
    }

    private Task CloseHistory(WorkspaceHistoryTab history)
    {
        HistoryTabs.Close(history);
        return Task.CompletedTask;
    }

    // Opens the History tab, or shows it if it's already open.
    private void OpenHistory()
    {
        if (_listing?.Workspace is { } workspace)
        {
            ShowTab(HistoryTabs.Open(workspace.Id));
        }
    }

    private Task CloseGraph(WorkspaceGitGraph graph)
    {
        GitGraphs.Close(graph);
        return Task.CompletedTask;
    }

    // Opens the git graph of a repository, or of one of its submodules by its path in the repository, and shows it.
    private void OpenGraph(WorkspaceRepository repository, string? submodulePath)
    {
        CloseNewMenu();
        if (_listing?.Workspace is { } workspace)
        {
            ShowTab(GitGraphs.Open(workspace, repository, submodulePath));
        }
    }

    // What the New menu's Git item offers: each repository, then its checked-out submodules (and theirs), as far as its
    // status has been read.
    private IEnumerable<(WorkspaceRepository Repository, string? SubmodulePath)> GraphTargets()
    {
        foreach (var repository in _listing?.Workspace?.Repositories ?? [])
        {
            yield return (repository, null);
            var status = _gitStatus?.Repositories
                .FirstOrDefault(candidate => candidate.Repository.FolderName == repository.FolderName)?.Status;
            foreach (var path in SubmodulePaths(status, null))
            {
                yield return (repository, path);
            }
        }
    }

    private static IEnumerable<string> SubmodulePaths(RepositoryStatus? status, string? prefix)
    {
        foreach (var submodule in status?.Submodules ?? [])
        {
            if (submodule.Status is not { } inner)
            {
                continue;
            }

            var path = prefix is null ? submodule.Path : $"{prefix}/{submodule.Path}";
            yield return path;
            foreach (var nested in SubmodulePaths(inner, path))
            {
                yield return nested;
            }
        }
    }

    // The New menu's Git item, with a submenu of the repositories and submodules whose graph it opens.
    private RenderFragment GitMenuItem() => __builder =>
    {
        var open = _openSubmenu == GitSubmenu;
        <li role="none" class="menu-submenu-anchor" @key="GitSubmenu" @onmouseenter="() => _openSubmenu = GitSubmenu">
            <button type="button" class="menu-item" role="menuitem" aria-haspopup="menu"
                    aria-expanded="@(open ? "true" : "false")" @onclick="() => _openSubmenu = open ? null : GitSubmenu">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">@GitGraphIconPaths</svg>
                <span class="tab-label-text">Git</span>
                <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
            </button>
            @if (open)
            {
                <ul class="menu menu-submenu" role="menu" aria-label="Git">
                    @foreach (var (repository, submodulePath) in GraphTargets())
                    {
                        <li role="none" @key="WorkspaceGitGraph.NameFor(repository, submodulePath)">
                            <button type="button" class="menu-item" role="menuitem"
                                    @onclick="() => OpenGraph(repository, submodulePath)">
                                @RepositoryIcon
                                @(submodulePath is null
                                    ? $"Repository: {repository.FolderName}"
                                    : $"Submodule: {repository.FolderName}/{submodulePath}")
                            </button>
                        </li>
                    }
                </ul>
            }
        </li>
    };

    // A git graph: a branch leaving one lane and merging back into it.
    private static readonly RenderFragment GitGraphIconPaths =
        @<g>
            <circle cx="6" cy="5" r="2" />
            <circle cx="6" cy="19" r="2" />
            <circle cx="18" cy="9" r="2" />
            <path d="M6 7v10" />
            <path d="M18 11c0 4-6 4-10.5 6.5" />
        </g>;

    // The New menu's icons: what each item starts, and where. Agents have theirs from AgentIcon.
    private static readonly RenderFragment TerminalIcon =
        @<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <polyline points="7 9 10 12 7 15" />
            <path d="M12 15h5" />
        </svg>;

    // A clock with its hands turned back: past sessions.
    private static readonly RenderFragment HistoryIcon =
        @<svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 12a9 9 0 1 0 2.6-6.4L3 8" />
            <path d="M3 3v5h5" />
            <path d="M12 7v5l3 2" />
        </svg>;

    private static readonly RenderFragment WorkspaceFolderIcon =
        @<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
        </svg>;

    private static readonly RenderFragment RepositoryIcon =
        @<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="6" cy="5" r="2" />
            <circle cx="6" cy="19" r="2" />
            <circle cx="18" cy="7" r="2" />
            <path d="M6 7v10M18 9a5 5 0 0 1-5 5h-2a5 5 0 0 0-5 3" />
        </svg>;

    // An item of the New menu with a submenu of where to start it: the Workspace Folder or one of its repositories.
    private RenderFragment NewMenuItem(
        string key,
        string label,
        RenderFragment icon,
        Func<WorkspaceRepository?, Task> start) => __builder =>
    {
        var open = _openSubmenu == key;
        <li role="none" class="menu-submenu-anchor" @key="key" @onmouseenter="() => _openSubmenu = key">
            <button type="button" class="menu-item" role="menuitem" aria-haspopup="menu"
                    aria-expanded="@(open ? "true" : "false")" @onclick="() => _openSubmenu = open ? null : key">
                @icon
                <span class="tab-label-text">@label</span>
                <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
            </button>
            @if (open)
            {
                <ul class="menu menu-submenu" role="menu" aria-label="@label">
                    <li role="none">
                        <button type="button" class="menu-item" role="menuitem" @onclick="() => start(null)">
                            @WorkspaceFolderIcon
                            Workspace
                        </button>
                    </li>
                    @foreach (var repository in _listing?.Workspace?.Repositories ?? [])
                    {
                        <li role="none" @key="repository.FolderName">
                            <button type="button" class="menu-item" role="menuitem"
                                    @onclick="() => start(repository)">
                                @RepositoryIcon
                                Repository: @repository.FolderName
                            </button>
                        </li>
                    }
                </ul>
            }
        </li>
    };

    private RenderFragment NewMenuItem(
        string key,
        string label,
        RenderFragment icon,
        Action<WorkspaceRepository?> start) =>
        NewMenuItem(key, label, icon, repository =>
        {
            start(repository);
            return Task.CompletedTask;
        });

    private void ToggleNewMenu()
    {
        CloseContextMenu();
        _newMenuOpen = !_newMenuOpen;
        _openSubmenu = null;
    }

    private void CloseNewMenu()
    {
        _newMenuOpen = false;
        _openSubmenu = null;
    }

    private void OnNewMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseNewMenu();
        }
    }

    private void OnMainAreaTabsChanged(string workspaceId) => InvokeAsync(() =>
    {
        if (_disposed.IsCancellationRequested || workspaceId != WorkspaceId)
        {
            return;
        }

        UpdateTabs();
        StateHasChanged();
    });

    private void ToggleManageMenu()
    {
        CloseContextMenu();
        _manageMenuOpen = !_manageMenuOpen;
    }

    private void OnManageMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _manageMenuOpen = false;
        }
    }

    private void StartDelete(string name)
    {
        _manageMenuOpen = false;
        _deletingName = name;
        _deleting = true;
        SetGitStatus(null);
        GitStatusMonitors.Stop(WorkspaceId);
    }

    private string? RenameProblem => WorkspaceNames.Validate(_newName);

    private void StartEdit()
    {
        _manageMenuOpen = false;
        Navigation.NavigateTo(AppRoutes.EditWorkspace(WorkspaceId));
    }

    private void StartRename()
    {
        _manageMenuOpen = false;
        _newName = _listing?.Workspace?.Name ?? _tab?.Name ?? "";
        _renameError = null;
        _renaming = true;
        _focusNewName = true;
    }

    private void CancelRename()
    {
        _renaming = false;
        _renameError = null;
    }

    private async Task RenameAsync()
    {
        if (RenameProblem is not null || _savingName)
        {
            return;
        }

        _savingName = true;
        _renameError = null;
        try
        {
            var renamed = await WorkspaceStore.RenameAsync(WorkspaceId, _newName, _disposed.Token);
            WorkspaceTabs.Rename(WorkspaceId, renamed.Name);
            _renaming = false;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex) when (ex is WorkspaceException or ArgumentException)
        {
            _renameError = $"Couldn't rename the workspace. {ex.Message}";
        }
        finally
        {
            _savingName = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNewName && _renaming)
        {
            _focusNewName = false;
            try
            {
                await _newNameInput.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // The input isn't rendered after all, e.g. the workspace couldn't be read.
            }
        }
    }

    private void CancelDelete()
    {
        _deleting = false;
        UpdateGitStatus();
        UpdateTasks();
        UpdatePullRequests();
    }

    private void FinishDelete()
    {
        _deleting = false;
        WorkspaceTabs.Close(WorkspaceId);
        Navigation.NavigateTo(AppRoutes.Home);
    }

    private void OnTabsChanged() => InvokeAsync(() =>
    {
        _tab = WorkspaceTabs.Find(WorkspaceId);
        UpdateGitStatus();
        UpdateTasks();
        UpdatePullRequests();
        StateHasChanged();
    });

    private void OnWorkspacesChanged() => InvokeAsync(async () =>
    {
        if (_disposed.IsCancellationRequested)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    // A right-click menu: where it opens, its name and its items. Each one is a new key, so it's fitted again.
    internal sealed record ContextMenuState(double X, double Y, string Label, RenderFragment Items);
}
