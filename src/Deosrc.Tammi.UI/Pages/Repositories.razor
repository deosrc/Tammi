@page "/repositories"
@implements IDisposable
@using Deosrc.Tammi.Core.Catalogue
@using Deosrc.Tammi.Core.Git
@inject IRepositoryCatalogue Catalogue
@inject IGitRepositoryReader Reader
@inject IGitCli Git
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceGitGraphs GitGraphs
@inject NavigationManager Navigation

@* The Repository Catalogue's Local Repositories with their git state, outside any workspace. *@
<div class="page">
    <h1>Repositories</h1>
    <div class="usage-toolbar">
        <button type="button" class="button" @onclick="LoadAsync" disabled="@_loading">
            @(_loading ? "Reading…" : "Refresh")
        </button>
        <a href="@AppRoutes.SettingsRepositories">Repository settings</a>
    </div>

    @if (_rows.Count == 0 && !_loading)
    {
        <p class="placeholder">
            No repositories yet. Add monitored folders or repositories in
            <a href="@AppRoutes.SettingsRepositories">Settings</a>.
        </p>
    }
    else
    {
        <table class="data-table data-table-repositories" aria-label="Repositories">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Branch</th>
                    <th scope="col">Changes</th>
                    <th scope="col">Ahead</th>
                    <th scope="col">Behind</th>
                    <th scope="col">Worktrees</th>
                    <th scope="col">Workspaces</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr @key="row.Repository.Path">
                        <td title="@row.Repository.Path">@row.Repository.Name</td>
                        @if (row.Problem is { } problem)
                        {
                            <td class="error data-table-span">@problem</td>
                        }
                        else
                        {
                            <td>@(row.Status?.Branch ?? "(detached)")</td>
                            <td>@(row.Status?.Changes.Count ?? 0)</td>
                            <td>@(row.Status?.AheadBy?.ToString() ?? "–")</td>
                            <td>@(row.Status?.BehindBy?.ToString() ?? "–")</td>
                            <td>@row.WorktreeCount</td>
                            <td>@row.WorkspaceCount</td>
                        }
                        <td>
                            <button type="button" class="button button-secondary" disabled="@(row.Problem is not null)"
                                    @onclick="() => OpenGit(row.Repository)">
                                Git…
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private sealed record Row(
        CatalogueRepository Repository,
        RepositoryStatus? Status,
        int WorktreeCount,
        int WorkspaceCount,
        string? Problem);

    private List<Row> _rows = [];
    private bool _loading;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Catalogue.Changed += OnCatalogueChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Catalogue.Changed -= OnCatalogueChanged;
    }

    private void OnCatalogueChanged()
    {
        if (!Catalogue.IsScanning)
        {
            _ = InvokeAsync(LoadAsync);
        }
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            var snapshot = await Catalogue.GetAsync();
            var listings = await WorkspaceStore.ListAsync();
            var rows = await Task.Run(() => snapshot.Repositories
                .Select(repository => ReadRow(repository, listings))
                .OrderBy(row => row.Repository.Name, StringComparer.OrdinalIgnoreCase)
                .ToList());
            if (!_disposed)
            {
                _rows = rows;
            }
        }
        finally
        {
            _loading = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private Row ReadRow(CatalogueRepository repository, IReadOnlyList<WorkspaceListing> listings)
    {
        var workspaces = listings.Count(listing => listing.Workspace?.Repositories.Any(
            used => string.Equals(used.LocalRepositoryPath, repository.Path, StringComparison.Ordinal)) == true);
        try
        {
            var status = Reader.ReadStatus(repository.Path);
            return new Row(repository, status, CountWorktrees(repository.Path), workspaces, null);
        }
        catch (Exception ex) when (ex is GitException or IOException)
        {
            return new Row(repository, null, 0, workspaces, ex.Message);
        }
    }

    private int CountWorktrees(string path)
    {
        try
        {
            var result = Git.RunAsync(path, ["worktree", "list", "--porcelain"], new GitCommandOptions { ThrowOnError = false })
                .GetAwaiter().GetResult();
            // The repository itself is listed too; the count is of its linked worktrees.
            return result.Succeeded ? Math.Max(0, result.OutputLines.Count(line => line.StartsWith("worktree ", StringComparison.Ordinal)) - 1) : 0;
        }
        catch (GitException)
        {
            return 0;
        }
    }

    private void OpenGit(CatalogueRepository repository)
    {
        GitGraphs.OpenRepository(repository.Path);
        Navigation.NavigateTo(AppRoutes.RepositoryGit(repository.Path));
    }
}
