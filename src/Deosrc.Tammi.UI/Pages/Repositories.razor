@page "/repositories"
@implements IDisposable
@using Deosrc.Tammi.Core.Catalogue
@inject RepositoryListState State
@inject WorkspaceGitGraphs GitGraphs
@inject NavigationManager Navigation
@inject Deosrc.Tammi.UI.Workspaces.WorkspaceViewState ViewState

@* The Repository Catalogue's Local Repositories with their git state, outside any workspace. *@
<div class="page">
    <div class="page-header">
        <h1>Repositories</h1>
        <div class="page-header-actions">
            <button type="button" class="button button-secondary button-icon"
                    title="Scan for repositories again and read their status again" aria-label="Refresh"
                    disabled="@State.IsLoading" @onclick="State.RescanAndRefreshAsync">
                <svg class="icon icon-small @(State.IsLoading ? "icon-spin" : null)" viewBox="0 0 24 24"
                     aria-hidden="true" focusable="false">
                    <path d="M21 12a9 9 0 1 1-2.6-6.4L21 8" />
                    <path d="M21 3v5h-5" />
                </svg>
            </button>
            <a class="button button-secondary button-icon" href="@AppRoutes.SettingsRepositories"
               title="Repository settings" aria-label="Repository settings">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="6.5" />
                    <circle cx="12" cy="12" r="2.5" />
                    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" stroke-width="3" />
                </svg>
            </a>
        </div>
    </div>
    <p class="settings-help repositories-help">
        Here you can find all of the repositories Tammi knows about, details about their primary clone, and the number
        of workspaces configured on the repository. Select a repository to open it.
    </p>
    @if (State.Rows.Count == 0 && !State.IsLoading)
    {
        <p class="placeholder">
            No repositories yet. Add monitored folders or repositories in
            <a href="@AppRoutes.SettingsRepositories">Settings</a>.
        </p>
    }
    else
    {
        <table class="data-table data-table-repositories" aria-label="Repositories">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Branch</th>
                    <th scope="col">Changes</th>
                    <th scope="col">Ahead</th>
                    <th scope="col">Behind</th>
                    <th scope="col">Workspaces</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in State.Rows)
                {
                    var canOpen = row.IsLoaded && row.Problem is null;
                    <tr @key="row.Repository.Path" class="@(canOpen ? "data-table-row-action" : null)"
                        tabindex="@(canOpen ? "0" : null)" title="@(canOpen ? "Open the git graph" : null)"
                        @onclick="() => OpenGit(row.Repository, canOpen)"
                        @onkeydown="e => OnRowKeyDown(e, row.Repository, canOpen)">
                        <td title="@row.Repository.Path">@row.Repository.Name</td>
                        @if (!row.IsLoaded)
                        {
                            @for (var i = 0; i < 5; i++)
                            {
                                <td><span class="placeholder-bar" aria-hidden="true"></span></td>
                            }
                        }
                        else if (row.Problem is { } problem)
                        {
                            <td class="error data-table-span">@problem</td>
                        }
                        else
                        {
                            <td>@(row.Status?.Branch ?? "(detached)")</td>
                            <td>
                                @if (row.Status is { } status && GitStatusText.UncommittedChangeCount(status) > 0)
                                {
                                    <span class="workspace-badge workspace-badge-warning">Local changes</span>
                                }
                            </td>
                            <td>
                                <GitSyncChips Ahead="row.Status?.AheadBy ?? 0" Behind="0" Upstream="@row.Status?.Upstream" Inline="true" />
                            </td>
                            <td>
                                <GitSyncChips Ahead="0" Behind="row.Status?.BehindBy ?? 0" Upstream="@row.Status?.Upstream" Inline="true" />
                            </td>
                            <td>@row.WorkspaceCount</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await State.EnsureLoadedAsync();
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnRowKeyDown(KeyboardEventArgs e, CatalogueRepository repository, bool canOpen)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenGit(repository, canOpen);
        }
    }

    private void OpenGit(CatalogueRepository repository, bool canOpen)
    {
        if (!canOpen)
        {
            return;
        }

        GitGraphs.OpenRepository(repository.Path);
        Navigation.NavigateTo(ViewState.RepositoryRouteOf(repository.Path));
    }
}
