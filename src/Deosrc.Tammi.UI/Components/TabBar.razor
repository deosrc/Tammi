@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* A row of tabs that are links: fixed tabs first, which can't be closed, then the tabs that can be, which scroll and,
   when they don't all fit, can be reached from a menu of every tab. Then come the end content, for something that is
   always after the tabs (e.g. a menu to open a new one), and the trailing content, which sits at the far end. *@
<nav class="tab-bar @Class" aria-label="@AriaLabel">
    @foreach (var item in FixedItems)
    {
        @Tab(item, closable: false)
    }
    <div class="tab-bar-scroll" @ref="_scroller">
        @foreach (var item in Items)
        {
            @Tab(item, closable: true)
        }
    </div>
    @if (_overflowing)
    {
        <FluentButton Id="@_overflowId" Class="tab-bar-overflow" Appearance="ButtonAppearance.Transparent"
                      Size="ButtonSize.Small" IconOnly="true" Title="All tabs" aria-label="All tabs"
                      IconStart="@(new Icons.Regular.Size16.ChevronDown())" />
        <FluentMenu Trigger="@_overflowId">
            @foreach (var item in AllItems)
            {
                var target = item;
                <FluentMenuItem Label="@(item.Label ?? item.Title)" Checked="@item.Active"
                                OnClick="() => Navigation.NavigateTo(target.Href)" />
            }
        </FluentMenu>
    }
    @EndContent
    <div class="tab-bar-trailing">
        @TrailingContent
    </div>
</nav>

@code {
    private static int _count;

    private readonly string _overflowId = $"tab-bar-overflow-{Interlocked.Increment(ref _count)}";
    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<TabBar>? _self;
    private bool _overflowing;
    private string? _shownKey;
    private bool _disposed;

    /// <summary>
    /// The bar's name for assistive technology.
    /// </summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>
    /// The tabs at the start, which can't be closed.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TabBarItem> FixedItems { get; set; } = [];

    /// <summary>
    /// The tabs after them, which can be closed. They scroll if they don't fit.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TabBarItem> Items { get; set; } = [];

    /// <summary>
    /// Raised when the user closes one of <see cref="Items"/>.
    /// </summary>
    [Parameter]
    public EventCallback<TabBarItem> OnClose { get; set; }

    /// <summary>
    /// Always after the tabs, and not scrolled with them, e.g. a button that opens a new tab.
    /// </summary>
    [Parameter]
    public RenderFragment? EndContent { get; set; }

    /// <summary>
    /// At the far end of the bar, e.g. a Settings tab. Use <c>tab-bar-tab</c> classes for a tab.
    /// </summary>
    [Parameter]
    public RenderFragment? TrailingContent { get; set; }

    /// <summary>
    /// Extra CSS classes for the bar, e.g. its colours and height.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    private IEnumerable<TabBarItem> AllItems => FixedItems.Concat(Items);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Deosrc.Tammi.UI/Components/TabBar.razor.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _self = DotNetObjectReference.Create(this);
            _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _scroller, _self);
        }

        // Scrolls a tab into view when it becomes the one shown, as it may be out of sight.
        var shown = AllItems.FirstOrDefault(item => item.Active)?.Key;
        if (_module is not null && shown is not null && shown != _shownKey)
        {
            _shownKey = shown;
            await _module.InvokeVoidAsync("scrollActiveIntoView", _scroller);
        }
    }

    /// <summary>
    /// Called by the browser when the tabs start or stop overflowing the space for them.
    /// </summary>
    [JSInvokable]
    public void SetOverflowing(bool overflowing)
    {
        if (overflowing != _overflowing)
        {
            _overflowing = overflowing;
            StateHasChanged();
        }
    }

    private RenderFragment Tab(TabBarItem item, bool closable) =>
        @<div class="tab-bar-tab @(item.Active ? "active" : null) @(closable ? "closable" : null)" @key="item.Key">
            <a class="tab-bar-label @(item.Label is null ? "icon-only" : null)" href="@item.Href" title="@item.Title"
               aria-label="@(item.Label is null ? item.Title : null)" aria-current="@(item.Active ? "page" : null)">
                @item.Icon
                @if (item.Label is not null)
                {
                    <span class="tab-bar-text">@item.Label</span>
                }
                @item.Indicator
            </a>
            @if (closable)
            {
                <FluentButton Class="tab-bar-close" Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                              IconOnly="true" Title="@($"Close {item.Title}")" aria-label="@($"Close {item.Title}")"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="() => OnClose.InvokeAsync(item)" />
            }
        </div>;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The window is closing.
        }

        _self?.Dispose();
    }
}
