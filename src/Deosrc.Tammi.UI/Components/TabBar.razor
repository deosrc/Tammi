@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* A row of tabs that are links: fixed tabs first, which can't be closed, then the tabs that can be, which are hidden when
   they don't all fit (the tab shown never is). Then come the end content, for something that is always after the tabs
   (e.g. a menu to open a new one), and the trailing tabs, which sit at the far end. When tabs are hidden, a More Tabs
   menu of the closable tabs comes just before the trailing tabs. The fixed and trailing tabs are always in sight, so
   they aren't in the menu. With OnMove, the closable tabs can be put in another order, by dragging them or with
   Ctrl+Shift+Left and Right. They stay between the fixed and trailing tabs. *@
<nav class="tab-bar @Class" aria-label="@AriaLabel">
    @foreach (var item in FixedItems)
    {
        @Tab(item, closable: false)
    }
    <div class="tab-bar-scroll" @ref="_scroller">
        @foreach (var item in Items)
        {
            @Tab(item, closable: true)
        }
    </div>
    @EndContent
    <div class="tab-bar-trailing">
        @if (_overflowing)
        {
            <FluentButton Id="@_overflowId" Class="tab-bar-overflow" Appearance="ButtonAppearance.Transparent"
                          Size="ButtonSize.Small" IconEnd="@(new Icons.Regular.Size16.ChevronDown())">More Tabs</FluentButton>
            <FluentMenu Trigger="@_overflowId">
                <FluentMenuList Class="tab-bar-overflow-list">
                    @foreach (var item in Items)
                    {
                        var target = item;
                        @* The tab shown is marked with a tick. *@
                        <FluentMenuItem IconEnd="@(item.Active ? new Icons.Regular.Size16.Checkmark() : null)"
                                        OnClick="() => Navigation.NavigateTo(target.Href)">
                            <span class="tab-bar-menu-item">
                                @if (item.Icon is not null)
                                {
                                    <span class="tab-bar-slot">@item.Icon</span>
                                }
                                <span>@(item.Label ?? item.Title)</span>
                                @if (item.Indicator is not null)
                                {
                                    <span class="tab-bar-slot">@item.Indicator</span>
                                }
                            </span>
                        </FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        }

        @foreach (var item in TrailingItems)
        {
            @Tab(item, closable: false)
        }
    </div>
</nav>

@code {
    private static int _count;

    private readonly string _overflowId = $"tab-bar-overflow-{Interlocked.Increment(ref _count)}";
    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<TabBar>? _self;
    private bool _overflowing;
    private bool _disposed;

    /// <summary>
    /// The bar's name for assistive technology.
    /// </summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>
    /// The tabs at the start, which can't be closed.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TabBarItem> FixedItems { get; set; } = [];

    /// <summary>
    /// The tabs after them, which can be closed. Those that don't fit are hidden, except the one shown.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TabBarItem> Items { get; set; } = [];

    /// <summary>
    /// Raised when the user closes one of <see cref="Items"/>.
    /// </summary>
    [Parameter]
    public EventCallback<TabBarItem> OnClose { get; set; }

    /// <summary>
    /// Raised when the user moves one of <see cref="Items"/> to another place among them. Without it the tabs can't be
    /// moved.
    /// </summary>
    [Parameter]
    public EventCallback<TabBarMove> OnMove { get; set; }

    /// <summary>
    /// Always after the tabs, and never hidden with them, e.g. a button that opens a new tab.
    /// </summary>
    [Parameter]
    public RenderFragment? EndContent { get; set; }

    /// <summary>
    /// The tabs at the far end of the bar, which can't be closed, e.g. Settings.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TabBarItem> TrailingItems { get; set; } = [];

    /// <summary>
    /// Extra CSS classes for the bar, e.g. its colours and height.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Deosrc.Tammi.UI/Components/TabBar.razor.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _self = DotNetObjectReference.Create(this);
            _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _scroller, _self);
        }

    }

    /// <summary>
    /// Called by the browser when the tabs start or stop overflowing the space for them.
    /// </summary>
    [JSInvokable]
    public void SetOverflowing(bool overflowing)
    {
        if (overflowing != _overflowing)
        {
            _overflowing = overflowing;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Called by the browser when the user has moved a tab next to another: after it, or else before it.
    /// </summary>
    [JSInvokable]
    public async Task MoveTab(string key, string otherKey, bool after)
    {
        var moved = Items.FirstOrDefault(item => item.Key == key);
        if (moved is null || key == otherKey)
        {
            return;
        }

        var others = Items.Where(item => item.Key != key).ToList();
        var index = others.FindIndex(item => item.Key == otherKey);
        if (index < 0)
        {
            return;
        }

        if (after)
        {
            index++;
        }

        if (index != Items.ToList().IndexOf(moved))
        {
            await OnMove.InvokeAsync(new TabBarMove(moved, index));
        }
    }

    private bool IsMovable(TabBarItem item, bool closable) => closable && OnMove.HasDelegate;

    private RenderFragment Tab(TabBarItem item, bool closable) =>
        @<div class="tab-bar-tab @(item.Active ? "active" : null) @(closable ? "closable" : null) @(IsMovable(item, closable) ? "movable" : null)"
              data-key="@item.Key" @key="item.Key">
            @* Links can be dragged out of the page on their own: here a drag moves the tab instead. *@
            <a class="tab-bar-label @(item.Label is null ? "icon-only" : null)" href="@item.Href" title="@item.Title"
               draggable="false" aria-label="@(item.Label is null ? item.Title : null)" aria-current="@(item.Active ? "page" : null)"
               aria-keyshortcuts="@(IsMovable(item, closable) ? "Control+Shift+ArrowLeft Control+Shift+ArrowRight" : null)">
                @if (item.Icon is not null)
                {
                    <span class="tab-bar-slot">@item.Icon</span>
                }
                @if (item.Label is not null)
                {
                    <span class="tab-bar-text">@item.Label</span>
                }
                @if (item.Indicator is not null)
                {
                    <span class="tab-bar-slot">@item.Indicator</span>
                }
            </a>
            @if (closable)
            {
                <FluentButton Class="tab-bar-close" Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                              IconOnly="true" Title="@($"Close {item.Label ?? item.Title}")" aria-label="@($"Close {item.Label ?? item.Title}")"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="() => OnClose.InvokeAsync(item)" />
            }
        </div>;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The window is closing, or the page's script objects are already gone.
        }

        _self?.Dispose();
    }
}
