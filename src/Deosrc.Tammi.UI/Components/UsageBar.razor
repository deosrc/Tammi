@using Deosrc.Tammi.Core.Usage

@* A limit's usage, warning from 75% and an error from 90%. *@
<FluentProgressBar Value="@((int)Math.Round(Limit.PercentUsed))" Max="100" aria-label="@Limit.Description" Width="@Width"
                   Thickness="@(Large ? ProgressThickness.Large : ProgressThickness.Medium)"
                   State="@(Limit.PercentUsed >= 90 ? ProgressState.Error : Limit.PercentUsed >= 75 ? ProgressState.Warning : null)" />

@code {
    [Parameter, EditorRequired]
    public AgentUsageLimit Limit { get; set; } = null!;

    /// <summary>
    /// A thicker bar, for a page of its own.
    /// </summary>
    [Parameter]
    public bool Large { get; set; }

    /// <summary>
    /// The bar's width as CSS, e.g. <c>80px</c>. It fills the available width by default.
    /// </summary>
    [Parameter]
    public string? Width { get; set; }
}
