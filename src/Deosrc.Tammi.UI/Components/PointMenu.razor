@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A menu opened where the pointer is, e.g. by a right-click: its items are FluentMenuItems. The menu is anchored to an
   empty element at the point, so it flips to stay inside the window, and closes as any menu does: on Escape, or a click
   outside it, or an item. Give it a new @key each time it opens, and drop it when OnClose is raised. *@
<div class="point-menu">
    <span id="@_anchorId" class="point-menu-anchor" aria-hidden="true"
          style="left: @Pixels(X); top: @Pixels(Y)"></span>
    <FluentMenu Id="@_menuId" Trigger="@_anchorId" OpenedChanged="OnOpenedChanged">
        <FluentMenuList aria-label="@Label">
            @ChildContent
        </FluentMenuList>
    </FluentMenu>
</div>

@code {
    private static int _count;

    private readonly string _anchorId;
    private readonly string _menuId;
    private IJSObjectReference? _module;
    private bool _opened;

    public PointMenu()
    {
        var number = Interlocked.Increment(ref _count);
        _anchorId = $"point-menu-anchor-{number}";
        _menuId = $"point-menu-{number}";
    }

    /// <summary>
    /// Where the menu opens, in pixels from the window's left edge, e.g. the pointer's position.
    /// </summary>
    [Parameter]
    public double X { get; set; }

    /// <summary>
    /// Where the menu opens, in pixels from the window's top edge.
    /// </summary>
    [Parameter]
    public double Y { get; set; }

    /// <summary>
    /// The menu's name for screen readers.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>
    /// The menu's items.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Called when the menu has closed, so it can be dropped.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Deosrc.Tammi.UI/Components/PointMenu.razor.js");
        await _module.InvokeVoidAsync("open", _menuId, _anchorId);
    }

    private Task OnOpenedChanged(bool opened)
    {
        // Closing before it was seen to open would be the menu being replaced, not the user closing it.
        if (opened)
        {
            _opened = true;
            return Task.CompletedTask;
        }

        return _opened ? OnClose.InvokeAsync() : Task.CompletedTask;
    }

    private static string Pixels(double value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException)
            {
                // The window has closed.
            }
        }
    }
}
