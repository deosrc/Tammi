@using Deosrc.Tammi.Core.Integrations.GitHub
@using Deosrc.Tammi.Core.Integrations.Jira
@using Deosrc.Tammi.Core.Settings

@* Says which token an integration needs, and where to create one. *@
<div class="settings-help">
    @if (ForBitbucket)
    {
        <text>An API token with scopes, used with your Atlassian account's email address. Create it for Bitbucket with these scopes:</text>
        <ul class="token-scopes">
            <li><code>read:issue:bitbucket</code></li>
            <li><code>read:pullrequest:bitbucket</code></li>
            <li><code>read:repository:bitbucket</code></li>
            <li><code>read:user:bitbucket</code></li>
            <li><code>read:workspace:bitbucket</code></li>
        </ul>
        <text>They let @AppInfo.Name list your repositories and issues, and show pull requests and their builds.</text>
        <a href="@BitbucketTokenUrl" @onclick="() => Open.InvokeAsync(BitbucketTokenUrl)"
           @onclick:preventDefault>Create a token</a>
    }
    else if (ForGitHub)
    {
        <text>A fine-grained or classic personal access token. A fine-grained token needs read access to these permissions on the repositories to include:</text>
        <ul class="token-scopes">
            <li>Commit statuses</li>
            <li>Contents</li>
            <li>Issues</li>
            <li>Metadata</li>
            <li>Pull requests</li>
        </ul>
        <text>
            Without Contents, GitHub's search leaves out private issues. Pull requests and commit statuses show the
            workspace branches' pull requests and their checks. On github.com, the link below fills in these
            permissions: choose the token's owner and its repositories (All repositories is simplest).
        </text>
        <text>A classic token needs these scopes:</text>
        <ul class="token-scopes">
            <li><code>repo</code> (for private repositories)</li>
        </ul>
        <text>To let @AppInfo.Name add SSH keys from Settings → Git, also give the token these optional permissions. Without them, @AppInfo.Name opens GitHub's page for adding a key instead:</text>
        <ul class="token-scopes">
            <li>Git SSH keys, read and write (fine-grained tokens)</li>
            <li><code>write:public_key</code> (classic tokens)</li>
        </ul>
        @* The link needs the server, so it waits until a GitHub Enterprise Server URL is entered. *@
        @if (GitHub is not null)
        {
            <a href="@GitHubTokenUrl(GitHub)" @onclick="() => Open.InvokeAsync(GitHubTokenUrl(GitHub))"
               @onclick:preventDefault>Create a token</a>
        }
    }
    else if (Deployment == JiraDeployment.Cloud)
    {
        <text>An API token, used with your Atlassian account's email address. A token without scopes needs nothing more. A token with scopes needs these JIRA scopes:</text>
        <ul class="token-scopes">
            <li><code>read:jira-user</code></li>
            <li><code>read:jira-work</code></li>
        </ul>
        <a href="@JiraCloudTokenUrl" @onclick="() => Open.InvokeAsync(JiraCloudTokenUrl)"
           @onclick:preventDefault>Create a token</a>
    }
    else if (Deployment == JiraDeployment.DataCenter)
    {
        <text>A personal access token (JIRA 8.14 or later). Create one in JIRA from your profile's Personal Access Tokens page.</text>
    }
</div>

@code {
    private const string BitbucketTokenUrl = "https://id.atlassian.com/manage-profile/security/api-tokens";
    private const string JiraCloudTokenUrl = "https://id.atlassian.com/manage-profile/security/api-tokens";

    /// <summary>
    /// Whether the token is for Bitbucket Cloud.
    /// </summary>
    [Parameter]
    public bool ForBitbucket { get; set; }

    /// <summary>
    /// Whether the token is for GitHub.
    /// </summary>
    [Parameter]
    public bool ForGitHub { get; set; }

    /// <summary>
    /// The GitHub integration the token is for, which says where to create one. <see langword="null"/> until its
    /// server is known.
    /// </summary>
    [Parameter]
    public GitHubIntegrationSettings? GitHub { get; set; }

    /// <summary>
    /// The deployment of the JIRA site the token is for.
    /// </summary>
    [Parameter]
    public JiraDeployment? Deployment { get; set; }

    /// <summary>
    /// Opens a link in the browser.
    /// </summary>
    [Parameter]
    public EventCallback<string> Open { get; set; }

    // github.com's link fills in the token's name and permissions. Enterprise Servers before 3.20 can't fill them in,
    // and may not have fine-grained tokens at all, so they get their token settings page.
    private static string GitHubTokenUrl(GitHubIntegrationSettings github) => github.IsGitHubCom
        ? GitHubTokenTemplate.GitHubComUrl.AbsoluteUri
        : $"{github.ApiUrl.GetLeftPart(UriPartial.Authority)}/settings/tokens";
}
