@using Deosrc.Tammi.Core.Tools

@* A tool's icon, a line icon in the text colour. *@
<svg class="icon @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Icon)
    {
        case ToolIcon.Editor:
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
            break;
        case ToolIcon.Ide:
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="m10 9-3 3 3 3M14 9l3 3-3 3" />
            break;
        case ToolIcon.Container:
            <path d="M21 8 12 3 3 8v8l9 5 9-5Z" />
            <path d="m3 8 9 5 9-5M12 13v8" />
            break;
        case ToolIcon.Folder:
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
            break;
        case ToolIcon.Terminal:
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <polyline points="7 9 10 12 7 15" />
            <path d="M12 15h5" />
            break;
        default:
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M3 9h18M7 6.5h.01M10 6.5h.01" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// The icon to show.
    /// </summary>
    [Parameter, EditorRequired]
    public ToolIcon Icon { get; set; }

    /// <summary>
    /// More classes for the icon, e.g. <c>icon-small</c>.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }
}
