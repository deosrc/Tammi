@using Deosrc.Tammi.Core.Tools

@* A tool's icon, a Fluent icon in the text colour. *@
<FluentIcon Value="@IconValue" />

@code {
    /// <summary>
    /// The icon to show.
    /// </summary>
    [Parameter, EditorRequired]
    public ToolIcon Icon { get; set; }

    private Microsoft.FluentUI.AspNetCore.Components.Icon IconValue => Icon switch
    {
        ToolIcon.Editor => new Icons.Regular.Size20.Code(),
        ToolIcon.Ide => new Icons.Regular.Size20.WindowDevTools(),
        ToolIcon.Container => new Icons.Regular.Size20.Box(),
        ToolIcon.Folder => new Icons.Regular.Size20.Folder(),
        ToolIcon.Terminal => new Icons.Regular.Size20.WindowConsole(),
        _ => new Icons.Regular.Size20.Window(),
    };
}
