@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A list of cards that can be reordered by dragging their grip (see SortableGrip), on a Fluent sortable list. The list is
   made for compact rows, so its own border, row height and background are turned off, and each item is just its card.
   While a card is dragged, the image that follows the cursor is a smaller copy of it, as the card can be tall. *@
<div class="sortable-card-list @Class" @ref="_root">
    <FluentSortableList TItem="TItem" Handle="true" AriaLabel="@AriaLabel" Items="Items" OnUpdate="OnMoved">
        <ItemTemplate>
            @ItemTemplate(context)
        </ItemTemplate>
    </FluentSortableList>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dragImage;
    private bool _disposed;

    /// <summary>
    /// The items, in order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>
    /// How an item is shown, usually as a card.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = null!;

    /// <summary>
    /// What the list is, for screen readers.
    /// </summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>
    /// Raised when an item has been dragged to another place, with where it was and where it is now.
    /// </summary>
    [Parameter]
    public EventCallback<FluentSortableListEventArgs> OnMoved { get; set; }

    /// <summary>
    /// How much smaller than the card the image that follows the cursor is when it's dragged.
    /// </summary>
    [Parameter]
    public double DragImageScale { get; set; } = 0.5;

    /// <summary>
    /// Extra CSS classes for the list, e.g. its width.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Deosrc.Tammi.UI/Components/SortableCardList.razor.js");
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        _dragImage = await _module.InvokeAsync<IJSObjectReference>("useScaledDragImage", _root, DragImageScale);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_dragImage is not null)
            {
                await _dragImage.InvokeVoidAsync("dispose");
                await _dragImage.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The window is closing.
        }
    }
}
