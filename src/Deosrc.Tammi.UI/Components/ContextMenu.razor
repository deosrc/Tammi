@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A menu opened by a right-click, at the pointer. It's kept inside the window, and closes on Escape or on a click
   (or right-click) anywhere outside it. Give it a new @key each time it opens, so it's fitted to the window again. *@
<div class="menu-backdrop" @onclick="OnClose" @oncontextmenu="OnClose" @oncontextmenu:preventDefault></div>
<ul @ref="_menu" class="menu menu-context" role="menu" aria-label="@Label" tabindex="-1"
    style="left: @Pixels(X); top: @Pixels(Y)" @onkeydown="OnKeyDown" @oncontextmenu:preventDefault>
    @ChildContent
</ul>

@code {
    private ElementReference _menu;
    private IJSObjectReference? _module;

    /// <summary>
    /// Where the menu opens, in pixels from the window's left edge, e.g. the pointer's position.
    /// </summary>
    [Parameter]
    public double X { get; set; }

    /// <summary>
    /// Where the menu opens, in pixels from the window's top edge.
    /// </summary>
    [Parameter]
    public double Y { get; set; }

    /// <summary>
    /// The menu's name for screen readers.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>
    /// The menu's items: <c>li</c> elements, as in other menus.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Called when the menu should close: on Escape, or a click outside it.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Deosrc.Tammi.UI/Components/ContextMenu.razor.js");
        await _module.InvokeVoidAsync("fit", _menu);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The window has closed.
            }
        }
    }

    private static string Pixels(double value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
