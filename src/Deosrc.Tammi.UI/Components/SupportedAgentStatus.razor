@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Platform
@implements IDisposable
@inject SupportedAgentChecker Checker
@inject IProcessLauncher ProcessLauncher

@* A Supported Agent on the Agents settings page: whether its CLI is installed and runs, and why not if it doesn't. *@
<li>
    <FluentCard>
        <div class="agent-settings-card">
            <div class="agent-definition-header">
                <AgentIcon Definition="Agent.Definition" />
                <span class="agent-definition-name">@Agent.Name</span>
                @if (_status is null)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint">Checking…</FluentBadge>
                }
                else if (_status.IsAvailable)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success">✓ Ready</FluentBadge>
                }
                else
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Danger">✗ Not available</FluentBadge>
                }
                <FluentButton Size="ButtonSize.Small" Disabled="@(_status is null)" OnClick="CheckAsync">
                    Check again
                </FluentButton>
            </div>

            <dl class="settings-values agent-status">
                <dt>Command</dt>
                <dd><code>@Agent.Definition.Command</code>@(_status?.ExecutablePath is { } path ? $" ({path})" : null)</dd>
                @if (_status?.Version is { } version)
                {
                    <dt>Version</dt>
                    <dd>@version</dd>
                }
            </dl>

            @if (_status is { IsAvailable: false } status)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    @status.Problem
                </FluentMessageBar>
                <p>
                    <FluentLink OnClick="OpenInstallGuide">How to install @Agent.Name</FluentLink>
                </p>
            }

            @if (_openError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    @_openError
                </FluentMessageBar>
            }
        </div>
    </FluentCard>
</li>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private AgentToolStatus? _status;
    private string? _openError;

    [Parameter, EditorRequired]
    public SupportedAgent Agent { get; set; } = null!;

    protected override Task OnInitializedAsync() => CheckAsync();

    private async Task CheckAsync()
    {
        _status = null;
        try
        {
            _status = await Checker.CheckAsync(Agent, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            // The page was closed.
        }
    }

    // Links must open in the user's browser: following them would navigate the app's own window away from Tammi.
    private void OpenInstallGuide()
    {
        _openError = null;
        try
        {
            ProcessLauncher.Open(Agent.InstallUrl);
        }
        catch (Exception ex)
        {
            _openError = $"Couldn't open {Agent.InstallUrl}: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
