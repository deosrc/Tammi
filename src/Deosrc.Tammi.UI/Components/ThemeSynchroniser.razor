@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISettingsStore SettingsStore
@inject ISystemTheme SystemTheme

@code {
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Deosrc.Tammi.UI/Components/ThemeSynchroniser.razor.js");
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        SettingsStore.Changed += OnChanged;
        SystemTheme.Changed += OnChanged;
        await ApplyAsync();
    }

    // Both events can be raised on any thread.
    private void OnChanged() => _ = InvokeAsync(ApplyAsync);

    // Light or dark when known. Auto with an undetected system theme is left to the browser's own detection.
    private async Task ApplyAsync()
    {
        if (_module is null || _disposed)
        {
            return;
        }

        var theme = SettingsStore.Current.General.Theme switch
        {
            ThemePreference.Light => "light",
            ThemePreference.Dark => "dark",
            _ => SystemTheme.IsDark switch { true => "dark", false => "light", null => null },
        };
        try
        {
            await _module.InvokeVoidAsync("setTheme", theme);
        }
        catch (JSDisconnectedException)
        {
            // The window is closing.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SettingsStore.Changed -= OnChanged;
        SystemTheme.Changed -= OnChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
