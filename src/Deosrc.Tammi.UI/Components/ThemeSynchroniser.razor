@using Deosrc.Tammi.Core.Platform
@using Deosrc.Tammi.Core.Settings
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISettingsStore SettingsStore
@inject ISystemTheme SystemTheme
@inject IThemeService FluentTheme

@code {
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Deosrc.Tammi.UI/Components/ThemeSynchroniser.razor.js");
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        SettingsStore.Changed += OnChanged;
        SystemTheme.Changed += OnChanged;
        await ApplyAsync();
    }

    // Both events can be raised on any thread.
    private void OnChanged() => _ = InvokeAsync(ApplyAsync);

    // Light or dark when known. Auto with an undetected system theme is left to the browser's own detection. Fluent's
    // components are told the same theme, as their own system detection (the browser's) can disagree with the
    // platform's, e.g. WebKitGTK reports light while the desktop is dark.
    private async Task ApplyAsync()
    {
        if (_module is null || _disposed)
        {
            return;
        }

        var theme = SettingsStore.Current.General.Theme switch
        {
            ThemePreference.Light => "light",
            ThemePreference.Dark => "dark",
            _ => SystemTheme.IsDark switch { true => "dark", false => "light", null => null },
        };
        try
        {
            await _module.InvokeVoidAsync("setTheme", theme);
            await ApplyFluentAsync(theme);
        }
        catch (JSDisconnectedException)
        {
            // The window is closing.
        }
    }

    // Fluent's mode comes first, as it also marks the page light or dark. Then its theme is built from the brand
    // palette (see palette.css) and replaces the colours it would otherwise generate. The accent seeds Fluent's brand
    // ramp, and the primary colours (filled controls and their text) are the palette's own.
    private async Task ApplyFluentAsync(string? theme)
    {
        var mode = theme switch
        {
            "light" => ThemeMode.Light,
            "dark" => ThemeMode.Dark,
            _ => ThemeMode.System,
        };
        await FluentTheme.SetThemeAsync(mode);

        var brand = await _module!.InvokeAsync<BrandColors>("brandColors");
        var fluent = await FluentTheme.CreateCustomThemeAsync(new ThemeSettings(brand.Accent, 0, 0, mode, false));
        fluent.Colors.Brand.Background = brand.Primary;
        fluent.Colors.Brand.BackgroundHover = brand.PrimaryHover;
        fluent.Colors.Brand.BackgroundPressed = brand.PrimaryPressed;
        fluent.Colors.Brand.BackgroundSelected = brand.PrimarySelected;
        var neutral = fluent.Colors.Neutral;
        neutral.Background1 = brand.Surface;
        neutral.Background2 = brand.Background;
        neutral.Background3 = brand.Background;
        neutral.Foreground1 = brand.Text;
        neutral.Foreground2 = brand.Text;
        neutral.Foreground3 = brand.TextMuted;
        neutral.ForegroundOnBrand = brand.OnPrimary;
        await FluentTheme.SetThemeAsync(fluent);
    }

    private sealed record BrandColors(
        string Background, string Surface, string Text, string TextMuted, string Accent, string Primary,
        string PrimaryHover, string PrimaryPressed, string PrimarySelected, string OnPrimary);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SettingsStore.Changed -= OnChanged;
        SystemTheme.Changed -= OnChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
