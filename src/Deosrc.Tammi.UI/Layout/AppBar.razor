@implements IAsyncDisposable
@using Deosrc.Tammi.Core.Platform
@inject IWindowFrame Frame
@inject IAppCloser AppCloser
@inject IJSRuntime JS

@* The bar at the top of the window: the wordmark and the main tabs. When the platform's title bar is removed, the bar
   takes its place: the window controls come at its end, and its empty space (anything that isn't a tab, a button or a
   menu, the wordmark included) moves the window when dragged and maximises or restores it when double-clicked. The
   controls are drawn here rather than by the platform so they fit the bar on every platform; they're Fluent buttons,
   sized and coloured like the platform's. *@
<header class="app-bar @(Frame.HasTitleBar ? null : "window-title-bar")" @ref="_bar">
    <BrandWordmark Class="app-name" />
    <TabStrip />
    @if (!Frame.HasTitleBar)
    {
        <div class="window-controls">
            <FluentButton Class="window-control" Appearance="ButtonAppearance.Transparent" IconOnly="true"
                          Title="Minimise" aria-label="Minimise" IconStart="@(new Icons.Regular.Size16.Subtract())"
                          OnClick="Frame.Minimize" />
            @if (Frame.IsMaximized)
            {
                <FluentButton Class="window-control" Appearance="ButtonAppearance.Transparent" IconOnly="true"
                              Title="Restore" aria-label="Restore" IconStart="@(new Icons.Regular.Size16.SquareMultiple())"
                              OnClick="Frame.ToggleMaximized" />
            }
            else
            {
                <FluentButton Class="window-control" Appearance="ButtonAppearance.Transparent" IconOnly="true"
                              Title="Maximise" aria-label="Maximise" IconStart="@(new Icons.Regular.Size16.Square())"
                              OnClick="Frame.ToggleMaximized" />
            }
            <FluentButton Class="window-control window-control-close" Appearance="ButtonAppearance.Transparent"
                          IconOnly="true" Title="Close" aria-label="Close" IconStart="@(new Icons.Regular.Size16.Dismiss())"
                          OnClick="AppCloser.Close" />
        </div>
    }
</header>

@code {
    private ElementReference _bar;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dragging;
    private DotNetObjectReference<AppBar>? _self;
    private bool _disposed;

    protected override void OnInitialized() => Frame.Changed += OnFrameChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Attached whatever the window has, as the title bar can be removed while the app runs. The script only acts
        // while the bar is the title bar.
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Deosrc.Tammi.UI/Layout/AppBar.razor.js");
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _dragging = await _module.InvokeAsync<IJSObjectReference>("attach", _bar, _self);
    }

    /// <summary>
    /// Called by the browser when the bar's empty space is dragged.
    /// </summary>
    [JSInvokable]
    public void BeginMove(int screenX, int screenY) => Frame.BeginMove(screenX, screenY);

    /// <summary>
    /// Called by the browser when the bar's empty space is double-clicked.
    /// </summary>
    [JSInvokable]
    public void ToggleMaximized() => Frame.ToggleMaximized();

    // Raised on any thread.
    private void OnFrameChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Frame.Changed -= OnFrameChanged;
        try
        {
            if (_dragging is not null)
            {
                await _dragging.InvokeVoidAsync("dispose");
                await _dragging.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The window is closing, or the page's script objects are already gone.
        }

        _self?.Dispose();
    }
}
