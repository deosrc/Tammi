@inherits LayoutComponentBase
@using Deosrc.Tammi.Core.Workspaces
@using Deosrc.Tammi.UI.Visualiser
@implements IDisposable
@inject WorkspaceTabsKeeper TabsKeeper
@inject NavigationManager Navigation
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceOpenRequests OpenRequests

<div class="app">
    <header class="app-bar">
        <span class="app-name">@AppInfo.Name</span>
        <TabStrip />
    </header>
    <main class="app-content">
        @Body
    </main>
    <UsageFooter />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        OpenRequests.Requested += OnOpenRequested;
        TabsKeeper.SetActive(ActiveWorkspaceId());

        // Opens the tabs from last time, once per app run. The app starts on Home, so the tab that was shown
        // is shown again, unless the app was started on another page.
        var shown = await TabsKeeper.RestoreAsync();
        if (shown is not null && Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') == AppRoutes.Home)
        {
            Navigation.NavigateTo(AppRoutes.Workspace(shown));
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        OpenRequests.Requested -= OnOpenRequested;
    }

    // Opens the workspace in a tab, or shows its tab if it's already open, as Home does.
    private void OnOpenRequested(string workspaceId) => _ = InvokeAsync(async () =>
    {
        if (await WorkspaceStore.FindAsync(workspaceId) is { } listing)
        {
            WorkspaceTabs.Open(listing.Id, listing.Name);
            Navigation.NavigateTo(AppRoutes.Workspace(listing.Id));
        }
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        TabsKeeper.SetActive(ActiveWorkspaceId());

    private string? ActiveWorkspaceId()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        return AppRoutes.WorkspaceIdOf(end < 0 ? path : path[..end]);
    }
}
