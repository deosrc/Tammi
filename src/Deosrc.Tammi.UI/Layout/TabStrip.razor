@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceAgents Agents
@inject UsageTabState UsageTabState
@inject Deosrc.Tammi.UI.Workspaces.EditWorkspaceSessions EditSessions
@inject NewWorkspaceTabState NewWorkspaceTabState
@inject WorkspaceGitGraphs GitGraphs
@inject Deosrc.Tammi.Core.Terminals.WorkspaceTerminals Terminals
@inject NavigationManager Navigation
@inject Deosrc.Tammi.UI.Workspaces.WorkspaceViewState ViewState

<nav class="tab-strip" aria-label="Main">
    <a class="tab home-tab @ActiveClass(AppRoutes.Home)" href="@AppRoutes.Home" title="Home" aria-label="Home"
       aria-current="@AriaCurrent(AppRoutes.Home)">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9v11a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9" />
        </svg>
    </a>

    <a class="tab home-tab @ActiveClass(AppRoutes.Repositories)" href="@AppRoutes.Repositories" title="Repositories"
       aria-label="Repositories" aria-current="@AriaCurrent(AppRoutes.Repositories)">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="6" cy="5" r="2" />
            <circle cx="6" cy="19" r="2" />
            <circle cx="18" cy="9" r="2" />
            <path d="M6 7v10M18 11c0 4-12 2-12 6" />
        </svg>
    </a>

    @* Tabs are in the order they were opened, whatever they are: a new one is always added at the end. *@
    @foreach (var key in OrderedKeys())
    {
        @if (key.StartsWith(WorkspaceKey, StringComparison.Ordinal))
        {
            var tab = WorkspaceTabs.Tabs.First(t => WorkspaceKey + t.WorkspaceId == key);
            // Returns to the edit flow if the workspace has one in progress.
            var route = EditSessions.Find(tab.WorkspaceId) is null
                ? ViewState.RouteOf(tab.WorkspaceId)
                : AppRoutes.EditWorkspace(tab.WorkspaceId);
            var shown = IsWorkspaceShown(tab.WorkspaceId);
            <div class="tab workspace-tab @(shown ? "active" : null)" @key="key">
                <a class="tab-label" href="@route" title="@tab.Name" aria-current="@(shown ? "page" : null)">
                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                    </svg>
                    <span class="tab-label-text">@tab.Name</span>
                    @* The state of the workspace's agents that most needs the user, if it has any. *@
                    @if (AgentStates.Summarise(Agents.For(tab.WorkspaceId).Select(agent => agent.State)) is { } agentState)
                    {
                        <AgentStateIndicator State="agentState" />
                    }
                </a>
                <button type="button" class="tab-close" title="Close @tab.Name" aria-label="Close @tab.Name"
                        @onclick="() => Close(tab)">
                    &times;
                </button>
            </div>
        }
        else if (key.StartsWith(GraphKey, StringComparison.Ordinal))
        {
            var graph = GitGraphs.StandaloneGraphs().First(g => GraphKey + g.Path == key);
            var graphRoute = ViewState.RepositoryRouteOf(graph.Path);
            var graphShown = IsRepositoryShown(graph.Path);
            <div class="tab workspace-tab @(graphShown ? "active" : null)" @key="key">
                <a class="tab-label" href="@graphRoute" title="@graph.Path" aria-current="@(graphShown ? "page" : null)">
                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="6" cy="5" r="2" />
                        <circle cx="6" cy="19" r="2" />
                        <circle cx="18" cy="9" r="2" />
                        <path d="M6 7v10M18 11c0 4-12 2-12 6" />
                    </svg>
                    <span class="tab-label-text">@graph.Name</span>
                    @* The state of the agents in the tab that most needs the user, if it has any. *@
                    @if (AgentStates.Summarise(Agents.For(graph.WorkspaceId).Select(agent => agent.State)) is { } graphAgentState)
                    {
                        <AgentStateIndicator State="graphAgentState" />
                    }
                </a>
                <button type="button" class="tab-close" title="Close @graph.Name" aria-label="Close @graph.Name"
                        @onclick="() => CloseRepositoryGraph(graph)">
                    &times;
                </button>
            </div>
        }
        else if (key == NewWorkspaceKey)
        {
            <div class="tab workspace-tab @ActiveClass(AppRoutes.NewWorkspace)" @key="key">
                <a class="tab-label" href="@AppRoutes.NewWorkspace" title="New workspace"
                   aria-current="@AriaCurrent(AppRoutes.NewWorkspace)">
                    <span class="tab-label-text">New workspace</span>
                </a>
                <button type="button" class="tab-close" title="Close New workspace" aria-label="Close New workspace"
                        @onclick="CloseNewWorkspace">
                    &times;
                </button>
            </div>
        }
        else if (key == UsageKey)
        {
            <div class="tab workspace-tab @ActiveClass(AppRoutes.Usage)" @key="key">
                <a class="tab-label" href="@AppRoutes.Usage" title="AI usage" aria-current="@AriaCurrent(AppRoutes.Usage)">
                    <span class="tab-label-text">AI usage</span>
                </a>
                <button type="button" class="tab-close" title="Close AI usage" aria-label="Close AI usage"
                        @onclick="CloseUsage">
                    &times;
                </button>
            </div>
        }
    }
</nav>

<a class="tab settings-tab @(IsInSettings ? "active" : null)" href="@AppRoutes.Settings" title="Settings"
   aria-label="Settings" aria-current="@(IsInSettings ? "page" : null)">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="6.5" />
        <circle cx="12" cy="12" r="2.5" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" stroke-width="3" />
    </svg>
</a>

@code {
    private string _currentPath = AppRoutes.Home;

    protected override void OnInitialized()
    {
        _currentPath = CurrentPath();
        WorkspaceTabs.Changed += OnTabsChanged;
        Agents.Changed += OnAgentsChanged;
        UsageTabState.Changed += OnTabsChanged;
        NewWorkspaceTabState.Changed += OnTabsChanged;
        EditSessions.Changed += OnTabsChanged;
        GitGraphs.Changed += OnGraphsChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        WorkspaceTabs.Changed -= OnTabsChanged;
        Agents.Changed -= OnAgentsChanged;
        UsageTabState.Changed -= OnTabsChanged;
        NewWorkspaceTabState.Changed -= OnTabsChanged;
        EditSessions.Changed -= OnTabsChanged;
        GitGraphs.Changed -= OnGraphsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void Close(WorkspaceTab tab)
    {
        var wasShown = IsWorkspaceShown(tab.WorkspaceId);
        var next = WorkspaceTabs.Close(tab.WorkspaceId);
        if (wasShown)
        {
            Navigation.NavigateTo(next is null ? AppRoutes.Home : ViewState.RouteOf(next.WorkspaceId));
        }
    }

    private const string WorkspaceKey = "workspace:";
    private const string GraphKey = "git:";
    private const string NewWorkspaceKey = "new-workspace";
    private const string UsageKey = "usage";

    // The open tabs' keys, in the order they were opened.
    private readonly List<string> _order = [];

    private List<string> OrderedKeys()
    {
        var open = WorkspaceTabs.Tabs.Select(tab => WorkspaceKey + tab.WorkspaceId)
            .Concat(GitGraphs.StandaloneGraphs().Select(graph => GraphKey + graph.Path))
            .Concat(NewWorkspaceTabState.IsOpen ? [NewWorkspaceKey] : [])
            .Concat(UsageTabState.IsOpen ? [UsageKey] : [])
            .ToList();
        _order.RemoveAll(key => !open.Contains(key));
        _order.AddRange(open.Where(key => !_order.Contains(key)));
        return [.. _order];
    }

    private void CloseRepositoryGraph(WorkspaceGitGraph graph)
    {
        var wasShown = IsRepositoryShown(graph.Path);
        // Closes everything in the tab: its graphs, and the terminals, which end their shells.
        GitGraphs.CloseAll(graph.WorkspaceId);
        _ = Terminals.CloseAllAsync(graph.WorkspaceId);
        _ = Agents.CloseAllAsync(graph.WorkspaceId);
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Repositories);
        }
    }

    private void CloseNewWorkspace()
    {
        var wasShown = IsCurrent(AppRoutes.NewWorkspace);
        NewWorkspaceTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private void CloseUsage()
    {
        var wasShown = IsCurrent(AppRoutes.Usage);
        UsageTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private bool IsInSettings =>
        IsCurrent(AppRoutes.Settings) || _currentPath.StartsWith(AppRoutes.Settings + "/", StringComparison.Ordinal);

    private bool IsCurrent(string route) => string.Equals(_currentPath, route, StringComparison.Ordinal);

    // A repository's tab also shows its secondary tabs.
    private bool IsRepositoryShown(string repositoryPath) => AppRoutes.RepositoryGitPathOf(_currentPath) == repositoryPath;

    // A workspace's tab also shows its edit flow.
    private bool IsWorkspaceShown(string workspaceId) => AppRoutes.WorkspaceIdOf(_currentPath) == workspaceId;

    private string? ActiveClass(string route) => IsCurrent(route) ? "active" : null;

    private string? AriaCurrent(string route) => IsCurrent(route) ? "page" : null;

    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        return (end < 0 ? path : path[..end]).TrimEnd('/');
    }

    private void OnGraphsChanged(string id) => InvokeAsync(StateHasChanged);

    private void OnTabsChanged() => InvokeAsync(StateHasChanged);

    // Raised on any thread, for any workspace.
    private void OnAgentsChanged(string workspaceId) => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = CurrentPath();
        InvokeAsync(StateHasChanged);
    }
}
