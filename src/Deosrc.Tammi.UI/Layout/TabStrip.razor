@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceAgents Agents
@inject UsageTabState UsageTabState
@inject Deosrc.Tammi.UI.Workspaces.EditWorkspaceSessions EditSessions
@inject NewWorkspaceTabState NewWorkspaceTabState
@inject NavigationManager Navigation

<nav class="tab-strip" aria-label="Main">
    <a class="tab home-tab @ActiveClass(AppRoutes.Home)" href="@AppRoutes.Home" title="Home" aria-label="Home"
       aria-current="@AriaCurrent(AppRoutes.Home)">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9v11a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9" />
        </svg>
    </a>

    @foreach (var tab in WorkspaceTabs.Tabs)
    {
        // Returns to the edit flow if the workspace has one in progress.
        var route = EditSessions.Find(tab.WorkspaceId) is null
            ? AppRoutes.Workspace(tab.WorkspaceId)
            : AppRoutes.EditWorkspace(tab.WorkspaceId);
        var shown = IsWorkspaceShown(tab.WorkspaceId);
        <div class="tab workspace-tab @(shown ? "active" : null)" @key="tab.WorkspaceId">
            <a class="tab-label" href="@route" title="@tab.Name" aria-current="@(shown ? "page" : null)">
                <span class="tab-label-text">@tab.Name</span>
                @* The state of the workspace's agents that most needs the user, if it has any. *@
                @if (AgentStates.Summarise(Agents.For(tab.WorkspaceId).Select(agent => agent.State)) is { } agentState)
                {
                    <AgentStateIndicator State="agentState" />
                }
            </a>
            <button type="button" class="tab-close" title="Close @tab.Name" aria-label="Close @tab.Name"
                    @onclick="() => Close(tab)">
                &times;
            </button>
        </div>
    }

    @if (NewWorkspaceTabState.IsOpen)
    {
        <div class="tab workspace-tab @ActiveClass(AppRoutes.NewWorkspace)">
            <a class="tab-label" href="@AppRoutes.NewWorkspace" title="New workspace"
               aria-current="@AriaCurrent(AppRoutes.NewWorkspace)">
                <span class="tab-label-text">New workspace</span>
            </a>
            <button type="button" class="tab-close" title="Close New workspace" aria-label="Close New workspace"
                    @onclick="CloseNewWorkspace">
                &times;
            </button>
        </div>
    }

    @if (UsageTabState.IsOpen)
    {
        <div class="tab workspace-tab @ActiveClass(AppRoutes.Usage)">
            <a class="tab-label" href="@AppRoutes.Usage" title="AI usage" aria-current="@AriaCurrent(AppRoutes.Usage)">
                <span class="tab-label-text">AI usage</span>
            </a>
            <button type="button" class="tab-close" title="Close AI usage" aria-label="Close AI usage"
                    @onclick="CloseUsage">
                &times;
            </button>
        </div>
    }
</nav>

<a class="tab settings-tab @(IsInSettings ? "active" : null)" href="@AppRoutes.Settings" title="Settings"
   aria-label="Settings" aria-current="@(IsInSettings ? "page" : null)">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="6.5" />
        <circle cx="12" cy="12" r="2.5" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" stroke-width="3" />
    </svg>
</a>

@code {
    private string _currentPath = AppRoutes.Home;

    protected override void OnInitialized()
    {
        _currentPath = CurrentPath();
        WorkspaceTabs.Changed += OnTabsChanged;
        Agents.Changed += OnAgentsChanged;
        UsageTabState.Changed += OnTabsChanged;
        NewWorkspaceTabState.Changed += OnTabsChanged;
        EditSessions.Changed += OnTabsChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        WorkspaceTabs.Changed -= OnTabsChanged;
        Agents.Changed -= OnAgentsChanged;
        UsageTabState.Changed -= OnTabsChanged;
        NewWorkspaceTabState.Changed -= OnTabsChanged;
        EditSessions.Changed -= OnTabsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void Close(WorkspaceTab tab)
    {
        var wasShown = IsWorkspaceShown(tab.WorkspaceId);
        var next = WorkspaceTabs.Close(tab.WorkspaceId);
        if (wasShown)
        {
            Navigation.NavigateTo(next is null ? AppRoutes.Home : AppRoutes.Workspace(next.WorkspaceId));
        }
    }

    private void CloseNewWorkspace()
    {
        var wasShown = IsCurrent(AppRoutes.NewWorkspace);
        NewWorkspaceTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private void CloseUsage()
    {
        var wasShown = IsCurrent(AppRoutes.Usage);
        UsageTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private bool IsInSettings =>
        IsCurrent(AppRoutes.Settings) || _currentPath.StartsWith(AppRoutes.Settings + "/", StringComparison.Ordinal);

    private bool IsCurrent(string route) => string.Equals(_currentPath, route, StringComparison.Ordinal);

    // A workspace's tab also shows its edit flow.
    private bool IsWorkspaceShown(string workspaceId) => AppRoutes.WorkspaceIdOf(_currentPath) == workspaceId;

    private string? ActiveClass(string route) => IsCurrent(route) ? "active" : null;

    private string? AriaCurrent(string route) => IsCurrent(route) ? "page" : null;

    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        return (end < 0 ? path : path[..end]).TrimEnd('/');
    }

    private void OnTabsChanged() => InvokeAsync(StateHasChanged);

    // Raised on any thread, for any workspace.
    private void OnAgentsChanged(string workspaceId) => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = CurrentPath();
        InvokeAsync(StateHasChanged);
    }
}
