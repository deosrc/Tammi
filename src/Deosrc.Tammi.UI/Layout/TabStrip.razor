@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceAgents Agents
@inject UsageTabState UsageTabState
@inject Deosrc.Tammi.UI.Workspaces.EditWorkspaceSessions EditSessions
@inject NewWorkspaceTabState NewWorkspaceTabState
@inject WorkspaceGitGraphs GitGraphs
@inject Deosrc.Tammi.Core.Terminals.WorkspaceTerminals Terminals
@inject MainTabOrder TabOrder
@inject NavigationManager Navigation
@inject Deosrc.Tammi.UI.Workspaces.WorkspaceViewState ViewState

@* The app's main tabs: Home and Repositories, then a tab for each workspace, repository and flow that is open, in the
   order they were opened, and Settings at the far end. *@
<TabBar Class="app-bar-tabs" AriaLabel="Main" FixedItems="FixedItems" Items="OpenItems" TrailingItems="SettingsItems"
        OnClose="CloseAsync" />

@code {
    private string _currentPath = AppRoutes.Home;

    protected override void OnInitialized()
    {
        _currentPath = CurrentPath();
        WorkspaceTabs.Changed += OnTabsChanged;
        Agents.Changed += OnAgentsChanged;
        UsageTabState.Changed += OnTabsChanged;
        NewWorkspaceTabState.Changed += OnTabsChanged;
        EditSessions.Changed += OnTabsChanged;
        GitGraphs.Changed += OnGraphsChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        WorkspaceTabs.Changed -= OnTabsChanged;
        Agents.Changed -= OnAgentsChanged;
        UsageTabState.Changed -= OnTabsChanged;
        NewWorkspaceTabState.Changed -= OnTabsChanged;
        EditSessions.Changed -= OnTabsChanged;
        GitGraphs.Changed -= OnGraphsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static RenderFragment IconOf(Microsoft.FluentUI.AspNetCore.Components.Icon icon) =>
        builder =>
        {
            builder.OpenComponent<FluentIcon<Microsoft.FluentUI.AspNetCore.Components.Icon>>(0);
            builder.AddAttribute(1, "Value", icon);
            builder.CloseComponent();
        };

    private IReadOnlyList<TabBarItem> FixedItems =>
    [
        new("home", AppRoutes.Home, "Home", Icon: IconOf(new Icons.Regular.Size20.Home()), Active: IsCurrent(AppRoutes.Home)),
        new("repositories", AppRoutes.Repositories, "Repositories", Icon: IconOf(new Icons.Regular.Size20.BranchFork()),
            Active: IsCurrent(AppRoutes.Repositories)),
    ];

    private IReadOnlyList<TabBarItem> SettingsItems =>
    [
        new("settings", AppRoutes.Settings, "Settings", Icon: IconOf(new Icons.Regular.Size20.Settings()), Active: IsInSettings),
    ];

    // The state of the agents in a tab that most needs the user, if it has any that are running or need attention.
    private RenderFragment? AgentIndicatorOf(string workspaceId) =>
        AgentStates.Summarise(Agents.For(workspaceId).Select(agent => agent.State)) is { } state
            ? builder =>
            {
                builder.OpenComponent<AgentStateIndicator>(0);
                builder.AddAttribute(1, "State", state);
                builder.CloseComponent();
            }
            : null;

    private IReadOnlyList<TabBarItem> OpenItems
    {
        get
        {
            var items = new List<TabBarItem>();
            foreach (var key in OrderedKeys())
            {
                if (MainTabOrder.IsWorkspaceKey(key))
                {
                    var tab = WorkspaceTabs.Tabs.First(t => MainTabOrder.WorkspaceKey(t.WorkspaceId) == key);
                    // Returns to the edit flow if the workspace has one in progress.
                    var route = EditSessions.Find(tab.WorkspaceId) is null
                        ? ViewState.RouteOf(tab.WorkspaceId)
                        : AppRoutes.EditWorkspace(tab.WorkspaceId);
                    items.Add(new(key, route, tab.Name, tab.Name, IconOf(new Icons.Regular.Size16.Folder()),
                        AgentIndicatorOf(tab.WorkspaceId), IsWorkspaceShown(tab.WorkspaceId)));
                }
                else if (MainTabOrder.IsRepositoryKey(key))
                {
                    var graph = GitGraphs.StandaloneGraphs().First(g => MainTabOrder.RepositoryKey(g.Path) == key);
                    items.Add(new(key, ViewState.RepositoryRouteOf(graph.Path), graph.Path, graph.Name,
                        IconOf(new Icons.Regular.Size16.BranchFork()), AgentIndicatorOf(graph.WorkspaceId),
                        IsRepositoryShown(graph.Path)));
                }
                else if (key == MainTabOrder.NewWorkspaceKey)
                {
                    items.Add(new(key, AppRoutes.NewWorkspace, "New workspace", "New workspace",
                        Active: IsCurrent(AppRoutes.NewWorkspace)));
                }
                else if (key == MainTabOrder.UsageKey)
                {
                    items.Add(new(key, AppRoutes.Usage, "AI Usage", "AI Usage", Active: IsCurrent(AppRoutes.Usage)));
                }
            }

            return items;
        }
    }

    private void CloseAsync(TabBarItem item)
    {
        if (MainTabOrder.IsWorkspaceKey(item.Key))
        {
            Close(WorkspaceTabs.Tabs.First(t => MainTabOrder.WorkspaceKey(t.WorkspaceId) == item.Key));
        }
        else if (MainTabOrder.IsRepositoryKey(item.Key))
        {
            CloseRepositoryGraph(GitGraphs.StandaloneGraphs().First(g => MainTabOrder.RepositoryKey(g.Path) == item.Key));
        }
        else if (item.Key == MainTabOrder.NewWorkspaceKey)
        {
            CloseNewWorkspace();
        }
        else if (item.Key == MainTabOrder.UsageKey)
        {
            CloseUsage();
        }
    }

    private void Close(WorkspaceTab tab)
    {
        var wasShown = IsWorkspaceShown(tab.WorkspaceId);
        var next = WorkspaceTabs.Close(tab.WorkspaceId);
        if (wasShown)
        {
            Navigation.NavigateTo(next is null ? AppRoutes.Home : ViewState.RouteOf(next.WorkspaceId));
        }
    }

    // The open tabs' keys, in the order they were opened (or, after a restart, the order they were saved in).
    private IReadOnlyList<string> OrderedKeys()
    {
        var open = WorkspaceTabs.Tabs.Select(tab => MainTabOrder.WorkspaceKey(tab.WorkspaceId))
            .Concat(GitGraphs.StandaloneGraphs().Select(graph => MainTabOrder.RepositoryKey(graph.Path)))
            .Concat(NewWorkspaceTabState.IsOpen ? [MainTabOrder.NewWorkspaceKey] : [])
            .Concat(UsageTabState.IsOpen ? [MainTabOrder.UsageKey] : [])
            .ToList();
        return TabOrder.Sync(open);
    }

    private void CloseRepositoryGraph(WorkspaceGitGraph graph)
    {
        var wasShown = IsRepositoryShown(graph.Path);
        // Closes everything in the tab: its graphs, and the terminals, which end their shells.
        GitGraphs.CloseAll(graph.WorkspaceId);
        _ = Terminals.CloseAllAsync(graph.WorkspaceId);
        _ = Agents.CloseAllAsync(graph.WorkspaceId);
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Repositories);
        }
    }

    private void CloseNewWorkspace()
    {
        var wasShown = IsCurrent(AppRoutes.NewWorkspace);
        NewWorkspaceTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private void CloseUsage()
    {
        var wasShown = IsCurrent(AppRoutes.Usage);
        UsageTabState.Close();
        if (wasShown)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private bool IsInSettings =>
        IsCurrent(AppRoutes.Settings) || _currentPath.StartsWith(AppRoutes.Settings + "/", StringComparison.Ordinal);

    private bool IsCurrent(string route) => string.Equals(_currentPath, route, StringComparison.Ordinal);

    // A repository's tab also shows its secondary tabs.
    private bool IsRepositoryShown(string repositoryPath) => AppRoutes.RepositoryGitPathOf(_currentPath) == repositoryPath;

    // A workspace's tab also shows its edit flow.
    private bool IsWorkspaceShown(string workspaceId) => AppRoutes.WorkspaceIdOf(_currentPath) == workspaceId;

    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        return (end < 0 ? path : path[..end]).TrimEnd('/');
    }

    private void OnGraphsChanged(string id) => InvokeAsync(StateHasChanged);

    private void OnTabsChanged() => InvokeAsync(StateHasChanged);

    // Raised on any thread, for any workspace.
    private void OnAgentsChanged(string workspaceId) => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = CurrentPath();
        InvokeAsync(StateHasChanged);
    }
}
