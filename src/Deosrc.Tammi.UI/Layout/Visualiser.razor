@implements IAsyncDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Workspaces
@inject IJSRuntime JS
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceAgents Agents

@* Covers the app bar and the page, but not the footer. A proof of concept: workspaces are glowing nodes grouped by
   task source, and each agent is a particle emitter orbiting its workspace, busier the more it's working. *@
<div class="visualiser" role="region" aria-label="Visualiser">
    <canvas @ref="_canvas" class="visualiser-canvas"></canvas>
</div>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _visualiser;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Deosrc.Tammi.UI/Layout/Visualiser.razor.js");
        _visualiser = await _module.InvokeAsync<IJSObjectReference>("create", _canvas);
        if (_disposed)
        {
            return;
        }

        WorkspaceStore.Changed += OnChanged;
        Agents.Changed += OnAgentsChanged;
        await PushAsync();
    }

    private void OnChanged() => _ = InvokeAsync(PushAsync);

    private void OnAgentsChanged(string workspaceId) => OnChanged();

    // Sends the workspaces, with their source and agents, to the page. The animation then runs there by itself.
    private async Task PushAsync()
    {
        if (_disposed || _visualiser is null)
        {
            return;
        }

        var listings = await WorkspaceStore.ListAsync();
        var nodes = listings.Select(listing => new
        {
            id = listing.Id,
            name = listing.Name,
            source = listing.Workspace?.Tasks.FirstOrDefault()?.Source ?? "local",
            agents = Agents.For(listing.Id)
                .Select(agent => new { id = agent.Name, state = agent.State.ToString() })
                .ToArray(),
        });

        try
        {
            await _visualiser.InvokeVoidAsync("update", nodes);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        WorkspaceStore.Changed -= OnChanged;
        Agents.Changed -= OnAgentsChanged;
        try
        {
            if (_visualiser is not null)
            {
                await _visualiser.InvokeVoidAsync("dispose");
                await _visualiser.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
