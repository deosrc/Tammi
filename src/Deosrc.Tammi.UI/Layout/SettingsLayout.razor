@inherits LayoutComponentBase
@layout MainLayout
@using Deosrc.Tammi.Core.Settings
@inject ISettingsStore SettingsStore

<div class="settings">
    <div class="settings-nav">
        <FluentNav Width="100%" BackgroundColor="transparent" UseIcons="false" aria-label="Settings">
            @foreach (var settingsSection in AppRoutes.SettingsSections)
            {
                <FluentNavItem Href="@settingsSection.Route"
                               Match="@(settingsSection.Route == AppRoutes.Settings ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @settingsSection.Title
                </FluentNavItem>
            }
        </FluentNav>
    </div>
    <div class="settings-content page">
        @* Shown on every section until the settings are next saved. *@
        @if (SettingsStore.LoadProblem is { } loadProblem)
        {
            <p class="error"><CopyOnClick>@loadProblem</CopyOnClick></p>
        }
        @Body
    </div>
</div>
