@* Step 3 of the Create Workspace flow: choose Local Repositories from the Repository Catalogue, with each worktree's
   folder name, merge target and branch, and the default branch for all of them. *@
@implements IDisposable
@using Deosrc.Tammi.Core.Catalogue
@using Deosrc.Tammi.Core.Git
@inject IRepositoryCatalogue Catalogue
@inject IGitWorktreeService Worktrees

<div class="repository-picker">
    <section class="repository-picker-catalogue" aria-labelledby="catalogue-heading">
        <h3 id="catalogue-heading">Repository Catalogue</h3>
        <FluentTextInput Class="repository-filter" TextInputType="TextInputType.Search" aria-label="Filter repositories"
                         AutoComplete="off" Immediate="true" Width="100%" Placeholder="Filter by name or folder"
                         @bind-Value="_filter" />

        @if (_snapshot is null)
        {
            <p class="placeholder">Finding repositories…</p>
        }
        else if (_snapshot.Repositories.Count == 0)
        {
            <p class="placeholder">
                No local repositories found. Add a Monitored Folder or a repository in
                <FluentLink Href="@AppRoutes.SettingsRepositories">Settings › Repositories</FluentLink>.
            </p>
        }
        else if (FilteredRepositories.Count == 0)
        {
            <p class="placeholder">No repositories match.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var repository in FilteredRepositories)
                {
                    var chosen = Draft.ContainsRepository(repository);
                    @* The whole card toggles the repository, unless it's already in the workspace, so the checkbox ignores
                       the mouse, which reaches the card instead. It still works with the keyboard. *@
                    <CardListItem @key="repository.Path" Chosen="chosen"
                                  OnClick="() => Draft.IsExistingRepository(repository) ? Task.CompletedTask : Toggle(repository)">
                        <FluentCheckbox Class="task-checkbox" title="@repository.Path" Value="chosen"
                                        Disabled="@Draft.IsExistingRepository(repository)"
                                        ValueChanged="_ => Toggle(repository)">
                            <span class="task-choice-text">
                                <span class="repository-name">@repository.Name</span>
                                <span class="task-title repository-path">@DisplayPath(repository)</span>
                                @if (Draft.IsExistingRepository(repository))
                                {
                                    <FluentBadge Appearance="BadgeAppearance.Tint">In the workspace</FluentBadge>
                                }
                            </span>
                        </FluentCheckbox>
                    </CardListItem>
                }
            </ul>
        }
        @if (Catalogue.IsScanning && _snapshot is not null)
        {
            <p class="settings-help">Scanning for repositories…</p>
        }
    </section>

    <section class="repository-picker-chosen" aria-labelledby="chosen-repositories-heading">
        <h3 id="chosen-repositories-heading">
            @(Draft.IsEditing ? "Repositories to add" : "Chosen repositories") (@Draft.Repositories.Count)
        </h3>
        <div class="settings-field-group">
            <FluentTextInput Label="Default branch" AutoComplete="off" Spellcheck="false" Width="100%" Immediate="true"
                             Disabled="@Draft.IsBranchFixed" Value="@Draft.BranchName" ValueChanged="OnBranchChanged"
                             MessageCondition="FluentFieldCondition.Always"
                             MessageState="@(BranchProblem is null ? null : MessageState.Error)"
                             Message="@(BranchProblem
                                 ?? (Draft.IsBranchFixed
                                     ? "The workspace's branch. Added repositories use it unless you change their branch."
                                     : "Each repository uses it, unless you change its branch. " + (Draft.IsBranchNameEdited ? null : Draft.Tasks.Count == 1
                                         ? "Suggested from the task."
                                         : "Suggested from the workspace's name.")))" />
        </div>
        @if (Draft.ExistingRepositories.Count > 0)
        {
            <p class="settings-help">
                Already in the workspace: @string.Join(", ", Draft.ExistingRepositories.Select(existing => existing.FolderName))
            </p>
        }
        @if (Draft.Repositories.Count == 0)
        {
            <p class="placeholder">
                @(Draft.IsEditing
                    ? "No repositories to add. Each one you choose gets a worktree in the Workspace Folder."
                    : "No repositories chosen. Each one you choose gets a worktree in the Workspace Folder.")
            </p>
        }
        else
        {
            <ul class="chosen-repositories">
                @foreach (var (repository, index) in Draft.Repositories.Select((repository, index) => (repository, index)))
                {
                    var mergeTargetId = $"repository-base-{index}";
                    var branchId = $"repository-branch-{index}";
                    var baseProblem = BaseProblem(repository);
                    <li @key="repository.Repository.Path">
                        <FluentCard>
                            <div class="chosen-repository">
                                <div class="chosen-repository-heading">
                                    <span class="repository-name">@repository.Repository.Name</span>
                                    <span class="task-title repository-path" title="@repository.Repository.Path">
                                        @DisplayPath(repository.Repository)
                                    </span>
                                    @if (repository.ChosenForTasks.Count > 0)
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Tint"
                                                     title="Chosen because the task belongs to this repository">
                                            For @string.Join(", ", repository.ChosenForTasks.Select(task => task.Key))
                                        </FluentBadge>
                                    }
                                    <FluentButton Class="card-remove" Appearance="ButtonAppearance.Transparent"
                                                  Size="ButtonSize.Small" IconOnly="true"
                                                  IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                                  Title="@($"Remove {repository.Repository.Name}")"
                                                  aria-label="@($"Remove {repository.Repository.Name}")"
                                                  OnClick="() => Draft.RemoveRepository(repository.Repository)" />
                                </div>

                                <div class="chosen-repository-fields">
                                    <FluentTextInput Label="Folder" AutoComplete="off" Spellcheck="false" Width="100%"
                                                     Immediate="true" @bind-Value="repository.FolderName"
                                                     MessageCondition="FluentFieldCondition.Always"
                                                     MessageState="@(repository.FolderNameProblem is null ? null : MessageState.Error)"
                                                     Message="@repository.FolderNameProblem" />

                                    <FluentTextInput Label="Merge target" DataList="@($"{mergeTargetId}-options")"
                                                     AutoComplete="off" Spellcheck="false" Width="100%" Immediate="true"
                                                     Placeholder="@(repository.IsLoading ? "Fetching…" : null)"
                                                     @bind-Value="repository.MergeTarget"
                                                     MessageCondition="FluentFieldCondition.Always"
                                                     MessageState="@(baseProblem is not null ? MessageState.Error : repository.FetchProblem is not null ? MessageState.Warning : null)"
                                                     Message="@(baseProblem
                                                         ?? repository.FetchProblem
                                                         ?? (repository.IsLoading
                                                             ? $"Fetching {repository.Remote?.Name}…"
                                                             : repository.MergeTarget.Trim() == repository.DefaultBranch
                                                                 ? "The remote's default branch."
                                                                 : null))" />
                                    <datalist id="@($"{mergeTargetId}-options")">
                                        @foreach (var branch in repository.Branches)
                                        {
                                            <option value="@branch"></option>
                                        }
                                    </datalist>

                                    <FluentTextInput Label="Branch" DataList="@($"{branchId}-options")" AutoComplete="off"
                                                     Spellcheck="false" Width="100%" Immediate="true"
                                                     @bind-Value="repository.BranchName"
                                                     MessageCondition="FluentFieldCondition.Always"
                                                     MessageState="@(repository.BranchNameProblem is null ? null : MessageState.Error)"
                                                     Message="@(repository.BranchNameProblem
                                                         ?? (!repository.IsLoaded
                                                             ? "Checking the existing branches…"
                                                             : repository.BranchExists
                                                                 ? "The branch exists, so it will be reused."
                                                                 : "The branch doesn't exist, so it will be created from the merge target."))" />
                                    <datalist id="@($"{branchId}-options")">
                                        @foreach (var branch in repository.ExistingBranches)
                                        {
                                            <option value="@branch"></option>
                                        }
                                    </datalist>
                                </div>
                            </div>
                        </FluentCard>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    /// <summary>
    /// The draft whose repositories this chooses.
    /// </summary>
    [Parameter, EditorRequired]
    public WorkspaceDraft Draft { get; set; } = null!;

    /// <summary>
    /// Raised when a repository finishes loading, so the page can update what depends on it.
    /// </summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private readonly CancellationTokenSource _disposed = new();
    private RepositoryCatalogueSnapshot? _snapshot;
    private string _filter = "";
    private string? _gitBranchProblem;
    private int _branchCheck;

    private string? BranchProblem => Draft.BranchNameProblem ?? _gitBranchProblem;

    private IReadOnlyList<CatalogueRepository> FilteredRepositories
    {
        get
        {
            var filter = _filter.Trim();
            var repositories = _snapshot?.Repositories ?? [];
            return filter.Length == 0
                ? repositories
                : [.. repositories.Where(repository =>
                    repository.Path.Contains(filter, StringComparison.CurrentCultureIgnoreCase))];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Catalogue.Changed += OnCatalogueChanged;
        await CheckBranchAsync();
        try
        {
            _snapshot = await Catalogue.GetAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var added = Draft.ChooseTaskRepositories(_snapshot.Repositories);
        if (added.Count > 0)
        {
            StateHasChanged();
            await Task.WhenAll(added.Select(LoadAsync));
        }
    }

    public void Dispose()
    {
        Catalogue.Changed -= OnCatalogueChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private void OnCatalogueChanged() => _ = InvokeAsync(() =>
    {
        if (!Catalogue.IsScanning)
        {
            _snapshot = Catalogue.Current;
        }

        StateHasChanged();
    });

    /// <summary>
    /// A repository's path, short enough to tell same-named repositories apart: relative to its Monitored Folder, or
    /// with the home folder as <c>~</c>. The full path is in the tooltip.
    /// </summary>
    private static string DisplayPath(CatalogueRepository repository)
    {
        if (repository.MonitoredFolders is [var monitored, ..])
        {
            return Path.GetRelativePath(monitored, repository.Path);
        }

        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        return home.Length > 0 && repository.Path.StartsWith(home + Path.DirectorySeparatorChar, StringComparison.Ordinal)
            ? "~" + repository.Path[home.Length..]
            : repository.Path;
    }

    private static string? BaseProblem(WorkspaceDraftRepository repository) =>
        repository.IsLoading || repository.MergeTarget.Trim().Length > 0
            ? null
            : repository.DefaultBranchProblem ?? "Choose the branch to start from.";

    private async Task Toggle(CatalogueRepository repository)
    {
        if (Draft.RemoveRepository(repository))
        {
            return;
        }

        if (Draft.AddRepository(repository) is not { } chosen)
        {
            return;
        }

        await LoadAsync(chosen);
    }

    /// <summary>
    /// Fetches a chosen repository and finds its merge target.
    /// </summary>
    private async Task LoadAsync(WorkspaceDraftRepository repository)
    {
        try
        {
            await repository.LoadAsync(Worktrees, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await Changed.InvokeAsync();
    }

    private async Task OnBranchChanged(string? branch)
    {
        Draft.BranchName = branch ?? "";
        await CheckBranchAsync();
    }

    /// <summary>
    /// Asks git whether the branch name is valid. A check that's overtaken by newer input is ignored.
    /// </summary>
    private async Task CheckBranchAsync()
    {
        var check = ++_branchCheck;
        var name = Draft.BranchName.Trim();
        if (name.Length == 0)
        {
            _gitBranchProblem = null;
            return;
        }

        bool valid;
        try
        {
            valid = await Worktrees.IsValidBranchNameAsync(name, _disposed.Token);
        }
        catch (Exception ex) when (ex is GitException or OperationCanceledException)
        {
            return;
        }

        if (check == _branchCheck)
        {
            _gitBranchProblem = valid ? null : $"'{name}' isn't a valid git branch name.";
        }
    }
}
