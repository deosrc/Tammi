@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@implements IDisposable
@inject ISettingsStore Settings
@inject GitGraphViewOptions Options
@* A file's diff, shown in place of the git graph: the file's path and a close button that goes back to the graph,
   then the changed lines, unified or side by side as the settings say. Side by side falls back to unified when the
   space is too narrow for two columns. *@

<section class="git-diff" aria-label="File diff">
    <header class="git-diff-header">
        <span class="git-diff-title" title="@Title">@Title</span>
        <span class="git-diff-source">@SourceText</span>
        <select class="git-diff-whitespace" aria-label="Whitespace" title="Whitespace"
                value="@Current.DiffWhitespace" @onchange="OnWhitespaceChanged">
            <option value="@GitDiffWhitespace.Show">Show whitespace changes</option>
            <option value="@GitDiffWhitespace.IgnoreAmount">Ignore changes in amount</option>
            <option value="@GitDiffWhitespace.IgnoreAll">Ignore all whitespace</option>
            <option value="@GitDiffWhitespace.IgnoreAtEol">Ignore at end of lines</option>
        </select>
        <div class="segmented segmented-small" role="group" aria-label="Layout">
            <button type="button" class="segmented-option" title="Unified" aria-label="Unified"
                    aria-pressed="@(Current.DiffLayout == GitDiffLayout.Unified ? "true" : "false")"
                    @onclick="() => Options.SetDiffLayoutAsync(GitDiffLayout.Unified)">Unified</button>
            <button type="button" class="segmented-option" title="Side by side" aria-label="Side by side"
                    aria-pressed="@(Current.DiffLayout == GitDiffLayout.SideBySide ? "true" : "false")"
                    @onclick="() => Options.SetDiffLayoutAsync(GitDiffLayout.SideBySide)">Side by side</button>
        </div>
        <button type="button" class="button button-secondary button-icon git-diff-close" title="Close the diff"
                aria-label="Close the diff" @onclick="Graph.CloseDiff">
            <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12M18 6 6 18" />
            </svg>
        </button>
    </header>

    <div class="git-diff-body">
        @if (Graph.DiffProblem is { } problem)
        {
            <p class="error">Couldn't read the diff. @problem</p>
        }
        else if (Graph.ActiveDiff is not { } diff)
        {
            <p class="placeholder">Reading the diff…</p>
        }
        else if (diff.IsBinary)
        {
            <p class="placeholder">This is a binary file, so there's no text to compare.</p>
        }
        else if (diff.Hunks.Count == 0)
        {
            <p class="placeholder">No changes to show.</p>
        }
        else
        {
            @if (Current.DiffLayout == GitDiffLayout.SideBySide && !IsSubmodule(diff))
            {
                <table class="git-diff-table git-diff-sbs" style="@TabStyle">
                    <colgroup><col class="git-diff-col-number" /><col /><col class="git-diff-col-number" /><col /></colgroup>
                    <tbody>
                        @foreach (var hunk in diff.Hunks)
                        {
                            <tr class="git-diff-hunk"><td colspan="4">@hunk.Header</td></tr>
                            @foreach (var row in SideBySideAligner.Align(hunk))
                            {
                                @if (row.IsNote)
                                {
                                    <tr class="git-diff-line git-diff-note"><td colspan="4" class="git-diff-text">@((row.Left ?? row.Right)!.Text)</td></tr>
                                }
                                else
                                {
                                    <tr class="git-diff-line">
                                        <td class="git-diff-number git-diff-side-@Side(row.Left)">@row.Left?.OldNumber</td>
                                        <td class="git-diff-text git-diff-half git-diff-side-@Side(row.Left)">@row.Left?.Text</td>
                                        <td class="git-diff-number git-diff-side-@Side(row.Right)">@row.Right?.NewNumber</td>
                                        <td class="git-diff-text git-diff-half git-diff-side-@Side(row.Right)">@row.Right?.Text</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }
            @* Always there for a unified diff, and for a side by side one it's what shows when the space is too narrow. *@
            <table class="@(Current.DiffLayout == GitDiffLayout.SideBySide ? "git-diff-table git-diff-narrow" : "git-diff-table")" style="@TabStyle">
                <tbody>
                    @foreach (var hunk in diff.Hunks)
                    {
                        <tr class="git-diff-hunk"><td colspan="3">@hunk.Header</td></tr>
                        @foreach (var line in hunk.Lines)
                        {
                            <tr class="git-diff-line git-diff-@line.Kind.ToString().ToLowerInvariant()">
                                <td class="git-diff-number">@line.OldNumber</td>
                                <td class="git-diff-number">@line.NewNumber</td>
                                <td class="git-diff-text"><span class="git-diff-mark">@Mark(line.Kind)</span>@line.Text</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (diff.IsTruncated)
            {
                <p class="placeholder">The diff is too large to show in full.</p>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public WorkspaceGitGraph Graph { get; set; } = null!;

    private GitSettings Current => Settings.Current.Git;

    private string TabStyle => $"tab-size: {Current.DiffTabWidth}";

    private GitDiffOptions _shownOptions = new();

    protected override void OnInitialized()
    {
        _shownOptions = Current.DiffOptions;
        Settings.Changed += OnSettingsChanged;
    }

    public void Dispose() => Settings.Changed -= OnSettingsChanged;

    // The layout and tab width are only drawn differently. The whitespace and context lines need the diff read again.
    private void OnSettingsChanged() => _ = InvokeAsync(async () =>
    {
        GitDiffOptions options = Current.DiffOptions;
        if (options != _shownOptions)
        {
            _shownOptions = options;
            await Graph.ReloadDiffAsync();
        }

        StateHasChanged();
    });

    private Task OnWhitespaceChanged(ChangeEventArgs e) =>
        Enum.TryParse(e.Value?.ToString(), out GitDiffWhitespace whitespace)
            ? Options.SetDiffWhitespaceAsync(whitespace)
            : Task.CompletedTask;

    // A submodule's diff is the old and new commit, which the layout doesn't apply to.
    private static bool IsSubmodule(FileDiff diff) =>
        diff.Hunks.Count == 1 && diff.Hunks[0].Header.StartsWith("@@ Submodule ", StringComparison.Ordinal);

    private static string Side(DiffLine? line) => line is null ? "blank" : line.Kind.ToString().ToLowerInvariant();

    private string Title => Graph.DiffTarget?.Path ?? "";

    private string SourceText => Graph.DiffTarget?.Source switch
    {
        GitDiffSource.Unstaged => "Unstaged changes",
        GitDiffSource.Staged => "Staged changes",
        _ => "Commit changes",
    };

    private static string Mark(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "+",
        DiffLineKind.Removed => "-",
        _ => " ",
    };
}
