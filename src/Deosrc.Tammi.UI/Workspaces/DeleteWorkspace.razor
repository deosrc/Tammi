@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Terminals
@inject WorkspaceDeleter Deleter
@inject WorkspaceTabs WorkspaceTabs
@inject WorkspaceTerminals Terminals
@inject WorkspaceAgents Agents
@inject WorkspaceGitGraphs GitGraphs
@inject WorkspaceHistoryTabs HistoryTabs
@inject WorkspaceTabRestorer TabRestorer

@* The Delete Workspace flow: check for work that would be lost, confirm, delete, then offer to delete the branches. *@
<div class="delete-workspace">
    @switch (_step)
    {
        case Step.Checking:
            <p class="placeholder">
                <FluentSpinner Size="SpinnerSize.Small" aria-label="Checking" />
                Checking for work that would be lost…
            </p>
            break;

        case Step.Failed:
            <FluentMessageBar Intent="MessageBarIntent.Error" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                <CopyOnClick>@_error</CopyOnClick>
            </FluentMessageBar>
            <div class="workspace-details-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="PlanAsync">Check again</FluentButton>
                <FluentButton OnClick="OnCancel">Cancel</FluentButton>
            </div>
            break;

        case Step.Confirm when _plan is { Scope: WorkspaceDeletionScope.IndexEntryOnly } plan:
            <p class="workspace-details-problem">@plan.Reason</p>
            <p>
                Its folder isn't this workspace's any more, so it's left alone. Deleting the workspace only removes it
                from the list of workspaces.
            </p>
            @TerminalsNotice
            <div class="workspace-details-actions">
                <FluentButton Class="danger-button" Appearance="ButtonAppearance.Primary" OnClick="DeleteAsync">Remove from list</FluentButton>
                <FluentButton OnClick="OnCancel">Cancel</FluentButton>
            </div>
            break;

        case Step.Confirm when _plan is { } plan:
            <p>@WorktreeDeletionText.DescribeRemoval(plan) You can choose which branches to delete next.</p>
            @TerminalsNotice
            @if (!plan.MetadataRead)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine" AllowDismiss="false">
                    The workspace's metadata can't be read, so its worktrees were found by looking in its folder.
                </FluentMessageBar>
            }
            @if (plan.CouldLoseWork)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                  AllowDismiss="false" Title="Work will be lost">
                    <p class="delete-workspace-lost">Deleting the workspace loses this work, which isn't committed and pushed anywhere else.</p>
                    <ul class="settings-list">
                        @foreach (var worktree in plan.Worktrees.Where(worktree => worktree.NeedsConfirmation))
                        {
                            <CardListItem>
                                <span class="settings-list-path">@worktree.FolderName</span>
                                <span class="settings-list-status">@WorktreeDeletionText.Describe(worktree)</span>
                            </CardListItem>
                        }
                        @foreach (var path in plan.OtherContent)
                        {
                            <CardListItem>
                                <span class="settings-list-path">@System.IO.Path.GetFileName(path)</span>
                                <span class="settings-list-status">Not a worktree</span>
                            </CardListItem>
                        }
                    </ul>
                </FluentMessageBar>
            }
            <div class="workspace-details-actions">
                <FluentButton Class="danger-button" Appearance="ButtonAppearance.Primary" OnClick="DeleteAsync">
                    @(plan.CouldLoseWork ? "Delete workspace and lose this work" : "Delete workspace")
                </FluentButton>
                <FluentButton OnClick="OnCancel">Cancel</FluentButton>
            </div>
            break;

        case Step.Deleting:
            <p class="placeholder">
                <FluentSpinner Size="SpinnerSize.Small" aria-label="Deleting" />
                Deleting the workspace…
            </p>
            break;

        case Step.Branches:
            <p>
                The workspace is deleted. Its @(_branches.Count == 1 ? "branch is" : "branches are") still in
                @(_branches.Count == 1 ? "its local repository" : "their local repositories"). Merged and pushed
                branches are selected, because deleting them loses no work.
            </p>
            @* The whole card toggles a branch, so the checkbox ignores the mouse, which reaches the card instead. *@
            <ul class="task-list">
                @foreach (var branch in _branches)
                {
                    var selected = _selected.Contains(branch);
                    <CardListItem @key="branch" Chosen="selected" OnClick="() => Select(branch, !selected)">
                        <FluentCheckbox Class="task-checkbox" Value="selected"
                                        ValueChanged="chosen => Select(branch, chosen)">
                            <span class="task-choice-text">
                                <span class="settings-list-path">@branch.Branch</span>
                                <span class="settings-list-status" title="@branch.LocalRepositoryPath">
                                    @WorktreeDeletionText.Describe(branch) · @System.IO.Path.GetFileName(branch.LocalRepositoryPath)
                                </span>
                            </span>
                        </FluentCheckbox>
                    </CardListItem>
                }
            </ul>
            <div class="workspace-details-actions">
                <FluentButton Class="danger-button" Appearance="ButtonAppearance.Primary" Disabled="@(_selected.Count == 0)"
                              OnClick="DeleteBranchesAsync">
                    Delete selected branches
                </FluentButton>
                <FluentButton OnClick="OnFinished">Keep all branches</FluentButton>
            </div>
            break;

        case Step.DeletingBranches:
            <p class="placeholder">
                <FluentSpinner Size="SpinnerSize.Small" aria-label="Deleting" />
                Deleting branches…
            </p>
            break;

        case Step.BranchesFailed:
            <p>The workspace is deleted, but some branches couldn't be deleted:</p>
            <ul class="settings-list">
                @foreach (var result in _failures)
                {
                    <CardListItem @key="result.Branch">
                        <span class="settings-list-path">@result.Branch.Branch</span>
                        <span class="error"><CopyOnClick>@result.Error</CopyOnClick></span>
                    </CardListItem>
                }
            </ul>
            <div class="workspace-details-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OnFinished">Done</FluentButton>
            </div>
            break;
    }
</div>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private bool _isDisposed;
    private Step _step = Step.Checking;
    private WorkspaceDeletionPlan? _plan;
    private string? _error;
    private List<WorkspaceBranch> _branches = [];
    private readonly HashSet<WorkspaceBranch> _selected = [];
    private IReadOnlyList<BranchDeletionResult> _failures = [];

    private enum Step
    {
        Checking,
        Failed,
        Confirm,
        Deleting,
        Branches,
        DeletingBranches,
        BranchesFailed,
    }

    /// <summary>
    /// The workspace to delete.
    /// </summary>
    [Parameter, EditorRequired]
    public string WorkspaceId { get; set; } = "";

    /// <summary>
    /// Called when the user cancels before anything is deleted.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Called once the workspace is deleted and the user is done with its branches.
    /// </summary>
    [Parameter]
    public EventCallback OnFinished { get; set; }

    protected override Task OnInitializedAsync() => PlanAsync();

    private RenderFragment? TerminalsNotice => (Terminals.For(WorkspaceId).Count, Agents.For(WorkspaceId).Count) switch
    {
        (0, 0) => null,
        (1, 0) => @<p>Its open terminal will be closed.</p>,
        (var terminals, 0) => @<p>Its @terminals open terminals will be closed.</p>,
        (0, 1) => @<p>Its open agent will be stopped and closed.</p>,
        (0, var agents) => @<p>Its @agents open agents will be stopped and closed.</p>,
        (var terminals, var agents) =>
            @<p>Its @Count(terminals, "open terminal") and @Count(agents, "agent") will be closed.</p>,
    };

    private static string Count(int count, string noun) => count == 1 ? $"{count} {noun}" : $"{count} {noun}s";

    public void Dispose()
    {
        _isDisposed = true;
        if (_step is Step.Branches or Step.BranchesFailed)
        {
            // The workspace is already deleted, so its tab has nothing left to show. Its branches are kept.
            WorkspaceTabs.Close(WorkspaceId);
        }

        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task PlanAsync()
    {
        _step = Step.Checking;
        try
        {
            _plan = await Deleter.PlanAsync(WorkspaceId, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Fail($"Couldn't check the workspace for work that would be lost. {ex.Message}");
            return;
        }

        if (_isDisposed)
        {
            return;
        }

        if (_plan is null)
        {
            // Already gone, e.g. deleted from another tab.
            await OnFinished.InvokeAsync();
            return;
        }

        _step = Step.Confirm;
    }

    private async Task DeleteAsync()
    {
        _step = Step.Deleting;
        IReadOnlyList<WorkspaceBranch> branches;
        try
        {
            // The terminals and agents end first, so no process is still using the folders being deleted, and the git
            // graphs close their repositories. Nothing here is cancelled if the flow is closed, e.g. by showing another
            // tab, so it doesn't stop half-way.
            TabRestorer.Forget(WorkspaceId);
            GitGraphs.CloseAll(WorkspaceId);
            HistoryTabs.CloseAll(WorkspaceId);
            await Task.WhenAll(Terminals.CloseAllAsync(WorkspaceId), Agents.CloseAllAsync(WorkspaceId));
            branches = await Deleter.DeleteAsync(_plan!, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Fail(ex is WorkspaceDeletionException ? ex.Message : $"Couldn't delete the workspace. {ex.Message}");
            return;
        }

        if (_isDisposed)
        {
            // Nothing is showing the flow any more, so its branches can't be offered. They're kept.
            WorkspaceTabs.Close(WorkspaceId);
            return;
        }

        if (branches.Count == 0)
        {
            await OnFinished.InvokeAsync();
            return;
        }

        _branches = [.. branches];
        _selected.Clear();
        _selected.UnionWith(branches.Where(branch => branch.SelectedByDefault));
        _step = Step.Branches;
    }

    private void Select(WorkspaceBranch branch, bool selected)
    {
        if (selected)
        {
            _selected.Add(branch);
        }
        else
        {
            _selected.Remove(branch);
        }
    }

    private async Task DeleteBranchesAsync()
    {
        _step = Step.DeletingBranches;
        var results = await Deleter.DeleteBranchesAsync(_branches.Where(_selected.Contains).ToList());
        if (_isDisposed)
        {
            WorkspaceTabs.Close(WorkspaceId);
            return;
        }

        _failures = [.. results.Where(result => !result.Succeeded)];
        if (_failures.Count == 0)
        {
            await OnFinished.InvokeAsync();
            return;
        }

        _step = Step.BranchesFailed;
    }

    private void Fail(string error)
    {
        _error = error;
        _step = Step.Failed;
    }
}
