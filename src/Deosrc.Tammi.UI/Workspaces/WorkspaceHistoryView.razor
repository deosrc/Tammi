@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Settings
@inject WorkspaceAgents Agents
@inject ISettingsStore SettingsStore

@* The History tab's content: a card for each of the workspace's Agent Sessions. Those running in one of its agents come
   first, highlighted with their state, and can be shown; then past ones, newest first, which can be resumed or
   forgotten. Each is named by the last title its agent set, if any, to tell them apart. *@
<div class="workspace-history">
    <h2>History</h2>
    @if (_error is not null)
    {
        <PanelMessage>@_error</PanelMessage>
    }
    @if (_problem is not null)
    {
        <PanelMessage Intent="MessageBarIntent.Warning"><CopyOnClick>@_problem</CopyOnClick></PanelMessage>
    }
    @if (!_loaded)
    {
        @* Not read yet. *@
    }
    else if (CurrentAgents.Count == 0 && PastSessions.Count == 0)
    {
        <p class="placeholder">No sessions yet. Agents' sessions show up here, to resume once they've closed.</p>
    }
    else
    {
        <ul class="agent-session-list">
            @foreach (var agent in CurrentAgents)
            {
                var tone = AgentStateText.CardTone(agent.State).ToString().ToLowerInvariant();
                <li class="agent-session agent-session-current agent-session-@tone" @key="agent">
                    <div class="agent-session-heading">
                        <AgentIcon Definition="agent.Agent.Definition" />
                        <div class="agent-session-name" title="@agent.WorkingDirectory">@agent.DisplayName</div>
                        <FluentBadge Class="agent-session-state" Appearance="BadgeAppearance.Tint"
                                     Color="AgentStateText.CardTone(agent.State).ToBadgeColor()">@AgentStateText.Label(agent.State)</FluentBadge>
                    </div>
                    <div class="agent-session-body">
                        <div class="agent-session-details">
                            <AgentSessionTimes CreatedAt="agent.SessionCreatedAt" LastStartedAt="agent.SessionStartedAt" />
                            @if (WorkspaceAgents.RepositoryFolderOf(Workspace, agent.WorkingDirectory) is { } folder)
                            {
                                <FluentBadge Class="agent-session-location" Appearance="BadgeAppearance.Tint" title="@agent.WorkingDirectory">@folder</FluentBadge>
                            }
                        </div>
                        <div class="agent-card-actions">
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary"
                                          OnClick="() => OnShow.InvokeAsync(agent)">Show</FluentButton>
                        </div>
                    </div>
                </li>
            }
            @foreach (var session in PastSessions)
            {
                var definition = session.FindDefinition(SettingsStore.Current.Agents.Definitions);
                var cantResume = CantResumeReason(session, definition);
                <li class="agent-session" @key="session.Id">
                    <div class="agent-session-heading">
                        @if (definition is not null)
                        {
                            <AgentIcon Definition="definition" />
                        }
                        <div class="agent-session-name" title="@session.WorkingDirectory">@(session.LastTitle ?? session.AgentName)</div>
                    </div>
                    <div class="agent-session-body">
                        <div class="agent-session-details">
                            <AgentSessionTimes CreatedAt="session.CreatedAt" LastStartedAt="session.LastStartedAt"
                                               LastEndedAt="session.LastEndedAt" />
                            @if (cantResume is not null)
                            {
                                <p class="agent-session-detail warning">@cantResume</p>
                            }
                            @if (WorkspaceAgents.RepositoryFolderOf(Workspace, session.WorkingDirectory) is { } folder)
                            {
                                <FluentBadge Class="agent-session-location" Appearance="BadgeAppearance.Tint" title="@session.WorkingDirectory">@folder</FluentBadge>
                            }
                        </div>
                        <div class="agent-card-actions">
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary"
                                          Disabled="@(cantResume is not null || _busy)"
                                          OnClick="() => ResumeAsync(session)">Resume</FluentButton>
                            <FluentButton Size="ButtonSize.Small" Disabled="@_busy"
                                          OnClick="() => ForgetAsync(session)">Forget</FluentButton>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private IReadOnlyList<AgentSession> _sessions = [];
    private string? _problem;
    private string? _error;
    private string? _loadedWorkspaceId;
    private bool _loaded;
    private bool _busy;

    // Counts loads, so a slow load doesn't replace a newer one's result.
    private int _loadCount;

    /// <summary>
    /// The workspace.
    /// </summary>
    [Parameter, EditorRequired]
    public Workspace Workspace { get; set; } = null!;

    /// <summary>
    /// Called with an agent just resumed, to show its tab.
    /// </summary>
    [Parameter]
    public EventCallback<WorkspaceAgent> OnShow { get; set; }

    // The workspace's running agents, in the order they started.
    private IReadOnlyList<WorkspaceAgent> CurrentAgents =>
        [.. Agents.For(Workspace.Id).Where(agent => !agent.HasExited)];

    // Sessions running in one of the workspace's agents are shown with the agents instead.
    private IReadOnlyList<AgentSession> PastSessions =>
        [.. _sessions.Where(session => !Agents.IsRunning(Workspace.Id, session.Id))
            .OrderByDescending(session => session.LastStartedAt)];

    protected override void OnInitialized() => Agents.Changed += OnAgentsChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedWorkspaceId != Workspace.Id)
        {
            _error = null;
            await LoadSessionsAsync();
        }
    }

    public void Dispose()
    {
        Agents.Changed -= OnAgentsChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private static string? CantResumeReason(AgentSession session, AgentDefinition? definition) =>
        definition switch
        {
            null => $"No agent is called \"{session.AgentName}\" now.",
            { CanResume: false } => $"{definition.Name} doesn't say how to resume sessions.",
            _ => null,
        };

    private async Task LoadSessionsAsync()
    {
        var load = ++_loadCount;
        var workspace = Workspace;
        var store = Agents.SessionsOf(workspace);
        IReadOnlyList<AgentSession> sessions;
        try
        {
            sessions = await store.ListAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (load == _loadCount)
        {
            _sessions = sessions;
            _problem = store.Problem;
            _loadedWorkspaceId = workspace.Id;
            _loaded = true;
        }
    }

    private async Task ResumeAsync(AgentSession session)
    {
        _error = null;
        _busy = true;
        try
        {
            await OnShow.InvokeAsync(await Agents.ResumeAsync(Workspace, session));
        }
        catch (Exception ex) when (ex is IOException or ArgumentException or InvalidOperationException
            or System.Runtime.InteropServices.ExternalException)
        {
            _error = $"Couldn't resume the session. {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ForgetAsync(AgentSession session)
    {
        _error = null;
        _busy = true;
        try
        {
            await Agents.SessionsOf(Workspace).ForgetAsync(session.Id);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _error = $"Couldn't forget the session. {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        await LoadSessionsAsync();
    }

    // Raised on a background thread, e.g. when an agent's state changes or its session is recorded.
    private void OnAgentsChanged(string workspaceId) => InvokeAsync(async () =>
    {
        if (_disposed.IsCancellationRequested || workspaceId != Workspace.Id)
        {
            return;
        }

        await LoadSessionsAsync();
        StateHasChanged();
    });
}
