@using Deosrc.Tammi.Core.Agents

@* An agent's state as an icon: a progress spinner while it works, and an icon for each other state (a dot while it's
   idle, or runs without finer detail). Needs input is in the warning colour, and Error in the danger colour. Shown on the
   agent's tab and its card in the side panel. *@
<span class="agent-state-indicator" title="@(Title ?? AgentStateText.Label(State))">
    @if (State == AgentState.Working)
    {
        <FluentSpinner Size="SpinnerSize.Tiny" role="progressbar" aria-label="Working" />
    }
    else if (State == AgentState.NeedsInput)
    {
        <FluentIcon Value="@(new Icons.Regular.Size16.Alert())" Color="Color.Warning" role="img" aria-label="Needs input" />
    }
    else if (State == AgentState.Error)
    {
        <FluentIcon Value="@(new Icons.Regular.Size16.ErrorCircle())" Color="Color.Error" role="img" aria-label="Error" />
    }
    else if (State == AgentState.Exited)
    {
        <FluentIcon Value="@(new Icons.Regular.Size16.RecordStop())" Color="Color.Disabled" role="img" aria-label="Exited" />
    }
    else
    {
        <StatusDot Tone="unknown" />
    }
</span>

@code {
    /// <summary>
    /// The state to show.
    /// </summary>
    [Parameter, EditorRequired]
    public AgentState State { get; set; }

    /// <summary>
    /// The tooltip, if it should say more than the state's name, e.g. which agent it is.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }
}
