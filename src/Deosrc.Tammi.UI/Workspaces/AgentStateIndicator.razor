@using Deosrc.Tammi.Core.Agents

@* An agent's state as an icon in the state's tone: a progress spinner while it works, and an icon for each other state
   except Idle and Running, which have none. Shown on the agent's tab and its card in the side panel. *@
<span class="agent-tab-state @AgentStateText.ToneClass(State)" title="@(Title ?? AgentStateText.Label(State))">
    @if (State == AgentState.Working)
    {
        <span class="spinner" role="progressbar" aria-label="Working"></span>
    }
    else if (State == AgentState.NeedsInput)
    {
        <svg class="icon icon-small" viewBox="0 0 24 24" role="img" aria-label="Needs input">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
        </svg>
    }
    else if (State == AgentState.Error)
    {
        <svg class="icon icon-small" viewBox="0 0 24 24" role="img" aria-label="Error">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5.5M12 16.5v.01" />
        </svg>
    }
    else if (State == AgentState.Exited)
    {
        <svg class="icon icon-small" viewBox="0 0 24 24" role="img" aria-label="Exited">
            <circle cx="12" cy="12" r="9" />
            <rect x="9" y="9" width="6" height="6" rx="1" />
        </svg>
    }
    @* Idle (waiting for its next prompt) and Running (no finer detail) have no icon: there's nothing to draw attention
       to. *@
</span>

@code {
    /// <summary>
    /// The state to show.
    /// </summary>
    [Parameter, EditorRequired]
    public AgentState State { get; set; }

    /// <summary>
    /// The tooltip, if it should say more than the state's name, e.g. which agent it is.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }
}
