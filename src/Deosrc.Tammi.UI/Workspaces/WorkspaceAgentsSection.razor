@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@inject WorkspaceAgents Agents

@* The body of the Workspace View's Agents section: the workspace's open agents with their live state. Past Agent
   Sessions are in the History tab. *@
@if (OpenAgents.Count == 0)
{
    <p class="placeholder">No agents running. Start one with the + button above.</p>
}
else
{
    <ul class="agent-list">
        @foreach (var agent in OpenAgents)
        {
            var state = agent.State;
            var shown = ReferenceEquals(agent, Shown);
            @* Clicking the card shows the agent's tab. Its name is a button for the keyboard, whose click reaches the
               card. *@
            <li class="agent-card card-action @AgentStateText.ToneClass(state) @(shown ? "agent-card-shown" : null)"
                @key="agent" title="Show @agent.Name" @onclick="() => OnShow.InvokeAsync(agent)">
                <div class="agent-card-heading">
                    <AgentIcon Definition="agent.Agent.Definition" />
                    <button type="button" class="agent-card-name card-action-name" title="@agent.WorkingDirectory"
                            aria-current="@(shown ? "true" : null)">
                        @agent.Name
                    </button>
                    <AgentStateIndicator State="state" />
                </div>
                @if (state == AgentState.Error && agent.Agent.ExitCode is { } exitCode)
                {
                    <p class="agent-card-detail">Exit code @exitCode</p>
                }
                @if (agent.SessionProblem is { } problem)
                {
                    <p class="agent-card-detail warning" title="@problem">Its session can't be resumed later.</p>
                }
            </li>
        }
    </ul>
}

@code {
    /// <summary>
    /// The workspace.
    /// </summary>
    [Parameter, EditorRequired]
    public Workspace Workspace { get; set; } = null!;

    /// <summary>
    /// The terminal or agent the Workspace View is showing, or <c>null</c> for the dashboard.
    /// </summary>
    [Parameter]
    public IMainAreaTab? Shown { get; set; }

    /// <summary>
    /// Called with an agent to show its tab, when the user picks it.
    /// </summary>
    [Parameter]
    public EventCallback<WorkspaceAgent> OnShow { get; set; }

    private IReadOnlyList<WorkspaceAgent> OpenAgents => Agents.For(Workspace.Id);

    protected override void OnInitialized() => Agents.Changed += OnAgentsChanged;

    public void Dispose() => Agents.Changed -= OnAgentsChanged;

    // Raised on a background thread, e.g. when an agent's state changes.
    private void OnAgentsChanged(string workspaceId)
    {
        if (workspaceId == Workspace.Id)
        {
            InvokeAsync(StateHasChanged);
        }
    }
}
