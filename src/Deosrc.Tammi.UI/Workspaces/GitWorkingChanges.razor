@implements IAsyncDisposable
@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Windowing
@using Deosrc.Tammi.Core.Workspaces
@inject IJSRuntime JS
@inject LayoutStateStore LayoutStore
@inject GitGraphViewOptions Options
@inject ISettingsStore Settings
@* The details panel for the working changes, where a commit is made: the files with unstaged changes, the staged
   files below them (select files and move them between the two with the buttons, or double-click one), the commit
   message's subject and body, which are kept in git's message file as they're typed, and the commit button. *@

<div class="git-working" @ref="_root">
    <div class="git-working-titlebar">
        <h2 class="git-working-title">Working changes</h2>
        @* Shows both lists as a list or a tree, the same choice as the changed files of a commit. *@
        <ToggleButtonGroup TValue="GitGraphFileView" Small="true" Options="_fileViews" Value="Options.FileView"
                           ValueChanged="view => Options.SetFileViewAsync(view)" AriaLabel="Show files as" />
    </div>

    @if (Graph.WorkingChanges is null && Graph.WorkingChangesProblem is { } readProblem)
    {
        <PanelMessage>Couldn't read the changes. @readProblem</PanelMessage>
    }
    else
    {
        <section class="git-working-section" aria-label="Unstaged changes">
            <div class="git-working-heading">
                <h3>Unstaged <span class="git-working-count">@Graph.UnstagedChanges.Count</span></h3>
                <FluentButton Size="ButtonSize.Small" Disabled="@(SelectedIn(staged: false).Count == 0)"
                              OnClick="() => StageAsync(SelectedIn(staged: false))">Stage</FluentButton>
                <FluentButton Size="ButtonSize.Small" Disabled="@(Graph.UnstagedChanges.Count == 0)"
                              OnClick="() => StageAsync(Graph.UnstagedChanges)">Stage all</FluentButton>
                <FluentButton Size="ButtonSize.Small" Class="danger-button" Title="Discard every unstaged change"
                              Disabled="@(Graph.UnstagedChanges.Count == 0)"
                              OnClick="() => RequestDiscard(null)">Discard all</FluentButton>
            </div>
            @if (Graph.PendingDiscard is { } discard)
            {
                <PanelMessage Intent="MessageBarIntent.Warning" Role="alertdialog" Title="@($"Discard {DiscardSubject(discard)}?")">
                    <ChildContent>
                        The changes are lost, and Tammi can't bring them back. Untracked files are deleted. Staged changes are
                        kept.
                    </ChildContent>
                    <Actions>
                        <FluentButton Appearance="ButtonAppearance.Primary" Class="danger-button" Size="ButtonSize.Small"
                                      OnClick="Graph.ConfirmDiscardAsync">Discard</FluentButton>
                        <FluentButton Size="ButtonSize.Small" OnClick="Graph.CancelDiscard">Cancel</FluentButton>
                    </Actions>
                </PanelMessage>
            }
            @FileList(Graph.UnstagedChanges, staged: false)
        </section>

        <section class="git-working-section" aria-label="Staged changes">
            <div class="git-working-heading">
                <h3>Staged <span class="git-working-count">@Graph.StagedChanges.Count</span></h3>
                <FluentButton Size="ButtonSize.Small" Disabled="@(SelectedIn(staged: true).Count == 0)"
                              OnClick="() => UnstageAsync(SelectedIn(staged: true))">Unstage</FluentButton>
                <FluentButton Size="ButtonSize.Small" Disabled="@(Graph.StagedChanges.Count == 0)"
                              OnClick="() => UnstageAsync(Graph.StagedChanges)">Unstage all</FluentButton>
            </div>
            @FileList(Graph.StagedChanges, staged: true)
        </section>

        @if (_menu is { } menu)
        {
            <PointMenu @key="menu" X="menu.X" Y="menu.Y" Label="@(menu.Staged ? "Staged changes" : "Unstaged changes")"
                       OnClose="() => _menu = null">
                <FluentMenuItem Disabled="@_stashing" OnClick="() => StashFromMenu(menu)">@menu.Describe("Stash")</FluentMenuItem>
                @if (!menu.Staged)
                {
                    <FluentMenuItem Class="danger-menu-item" OnClick="() => DiscardFromMenu(menu)">@menu.Describe("Discard")…</FluentMenuItem>
                }
            </PointMenu>
        }
    }

    @* Resizes the message's body: drag it up to make the body taller, or focus it and use Up and Down. *@
    <Splitter AriaLabel="Resize the commit message" @ref="_splitter" />

    <section class="git-working-message" aria-label="Commit message">
        @* The counter, at the end of the subject, counts down the characters left of the soft limit in the settings. *@
        <FluentTextInput Class="git-working-subject" Placeholder="Subject" aria-label="Commit subject" Width="100%"
                         Value="@_subject" ValueChanged="OnSubjectChanged" Immediate="true">
            <EndTemplate>
                <span class="git-working-subject-counter git-working-subject-counter-@CounterState"
                      title="@CounterTitle">@Remaining</span>
            </EndTemplate>
        </FluentTextInput>
        <textarea class="git-working-body" rows="5" @ref="_bodyInput" placeholder="Body (optional)" aria-label="Commit body"
                  value="@_body" @oninput="OnBodyInput"></textarea>
        @if (Graph.WorkingChangesProblem is { } problem && Graph.WorkingChanges is not null)
        {
            <PanelMessage>@problem</PanelMessage>
        }
        <FluentButton Class="git-working-commit" Appearance="ButtonAppearance.Primary" Disabled="@(!CanCommit)"
                      OnClick="CommitAsync">
            @(_committing ? "Committing…" : $"Commit {Graph.StagedChanges.Count} {(Graph.StagedChanges.Count == 1 ? "file" : "files")}")
        </FluentButton>
    </section>
</div>

@code {
    // How many characters from the limit the counter turns orange.
    private const int SubjectWarningAt = 10;

    private readonly List<string> _selected = [];
    // The files' rows, by key, in the order they're shown, and the one clicked last without Shift, which a Shift-click
    // selects from.
    private readonly List<string> _rowOrder = [];
    private string? _anchor;
    // The tree's closed folders, by list and path. Folders start open.
    private readonly HashSet<string> _collapsed = [];
    // The selected file whose diff is shown, if any.
    private string? _active;
    private ElementReference _root;
    private Splitter? _splitter;
    private ElementReference _bodyInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _script;
    private DotNetObjectReference<GitWorkingChanges>? _self;
    private CancellationTokenSource? _saveDelay;
    private string _subject = "";
    private string _body = "";
    private bool _committing;
    private bool _stashing;

    [Parameter, EditorRequired]
    public WorkspaceGitGraph Graph { get; set; } = null!;

    private static readonly IReadOnlyList<ToggleButtonOption<GitGraphFileView>> _fileViews =
    [
        new(GitGraphFileView.List, new Icons.Regular.Size16.TextBulletListLtr(), "As a list"),
        new(GitGraphFileView.Tree, new Icons.Regular.Size16.TextBulletListTree(), "As a tree"),
    ];

    private int Remaining => Settings.Current.Git.SubjectLimit - _subject.Length;

    // Green until 10 characters are left, then orange (up to the limit), and red once over it.
    private string CounterState => Remaining switch
    {
        < 0 => "over",
        <= SubjectWarningAt => "near",
        _ => "ok",
    };

    private string CounterTitle => Remaining >= 0
        ? $"{Remaining} of {Settings.Current.Git.SubjectLimit} characters left in the subject"
        : $"The subject is {-Remaining} over the {Settings.Current.Git.SubjectLimit} character limit";

    private bool CanCommit => !_committing && Graph.StagedChanges.Count > 0 && _subject.Trim().Length > 0;

    protected override void OnInitialized()
    {
        LoadMessage();
        Options.Changed += OnOptionsChanged;
        Settings.Changed += OnOptionsChanged;
    }

    private void OnOptionsChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        // The draft changed outside the fields (e.g. cleared by a commit): show it. Typing is saved as it happens, so
        // it never differs from the fields while there's something to keep.
        if (_saveDelay is null && Graph.Message != Combine())
        {
            LoadMessage();
        }

        // Files that have moved or gone are no longer selected.
        var present = Graph.UnstagedChanges.Select(change => Key(change, staged: false))
            .Concat(Graph.StagedChanges.Select(change => Key(change, staged: true)))
            .ToHashSet();
        _selected.RemoveAll(key => !present.Contains(key));
        if (_active is not null && !_selected.Contains(_active))
        {
            _ = ShowDiffForSelectionAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Deosrc.Tammi.UI/Workspaces/GitWorkingChanges.razor.js");
            _script = await _module.InvokeAsync<IJSObjectReference>("attachSplitter",
                _root,
                _bodyInput,
                _splitter!.Element,
                LayoutStore.Current.GitWorkingMessageHeight,
                _self ??= DotNetObjectReference.Create(this));
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone.
        }
    }

    // The user resized the message's body: keep the height they chose (null for the default) for next time.
    [JSInvokable]
    public Task OnMessageHeightChanged(int? height) =>
        LayoutStore.UpdateAsync(state => state with { GitWorkingMessageHeight = height });

    public async ValueTask DisposeAsync()
    {
        Options.Changed -= OnOptionsChanged;
        Settings.Changed -= OnOptionsChanged;
        if (_saveDelay is { } pending)
        {
            // Keep what was typed in the last moments.
            pending.Cancel();
            _ = Graph.SaveMessageAsync(Combine());
        }

        try
        {
            if (_script is not null)
            {
                await _script.InvokeVoidAsync("dispose");
                await _script.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The web view has gone, and the panel with it.
        }

        _self?.Dispose();
    }

    // The selection is by list ('S' for staged, 'U' for unstaged) and path.
    private static string Key(FileChange change, bool staged) => (staged ? "S" : "U") + change.Path;

    private List<FileChange> SelectedIn(bool staged) =>
        [.. (staged ? Graph.StagedChanges : Graph.UnstagedChanges).Where(change => _selected.Contains(Key(change, staged)))];

    private RenderFragment FileList(IReadOnlyList<FileChange> files, bool staged) => __builder =>
    {
        if (files.Count == 0)
        {
            <p class="placeholder">@(staged ? "Nothing staged." : "No unstaged changes.")</p>
            return;
        }

        if (Options.FileView == GitGraphFileView.Tree)
        {
            // Maps the tree's nodes (made for a commit's files) back to the working changes.
            var byPath = files.ToDictionary(change => change.Path);
            var nodes = CommitFileTree.Build(files.Select(change =>
                new CommitFileChange(change.Path, staged ? change.Staged : change.Unstaged, change.OldPath)));
            <ul class="git-working-files git-commit-tree" role="tree" aria-multiselectable="true">
                @TreeNodes(nodes, byPath, staged, 0)
            </ul>
        }
        else
        {
            <ul class="git-working-files" role="listbox" aria-multiselectable="true">
                @foreach (var change in files)
                {
                    @FileRow(change, staged, 0, showFolder: true)
                }
            </ul>
        }
    };

    private RenderFragment FileRow(FileChange change, bool staged, int depth, bool showFolder) => __builder =>
    {
        var key = Key(change, staged);
        _rowOrder.Add(key);
        var kind = staged ? change.Staged : change.Unstaged;
        var isSelected = _selected.Contains(key);
        <li class="git-working-file @(isSelected ? "selected" : null)" role="@(showFolder ? "option" : "treeitem")"
            aria-selected="@(isSelected ? "true" : "false")" @key="key" style="--git-commit-tree-depth: @depth"
            title="@(change.OldPath is { } old ? $"{old} → {change.Path}" : change.Path)"
            @onclick="e => e.ShiftKey ? SelectRangeAsync(key, e.CtrlKey || e.MetaKey) : ToggleAsync(key, e.CtrlKey || e.MetaKey)"
            @oncontextmenu="e => OpenFileMenu(e, change, staged)" @oncontextmenu:preventDefault
            @ondblclick="() => MoveAsync(change, staged)">
            <span class="git-commit-file-kind git-graph-file-@kind.ToString().ToLowerInvariant()"
                  title="@(change.IsSubmodule ? "Submodule commit changed" : GitGraphText.Label(kind))">@(change.IsSubmodule ? "S" : GitGraphText.Letter(kind))</span>
            <span class="git-commit-file-name">@CommitFileTree.DisplayName(change.Path, change.OldPath)</span>
            @if (CommitFileTree.MovedFrom(change.Path, change.OldPath) is { } movedFrom)
            {
                <span class="git-commit-file-folder">@(showFolder ? $"{CommitFileTree.FolderOf(change.Path)} ← {movedFrom}" : $"from {movedFrom}")</span>
            }
            else if (showFolder)
            {
                <span class="git-commit-file-folder">@CommitFileTree.FolderOf(change.Path)</span>
            }
        </li>
    };

    // A level of a list's tree: folders, which open and close (they start open, since the files are what's being
    // worked on), then files. Each level is indented by `depth`.
    private RenderFragment TreeNodes(
        IReadOnlyList<CommitFileTreeNode> nodes,
        Dictionary<string, FileChange> byPath,
        bool staged,
        int depth) => __builder =>
    {
        foreach (var node in nodes)
        {
            if (node.IsFolder)
            {
                var folderKey = (staged ? "S" : "U") + node.Path;
                var open = !_collapsed.Contains(folderKey);
                var folderFiles = CommitFileTree.FilesIn(node).ToList();
                var folderChanges = folderFiles.Select(change => byPath[change.Path]).ToList();
                var folderKeys = folderChanges.Select(change => Key(change, staged)).ToList();
                var folderSelected = folderKeys.Count > 0 && folderKeys.All(_selected.Contains);
                <li role="treeitem" aria-expanded="@(open ? "true" : "false")" @key="folderKey">
                    @* Selects every file in the folder, so the Stage/Unstage buttons above the list act on them like on
                       selected files. The chevron opens and closes it. *@
                    <div class="git-working-folder @(folderSelected ? "selected" : null)" title="@node.Path"
                         style="--git-commit-tree-depth: @depth"
                         @onclick="e => SelectFolderAsync(folderKeys, e.CtrlKey || e.MetaKey)"
                         @oncontextmenu="e => OpenFolderMenu(e, node.Path, folderChanges, staged)"
                         @oncontextmenu:preventDefault>
                        <button type="button" class="git-commit-folder-toggle" aria-label="@(open ? "Close" : "Open") @node.Path"
                                @onclick="() => ToggleFolder(folderKey)" @onclick:stopPropagation>
                            <span class="git-commit-folder-chevron @(open ? "open" : null)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" />
                            </span>
                        </button>
                        <span class="git-commit-folder-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Folder())" />
                        </span>
                        <span class="git-commit-folder-name">@node.Name</span>
                        <GitFileChangeCounts Kinds="folderFiles.Select(change => change.Kind)" />
                    </div>
                    @if (open)
                    {
                        <ul role="group">@TreeNodes(node.Children, byPath, staged, depth + 1)</ul>
                    }
                </li>
            }
            else
            {
                @FileRow(byPath[node.Path], staged, depth, showFolder: false)
            }
        }
    };

    private void ToggleFolder(string key)
    {
        if (!_collapsed.Remove(key))
        {
            _collapsed.Add(key);
        }
    }

    // Selecting a file shows its diff straight away, and deselecting it takes the diff away. With several files
    // selected, the diff is of the one selected last.
    private Task ToggleAsync(string key, bool add)
    {
        _anchor = key;
        if (!add)
        {
            bool only = _selected.Count == 1 && _selected.Contains(key);
            _selected.Clear();
            if (!only)
            {
                _selected.Add(key);
            }
        }
        else if (!_selected.Remove(key))
        {
            _selected.Add(key);
        }
        else if (_active != key)
        {
            return Task.CompletedTask;
        }

        return ShowDiffForSelectionAsync(_selected.Contains(key) ? key : null);
    }

    // Shift-clicking a file selects every file shown from the one clicked last (without Shift) to this one, in the same
    // list, instead of the selection, or with Ctrl as well as it. Without such a file, it's an ordinary click.
    private Task SelectRangeAsync(string key, bool add)
    {
        int from = _anchor is null ? -1 : _rowOrder.IndexOf(_anchor);
        int to = _rowOrder.IndexOf(key);
        if (from < 0 || to < 0 || _anchor![0] != key[0])
        {
            return ToggleAsync(key, add);
        }

        if (!add)
        {
            _selected.Clear();
        }

        foreach (var row in _rowOrder.GetRange(Math.Min(from, to), Math.Abs(to - from) + 1))
        {
            if (!_selected.Contains(row))
            {
                _selected.Add(row);
            }
        }

        return ShowDiffForSelectionAsync(key);
    }

    // Selecting a folder selects all the files in it. Like for a file, selecting it again deselects them: if they're
    // all selected, and the only ones (or with Ctrl, whatever else is).
    private Task SelectFolderAsync(IReadOnlyList<string> keys, bool add)
    {
        bool all = keys.All(_selected.Contains);
        bool deselect = all && (add || _selected.Count == keys.Count);
        if (!add)
        {
            _selected.Clear();
        }

        foreach (var key in keys)
        {
            _selected.Remove(key);
        }

        if (!deselect)
        {
            _selected.AddRange(keys);
        }

        return ShowDiffForSelectionAsync(deselect ? null : keys[^1]);
    }

    // Shows the diff of a selected file (the given one, or else any other that's selected), or closes the diff if none
    // is.
    private Task ShowDiffForSelectionAsync(string? preferred = null)
    {
        _active = preferred ?? _selected.LastOrDefault();
        if (_active is null)
        {
            Graph.CloseDiff();
            return Task.CompletedTask;
        }

        bool staged = _active.StartsWith('S');
        FileChange? change = (staged ? Graph.StagedChanges : Graph.UnstagedChanges)
            .FirstOrDefault(change => Key(change, staged) == _active);
        if (change is null)
        {
            Graph.CloseDiff();
            return Task.CompletedTask;
        }

        return Graph.OpenDiffAsync(staged ? GitDiffSource.Staged : GitDiffSource.Unstaged, change.Path, change.OldPath);
    }

    // The right-click menu of a file or folder: Stash, and Discard on the unstaged list. `Folder` is set when it's
    // opened on a folder.
    private sealed record FileMenu(double X, double Y, bool Staged, IReadOnlyList<FileChange> Files, string? Folder)
    {
        public string Describe(string verb) =>
            Folder is not null ? $"{verb} changes in {Folder}"
            : Files.Count == 1 ? $"{verb} changes"
            : $"{verb} changes to {Files.Count} files";
    }

    private FileMenu? _menu;

    // On a selected file the menu is for every selected file in its list. Otherwise it's for the file clicked, which
    // becomes the selection.
    private void OpenFileMenu(MouseEventArgs e, FileChange change, bool staged)
    {
        string key = Key(change, staged);
        if (!_selected.Contains(key))
        {
            _selected.Clear();
            _selected.Add(key);
        }

        _menu = new FileMenu(e.ClientX, e.ClientY, staged, SelectedIn(staged), null);
    }

    private void OpenFolderMenu(MouseEventArgs e, string folder, IReadOnlyList<FileChange> files, bool staged) =>
        _menu = new FileMenu(e.ClientX, e.ClientY, staged, files, folder);

    private void DiscardFromMenu(FileMenu menu)
    {
        _menu = null;
        RequestDiscard(menu.Files);
    }

    private Task StashFromMenu(FileMenu menu)
    {
        _menu = null;
        return StashAsync(menu.Files);
    }

    private void RequestDiscard(IReadOnlyCollection<FileChange>? files)
    {
        _selected.Clear();
        _active = null;
        Graph.CloseDiff();
        Graph.RequestDiscard(files);
    }

    private static string DiscardSubject(DiscardRequest request) => request.Files switch
    {
        null => "all unstaged changes",
        { Count: 1 } files => $"the changes to {CommitFileTree.NameOf(files[0].Path)}",
        var files => $"the changes to {files.Count} files",
    };

    private Task MoveAsync(FileChange change, bool staged) => staged ? UnstageAsync([change]) : StageAsync([change]);

    private async Task StageAsync(IReadOnlyCollection<FileChange> files)
    {
        _selected.Clear();
        _active = null;
        Graph.CloseDiff();
        await Graph.StageAsync(files);
    }

    private async Task UnstageAsync(IReadOnlyCollection<FileChange> files)
    {
        _selected.Clear();
        _active = null;
        Graph.CloseDiff();
        await Graph.UnstageAsync(files);
    }

    // Stashes the files, or everything if there are none given.
    private async Task StashAsync(IReadOnlyCollection<FileChange>? files)
    {
        _selected.Clear();
        _active = null;
        Graph.CloseDiff();
        await RunStashAsync(Graph.StashAsync(files));
    }

    private async Task RunStashAsync(Task<bool> action)
    {
        _stashing = true;
        try
        {
            await action;
        }
        finally
        {
            _stashing = false;
        }
    }

    private async Task CommitAsync()
    {
        _committing = true;
        _saveDelay?.Cancel();
        _saveDelay = null;
        try
        {
            if (await Graph.CommitAsync(Combine()))
            {
                _subject = "";
                _body = "";
            }
        }
        finally
        {
            _committing = false;
        }
    }

    private void LoadMessage()
    {
        string message = Graph.Message.Replace("\r\n", "\n");
        int split = message.IndexOf('\n');
        _subject = split < 0 ? message : message[..split];
        _body = split < 0 ? "" : message[(split + 1)..].TrimStart('\n');
    }

    private string Combine() =>
        _body.Trim().Length == 0 ? _subject : $"{_subject}\n\n{_body}";

    private void OnSubjectChanged(string? value)
    {
        _subject = (value ?? "").ReplaceLineEndings(" ");
        SaveSoon();
    }

    private void OnBodyInput(ChangeEventArgs e)
    {
        _body = e.Value as string ?? "";
        SaveSoon();
    }

    // Saves the message shortly after the user stops typing.
    private void SaveSoon()
    {
        _saveDelay?.Cancel();
        var delay = _saveDelay = new CancellationTokenSource();
        _ = SaveAfterAsync(delay);
    }

    private async Task SaveAfterAsync(CancellationTokenSource delay)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(400), delay.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await Graph.SaveMessageAsync(Combine());
        if (ReferenceEquals(_saveDelay, delay))
        {
            _saveDelay = null;
        }
    }
}
