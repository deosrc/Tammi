@implements IAsyncDisposable
@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Windowing
@inject IJSRuntime JS
@inject GitGraphViewOptions Options
@inject LayoutStateStore LayoutStore
@* The selected commit's details, beside a git graph: a bar with its short id (which copies it), its subject, its
   message's body (resizable, with the split below it), its authors (which collapse) and, after a divider, the files it
   changed, as a list or a tree. *@

<div class="git-commit-details" @ref="_root">
    @if (Graph.Selected is not { } selection)
    {
        <p class="placeholder git-commit-details-empty">Select a commit to see its details.</p>
    }
    else
    {
        var commit = selection.Commit;
        var body = GitGraphText.Body(commit);
        _hasBody = body.Length > 0;

        <div class="git-commit-bar">
            <button type="button" class="git-commit-hash" title="Copy the commit id (@commit.Sha)"
                    @onclick="() => CopyAsync(commit.Sha)">
                @GitGraphText.ShortSha(commit.Sha)
            </button>
            <span class="git-commit-copied @(_copied == commit.Sha ? "shown" : null)" role="status">
                @(_copied == commit.Sha ? "Copied" : null)
            </span>
        </div>

        <h2 class="git-commit-subject">@commit.Subject</h2>

        @if (_hasBody)
        {
            <div class="git-commit-body" tabindex="0" aria-label="Commit message" @ref="_message">@body</div>
            @* Resizes the body: drag it, or focus it and use Up and Down. *@
            <div class="git-commit-body-splitter" role="separator" aria-orientation="horizontal"
                 aria-label="Resize the commit message" tabindex="0" title="Drag to resize. Double-click to reset."
                 @ref="_messageSplitter">
            </div>
        }

        <div class="git-commit-lower">
            @* Collapses to its heading, with the author's name beside it. *@
            <section class="git-commit-section" aria-labelledby="@($"{_id}-authors")">
                <h3 class="git-commit-heading" id="@($"{_id}-authors")">
                    <button type="button" class="git-commit-collapse" aria-expanded="@(Options.AuthorsCollapsed ? "false" : "true")"
                            aria-controls="@($"{_id}-people")" @onclick="Options.ToggleAuthors">
                        <svg class="icon icon-small git-commit-folder-chevron @(Options.AuthorsCollapsed ? null : "open")"
                             viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="9 6 15 12 9 18"></polyline>
                        </svg>
                        Authors
                    </button>
                    @if (Options.AuthorsCollapsed)
                    {
                        <span class="git-commit-heading-summary" title="@commit.Author.Email">@commit.Author.Name</span>
                    }
                </h3>
                <ul class="git-commit-people" id="@($"{_id}-people")" hidden="@Options.AuthorsCollapsed">
                    @Person(commit.Author.Name, commit.Author.Email, "Authored", commit.Author.When)
                    @if (commit.Committer.Name != commit.Author.Name || commit.Committer.Email != commit.Author.Email)
                    {
                        @Person(commit.Committer.Name, commit.Committer.Email, "Committed", commit.Committer.When)
                    }
                    @foreach (var coAuthor in CommitMessage.CoAuthors(commit.Message))
                    {
                        @Person(coAuthor.Name, coAuthor.Email, "Co-author", null)
                    }
                </ul>
            </section>

            <section class="git-commit-section" aria-labelledby="@($"{_id}-files")">
                <div class="git-commit-files-heading">
                    <h3 class="git-commit-heading" id="@($"{_id}-files")">Changed files</h3>
                    @if (Graph.SelectedChanges is { Count: > 0 } counted)
                    {
                        <GitFileChangeCounts Kinds="counted.Select(change => change.Kind)" />
                    }
                    <div class="segmented segmented-small git-commit-file-view" role="group" aria-label="Show files as">
                        <button type="button" class="segmented-option" title="As a list" aria-label="As a list"
                                aria-pressed="@(Options.FileView == GitGraphFileView.List ? "true" : "false")"
                                @onclick="() => Options.SetFileViewAsync(GitGraphFileView.List)">
                            <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M9 6h11M9 12h11M9 18h11" />
                                <path d="M4 6h.01M4 12h.01M4 18h.01" />
                            </svg>
                        </button>
                        <button type="button" class="segmented-option" title="As a tree" aria-label="As a tree"
                                aria-pressed="@(Options.FileView == GitGraphFileView.Tree ? "true" : "false")"
                                @onclick="() => Options.SetFileViewAsync(GitGraphFileView.Tree)">
                            <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M4 4h6M7 4v14h5M7 11h5" />
                                <path d="M14 11h6M14 18h6" />
                            </svg>
                        </button>
                    </div>
                </div>

                @if (Graph.SelectedChangesProblem is { } changesProblem)
                {
                    <p class="error">Couldn't read the changed files. @changesProblem</p>
                }
                else if (Graph.SelectedChanges is not { } changes)
                {
                    <p class="placeholder">Reading changed files…</p>
                }
                else if (changes.Count == 0)
                {
                    <p class="placeholder">No files changed.</p>
                }
                else if (Options.FileView == GitGraphFileView.Tree)
                {
                    <ul class="git-commit-files git-commit-tree" role="tree" aria-label="Changed files">
                        @TreeNodes(CommitFileTree.Build(changes), 0)
                    </ul>
                }
                else
                {
                    <ul class="git-commit-files" aria-label="Changed files">
                        @foreach (var change in changes)
                        {
                            var folder = CommitFileTree.FolderOf(change.Path);
                            <li class="git-commit-file git-commit-file-openable @(IsShown(change) ? "selected" : null)"
                                @key="change.Path" title="@FileTitle(change)" @onclick="() => ToggleDiff(change)">
                                @Kind(change.Kind)
                                <span class="git-commit-file-name">@CommitFileTree.NameOf(change.Path)</span>
                                @if (folder.Length > 0)
                                {
                                    <span class="git-commit-file-folder">@folder</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
</div>

@code {
    private readonly string _id = $"git-commit-{Guid.NewGuid():N}";
    // The tree's open folders, by path. Folders start closed.
    private readonly HashSet<string> _expanded = [];
    private ElementReference _root;
    private ElementReference _message;
    private ElementReference _messageSplitter;
    private IJSObjectReference? _module;
    private IJSObjectReference? _messageScript;
    private DotNetObjectReference<GitCommitDetails>? _self;
    private string? _shownSha;
    private string? _copied;
    private bool _hasBody;
    private bool _disposed;

    [Parameter, EditorRequired]
    public WorkspaceGitGraph Graph { get; set; } = null!;

    protected override void OnInitialized() => Options.Changed += OnOptionsChanged;

    protected override void OnParametersSet()
    {
        // Another commit's folders all start closed.
        if (Graph.Selected?.Commit.Sha != _shownSha)
        {
            _shownSha = Graph.Selected?.Commit.Sha;
            _expanded.Clear();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Deosrc.Tammi.UI/Workspaces/GitCommitDetails.razor.js");

            // The body and its split are only there for a commit whose message has one.
            if (_hasBody && Graph.Selected is not null && _messageScript is null)
            {
                _self ??= DotNetObjectReference.Create(this);
                _messageScript = await _module.InvokeAsync<IJSObjectReference>(
                    "attachMessageSplitter",
                    _root,
                    _message,
                    _messageSplitter,
                    LayoutStore.Current.GitGraphMessageHeight,
                    _self);
            }
            else if ((!_hasBody || Graph.Selected is null) && _messageScript is not null)
            {
                await DetachMessageSplitterAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Options.Changed -= OnOptionsChanged;
        try
        {
            await DetachMessageSplitterAsync();
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone, and the panel with it.
        }

        _self?.Dispose();
    }

    // The user resized the message's body: keep the height they chose (null for the default) for next time.
    [JSInvokable]
    public Task OnMessageHeightChanged(int? height) =>
        LayoutStore.UpdateAsync(state => state with { GitGraphMessageHeight = height });

    private async Task DetachMessageSplitterAsync()
    {
        if (_messageScript is null)
        {
            return;
        }

        var script = _messageScript;
        _messageScript = null;
        await script.InvokeVoidAsync("dispose");
        await script.DisposeAsync();
    }

    // Copies the full commit id, and says so for a moment.
    private async Task CopyAsync(string sha)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (!await _module.InvokeAsync<bool>("copyText", sha))
            {
                return;
            }
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        _copied = sha;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(1.5));
        if (!_disposed && _copied == sha)
        {
            _copied = null;
            StateHasChanged();
        }
    }

    private void OnOptionsChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    private bool IsShown(CommitFileChange change) => Graph.DiffTarget?.Path == change.Path;

    // Selecting a file shows its changes in this commit, and selecting it again takes them away.
    private Task ToggleDiff(CommitFileChange change)
    {
        if (IsShown(change))
        {
            Graph.CloseDiff();
            return Task.CompletedTask;
        }

        return Graph.OpenDiffAsync(GitDiffSource.Commit, change.Path, change.OldPath, Graph.Selected?.Commit.Sha);
    }

    private void ToggleFolder(string path)
    {
        if (!_expanded.Remove(path))
        {
            _expanded.Add(path);
        }
    }

    private static string FileTitle(CommitFileChange change) =>
        change.OldPath is { } oldPath ? $"{oldPath} → {change.Path}" : change.Path;

    private static RenderFragment Kind(FileChangeKind kind) => __builder =>
    {
        <span class="git-commit-file-kind git-graph-file-@kind.ToString().ToLowerInvariant()"
              title="@GitGraphText.Label(kind)">@GitGraphText.Letter(kind)</span>
    };

    private RenderFragment Person(string name, string email, string role, DateTimeOffset? when) => __builder =>
    {
        <li class="git-commit-person">
            <span class="git-commit-person-name">@name</span>
            <span class="git-commit-person-email">@email</span>
            <span class="git-commit-person-role" title="@(when is { } at ? GitGraphText.FullDate(at) : null)">
                @role@(when is { } date ? $" {GitGraphText.When(date, DateTimeOffset.Now).ToLowerInvariant()}" : null)
            </span>
        </li>
    };

    // A level of the files' tree: folders, which open and close, then files. Each level is indented by `depth`.
    private RenderFragment TreeNodes(IReadOnlyList<CommitFileTreeNode> nodes, int depth) => __builder =>
    {
        foreach (var node in nodes)
        {
            var indent = $"--git-commit-tree-depth: {depth}";
            if (node.IsFolder)
            {
                var open = _expanded.Contains(node.Path);
                <li role="treeitem" aria-expanded="@(open ? "true" : "false")" @key="node.Path">
                    <button type="button" class="git-commit-file git-commit-folder" style="@indent" title="@node.Path"
                            @onclick="() => ToggleFolder(node.Path)">
                        <svg class="icon icon-small git-commit-folder-chevron @(open ? "open" : null)" viewBox="0 0 24 24"
                             aria-hidden="true" focusable="false">
                            <polyline points="9 6 15 12 9 18"></polyline>
                        </svg>
                        <svg class="icon icon-small git-commit-folder-icon" viewBox="0 0 24 24" aria-hidden="true"
                             focusable="false">
                            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
                        </svg>
                        <span class="git-commit-folder-name">@node.Name</span>
                        <GitFileChangeCounts Kinds="CommitFileTree.FilesIn(node).Select(change => change.Kind)" />
                    </button>
                    @if (open)
                    {
                        <ul role="group">@TreeNodes(node.Children, depth + 1)</ul>
                    }
                </li>
            }
            else
            {
                <li class="git-commit-file git-commit-file-openable @(IsShown(node.Change!) ? "selected" : null)"
                    role="treeitem" aria-selected="@(IsShown(node.Change!) ? "true" : "false")" style="@indent"
                    title="@FileTitle(node.Change!)" @key="node.Path" @onclick="() => ToggleDiff(node.Change!)">
                    @Kind(node.Change!.Kind)
                    <span class="git-commit-file-name">@node.Name</span>
                </li>
            }
        }
    };
}
