@implements IDisposable
@using Deosrc.Tammi.Core.Agents
@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Tools
@inject WorkspaceTools Tools
@inject ToolImages ToolImages
@inject ISettingsStore SettingsStore
@inject IWorkspaceStore WorkspaceStore
@inject WorkspaceTabs WorkspaceTabs
@inject IGitRepositoryReader Reader
@inject IGitCli Git
@inject NavigationManager Navigation

@* The side panel of a git tab opened outside any workspace, laid out like the Workspace View's: the workspaces that use
   the repository, its other worktrees and submodules, and what it can be opened in. *@
<SidePanel>
    <ChildContent>
        <SidePanelSection Title="Agents">
            <HeaderContent>
                <WorkspaceAgentCounts WorkspaceId="@StandaloneRepository.IdFor(RepositoryPath)" />
            </HeaderContent>
            <Actions>
                <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small" IconOnly="true"
                              Disabled="@(AgentDefinitions.Count == 0)" IconStart="@(new Icons.Regular.Size16.Add())"
                              Title="Start a new agent" aria-label="New agent" aria-haspopup="menu"
                              OnClick="OpenNewAgentMenu" />
            </Actions>
            <ChildContent>
                <WorkspaceAgentsSection Workspace="StandaloneRepository.WorkspaceOf(RepositoryPath)" Shown="Shown"
                                        OnShow="agent => OnShowAgent.InvokeAsync(agent)" />
            </ChildContent>
        </SidePanelSection>
        <SidePanelSection Flush="true" Title="Workspaces" Count="@(_related.IsLoaded ? _related.Workspaces.Count : null)">
            @if (!_related.IsLoaded)
            {
                <p class="placeholder">Reading…</p>
            }
            else if (_related.Workspaces.Count == 0)
            {
                <p class="placeholder">No workspaces use this repository</p>
            }
            else
            {
                <ul class="side-panel-list">
                    @foreach (var workspace in _related.Workspaces)
                    {
                        <SidePanelListItem @key="workspace.Id" Hint="@workspace.Folder" OnClick="() => OpenWorkspace(workspace)">
                            <Icon><FluentIcon Value="@(new Icons.Regular.Size16.Folder())" /></Icon>
                            <ChildContent>@workspace.Name</ChildContent>
                        </SidePanelListItem>
                    }
                </ul>
            }
        </SidePanelSection>
        <SidePanelSection Flush="true" Title="Other Worktrees" Count="@(_related.IsLoaded ? _related.Worktrees.Count : null)">
            @if (!_related.IsLoaded)
            {
                <p class="placeholder">Reading…</p>
            }
            else if (_related.Worktrees.Count == 0)
            {
                <p class="placeholder">No other worktrees</p>
            }
            else
            {
                <ul class="side-panel-list">
                    @foreach (var worktree in _related.Worktrees)
                    {
                        <SidePanelListItem @key="worktree.Path" Hint="@worktree.Path" OnClick="() => OnOpenGit.InvokeAsync(worktree.Path)">
                            <Icon><FluentIcon Value="@(new Icons.Regular.Size16.BranchFork())" /></Icon>
                            <ChildContent>@(worktree.Branch ?? System.IO.Path.GetFileName(worktree.Path))</ChildContent>
                        </SidePanelListItem>
                    }
                </ul>
            }
        </SidePanelSection>
        <SidePanelSection Flush="true" Title="Submodules" Count="@(_related.IsLoaded ? _related.Submodules.Count : null)">
            @if (!_related.IsLoaded)
            {
                <p class="placeholder">Reading…</p>
            }
            else if (_related.Submodules.Count == 0)
            {
                <p class="placeholder">No submodules</p>
            }
            else
            {
                <ul class="side-panel-list">
                    @foreach (var submodule in _related.Submodules)
                    {
                        <SidePanelListItem @key="submodule.Path" Disabled="!submodule.IsInitialized"
                                           Hint="@(submodule.IsInitialized ? submodule.Path : "Not checked out")"
                                           OnClick="() => OnOpenGit.InvokeAsync(submodule.Path)">
                            <Icon><FluentIcon Value="@(new Icons.Regular.Size16.Box())" /></Icon>
                            <ChildContent>@submodule.Name</ChildContent>
                        </SidePanelListItem>
                    }
                </ul>
            }
        </SidePanelSection>
        <SidePanelSection Flush="true" Title="Tools" Count="@(_toolsLoaded ? _items.Count : null)">
            @if (!_toolsLoaded)
            {
                <p class="placeholder">Finding tools…</p>
            }
            else if (_items.Count == 0)
            {
                <p class="placeholder">
                    No tools to open the repository in. Add or enable them in
                    <FluentLink Href="@AppRoutes.SettingsTools">Settings</FluentLink>.
                </p>
            }
            else
            {
                @* Clicking a tool opens the repository in it, or, for a file tool with several files, offers them. The same
                   menu opens from the ⋮ button and a right-click, as in a workspace. *@
                <ul class="side-panel-list">
                    @foreach (var item in _items)
                    {
                        <SidePanelListItem @key="item.Tool" Hint="@(item.Tool.Kind == ToolKind.File && item.DefaultEntry is { } only ? only.Path : item.Label)"
                                           HasMenu="item.DefaultEntry is null" Pulse="PulseOf(item)"
                                           OnClick="e => OnToolClicked(item, e)"
                                           OnContextMenu="e => OpenToolMenu(item, e)"
                                           OnMenu="e => OpenToolMenu(item, e)" MenuHint="@($"More ways to open with {item.Label}")">
                            <Icon><ToolImageView Image="item.Entries[0].Image" Fallback="item.Tool.Icon.Generic" /></Icon>
                            <ChildContent>@item.Label</ChildContent>
                        </SidePanelListItem>
                    }
                </ul>
            }
            @if (_error is not null)
            {
                <p class="error"><CopyOnClick>@_error</CopyOnClick></p>
            }
        </SidePanelSection>
    </ChildContent>
</SidePanel>
@if (_toolMenu is { } toolMenu)
{
    <PointMenu @key="toolMenu" X="toolMenu.X" Y="toolMenu.Y" Label="@toolMenu.Item.Label" OnClose="() => _toolMenu = null">
        @foreach (var entry in toolMenu.Item.Places)
        {
            var target = entry;
            <FluentMenuItem @key="target.Path" Title="@target.Path"
                            Label="@(toolMenu.Item.Tool.Kind == ToolKind.File ? target.MenuLabel : $"Repository: {target.Repository?.FolderName}")"
                            IconStart="@(toolMenu.Item.Tool.Kind == ToolKind.File ? new Icons.Regular.Size20.Document() : new Icons.Regular.Size20.BranchFork())"
                            OnClick="() => OpenTool(toolMenu.Item, target)" />
        }
    </PointMenu>
}
@if (_agentMenu is { } agentMenu)
{
    @* A menu at the pointer, as the side panel scrolls and would clip a drop-down. *@
    <PointMenu @key="agentMenu" X="agentMenu.X" Y="agentMenu.Y" Label="New agent" OnClose="() => _agentMenu = null">
        <AgentMenuItems AgentDefinitions="AgentDefinitions" OnStart="request => StartAgentAsync(request.Definition)" />
    </PointMenu>
}

@code {
    private sealed record WorkspaceLink(string Id, string Name, string Folder);

    private sealed record SubmoduleLink(string Name, string Path, bool IsInitialized);

    private sealed record Related(
        bool IsLoaded,
        IReadOnlyList<WorkspaceLink> Workspaces,
        IReadOnlyList<GitWorktreeEntry> Worktrees,
        IReadOnlyList<SubmoduleLink> Submodules)
    {
        public static Related Loading { get; } = new(false, [], [], []);
    }

    private sealed record AgentMenu(double X, double Y);

    private sealed record ToolMenu(double X, double Y, ToolItem Item);

    private ToolMenu? _toolMenu;
    private IReadOnlyList<ToolItem> _items = [];
    private ToolItem? _pulsing;
    private int _pulseCount;
    private static readonly TimeSpan PulseDuration = TimeSpan.FromMilliseconds(600);

    private AgentMenu? _agentMenu;
    private IReadOnlyList<AgentDefinition> AgentDefinitions => SettingsStore.Current.Agents.Definitions;
    private Related _related = Related.Loading;
    private string? _error;
    private string? _loadedPath;
    private bool _toolsLoaded;
    private int _toolUpdates;
    private int _relatedUpdates;
    private bool _disposed;

    /// <summary>
    /// The full path of the repository.
    /// </summary>
    [Parameter, EditorRequired]
    public string RepositoryPath { get; set; } = "";

    /// <summary>
    /// The terminal, agent or git graph the repository's tab is showing.
    /// </summary>
    [Parameter]
    public IMainAreaTab? Shown { get; set; }

    /// <summary>
    /// Shows an agent's secondary tab.
    /// </summary>
    [Parameter]
    public EventCallback<WorkspaceAgent> OnShowAgent { get; set; }

    /// <summary>
    /// Starts an agent in the repository as a secondary tab.
    /// </summary>
    [Parameter]
    public EventCallback<AgentDefinition> OnStartAgent { get; set; }

    /// <summary>
    /// Opens the git graph of a submodule or another worktree, by its full path, as a secondary tab.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnOpenGit { get; set; }

    /// <summary>
    /// Opens a terminal in the repository as a secondary tab.
    /// </summary>
    [Parameter]
    public EventCallback OnOpenTerminal { get; set; }

    protected override void OnInitialized()
    {
        SettingsStore.Changed += OnSettingsChanged;
        WorkspaceStore.Changed += OnWorkspacesChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedPath != RepositoryPath)
        {
            _loadedPath = RepositoryPath;
            _related = Related.Loading;
            await Task.WhenAll(UpdateRelatedAsync(), UpdateToolsAsync());
        }
    }

    public void Dispose()
    {
        _disposed = true;
        SettingsStore.Changed -= OnSettingsChanged;
        WorkspaceStore.Changed -= OnWorkspacesChanged;
    }

    private void OnSettingsChanged() => _ = InvokeAsync(UpdateToolsAsync);

    private void OnWorkspacesChanged() => _ = InvokeAsync(UpdateRelatedAsync);

    private static StringComparison PathComparison =>
        OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;

    private static string Normalize(string path) => System.IO.Path.TrimEndingDirectorySeparator(path);

    // The workspaces that use the repository, and its other worktrees and submodules. Reads git, so it's done in the
    // background.
    private async Task UpdateRelatedAsync()
    {
        var update = ++_relatedUpdates;
        var path = RepositoryPath;
        var listings = await WorkspaceStore.ListAsync();
        var related = await Task.Run(async () =>
        {
            var workspaces = new List<WorkspaceLink>();
            var workspaceWorktrees = new List<string>();
            foreach (var listing in listings)
            {
                if (listing.Workspace is not { } workspace)
                {
                    continue;
                }

                var used = workspace.Repositories
                    .Where(repository => string.Equals(Normalize(repository.LocalRepositoryPath), Normalize(path), PathComparison))
                    .ToList();
                if (used.Count > 0)
                {
                    workspaces.Add(new WorkspaceLink(workspace.Id, workspace.Name, workspace.Folder));
                    workspaceWorktrees.AddRange(used.Select(workspace.GetWorktreePath));
                }
            }

            IReadOnlyList<GitWorktreeEntry> worktrees = [];
            try
            {
                var result = await Git.RunAsync(path, ["worktree", "list", "--porcelain"], new GitCommandOptions { ThrowOnError = false });
                if (result.Succeeded)
                {
                    // Worktrees that belong to a workspace are listed under it, and the main working tree is this one.
                    worktrees =
                    [
                        .. GitWorktreeList.Parse(result.OutputLines)
                            .Where(entry => !entry.IsMain
                                && !workspaceWorktrees.Any(worktree => string.Equals(Normalize(worktree), Normalize(entry.Path), PathComparison))),
                    ];
                }
            }
            catch (GitException)
            {
            }

            IReadOnlyList<SubmoduleLink> submodules = [];
            try
            {
                submodules =
                [
                    .. Reader.ReadStatus(path).Submodules.Select(submodule => new SubmoduleLink(
                        submodule.Name,
                        System.IO.Path.Combine(path, submodule.Path.Replace('/', System.IO.Path.DirectorySeparatorChar)),
                        submodule.IsInitialized)),
                ];
            }
            catch (Exception ex) when (ex is GitException or IOException)
            {
            }

            return new Related(true, workspaces.OrderBy(workspace => workspace.Name, StringComparer.CurrentCultureIgnoreCase).ToList(), worktrees, submodules);
        });

        if (update == _relatedUpdates && !_disposed)
        {
            _related = related;
            StateHasChanged();
        }
    }

    // Reads the repository's folders for the files file tools open, so it's done in the background.
    private async Task UpdateToolsAsync()
    {
        var update = ++_toolUpdates;
        var path = RepositoryPath;
        var settings = SettingsStore.Current.Tools;
        var entries = await Task.Run(() => Tools.GetEntriesForRepository(path, settings));
        if (update != _toolUpdates || _disposed)
        {
            return;
        }

        UpdateItems(entries);
        _toolsLoaded = true;
        StateHasChanged();

        // The icons are shown once they're found. Until then, each tool shows its generic icon.
        var withImages = new List<ToolEntry>(entries.Count);
        foreach (var entry in entries)
        {
            withImages.Add(entry with { Image = await ToolImages.GetAsync(entry.Tool, entry.Request?.FileName) });
        }

        if (update == _toolUpdates && !_disposed)
        {
            UpdateItems(withImages);
            StateHasChanged();
        }
    }

    // Each tool is one item, as in a workspace: with the files it found, if it's a file tool.
    private void UpdateItems(IReadOnlyList<ToolEntry> entries)
    {
        _items = WorkspaceTools.GroupByTool(SettingsStore.Current.Tools.Tools, [], [entries]);
    }

    private void OpenNewAgentMenu(MouseEventArgs e) => _agentMenu = new AgentMenu(e.ClientX, e.ClientY);

    private async Task StartAgentAsync(AgentDefinition definition)
    {
        _agentMenu = null;
        await OnStartAgent.InvokeAsync(definition);
    }

    private void OpenWorkspace(WorkspaceLink workspace)
    {
        WorkspaceTabs.Open(workspace.Id, workspace.Name);
        Navigation.NavigateTo(AppRoutes.Workspace(workspace.Id));
    }

    private async Task OnToolClicked(ToolItem item, MouseEventArgs e)
    {
        if (item.DefaultEntry is { } entry)
        {
            await OpenTool(item, entry);
        }
        else
        {
            // A file tool with several files offers them.
            OpenToolMenu(item, e);
        }
    }

    private void OpenToolMenu(ToolItem item, MouseEventArgs e) => _toolMenu = new ToolMenu(e.ClientX, e.ClientY, item);

    // Opens a tool, and pulses its item once to show it's launching.
    private async Task OpenTool(ToolItem item, ToolEntry entry)
    {
        var pulse = ++_pulseCount;
        _pulsing = item;
        await OpenTool(entry);
        _ = EndPulseAsync(pulse);
    }

    private async Task EndPulseAsync(int pulse)
    {
        await Task.Delay(PulseDuration);
        if (pulse == _pulseCount && !_disposed)
        {
            _pulsing = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int? PulseOf(ToolItem item) => Equals(item, _pulsing) ? _pulseCount : null;

    private async Task OpenTool(ToolEntry entry)
    {
        _error = null;
        if (entry.OpensTerminal)
        {
            // Terminals open as a secondary tab of the repository's tab.
            await OnOpenTerminal.InvokeAsync();
            return;
        }

        try
        {
            Tools.Open(entry);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException
            or System.ComponentModel.Win32Exception)
        {
            _error = $"Couldn't open {entry.Label}. {ex.Message}";
        }
    }
}
