@* One repository's card in the side panel's Repositories section. The card's colour says whether it needs attention:
   danger when it's broken or can't be read, warning when it has work that isn't pushed or is out of sync with its
   upstream, and success when it's clean. Clicking the card opens the repository's git graph, or shows it if it's open.
   Its name is a button for the keyboard, whose click reaches the card. A checked-out submodule's part of the card
   opens the submodule's graph instead. A badge for each Pull Request from the workspace branch sits under its name,
   and opens the Pull Request in the browser. *@

<li class="git-status-card card-action @ToneClass" title="Open the git graph of @Repository.Repository.FolderName"
    @onclick="() => OnOpenGraph.InvokeAsync(null)" @oncontextmenu="OnContextMenu" @oncontextmenu:preventDefault>
    <div class="git-status-heading">
        <button type="button" class="git-status-name card-action-name" title="@Repository.WorktreePath">
            @Repository.Repository.FolderName
        </button>
        @if (Label is { } label)
        {
            <span class="git-status-badge">@label</span>
        }
    </div>

    @if (PullRequests is { } pullRequests)
    {
        <PullRequestBadges PullRequests="pullRequests.PullRequests" Problem="@pullRequests.Problem" />
    }

    @if (!Repository.IsLoaded)
    {
        <p class="placeholder">Reading status…</p>
    }
    else if (Repository.IsBroken)
    {
        <p class="git-status-problem">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9v4M12 17h.01" />
            </svg>
            <span>@WorktreeHealthText.Summary(Repository.Health)</span>
        </p>
    }
    else if (Repository.Status is { } status)
    {
        <GitStatusDetails Status="status" OnOpenGraph="path => OnOpenGraph.InvokeAsync(path)" />
    }
    else
    {
        <p class="git-status-problem" title="@Repository.Problem">Couldn't read the status.</p>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public WorkspaceRepositoryStatus Repository { get; set; } = null!;

    /// <summary>
    /// The Pull Requests from the repository's workspace branch, or <see langword="null"/> until they're read.
    /// </summary>
    [Parameter]
    public WorkspaceRepositoryPullRequests? PullRequests { get; set; }

    /// <summary>
    /// Opens a git graph: the repository's (with <see langword="null"/>), or a submodule's, by its path in the
    /// repository.
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnOpenGraph { get; set; }

    /// <summary>
    /// Called when the card is right-clicked, to open its menu.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnContextMenu { get; set; }

    private string? ToneClass => Repository switch
    {
        { IsLoaded: false } => null,
        { IsBroken: true } or { Status: null } => "git-status-card-danger",
        { Status: { } status } when GitStatusText.NeedsAttention(status) => "git-status-card-warning",
        _ => "git-status-card-success",
    };

    private string? Label => Repository switch
    {
        { IsLoaded: false } => null,
        { IsBroken: true } => "Broken",
        { Status: null } => "Unreadable",
        { Status.IsChanged: true } => "Changed",
        { Status: { } status } when GitStatusText.NeedsAttention(status) => "Out of sync",
        _ => "Clean",
    };
}
