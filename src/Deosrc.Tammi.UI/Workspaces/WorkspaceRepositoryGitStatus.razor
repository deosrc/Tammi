@* One repository's card in the side panel's Repositories section. The card's colour says whether it needs attention:
   danger when it's broken or can't be read and warning when it has work that isn't pushed or is out of sync with its
   upstream. A clean card has no label and is styled like a task's card. Clicking the card opens the repository's git
   graph, or shows it if it's open.
   Its name is a button for the keyboard, whose click reaches the card. A checked-out submodule's part of the card
   opens the submodule's graph instead. Under the branch, in sections like a workspace's card on Home: how far it's
   ahead of and behind its upstream, a badge for each Pull Request from the workspace branch (which opens it in the
   browser), and its uncommitted changes. *@

<SidePanelCard Tone="Tone" Hint="@($"Open the git graph of {Repository.Repository.FolderName}")" Badge="@Label"
               OnClick="() => OnOpenGraph.InvokeAsync(null)" OnContextMenu="OnContextMenu">
    <Heading>
        <button type="button" class="git-status-name" title="@Repository.WorktreePath">
            @Repository.Repository.FolderName
        </button>
    </Heading>
    <ChildContent>
        @if (!Repository.IsLoaded)
        {
            <p class="git-status-note">Reading status…</p>
        }
        else if (Repository.IsBroken)
        {
            <p class="git-status-problem">
                <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Color="Color.Error" />
                <span>@WorktreeHealthText.Summary(Repository.Health)</span>
            </p>
        }
        else if (Repository.Status is { } status)
        {
            <GitStatusDetails Status="status" PullRequests="PullRequestSection"
                              OnOpenGraph="path => OnOpenGraph.InvokeAsync(path)" />
        }
        else
        {
            <p class="git-status-problem" title="@Repository.Problem">Couldn't read the status.</p>
        }
    </ChildContent>
</SidePanelCard>

@code {
    [Parameter, EditorRequired]
    public WorkspaceRepositoryStatus Repository { get; set; } = null!;

    /// <summary>
    /// The Pull Requests from the repository's workspace branch, or <see langword="null"/> until they're read.
    /// </summary>
    [Parameter]
    public WorkspaceRepositoryPullRequests? PullRequests { get; set; }

    /// <summary>
    /// Opens a git graph: the repository's (with <see langword="null"/>), or a submodule's, by its path in the
    /// repository.
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnOpenGraph { get; set; }

    /// <summary>
    /// Called when the card is right-clicked, to open its menu.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnContextMenu { get; set; }

    private string? Label => Repository switch
    {
        { IsLoaded: false } => null,
        { IsBroken: true } => "Broken",
        { Status: null } => "Unreadable",
        { Status: { IsChanged: false } status } when GitStatusText.NeedsAttention(status) => "Out of sync",
        _ => null,
    };

    // The Pull Requests' section of the card, when there are any or they couldn't be read.
    private RenderFragment? PullRequestSection => PullRequests is { } pullRequests
        && (pullRequests.PullRequests.Count > 0 || pullRequests.Problem is not null)
            ? @<PullRequestBadges PullRequests="pullRequests.PullRequests" Problem="@pullRequests.Problem" />
            : null;

    private SidePanelCardTone Tone => Repository switch
    {
        { IsLoaded: false } => SidePanelCardTone.Neutral,
        { IsBroken: true } or { Status: null } => SidePanelCardTone.Danger,
        { Status: { } status } when GitStatusText.NeedsAttention(status) => SidePanelCardTone.Warning,
        _ => SidePanelCardTone.Neutral,
    };
}
