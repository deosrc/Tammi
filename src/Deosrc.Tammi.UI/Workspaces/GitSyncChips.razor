@* The ahead and behind counts of a branch (or the sum over a workspace's repositories) as filled badges with an arrow
   and the count. Ahead is work to push (warning); behind is commits to pull (informational). Nothing is shown for a
   count of 0. *@
@if (Ahead > 0 || Behind > 0)
{
    <span class="git-sync-chips @(Inline ? null : "git-sync-chips-end")">
        @if (Ahead > 0)
        {
            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning"
                         IconStart="@(new Icons.Filled.Size12.ArrowUp())" title="@TitleFor(Ahead, "ahead of")">@Ahead</FluentBadge>
        }
        @if (Behind > 0)
        {
            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative"
                         IconStart="@(new Icons.Filled.Size12.ArrowDown())" title="@TitleFor(Behind, "behind")">@Behind</FluentBadge>
        }
    </span>
}

@code {
    [Parameter]
    public int Ahead { get; set; }

    [Parameter]
    public int Behind { get; set; }

    /// <summary>
    /// The upstream the counts are relative to, for the tooltips, if there's a single one.
    /// </summary>
    [Parameter]
    public string? Upstream { get; set; }

    /// <summary>
    /// Whether the chips sit in a row or table cell, instead of being pushed to the end of a card's heading.
    /// </summary>
    [Parameter]
    public bool Inline { get; set; }

    private string TitleFor(int count, string relation) =>
        Upstream is null
            ? $"{count} {(count == 1 ? "commit" : "commits")} {relation.Replace(" of", "")} the upstream"
            : GitStatusText.AheadBehindTitle(count, relation, Upstream);
}
