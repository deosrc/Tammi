@* A Pull Request's badge: coloured by its state (grey for a draft, blue when open, green when merged, red when
   closed), with an icon for its state and its number. A draft or open Pull Request with checks ends with a dot for
   them: red if any failed, amber if any are running, green if all passed. Clicking it opens the Pull Request in the
   browser, and the click stops here, so a card around it doesn't act on it. *@
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@inject IProcessLauncher ProcessLauncher

<button type="button" class="pull-request-badge @StateClass" title="@PullRequestText.Title(PullRequest)"
        aria-label="@PullRequestText.Title(PullRequest)"
        @onclick="OpenInBrowser" @onclick:stopPropagation>
    <PullRequestStateIcon State="PullRequest.State" />
    <span class="pull-request-number">#@PullRequest.Number</span>
    @if (ChecksClass is { } checksClass)
    {
        <span class="pull-request-checks @checksClass" aria-hidden="true"></span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public PullRequestInfo PullRequest { get; set; } = null!;

    private string StateClass => PullRequest.State switch
    {
        PullRequestState.Draft => "pull-request-draft",
        PullRequestState.Open => "pull-request-open",
        PullRequestState.Merged => "pull-request-merged",
        _ => "pull-request-closed",
    };

    // Checks only matter while the Pull Request can still change: not once it's merged or closed.
    private string? ChecksClass => PullRequest is { State: PullRequestState.Draft or PullRequestState.Open, Checks: { } checks }
        ? checks switch
        {
            PullRequestChecks.Failed => "pull-request-checks-failed",
            PullRequestChecks.InProgress => "pull-request-checks-running",
            _ => "pull-request-checks-passed",
        }
        : null;

    private void OpenInBrowser() => ProcessLauncher.Open(PullRequest.Url.AbsoluteUri);
}
