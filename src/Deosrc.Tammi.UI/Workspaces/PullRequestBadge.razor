@* A Pull Request's badge: coloured by its state (grey for a draft, blue when open, green when merged, red when
   closed), with an icon for its state and its number. A draft or open Pull Request with checks ends with a dot for
   them: red if any failed, amber if any are running, green if all passed. Clicking it opens the Pull Request in the
   browser, and the click stops here, so a card around it doesn't act on it. *@
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@inject IProcessLauncher ProcessLauncher

<button type="button" class="pull-request-badge" title="@PullRequestText.Title(PullRequest)"
        aria-label="@PullRequestText.Title(PullRequest)"
        @onclick="OpenInBrowser" @onclick:stopPropagation>
    <FluentBadge Appearance="BadgeAppearance.Filled" Color="ColorOf(PullRequest.State)"
                 IconStart="@IconOf(PullRequest.State)">
        #@PullRequest.Number
        @if (ChecksTone is { } tone)
        {
            <span class="pull-request-checks pull-request-checks-@tone" aria-hidden="true"></span>
        }
    </FluentBadge>
</button>

@code {
    [Parameter, EditorRequired]
    public PullRequestInfo PullRequest { get; set; } = null!;

    private static BadgeColor ColorOf(PullRequestState state) => state switch
    {
        PullRequestState.Draft => BadgeColor.Subtle,
        PullRequestState.Open => BadgeColor.Informative,
        PullRequestState.Merged => BadgeColor.Success,
        _ => BadgeColor.Danger,
    };

    private static Icon IconOf(PullRequestState state) => state switch
    {
        PullRequestState.Draft => new Icons.Regular.Size16.BranchRequestDraft(),
        PullRequestState.Open => new Icons.Regular.Size16.BranchRequest(),
        PullRequestState.Merged => new Icons.Regular.Size16.Branch(),
        _ => new Icons.Regular.Size16.BranchRequestClosed(),
    };

    // Checks only matter while the Pull Request can still change: not once it's merged or closed.
    private string? ChecksTone => PullRequest is { State: PullRequestState.Draft or PullRequestState.Open, Checks: { } checks }
        ? checks switch
        {
            PullRequestChecks.Failed => "error",
            PullRequestChecks.InProgress => "warning",
            _ => "ok",
        }
        : null;

    private void OpenInBrowser() => ProcessLauncher.Open(PullRequest.Url.AbsoluteUri);
}
