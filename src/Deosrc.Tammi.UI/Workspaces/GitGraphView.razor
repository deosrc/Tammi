@implements IAsyncDisposable
@using Deosrc.Tammi.Core.Git
@using Deosrc.Tammi.Core.Settings
@using Deosrc.Tammi.Core.Windowing
@inject IJSRuntime JS
@inject GitGraphViewOptions Options
@inject LayoutStateStore LayoutStore
@inject WorkspaceGitStatusMonitors StatusMonitors
@* A repository's git graph, shown as a main area tab: the commits, newest first, with their lanes, branches and tags,
   and the selected commit's details beside them. Only the rows in view are rendered, and the history is read a page
   at a time as the list scrolls. *@

<div class="git-graph">
    <div class="git-graph-toolbar">
        <div class="segmented" role="group" aria-label="Commits shown">
            <button type="button" class="segmented-option" aria-pressed="@Pressed(GitGraphScope.WorkspaceBranch)"
                    title="HEAD, the workspace branch, its upstream and its merge target"
                    @onclick="() => Graph.SetScopeAsync(GitGraphScope.WorkspaceBranch)">
                Workspace branch
            </button>
            <button type="button" class="segmented-option" aria-pressed="@Pressed(GitGraphScope.Everything)"
                    title="Every branch and tag" @onclick="() => Graph.SetScopeAsync(GitGraphScope.Everything)">
                Everything
            </button>
        </div>
        <span class="git-graph-count">@CountText</span>
        <div class="git-graph-sync" role="group" aria-label="Sync with the remote">
            <button type="button" class="button button-secondary button-icon" title="Download new commits from the remotes"
                    disabled="@(Graph.Syncing is not null)" @onclick="() => Graph.SyncAsync(GitSyncOperation.Fetch)">
                @if (Graph.Syncing == GitSyncOperation.Fetch)
                {
                    <span class="spinner" role="progressbar" aria-label="Fetching"></span>
                }
                else
                {
                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
                    </svg>
                }
                Fetch
            </button>
            <button type="button" class="button button-secondary button-icon"
                    title="Fetch the upstream branch and bring this branch up to date with it"
                    disabled="@(Graph.Syncing is not null)" @onclick="() => Graph.SyncAsync(GitSyncOperation.Pull)">
                @if (Graph.Syncing == GitSyncOperation.Pull)
                {
                    <span class="spinner" role="progressbar" aria-label="Pulling"></span>
                }
                else
                {
                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 5v14M19 12l-7 7-7-7" />
                    </svg>
                }
                Pull
            </button>
            <button type="button" class="button button-secondary button-icon" title="Upload this branch's commits to the remote"
                    disabled="@(Graph.Syncing is not null)" @onclick="() => Graph.SyncAsync(GitSyncOperation.Push)">
                @if (Graph.Syncing == GitSyncOperation.Push)
                {
                    <span class="spinner" role="progressbar" aria-label="Pushing"></span>
                }
                else
                {
                    <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 19V5M5 12l7-7 7 7" />
                    </svg>
                }
                Push
            </button>
        </div>
        <div class="git-graph-sync" role="group" aria-label="Stash">
            <button type="button" class="button button-secondary button-icon"
                    title="Stash every change, including new files"
                    disabled="@((Graph.WorkingChanges?.Count ?? 0) == 0 || _stashing)"
                    @onclick="() => RunStashAsync(Graph.StashAsync())">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 3v11M8 10l4 4 4-4" />
                    <path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" />
                </svg>
                Stash
            </button>
            <button type="button" class="button button-secondary button-icon"
                    title="Apply the newest stash and drop it"
                    disabled="@(Graph.Stashes.Count == 0 || _stashing)"
                    @onclick="() => RunStashAsync(Graph.PopStashAsync(Graph.Stashes[0]))">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 14V3M8 7l4-4 4 4" />
                    <path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" />
                </svg>
                Pop
            </button>
        </div>
        <button type="button" class="button button-secondary button-icon git-graph-refresh" title="Read the graph again"
                aria-label="Refresh" disabled="@Graph.IsLoading" @onclick="Graph.RefreshAsync">
            <svg class="icon icon-small @(Graph.IsLoading ? "icon-spin" : null)" viewBox="0 0 24 24" aria-hidden="true"
                 focusable="false">
                <path d="M21 12a9 9 0 1 1-2.6-6.4L21 8" />
                <path d="M21 3v5h-5" />
            </svg>
        </button>
    </div>

    @* Only a failed fetch, pull or push is shown: the buttons' spinner says one is running. *@
    @if (Graph.Syncing is null && Graph.SyncProblem is { } syncProblem)
    {
        <div class="error git-graph-sync-error" role="alert">
            <div class="git-graph-sync-error-body">
                <p>@syncProblem.Message</p>
                @if (syncProblem.Details.Length > 0)
                {
                    <details>
                        <summary>Git's output</summary>
                        <pre class="git-graph-sync-details">@syncProblem.Details</pre>
                    </details>
                }
            </div>
            <button type="button" class="button button-secondary button-icon git-graph-sync-error-close"
                    title="Dismiss" aria-label="Dismiss the error" @onclick="Graph.DismissSyncProblem">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    }

    @if (Graph.Problem is { } problem)
    {
        <p class="error git-graph-problem">Couldn't read the git graph. @problem</p>
    }

    @if (Graph.TagProblem is { } tagProblem)
    {
        <div class="error git-graph-sync-error" role="alert">
            <div class="git-graph-sync-error-body">
                <p>@tagProblem</p>
            </div>
            <button type="button" class="button button-secondary button-icon git-graph-sync-error-close"
                    title="Dismiss" aria-label="Dismiss the error" @onclick="Graph.DismissTagProblem">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    }

    @if (Graph.BranchProblem is { } branchProblem)
    {
        <div class="error git-graph-sync-error" role="alert">
            <div class="git-graph-sync-error-body">
                <p>@branchProblem</p>
            </div>
            <button type="button" class="button button-secondary button-icon git-graph-sync-error-close"
                    title="Dismiss" aria-label="Dismiss the error" @onclick="Graph.DismissBranchProblem">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    }

    @if (Graph.DropRequest is { } dropRequest)
    {
        <div class="alert alert-warning git-graph-drop-confirm" role="alertdialog" aria-labelledby="confirm-drop-stash-title">
            <h3 id="confirm-drop-stash-title" class="alert-title">Drop @dropRequest.Name?</h3>
            <p>
                "@dropRequest.Message" is deleted without being applied, and Tammi can't bring it back.
            </p>
            <div class="settings-field-row">
                <button type="button" class="button button-danger" disabled="@_stashing"
                        @onclick="() => RunStashAsync(Graph.ConfirmDropStashAsync())">Drop stash</button>
                <button type="button" class="button button-secondary" disabled="@_stashing"
                        @onclick="Graph.CancelDropStash">Cancel</button>
            </div>
        </div>
    }

    @if (Graph.PendingReset is { } reset)
    {
        <div class="alert alert-warning git-graph-drop-confirm" role="alertdialog" aria-labelledby="confirm-reset-title">
            <h3 id="confirm-reset-title" class="alert-title">
                @ResetTitle(reset.Mode) @(Graph.Refs.HeadBranch ?? "HEAD") to @reset.Sha[..Math.Min(7, reset.Sha.Length)]?
            </h3>
            <p>@ResetText(reset.Mode)</p>
            <div class="settings-field-row">
                <button type="button" class="button @(reset.Mode == GitResetMode.Hard ? "button-danger" : null)"
                        @onclick="Graph.ConfirmResetAsync">@ResetTitle(reset.Mode)</button>
                <button type="button" class="button button-secondary" @onclick="Graph.CancelReset">Cancel</button>
            </div>
        </div>
    }

    @if (Graph.StashProblem is { } stashProblem)
    {
        <div class="error git-graph-sync-error" role="alert">
            <div class="git-graph-sync-error-body">
                <p>@stashProblem</p>
            </div>
            <button type="button" class="button button-secondary button-icon git-graph-sync-error-close"
                    title="Dismiss" aria-label="Dismiss the error" @onclick="Graph.DismissStashProblem">
                <svg class="icon icon-small" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    }

    @if (_branchPrompt is { } branchPrompt)
    {
        <form class="git-graph-tag-prompt" @onsubmit="SubmitBranchPromptAsync" @onsubmit:preventDefault="true">
            <label>
                @(branchPrompt.Kind == BranchPromptKind.Rename ? $"New name for {branchPrompt.Name}" : "Branch name")
                <input type="text" class="input" @bind="_branchName" @bind:event="oninput" @ref="_branchInput"
                       spellcheck="false" />
            </label>
            <div class="git-graph-tag-prompt-actions">
                <button type="submit" class="button" disabled="@(!CanSubmitBranchPrompt)">
                    @(branchPrompt.Kind == BranchPromptKind.Create ? "Create and checkout" : "Rename branch")
                </button>
                @if (branchPrompt.Kind == BranchPromptKind.Create)
                {
                    <button type="button" class="button button-secondary" disabled="@(!CanSubmitBranchPrompt)"
                            @onclick="() => SubmitBranchPromptAsync(checkout: false)">
                        Create branch
                    </button>
                }
                <button type="button" class="button button-secondary" @onclick="() => _branchPrompt = null">Cancel</button>
            </div>
        </form>
    }

    @if (_confirm is { } confirm)
    {
        <form class="git-graph-tag-prompt" role="alertdialog" aria-label="Confirm delete"
              @onsubmit="ConfirmAsync" @onsubmit:preventDefault="true">
            <p>@confirm.Message</p>
            <div class="git-graph-tag-prompt-actions">
                <button type="submit" class="button button-danger" @ref="_confirmButton">Delete</button>
                <button type="button" class="button button-secondary" @onclick="() => _confirm = null">Cancel</button>
            </div>
        </form>
    }

    @if (_tagPrompt is { } prompt)
    {
        <form class="git-graph-tag-prompt" @onsubmit="() => SubmitTagPromptAsync(push: false)" @onsubmit:preventDefault="true">
            <label>
                Tag name
                <input type="text" class="input" @bind="_tagName" @bind:event="oninput" autofocus
                       spellcheck="false" />
            </label>
            <div class="git-graph-tag-prompt-actions">
                <button type="submit" class="button" disabled="@(!CanSubmitTagPrompt)">
                    Create tag
                </button>
                <button type="button" class="button button-secondary" disabled="@(!CanSubmitTagPrompt)"
                        @onclick="() => SubmitTagPromptAsync(push: true)">
                    Create and push tag
                </button>
                <button type="button" class="button button-secondary" @onclick="() => _tagPrompt = null">Cancel</button>
            </div>
        </form>
    }

    @if (_stashMenu is { } stashMenu)
    {
        <ContextMenu @key="stashMenu" X="stashMenu.X" Y="stashMenu.Y" Label="Stash" OnClose="() => _stashMenu = null">
            <li role="none">
                <button type="button" class="menu-item" role="menuitem" disabled="@_stashing"
                        @onclick="() => RunStashMenuAsync(Graph.PopStashAsync(stashMenu.Stash))">Pop stash</button>
            </li>
            <li role="none">
                <button type="button" class="menu-item" role="menuitem" disabled="@_stashing"
                        @onclick="() => RunStashMenuAsync(Graph.ApplyStashAsync(stashMenu.Stash))">Apply stash</button>
            </li>
            <li role="none">
                <button type="button" class="menu-item menu-item-danger" role="menuitem" disabled="@_stashing"
                        @onclick="() => ConfirmDrop(stashMenu.Stash)">Drop stash</button>
            </li>
        </ContextMenu>
    }

    @if (_commitMenu is { } commitMenu)
    {
        <ContextMenu @key="commitMenu" X="commitMenu.X" Y="commitMenu.Y" Label="Commit" OnClose="CloseCommitMenu">
            @if (Graph.Refs.HeadBranch is not null)
            {
                var mergeable = commitMenu.Branches.Where(b => b != Graph.Refs.HeadBranch).ToList();
                @foreach (var branch in mergeable)
                {
                    <li role="none">
                        <button type="button" class="menu-item" role="menuitem"
                                @onclick="() => RunBranchAsync(() => Graph.MergeBranchAsync(branch))">
                            Merge @branch
                        </button>
                    </li>
                    <li role="none">
                        <button type="button" class="menu-item" role="menuitem"
                                @onclick="() => RunBranchAsync(() => Graph.RebaseBranchAsync(branch))">
                            Rebase onto @branch
                        </button>
                    </li>
                }
                @if (mergeable.Count > 0)
                {
                    <li role="separator" class="menu-separator"></li>
                }
            }
            <li role="none">
                <button type="button" class="menu-item" role="menuitem" @onclick="() => StartCreateBranch(commitMenu)">
                    Create branch…
                </button>
            </li>
            @foreach (var mode in new[] { GitResetMode.Soft, GitResetMode.Mixed, GitResetMode.Hard })
            {
                <li role="none">
                    <button type="button" class="menu-item @(mode == GitResetMode.Hard ? "menu-item-danger" : null)"
                            role="menuitem" disabled="@(Graph.Refs.HeadBranch is null)"
                            title="@ResetText(mode)" @onclick="() => StartReset(commitMenu, mode)">
                        @ResetTitle(mode)…
                    </button>
                </li>
            }
            @foreach (var branch in commitMenu.Branches)
            {
                var isCurrent = branch == Graph.Refs.HeadBranch;
                var isWorkspace = Graph.IsWorkspaceBranch(branch);
                <li role="none">
                    <button type="button" class="menu-item" role="menuitem" disabled="@isCurrent"
                            @onclick="() => RunBranchAsync(() => Graph.CheckoutBranchAsync(branch))">
                        Checkout @branch@(isCurrent ? " (current)" : null)
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="menu-item" role="menuitem" disabled="@isWorkspace"
                            title="@(isWorkspace ? "The workspace branch can't be renamed here" : null)"
                            @onclick="() => StartRenameBranch(branch)">
                        Rename branch @branch…
                    </button>
                </li>
                var deleteKey = DeleteBranchSubmenu + branch;
                var hasUpstream = commitMenu.Upstreams.TryGetValue(branch, out var upstream);
                <li role="none" class="menu-submenu-anchor" @onmouseenter="() => commitMenu.OpenSubmenu = deleteKey">
                    <button type="button" class="menu-item menu-item-danger" role="menuitem" aria-haspopup="menu" disabled="@isWorkspace"
                            title="@(isWorkspace ? "The workspace branch can't be deleted here" : null)"
                            aria-expanded="@(commitMenu.OpenSubmenu == deleteKey ? "true" : "false")"
                            @onclick="() => ToggleSubmenu(commitMenu, deleteKey)">
                        <span class="tab-label-text">Delete branch @branch…</span>
                        <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="9 6 15 12 9 18"></polyline>
                        </svg>
                    </button>
                    @if (commitMenu.OpenSubmenu == deleteKey && !isWorkspace)
                    {
                        <ul class="menu menu-submenu" role="menu" aria-label="Delete branch">
                            <li role="none">
                                <button type="button" class="menu-item" role="menuitem" disabled="@isCurrent"
                                        title="@(isCurrent ? "The checked out branch can't be deleted" : null)"
                                        @onclick="() => ConfirmDeleteBranch(branch, deleteLocal: true, deleteRemote: false, upstream)">
                                    Local branch
                                </button>
                            </li>
                            <li role="none">
                                <button type="button" class="menu-item" role="menuitem" disabled="@(upstream is null)"
                                        @onclick="() => ConfirmDeleteBranch(branch, deleteLocal: false, deleteRemote: true, upstream)">
                                    Remote branch@(!hasUpstream ? " (checking...)" : upstream is null ? " (none)" : $" ({upstream.Remote}/{upstream.Branch})")
                                </button>
                            </li>
                            <li role="none">
                                <button type="button" class="menu-item" role="menuitem" disabled="@(isCurrent || upstream is null)"
                                        title="@(isCurrent ? "The checked out branch can't be deleted" : null)"
                                        @onclick="() => ConfirmDeleteBranch(branch, deleteLocal: true, deleteRemote: true, upstream)">
                                    Local and remote branch
                                </button>
                            </li>
                        </ul>
                    }
                </li>
            }
            @foreach (var branch in commitMenu.RemoteBranches)
            {
                <li role="separator" class="menu-separator"></li>
                <li role="none">
                    <button type="button" class="menu-item" role="menuitem"
                            @onclick="() => RunBranchAsync(() => Graph.CheckoutBranchAsync(branch))">
                        Checkout @branch
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="menu-item menu-item-danger" role="menuitem"
                            @onclick="() => ConfirmDeleteRemoteBranch(branch)">
                        Delete remote branch @branch…
                    </button>
                </li>
            }
            <li role="separator" class="menu-separator"></li>
            <li role="none">
                <button type="button" class="menu-item" role="menuitem" @onclick="() => StartCreateTag(commitMenu)">
                    Create tag…
                </button>
            </li>
            @if (commitMenu.Tags.Count == 1)
            {
                var tag = commitMenu.Tags[0];
                <li role="none">
                    <button type="button" class="menu-item" role="menuitem"
                            disabled="@(PushState(commitMenu, tag) is not false)"
                            @onclick="() => RunTagAsync(commitMenu, () => Graph.PushTagAsync(tag))">
                        Push tag @tag@(PushState(commitMenu, tag) is null ? " (checking...)" : PushState(commitMenu, tag) is true ? $" (already on {commitMenu.Remote})" : null)
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="menu-item menu-item-danger" role="menuitem"
                            @onclick="() => ConfirmDeleteTag(commitMenu, tag)">
                        Delete tag @tag@DeleteSuffix(commitMenu, tag)
                    </button>
                </li>
            }
            else if (commitMenu.Tags.Count > 1)
            {
                <li role="none" class="menu-submenu-anchor" @onmouseenter="() => commitMenu.OpenSubmenu = PushSubmenu">
                    <button type="button" class="menu-item" role="menuitem" aria-haspopup="menu"
                            aria-expanded="@(commitMenu.OpenSubmenu == PushSubmenu ? "true" : "false")"
                            @onclick="() => ToggleSubmenu(commitMenu, PushSubmenu)">
                        <span class="tab-label-text">Push tag…</span>
                        <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="9 6 15 12 9 18"></polyline>
                        </svg>
                    </button>
                    @if (commitMenu.OpenSubmenu == PushSubmenu)
                    {
                        <ul class="menu menu-submenu" role="menu" aria-label="Push tag">
                            @foreach (var tag in commitMenu.Tags)
                            {
                                var state = PushState(commitMenu, tag);
                                <li role="none">
                                    <button type="button" class="menu-item" role="menuitem" disabled="@(state is not false)"
                                            @onclick="() => RunTagAsync(commitMenu, () => Graph.PushTagAsync(tag))">
                                        @tag@(state is null ? " (checking...)" : state is true ? $" (already on {commitMenu.Remote})" : null)
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </li>
                <li role="none" class="menu-submenu-anchor" @onmouseenter="() => commitMenu.OpenSubmenu = DeleteSubmenu">
                    <button type="button" class="menu-item menu-item-danger" role="menuitem" aria-haspopup="menu"
                            aria-expanded="@(commitMenu.OpenSubmenu == DeleteSubmenu ? "true" : "false")"
                            @onclick="() => ToggleSubmenu(commitMenu, DeleteSubmenu)">
                        <span class="tab-label-text">Delete tag…</span>
                        <svg class="icon icon-small menu-item-end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="9 6 15 12 9 18"></polyline>
                        </svg>
                    </button>
                    @if (commitMenu.OpenSubmenu == DeleteSubmenu)
                    {
                        <ul class="menu menu-submenu" role="menu" aria-label="Delete tag">
                            @foreach (var tag in commitMenu.Tags)
                            {
                                <li role="none">
                                    <button type="button" class="menu-item" role="menuitem"
                                            @onclick="() => ConfirmDeleteTag(commitMenu, tag)">
                                        @tag@DeleteSuffix(commitMenu, tag)
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ContextMenu>
    }

    <div class="git-graph-body" @ref="_body">
        @* A diff takes the place of the list only, so the details stay beside it. The list stays in the page, only
           hidden, so it keeps its scroll position and selection. *@
        @if (Graph.DiffTarget is not null)
        {
            <GitFileDiffView Graph="Graph" />
        }

        <div class="git-graph-list" tabindex="0" @ref="_list" hidden="@(Graph.DiffTarget is not null)"
             style="@ListStyle" @onkeydown="OnKeyDownAsync">
            @* Stays at the top as the list scrolls down, and scrolls sideways with it. Each column but Description,
               which takes the space left, has a handle on the edge towards Description that resizes it. Right-clicking
               it shows or hides columns and labels. *@
            <div class="git-graph-header" @ref="_header" @oncontextmenu="OpenViewMenu"
                 @oncontextmenu:preventDefault="true">
                @foreach (var column in _visibleColumns)
                {
                    <span class="git-graph-heading" @key="column">
                        @if (column > GitGraphColumn.Description)
                        {
                            @ColumnHandle(column, end: false)
                        }
                        <span class="git-graph-heading-label">@column</span>
                        @if (column < GitGraphColumn.Description)
                        {
                            @ColumnHandle(column, end: true)
                        }
                    </span>
                }
            </div>
            @if (_viewMenu is { } menuAt)
            {
                <div class="menu-backdrop" @onclick="CloseViewMenu"
                     @oncontextmenu="CloseViewMenu" @oncontextmenu:preventDefault="true"></div>
                <ul class="menu git-graph-view-menu" role="menu" aria-label="View" @onkeydown="OnViewMenuKeyDown"
                    style="@FormattableString.Invariant($"left: {menuAt.X}px; top: {menuAt.Y}px")">
                    @* The columns, then the rows' labels. Graph is always shown, so it isn't offered. Description is,
                       greyed out, as the column the others give their space to. *@
                    @foreach (var column in Enum.GetValues<GitGraphColumn>().Where(column => column != GitGraphColumn.Graph))
                    {
                        @MenuCheckbox(
                            column.ToString(),
                            Options.IsVisible(column),
                            GitGraphViewOptions.CanHide(column),
                            () => Options.ToggleColumn(column))
                    }
                    <li role="separator" class="menu-separator"></li>
                    @MenuCheckbox("Tags", Options.ShowTags, enabled: true, Options.ToggleTags)
                    @MenuCheckbox("Remote branches", Options.ShowRemoteBranches, enabled: true, Options.ToggleRemoteBranches)
                </ul>
            }
            @* The changes not yet committed, as a row above the commits, with a dashed line down to HEAD. There
               is no row while there are none. *@
            @if (Graph.WorkingChanges is { Count: > 0 })
            {
                <div class="git-graph-row git-graph-working @(Graph.IsWorkingChangesSelected ? "selected" : null)"
                     role="option" aria-selected="@(Graph.IsWorkingChangesSelected ? "true" : "false")"
                     @onclick="Graph.SelectWorkingChangesAsync">
                    @foreach (var column in _visibleColumns)
                    {
                        @switch (column)
                        {
                            case GitGraphColumn.Graph:
                                <span class="git-graph-lane-cell">
                                    <svg class="git-graph-lanes" width="@GraphWidth" height="@GitGraphRowView.RowHeight"
                                         viewBox="0 0 @GraphWidth @GitGraphRowView.RowHeight" aria-hidden="true" focusable="false">
                                        <path class="git-graph-working-line" d="@WorkingLinePath" />
                                        <circle class="git-graph-working-dot" cx="@WorkingX" cy="@(GitGraphRowView.RowHeight / 2.0)" r="4" />
                                    </svg>
                                </span>
                                break;
                            case GitGraphColumn.Description:
                                <span class="git-graph-summary">
                                    <span class="git-graph-subject git-graph-working-label">Working changes</span>
                                    <span class="git-graph-working-counts">@WorkingCounts</span>
                                </span>
                                break;
                            default:
                                <span></span>
                                break;
                        }
                    }
                </div>
            }
            <div role="listbox" aria-label="Commits">
                <Virtualize @ref="_virtualize" TItem="GitGraphItem" ItemsProvider="ProvideRowsAsync"
                            ItemSize="GitGraphRowView.RowHeight" OverscanCount="30">
                    <ItemContent Context="item">
                        @if (item.Stash is { } stash)
                        {
                            @StashRow(item, stash)
                            return;
                        }

                        @{
                            var row = item.Row!;
                            var selected = row.Commit.Sha == Graph.Selected?.Commit.Sha;
                            var isHead = row.Commit.Sha == Graph.Refs.HeadSha;
                        }
                        <div class="git-graph-row @(selected ? "selected" : null)" role="option"
                             aria-selected="@(selected ? "true" : "false")" @key="row.Commit.Sha"
                             @onclick="() => Graph.SelectAsync(row.Commit.Sha)"
                             @oncontextmenu="e => OpenCommitMenuAsync(row.Commit.Sha, e)"
                             @oncontextmenu:preventDefault="true">
                            @foreach (var column in _visibleColumns)
                            {
                                @switch (column)
                                {
                                    case GitGraphColumn.Graph:
                                        <span class="git-graph-lane-cell">
                                            <GitGraphRowView Row="row" Width="GraphWidth" IsHead="isHead" PassLanes="item.PassLanes" EndLines="item.EndLines" />
                                        </span>
                                        break;
                                    case GitGraphColumn.Description:
                                        <span class="git-graph-summary">
                                            @References(row.Commit.Sha, isHead)
                                            <span class="git-graph-subject" title="@row.Commit.Subject">@row.Commit.Subject</span>
                                        </span>
                                        break;
                                    case GitGraphColumn.Author:
                                        <span class="git-graph-author" title="@row.Commit.Author.Email">@row.Commit.Author.Name</span>
                                        break;
                                    case GitGraphColumn.Date:
                                        <span class="git-graph-date" title="@GitGraphText.FullDate(row.Commit.Author.When)">
                                            @GitGraphText.When(row.Commit.Author.When, _now)
                                        </span>
                                        break;
                                    case GitGraphColumn.Commit:
                                        <span class="git-graph-sha">@GitGraphText.ShortSha(row.Commit.Sha)</span>
                                        break;
                                }
                            }
                        </div>
                    </ItemContent>
                    <Placeholder>
                        <div class="git-graph-row git-graph-row-placeholder"></div>
                    </Placeholder>
                </Virtualize>
            </div>
        </div>

        @* Resizes the details panel: drag it, or focus it and use Left and Right. *@
        <div class="git-graph-splitter" role="separator" aria-orientation="vertical" aria-label="Resize commit details"
             aria-controls="@_detailsId" tabindex="0" title="Drag to resize. Double-click to reset." @ref="_splitter">
        </div>

        <aside class="git-graph-details" id="@_detailsId" aria-label="Commit details">
            @if (Graph.IsWorkingChangesSelected)
            {
                <GitWorkingChanges Graph="Graph" />
            }
            else
            {
                <GitCommitDetails Graph="Graph" />
            }
        </aside>
    </div>
</div>

@code {
    // Wider graphs are cut off, so the commits' text stays in view.
    private const int MaxLanes = 24;

    private WorkspaceGitGraph? _attached;
    // Where the header's right-click menu is open, in the window, or null when it's closed.
    private (double X, double Y)? _viewMenu;
    private IReadOnlyList<GitGraphColumn> _visibleColumns = [];
    private readonly string _detailsId = $"git-graph-details-{Guid.NewGuid():N}";
    private ElementReference _list;
    private ElementReference _header;
    private ElementReference _body;
    private ElementReference _splitter;
    private ElementReference _branchInput;
    private ElementReference _confirmButton;

    // Set when the branch prompt or the delete confirmation opens, so the next render moves focus into it.
    private bool _focusBranchInput;
    private bool _focusConfirm;
    private IJSObjectReference? _splitterScript;
    private DotNetObjectReference<GitGraphView>? _self;
    private Virtualize<GitGraphItem>? _virtualize;
    private IJSObjectReference? _module;
    private IJSObjectReference? _listScript;
    private IReadOnlyList<GitGraphRow> _shownRows = [];
    private IReadOnlyList<GitStashEntry> _shownStashes = [];
    private IReadOnlyList<GitGraphItem> _items = [];
    private GitGraphScope _shownScope;
    private DateTimeOffset _now = DateTimeOffset.Now;
    private WorkspaceGitStatusMonitor? _monitor;
    private bool _disposed;
    private bool _stashing;

    [Parameter, EditorRequired]
    public WorkspaceGitGraph Graph { get; set; } = null!;

    // Where a stash's right-click menu is open, or null when it's closed.
    private sealed record StashMenu(double X, double Y, GitStashEntry Stash);

    private StashMenu? _stashMenu;

    private void ConfirmDrop(GitStashEntry stash)
    {
        _stashMenu = null;
        Graph.RequestDropStash(stash);
    }

    private Task RunStashMenuAsync(Task<bool> action)
    {
        _stashMenu = null;
        return RunStashAsync(action);
    }

    private async Task RunStashAsync(Task<bool> action)
    {
        _stashing = true;
        try
        {
            await action;
        }
        finally
        {
            _stashing = false;
        }
    }

    // A stash that isn't above the end of a branch has a lane to the right of the others.
    private int GraphWidth => Math.Clamp(Graph.LaneCount + (_items.Any(item => item.IsSide) ? 1 : 0), 1, MaxLanes) * GitGraphRowView.LaneWidth;

    // The working changes' dot is in HEAD's lane, with a dashed line down to HEAD's row.
    private int WorkingLane => Graph.Rows.FirstOrDefault(row => row.Commit.Sha == Graph.HeadSha)?.Lane is { } lane
        ? Math.Min(lane, MaxLanes - 1)
        : 0;

    private double WorkingX => WorkingLane * GitGraphRowView.LaneWidth + GitGraphRowView.LaneWidth / 2.0;

    private string WorkingLinePath => FormattableString.Invariant(
        $"M{WorkingX} {GitGraphRowView.RowHeight / 2.0}V{GitGraphRowView.RowHeight}");

    private string WorkingCounts => Graph.WorkingChanges is null
        ? ""
        : $"{Graph.UnstagedChanges.Count} unstaged, {Graph.StagedChanges.Count} staged";

    private string CountText => Graph.Rows.Count switch
    {
        0 when Graph.IsLoading => "Reading commits…",
        1 when Graph.IsComplete => "1 commit",
        var count when Graph.IsComplete => $"{count:N0} commits",
        var count => $"{count:N0}+ commits",
    };

    protected override void OnInitialized()
    {
        _visibleColumns = Options.VisibleColumns;
        Options.Changed += OnOptionsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_attached, Graph))
        {
            return;
        }

        if (_attached is not null)
        {
            _attached.Changed -= OnGraphChanged;
        }

        _attached = Graph;
        _shownScope = Graph.Scope;
        Graph.Changed += OnGraphChanged;

        // The files and refs change as the user works, so keep up with them.
        if (_monitor is not null)
        {
            _monitor.Changed -= OnFilesChanged;
        }

        _monitor = StatusMonitors.Find(Graph.WorkspaceId);
        if (_monitor is not null)
        {
            _monitor.Changed += OnFilesChanged;
        }

        // The first time, this reads the first page. Coming back to a graph read before, it's read again only if its
        // refs have changed.
        await Graph.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBranchInput && _branchPrompt is not null)
        {
            _focusBranchInput = false;
            await _branchInput.FocusAsync();
        }
        else if (_focusConfirm && _confirm is not null)
        {
            _focusConfirm = false;
            await _confirmButton.FocusAsync();
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Deosrc.Tammi.UI/Workspaces/GitGraphView.razor.js");
            _listScript = await _module.InvokeAsync<IJSObjectReference>("attach", _list, _header);
            _self = DotNetObjectReference.Create(this);
            _splitterScript = await _module.InvokeAsync<IJSObjectReference>(
                "attachSplitter",
                _body,
                _splitter,
                LayoutStore.Current.GitGraphDetailsWidth,
                _self);
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Options.Changed -= OnOptionsChanged;
        if (_monitor is not null)
        {
            _monitor.Changed -= OnFilesChanged;
        }

        if (_attached is not null)
        {
            _attached.Changed -= OnGraphChanged;
        }

        try
        {
            foreach (var script in new[] { _listScript, _splitterScript })
            {
                if (script is not null)
                {
                    await script.InvokeVoidAsync("dispose");
                    await script.DisposeAsync();
                }
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone, and the list with it.
        }

        _self?.Dispose();
    }

    // The user resized the details panel: keep the width they chose (null for the default) for next time. Failing to
    // save only means it opens at its old width after a restart.
    [JSInvokable]
    public Task OnDetailsWidthChanged(int? width) =>
        LayoutStore.UpdateAsync(state => state with { GitGraphDetailsWidth = width });

    private void OnFilesChanged()
    {
        if (!_disposed)
        {
            _ = Graph.RefreshWorkingChangesAsync();
            _ = Graph.RefreshIfChangedAsync();
        }
    }

    private string Pressed(GitGraphScope scope) => Graph.Scope == scope ? "true" : "false";

    // Gives the list the rows it asks for, reading more of the history when it scrolls past what's been read. Until
    // every commit is read, the list is a page longer than what's been read, so it can scroll on.
    private async ValueTask<ItemsProviderResult<GitGraphItem>> ProvideRowsAsync(ItemsProviderRequest request)
    {
        // The stashes are among the commits, so they count too.
        if (request.StartIndex + request.Count > _items.Count && !Graph.IsComplete)
        {
            await Graph.LoadMoreAsync();
        }

        _shownRows = Graph.Rows;
        _shownStashes = Graph.Stashes;
        _items = GitGraphItem.Build(
            _shownRows,
            _shownStashes,
            Graph.IsComplete,
            Graph.LaneCount,
            MaxLanes - 1,
            Graph.WorkingChanges is { Count: > 0 } ? Graph.HeadSha : null);
        var start = Math.Min(request.StartIndex, _items.Count);
        var count = Math.Min(request.Count, _items.Count - start);
        var total = Graph.IsComplete ? _items.Count : _items.Count + WorkspaceGitGraph.PageSize;
        return new ItemsProviderResult<GitGraphItem>(_items.Skip(start).Take(count), total);
    }

    // A stash's row among the commits: its square in the lane of the commit it was made on, with a dotted line down to
    // that commit, which also runs through the rows between.
    private RenderFragment StashRow(GitGraphItem item, GitStashEntry stash) => __builder =>
    {
        <div class="git-graph-row git-graph-stash @(Graph.SelectedStash?.Sha == stash.Sha ? "selected" : null)" role="option"
             aria-selected="@(Graph.SelectedStash?.Sha == stash.Sha ? "true" : "false")" @key="@($"stash-{stash.Sha}")"
             title="@stash.Name, @GitGraphText.FullDate(stash.CreatedAt)" @onclick="() => Graph.SelectStashAsync(stash)"
             @oncontextmenu="e => _stashMenu = new StashMenu(e.ClientX, e.ClientY, stash)"
             @oncontextmenu:preventDefault="true">
            @foreach (var column in _visibleColumns)
            {
                @switch (column)
                {
                    case GitGraphColumn.Graph:
                        <span class="git-graph-lane-cell">
                            <svg class="git-graph-lanes" width="@GraphWidth" height="@GitGraphRowView.RowHeight"
                                 viewBox="0 0 @GraphWidth @GitGraphRowView.RowHeight" aria-hidden="true" focusable="false">
                                @foreach (var (lane, colour) in item.CommitLanes)
                                {
                                    <path d="@StashLine(lane, 0, GitGraphRowView.RowHeight)"
                                          style="stroke: var(--color-graph-@(colour % GitGraphRowView.ColourCount))" />
                                }
                                @foreach (var lane in item.PassLanes)
                                {
                                    <path class="git-graph-stash-line" d="@StashLine(lane, 0, GitGraphRowView.RowHeight)" />
                                }
                                @if (item.HasLine)
                                {
                                    <path class="git-graph-stash-line"
                                          d="@StashLine(item.Lane, GitGraphRowView.RowHeight / 2.0, GitGraphRowView.RowHeight)" />
                                }
                                <rect class="git-graph-stash-dot" x="@(LaneX(item.Lane) - 4)"
                                      y="@(GitGraphRowView.RowHeight / 2.0 - 4)" width="8" height="8" />
                            </svg>
                        </span>
                        break;
                    case GitGraphColumn.Description:
                        <span class="git-graph-summary">
                            <span class="git-graph-subject git-graph-working-label">@stash.Message</span>
                        </span>
                        break;
                    case GitGraphColumn.Date:
                        <span class="git-graph-date" title="@GitGraphText.FullDate(stash.CreatedAt)">@GitGraphText.When(stash.CreatedAt, _now)</span>
                        break;
                    default:
                        <span></span>
                        break;
                }
            }
        </div>
    };

    private static double LaneX(int lane) => lane * GitGraphRowView.LaneWidth + GitGraphRowView.LaneWidth / 2.0;

    private static string StashLine(int lane, double top, double bottom) =>
        FormattableString.Invariant($"M{LaneX(lane)} {top}V{bottom}");

    private void OnGraphChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed)
        {
            return;
        }

        _now = DateTimeOffset.Now;
        var scopeChanged = _shownScope != Graph.Scope;
        _shownScope = Graph.Scope;

        // Rows read while scrolling are already shown. Otherwise the graph was read again (e.g. after a commit), and
        // the list shows it from the start. Other commits start at the top.
        if ((!ReferenceEquals(_shownRows, Graph.Rows) || !ReferenceEquals(_shownStashes, Graph.Stashes)) && _virtualize is not null)
        {
            _shownRows = Graph.Rows;
            _shownStashes = Graph.Stashes;
            if (scopeChanged)
            {
                await ScrollToTopAsync();
            }

            await _virtualize.RefreshDataAsync();
        }

        StateHasChanged();
    });

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var rows = Graph.Rows;
        if (rows.Count == 0 || e.Key is not ("ArrowUp" or "ArrowDown" or "Home"))
        {
            return;
        }

        var index = Graph.Selected is { } selected ? IndexOf(selected.Commit.Sha) : -1;
        index = e.Key switch
        {
            "Home" => 0,
            "ArrowUp" => Math.Max(index - 1, 0),
            _ => Math.Min(index + 1, rows.Count - 1),
        };

        await SelectAndRevealAsync(rows[index].Commit.Sha);
    }

    // Selects a commit that's been read and scrolls the list to it.
    private async Task SelectAndRevealAsync(string sha)
    {
        var index = IndexOf(sha);
        if (index < 0)
        {
            return;
        }

        // The list's rows include the stashes among the commits.
        var itemIndex = _items.ToList().FindIndex(item => item.Row?.Commit.Sha == sha);
        if (itemIndex >= 0)
        {
            index = itemIndex;
        }

        await Graph.SelectAsync(sha);
        if (_listScript is not null)
        {
            try
            {
                await _listScript.InvokeVoidAsync("reveal", index, GitGraphRowView.RowHeight);
            }
            catch (JSDisconnectedException)
            {
                // The web view has gone.
            }
        }
    }

    private async Task ScrollToTopAsync()
    {
        if (_listScript is null)
        {
            return;
        }

        try
        {
            await _listScript.InvokeVoidAsync("scrollToTop");
        }
        catch (JSDisconnectedException)
        {
            // The web view has gone.
        }
    }

    private int IndexOf(string sha)
    {
        var rows = Graph.Rows;
        for (var i = 0; i < rows.Count; i++)
        {
            if (rows[i].Commit.Sha == sha)
            {
                return i;
            }
        }

        return -1;
    }

    // Where a commit's right-click menu is open, or null when it's closed. RemoteTags says, for each of the commit's
    // tags, whether the remote has it, once that's known.
    private sealed record CommitMenu(double X, double Y, string Sha, IReadOnlyList<string> Tags, IReadOnlyList<string> Branches, IReadOnlyList<string> RemoteBranches)
    {
        // The submenu that's open, if any, and the remote the tags are pushed to once that's known.
        public string? OpenSubmenu { get; set; }

        public string? Remote { get; set; }

        // Each local branch's upstream (null for none), once it's been read.
        public IReadOnlyDictionary<string, GitUpstream?> Upstreams { get; set; } = new Dictionary<string, GitUpstream?>();

        public IReadOnlyDictionary<string, bool> RemoteTags { get; set; } = new Dictionary<string, bool>();
    }

    private enum BranchPromptKind { Create, Rename }

    // Asks for a branch's name. For Create, Name is the commit; for Rename, the branch.
    private sealed record BranchPrompt(BranchPromptKind Kind, string Name);

    // Asks the user to confirm a delete before it's done.
    private sealed record Confirmation(string Message, Func<Task<bool>> Action);

    private BranchPrompt? _branchPrompt;
    private Confirmation? _confirm;
    private string _branchName = "";

    private bool CanSubmitBranchPrompt => _branchPrompt is not null && !string.IsNullOrWhiteSpace(_branchName);

    private void ConfirmDelete(string message, Func<Task<bool>> action)
    {
        _commitMenu = null;
        _confirm = new Confirmation(message, action);
        _focusConfirm = true;
    }

    private void ConfirmDeleteBranch(string branch, bool deleteLocal, bool deleteRemote, GitUpstream? upstream)
    {
        string remote = upstream is null ? "" : $"{upstream.Remote}/{upstream.Branch}";
        string message = (deleteLocal, deleteRemote) switch
        {
            (true, true) => $"Delete the local branch {branch} and the remote branch {remote}? Commits only on them may be lost.",
            (true, false) => $"Delete the local branch {branch}? Commits only on it may be lost.",
            _ => $"Delete the remote branch {remote}?",
        };
        ConfirmDelete(message, () => Graph.DeleteBranchAsync(branch, deleteLocal, deleteRemote));
    }

    private void ConfirmDeleteRemoteBranch(string branch) =>
        ConfirmDelete($"Delete the remote branch {branch}?", () => Graph.DeleteRemoteBranchAsync(branch));

    private void ConfirmDeleteTag(CommitMenu menu, string tag) =>
        ConfirmDelete($"Delete the tag {tag}{DeleteTargets(menu, tag)}?", () => Graph.DeleteTagAsync(tag));

    private void StartReset(CommitMenu menu, GitResetMode mode)
    {
        _commitMenu = null;
        Graph.RequestReset(menu.Sha, mode);
    }

    private static string ResetTitle(GitResetMode mode) => mode switch
    {
        GitResetMode.Soft => "Soft reset",
        GitResetMode.Hard => "Hard reset",
        _ => "Mixed reset",
    };

    private static string ResetText(GitResetMode mode) => mode switch
    {
        GitResetMode.Soft => "Moves the branch here. The changes since this commit stay staged.",
        GitResetMode.Hard =>
            "Moves the branch here and discards every change since this commit, staged or not. Tammi can't bring them back.",
        _ => "Moves the branch here. The changes since this commit stay in the working directory, unstaged.",
    };

    private async Task ConfirmAsync()
    {
        if (_confirm is not { } confirm)
        {
            return;
        }

        _confirm = null;
        await confirm.Action();
    }

    private void StartCreateBranch(CommitMenu menu)
    {
        _commitMenu = null;
        _branchName = "";
        _branchPrompt = new BranchPrompt(BranchPromptKind.Create, menu.Sha);
        _focusBranchInput = true;
    }

    private void StartRenameBranch(string branch)
    {
        _commitMenu = null;
        _branchName = branch;
        _branchPrompt = new BranchPrompt(BranchPromptKind.Rename, branch);
        _focusBranchInput = true;
    }

    private async Task RunBranchAsync(Func<Task<bool>> action)
    {
        _commitMenu = null;
        await action();
    }

    private Task SubmitBranchPromptAsync() => SubmitBranchPromptAsync(checkout: true);

    private async Task SubmitBranchPromptAsync(bool checkout)
    {
        if (_branchPrompt is not { } prompt || !CanSubmitBranchPrompt)
        {
            return;
        }

        _branchPrompt = null;
        var name = _branchName.Trim();
        switch (prompt.Kind)
        {
            case BranchPromptKind.Create:
                await Graph.CreateBranchAsync(name, prompt.Name, checkout);
                break;
            default:
                if (name != prompt.Name)
                {
                    await Graph.RenameBranchAsync(prompt.Name, name);
                }
                break;
        }
    }

    // Asks for a new tag's name.
    private sealed record TagPrompt(string Sha);

    private const string PushSubmenu = "push";
    private const string DeleteSubmenu = "delete";
    private const string DeleteBranchSubmenu = "delete-branch:";

    private CommitMenu? _commitMenu;
    private TagPrompt? _tagPrompt;
    private string _tagName = "";

    private bool CanSubmitTagPrompt => _tagPrompt is not null && !string.IsNullOrWhiteSpace(_tagName);

    private async Task OpenCommitMenuAsync(string sha, MouseEventArgs e)
    {
        string[] tags = [.. Graph.LabelsFor(sha).Where(reference => reference.Kind == GitReferenceKind.Tag).Select(reference => reference.Name)];
        string[] branches = [.. Graph.LabelsFor(sha).Where(reference => reference.Kind == GitReferenceKind.LocalBranch).Select(reference => reference.Name)];
        string[] remoteBranches = [.. Graph.LabelsFor(sha).Where(reference => reference.Kind == GitReferenceKind.RemoteBranch).Select(reference => reference.Name)];
        var menu = new CommitMenu(e.ClientX, e.ClientY, sha, tags, branches, remoteBranches);
        _commitMenu = menu;
        _ = LoadUpstreamsAsync(menu);
        if (tags.Length == 0)
        {
            return;
        }

        // Whether the remote has each tag needs a trip to it, so the menu opens first with Push disabled.
        menu.Remote = await Graph.TagRemoteAsync();
        var found = new Dictionary<string, bool>();
        foreach (var tag in tags)
        {
            found[tag] = await Graph.TagExistsOnRemoteAsync(tag);
            if (!ReferenceEquals(_commitMenu, menu) || _disposed)
            {
                return;
            }

            menu.RemoteTags = new Dictionary<string, bool>(found);
            await InvokeAsync(StateHasChanged);
        }
    }

    // Which remote branch each local branch tracks is in the config, so the menu opens first.
    private async Task LoadUpstreamsAsync(CommitMenu menu)
    {
        var found = new Dictionary<string, GitUpstream?>();
        foreach (var branch in menu.Branches)
        {
            found[branch] = await Graph.BranchUpstreamAsync(branch);
        }

        if (ReferenceEquals(_commitMenu, menu) && !_disposed)
        {
            menu.Upstreams = found;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Where deleting a tag removes it from, for the confirmation.
    private static string DeleteTargets(CommitMenu menu, string tag) => PushState(menu, tag) is true ? $" locally and on {menu.Remote}" : " locally";

    // Whether the remote has a tag: null until it's been checked.
    private static bool? PushState(CommitMenu menu, string tag) =>
        menu.RemoteTags.TryGetValue(tag, out var known) ? known : null;

    // Where deleting a tag removes it from. Deleting doesn't wait for the remote check, which it repeats itself.
    private static string DeleteSuffix(CommitMenu menu, string tag) => PushState(menu, tag) switch
    {
        null => " (checking...)",
        true => $" (local and {menu.Remote})",
        false => " (local only)",
    };

    private static void ToggleSubmenu(CommitMenu menu, string submenu) =>
        menu.OpenSubmenu = menu.OpenSubmenu == submenu ? null : submenu;

    private void CloseCommitMenu() => _commitMenu = null;

    private void StartCreateTag(CommitMenu menu)
    {
        _commitMenu = null;
        _tagName = "";
        _tagPrompt = new TagPrompt(menu.Sha);
    }

    private async Task RunTagAsync(CommitMenu menu, Func<Task<bool>> action)
    {
        _commitMenu = null;
        await action();
    }

    private async Task SubmitTagPromptAsync(bool push)
    {
        if (_tagPrompt is not { } prompt || !CanSubmitTagPrompt)
        {
            return;
        }

        _tagPrompt = null;
        var name = _tagName.Trim();
        if (await Graph.CreateTagAsync(name, prompt.Sha) && push)
        {
            await Graph.PushTagAsync(name);
        }
    }

    // A commit's labels: HEAD when it's detached here, then the branches and tags the options show. The branch HEAD is
    // on stands out, and tags have a tag icon.
    private RenderFragment References(string sha, bool isHead) => __builder =>
    {
        if (isHead && Graph.Refs.HeadBranch is null)
        {
            <span class="git-graph-ref git-graph-ref-detached" title="Detached HEAD">HEAD</span>
        }

        foreach (var badge in GitGraphText.CombineBranches(Graph.LabelsFor(sha).Where(Options.Shows)))
        {
            var reference = badge.Primary;
            var combined = badge.Remotes.Count > 0;
            var current = reference.Kind == GitReferenceKind.LocalBranch && reference.Name == Graph.Refs.HeadBranch;
            var tagOnRemote = reference.Kind == GitReferenceKind.Tag && Graph.RemoteTags.Contains(reference.Name);
            var title = reference.Kind == GitReferenceKind.Tag ? (tagOnRemote ? $"Tag {reference.Name} (local and remote)" : $"Tag {reference.Name}")
                : combined ? $"{reference.Name} (local and {string.Join(", ", badge.Remotes.Select(remote => remote.Name))})"
                : reference.Kind == GitReferenceKind.RemoteBranch ? $"{reference.Name} (remote)"
                : $"{reference.Name} (local)";
            if (current)
            {
                title += " (HEAD)";
            }

            <span class="git-graph-ref @GitGraphText.ReferenceClass(reference.Kind) @(current ? "git-graph-ref-head" : null)"
                  title="@title">
                @if (reference.Kind == GitReferenceKind.Tag)
                {
                    <svg class="git-graph-ref-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9Z" />
                        <circle cx="8" cy="8" r="1.5" />
                    </svg>
                    if (tagOnRemote)
                    {
                        <svg class="git-graph-ref-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.5 4.75 4.75 0 0 1 17 18Z" />
                        </svg>
                    }
                }
                else
                {
                    if (reference.Kind == GitReferenceKind.LocalBranch)
                    {
                        <svg class="git-graph-ref-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <rect x="3" y="4" width="18" height="12" rx="1.5" />
                            <path d="M8 20h8M12 16v4" />
                        </svg>
                    }
                    if (reference.Kind == GitReferenceKind.RemoteBranch || combined)
                    {
                        <svg class="git-graph-ref-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.5 4.75 4.75 0 0 1 17 18Z" />
                        </svg>
                    }
                }
                <span class="git-graph-ref-name">@reference.Name</span>
            </span>
        }
    };

    // An item of the header's menu that's ticked when its option is on.
    private RenderFragment MenuCheckbox(string label, bool on, bool enabled, Action toggle) => __builder =>
    {
        <li role="none" @key="label">
            <button type="button" class="menu-item" role="menuitemcheckbox" aria-checked="@(on ? "true" : "false")"
                    disabled="@(!enabled)" @onclick="() => { CloseViewMenu(); toggle(); }">
                <svg class="icon icon-small git-graph-menu-check @(on ? null : "hidden")" viewBox="0 0 24 24"
                     aria-hidden="true" focusable="false">
                    <polyline points="5 12 10 17 19 7" />
                </svg>
                @label
            </button>
        </li>
    };

    // A handle on a column heading's edge that resizes the column: drag it, or focus it and use Left and Right.
    // `end` puts it on the heading's right edge, otherwise it's on its left edge.
    private static RenderFragment ColumnHandle(GitGraphColumn column, bool end) => __builder =>
    {
        <span class="git-graph-column-handle @(end ? "git-graph-column-handle-end" : "git-graph-column-handle-start")"
              role="separator" aria-orientation="vertical" aria-label="Resize the @column column" tabindex="0"
              title="Drag to resize. Double-click to reset." data-column="@ColumnKey(column)"
              data-direction="@(end ? "1" : "-1")"></span>
    };

    // Names the column's width in CSS (--git-graph-col-<key>) and in GitGraphView.razor.js.
    private static string ColumnKey(GitGraphColumn column) => column switch
    {
        GitGraphColumn.Commit => "sha",
        _ => column.ToString().ToLowerInvariant(),
    };

    // A column's track in the grid, and its width when the list is at its narrowest. Description takes the space left.
    private static (string Track, string MinWidth) Track(GitGraphColumn column) => column switch
    {
        GitGraphColumn.Graph => ("var(--git-graph-graph-column)", "var(--git-graph-graph-column)"),
        GitGraphColumn.Description => ("minmax(120px, 1fr)", "120px"),
        GitGraphColumn.Author => ("var(--git-graph-col-author, 160px)", "var(--git-graph-col-author, 160px)"),
        GitGraphColumn.Date => ("var(--git-graph-col-date, 120px)", "var(--git-graph-col-date, 120px)"),
        _ => ("var(--git-graph-col-sha, 72px)", "var(--git-graph-col-sha, 72px)"),
    };

    // The graph's width, and the columns shown, which the header and every row share.
    private string ListStyle
    {
        get
        {
            var tracks = _visibleColumns.Select(Track).ToArray();
            var minWidth = string.Join(" + ", tracks.Select(track => track.MinWidth));
            return $"--git-graph-width: {GraphWidth}px; "
                + $"--git-graph-columns: {string.Join(" ", tracks.Select(track => track.Track))}; "
                + $"--git-graph-columns-min-width: calc({minWidth} + {tracks.Length - 1} * var(--space-3) "
                + "+ var(--space-2) + var(--space-3))";
        }
    }

    private void OpenViewMenu(MouseEventArgs e) => _viewMenu = (e.ClientX, e.ClientY);

    private void CloseViewMenu() => _viewMenu = null;

    private void OnViewMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseViewMenu();
        }
    }

    // This graph's menu, or another's, changed the options. Rows already shown are rendered again with them.
    private void OnOptionsChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed)
        {
            return;
        }

        _visibleColumns = Options.VisibleColumns;
        if (_virtualize is not null)
        {
            await _virtualize.RefreshDataAsync();
        }

        StateHasChanged();
    });
}
