@* Step 1 of the Create Workspace flow: find tasks in every connected Task Source at once and choose any number. *@
@implements IDisposable
@using Deosrc.Tammi.Core.Integrations
@using Deosrc.Tammi.Core.Platform
@inject IntegrationRegistry Registry
@inject TaskFinder TaskFinder
@inject IWorkspaceStore WorkspaceStore
@inject IProcessLauncher ProcessLauncher

<div class="task-picker">
    <section class="task-picker-search" aria-label="Find tasks">
        @if (!_hasSources)
        {
            <p class="placeholder">
                No connected integrations provide tasks. Connect one in
                <FluentLink Href="@AppRoutes.SettingsIntegrations">Settings › Integrations</FluentLink>, or go on without tasks.
            </p>
        }
        else
        {
            <form class="task-search" @onsubmit="SearchNowAsync">
                <AutofocusTextInput Class="task-query" TextInputType="TextInputType.Search" aria-label="Search tasks"
                                 AutoComplete="off" Autofocus="true" Immediate="true" Width="100%"
                                 Placeholder="Search your tasks, or paste a link or reference"
                                 Value="@_query" ValueChanged="OnQueryChanged" />
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary">Search</FluentButton>
            </form>
            <p class="settings-help">
                Words are searched in your own and your organisations' tasks in @SourceNames. To add any other task, paste its
                link, or its reference such as <code>owner/repo#42</code> or <code>ABC-123</code>. For your own
                repositories, <code>repo#42</code> and <code>repo some words</code> work too, and so does just
                <code>123</code> for JIRA issues.
            </p>

            <div class="task-results" aria-live="polite" aria-busy="@(_searching ? "true" : "false")">
                <h2>
                    @ResultsHeading
                    @if (_searching)
                    {
                        <FluentSpinner Class="task-searching" Size="SpinnerSize.Tiny" aria-label="Searching" />
                    }
                </h2>
                @if (_results?.Kind is null or TaskSearchKind.Assigned)
                {
                    <p class="settings-help task-results-help">
                        Open tasks assigned to you that aren't in a workspace yet. Tasks already in progress aren't
                        listed.
                    </p>
                }

                @foreach (var error in _results?.Errors ?? [])
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine"
                                      AllowDismiss="false">
                        <CopyOnClick>@error.SourceName: @error.Message</CopyOnClick>
                        @if (error.IsAuthentication)
                        {
                            <FluentLink Href="@AppRoutes.SettingsIntegrations">Check it in Settings › Integrations.</FluentLink>
                        }
                    </FluentMessageBar>
                }

                @if (_results is null)
                {
                    <p class="placeholder">
                        <FluentSpinner Size="SpinnerSize.Small" aria-label="Searching" />
                        Searching…
                    </p>
                }
                else if (_results.IsUnrecognisedLink)
                {
                    <p class="placeholder">That link isn't to a task on any connected integration.</p>
                }
                else if (_results.Tasks.Count == 0)
                {
                    <p class="placeholder">@EmptyText</p>
                }
                else
                {
                    <ul class="task-list @(_searching ? "task-list-stale" : null)">
                        @foreach (var task in _results.Tasks)
                        {
                            var chosen = Draft.ContainsTask(task.Reference);
                            @* The whole card toggles the task, so the checkbox ignores the mouse, which reaches the card
                               instead. It still works with the keyboard. The status and the open-in-browser button
                               end the card, and the button stops its click reaching the card. *@
                            <CardListItem @key="task.Reference" Chosen="chosen" OnClick="() => Toggle(task)">
                                <FluentCheckbox Class="task-checkbox" Value="chosen" ValueChanged="_ => Toggle(task)">
                                    <span class="task-choice-text">
                                        <TaskSourceIcon Source="Registry.Find(task.Source)" />
                                        <span class="task-key">@task.Key</span>
                                        <span class="task-title" title="@task.Title">@task.Title</span>
                                        @if (_workspaceNames.TryGetValue(task.Reference, out var workspace))
                                        {
                                            <FluentBadge Appearance="BadgeAppearance.Tint" title="@($"Already in the workspace {workspace}")">
                                                In @workspace
                                            </FluentBadge>
                                        }
                                    </span>
                                </FluentCheckbox>
                                <TaskStatusBadge Task="task" />
                                <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                                              IconOnly="true" IconStart="@(new Icons.Regular.Size16.Open())"
                                              Title="@($"Open {task.Key} in the browser")"
                                              aria-label="@($"Open {task.Key} in the browser")"
                                              StopPropagation="true" OnClick="() => Open(task)" />
                            </CardListItem>
                        }
                    </ul>
                }
            </div>
        }
    </section>

    <section class="task-picker-chosen" aria-labelledby="chosen-tasks-heading">
        <h2 id="chosen-tasks-heading">Chosen tasks (@Draft.Tasks.Count)</h2>
        @if (Draft.Tasks.Count == 0)
        {
            <p class="placeholder">
                @(Draft.IsEditing
                    ? "No tasks chosen. A workspace doesn't need tasks."
                    : "No tasks chosen. A workspace doesn't need tasks: you'll name it in the next step.")
            </p>
        }
        else
        {
            <ul class="task-list chosen-task-list">
                @foreach (var task in Draft.Tasks)
                {
                    <CardListItem @key="task.Reference">
                        <div class="task-choice">
                            <TaskSourceIcon Source="Registry.Find(task.Source)" />
                            <span class="task-key">@task.Key</span>
                            <span class="task-title" title="@task.Title">@task.Title</span>
                            <TaskStatusBadge Task="task" />
                        </div>
                        <FluentButton Class="card-remove" Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small"
                                      IconOnly="true" IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                      Title="@($"Remove {task.Key}")" aria-label="@($"Remove {task.Key}")"
                                      OnClick="() => Draft.RemoveTask(task.Reference)" />
                    </CardListItem>
                }
            </ul>
        }
    </section>
</div>

@code {
    /// <summary>
    /// How long typing has to pause before the search runs.
    /// </summary>
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(400);

    /// <summary>
    /// The draft whose tasks this chooses.
    /// </summary>
    [Parameter, EditorRequired]
    public WorkspaceDraft Draft { get; set; } = null!;

    private readonly CancellationTokenSource _disposed = new();
    private bool _hasSources;
    private string _query = "";
    private TaskSearchResults? _results;
    private bool _searching;
    private CancellationTokenSource? _search;

    // The workspace each task is already in, so it can be left out of the assigned tasks and marked elsewhere.
    private IReadOnlyDictionary<TaskReference, string> _workspaceNames = new Dictionary<TaskReference, string>();

    private string SourceNames => string.Join(", ", Registry.TaskIntegrations.Select(source => source.Name));

    private string ResultsHeading => _results?.Kind switch
    {
        TaskSearchKind.Reference => "Linked task",
        TaskSearchKind.Text => "Results",
        _ => "Assigned to you",
    };

    private string EmptyText => _results?.Kind switch
    {
        TaskSearchKind.Reference => "No task found there, or you can't see it.",
        TaskSearchKind.Text => "No tasks found.",
        _ => "Nothing assigned to you is waiting to be started.",
    };

    protected override async Task OnInitializedAsync()
    {
        Registry.Changed += OnRegistryChanged;
        _hasSources = Registry.TaskIntegrations.Count > 0;
        await LoadWorkspaceTasksAsync();
        await SearchAsync(delay: false);
    }

    public void Dispose()
    {
        Registry.Changed -= OnRegistryChanged;
        _disposed.Cancel();
        _disposed.Dispose();
        _search?.Cancel();
    }

    private async Task LoadWorkspaceTasksAsync()
    {
        IReadOnlyList<WorkspaceListing> workspaces;
        try
        {
            workspaces = await WorkspaceStore.ListAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var names = new Dictionary<TaskReference, string>();
        foreach (var listing in workspaces)
        {
            foreach (var task in listing.Workspace?.Tasks ?? [])
            {
                names.TryAdd(task, listing.Name);
            }
        }

        _workspaceNames = names;
    }

    private Task OnQueryChanged(string? query)
    {
        _query = query ?? "";
        return SearchAsync(delay: true);
    }

    private Task SearchNowAsync() => SearchAsync(delay: false, addLinkedTask: true);

    /// <summary>
    /// Searches for <see cref="_query"/>, replacing any search still running. When <paramref name="addLinkedTask"/>
    /// is set (the user pressed enter) and the search finds the one task a link or reference is to, it's chosen.
    /// The last results stay on screen,
    /// dimmed, until the new ones arrive.
    /// </summary>
    private async Task SearchAsync(bool delay, bool addLinkedTask = false)
    {
        // The cancelled search disposes of its own token source when it finishes.
        _search?.Cancel();
        if (!_hasSources)
        {
            _search = null;
            _results = null;
            _searching = false;
            return;
        }

        var search = _search = new CancellationTokenSource();
        try
        {
            if (delay)
            {
                await Task.Delay(SearchDelay, search.Token);
            }

            _searching = true;
            StateHasChanged();
            var results = await TaskFinder.FindAsync(_query, new HashSet<TaskReference>(_workspaceNames.Keys),
                search.Token);

            // A source that ignores cancellation can still finish after a newer search started.
            if (!search.IsCancellationRequested)
            {
                _results = results;
                _searching = false;

                // Pressing enter on a link or reference means the user wants that task: don't make them tick it.
                if (addLinkedTask && results is { Kind: TaskSearchKind.Reference, Tasks: [var linked] })
                {
                    Draft.AddTask(linked);
                }
            }
        }
        catch (OperationCanceledException) when (search.IsCancellationRequested)
        {
            // A newer search, or leaving the page, replaced it.
        }
        finally
        {
            if (_search == search)
            {
                _search = null;
            }

            search.Dispose();
        }
    }

    private void Toggle(TaskInfo task)
    {
        if (!Draft.AddTask(task))
        {
            Draft.RemoveTask(task.Reference);
        }
    }

    private void Open(TaskInfo task) => ProcessLauncher.Open(task.Url.AbsoluteUri);

    private void OnRegistryChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        _hasSources = Registry.TaskIntegrations.Count > 0;
        await SearchAsync(delay: false);
        StateHasChanged();
    });
}
