<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>tammi-installer</AssemblyName>
    <RootNamespace>Deosrc.Tammi.Installer</RootNamespace>
    <!-- Published as a self-contained single file for each OS, so it runs before .NET is installed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deosrc.Tammi.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deosrc.Tammi.Installation\Deosrc.Tammi.Installation.csproj" />
  </ItemGroup>

</Project>
