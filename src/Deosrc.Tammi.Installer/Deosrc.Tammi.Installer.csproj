<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>tammi-installer</AssemblyName>
    <RootNamespace>Deosrc.Tammi.Installer</RootNamespace>
    <!-- Published once, framework-dependent, for every OS: run it with `dotnet tammi-installer.dll`. The bootstrap
         scripts (scripts/install.sh and scripts/install.ps1) check for .NET, then download and run it. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deosrc.Tammi.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deosrc.Tammi.Installation\Deosrc.Tammi.Installation.csproj" />
  </ItemGroup>

</Project>
