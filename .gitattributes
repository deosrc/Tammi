# Normalise line endings to LF in the repository; check out with the platform default.
* text=auto

# Files that Windows tooling expects with CRLF.
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.slnf   text eol=crlf
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Files that must keep LF.
*.sh     text eol=lf

# Binary files.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svgz   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.dll    binary
*.exe    binary
*.snk    binary
